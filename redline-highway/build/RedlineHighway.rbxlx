<Item class="Folder" referent="RBX00000003">
<Properties>
<string name="Name">Gameplay</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000004">
<Properties>
<string name="Name">ClosePass</string>
<ProtectedString name="Source"><![CDATA[--[[
	ClosePass: close-pass scoring, a fictional arcade layer on top of the realistic driving. Pure maths
	with no Roblox objects; tools/close_pass_model.py is a line-for-line Python copy with tests. Keep
	the two in step.

	A pass counts when the player overtakes a traffic car at speed, faster than it by a margin, with a
	small gap between the two cars' sides while they are alongside. Closer and faster passes score
	more. Passes within a few seconds of each other build a combo multiplier; the combo is banked when
	the chain ends, and lost if the player hits a car first.

	Positions are road coordinates: s along the road (m), offset sideways (m), v along the road (m/s).
]]

local ClosePass = {}
ClosePass.__index = ClosePass

ClosePass.DEFAULTS = {
	minSpeedKmh = 120, -- the player must be at least this fast
	minRelativeKmh = 30, -- and this much faster than the car being passed
	maxGap = 2.0, -- m between the cars' sides for a pass to count
	closeGap = 1.0, -- m, "close pass"
	insaneGap = 0.5, -- m, "insane pass"
	basePoints = 100,
	closenessPoints = 400, -- added at the closest gaps
	speedRef = 200, -- km/h where the speed factor is 1
	speedExponent = 1.5,
	comboWindow = 4.0, -- s to make the next pass and keep the combo going
	comboStep = 0.5, -- added to the multiplier for each chained pass
	comboMax = 5.0,
}

function ClosePass.new(settings, lap: number)
	local self = setmetatable({}, ClosePass)
	self.settings = settings or ClosePass.DEFAULTS
	self.lap = lap
	self.tracks = {} -- cars alongside the player right now
	self.total = 0 -- banked points
	self.combo = 0 -- points in the current, unbanked combo
	self.multiplier = 1
	self.timer = 0 -- time left to chain the next pass
	self.passes = 0
	self.events = {}
	return self
end

function ClosePass:wrap(d: number): number
	return (d + self.lap / 2) % self.lap - self.lap / 2
end

-- player and each car: { s, offset, v, length, width }. cars: id -> car.
function ClosePass:update(dt: number, player, cars)
	table.clear(self.events)
	if self.timer > 0 then
		self.timer -= dt
		if self.timer <= 0 then
			self.timer = 0
			if self.combo > 0 then
				self.total += self.combo
				table.insert(self.events, { kind = "banked", points = self.combo, total = self.total })
			end
			self.combo = 0
			self.multiplier = 1
		end
	end

	for id, car in cars do
		local ds = self:wrap(car.s - player.s) -- positive: the car is ahead
		local alongside = math.abs(ds) < (player.length + car.length) / 2
		local gap = math.abs(car.offset - player.offset) - (player.width + car.width) / 2
		local track = self.tracks[id]
		if alongside then
			if track == nil then
				track = { minGap = gap, startedBehind = ds > 0, crashed = false }
				self.tracks[id] = track
			else
				track.minGap = math.min(track.minGap, gap)
			end
			if gap < 0 and not track.crashed then
				track.crashed = true
				table.insert(self.events, { kind = "crash", lost = self.combo })
				self.combo = 0
				self.multiplier = 1
				self.timer = 0
			end
		elseif track ~= nil then
			self.tracks[id] = nil
			if track.startedBehind and ds < 0 and not track.crashed then
				self:score(player, car, track.minGap)
			end
		end
	end

	for id in self.tracks do
		if cars[id] == nil then
			self.tracks[id] = nil
		end
	end
end

function ClosePass:score(player, car, gap: number)
	local st = self.settings
	local speed = player.v * 3.6
	local relative = (player.v - car.v) * 3.6
	if speed < st.minSpeedKmh or relative < st.minRelativeKmh or gap > st.maxGap then
		return
	end
	local closeness = math.clamp((st.maxGap - gap) / (st.maxGap - st.insaneGap), 0, 1)
	local points = (st.basePoints + st.closenessPoints * closeness ^ 1.5) * (speed / st.speedRef) ^ st.speedExponent
	if self.timer > 0 then
		self.multiplier = math.min(st.comboMax, self.multiplier + st.comboStep)
	else
		self.multiplier = 1
	end
	local gained = math.floor(points * self.multiplier + 0.5)
	self.combo += gained
	self.timer = st.comboWindow
	self.passes += 1
	local label = if gap <= st.insaneGap then "INSANE PASS" elseif gap <= st.closeGap then "CLOSE PASS" else "NEAR MISS"
	table.insert(self.events, {
		kind = "pass",
		points = gained,
		label = label,
		gap = gap,
		multiplier = self.multiplier,
		combo = self.combo,
	})
end

return ClosePass
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000005">
<Properties>
<string name="Name">MapLighting</string>
<ProtectedString name="Source"><![CDATA[--[[
	MapLighting: the look of each map. The server applies the oval's afternoon when the game starts;
	each client then applies the preset of the map its player is on (a map's data names it), so a
	player in the city sees night while a player on the oval keeps the afternoon. Lighting changes
	made by a client affect only that client.

	Lighting.Technology can't be set by scripts: set it to Future in Studio for the intended look.
]]

local Lighting = game:GetService("Lighting")

local MapLighting = {}

MapLighting.presets = {
	-- the proving ground's late afternoon
	Afternoon = {
		clockTime = 16.4,
		brightness = 3,
		latitude = 38,
		ambient = Color3.fromRGB(40, 40, 44),
		outdoorAmbient = Color3.fromRGB(128, 128, 128),
		exposure = 0,
		diffuse = 1,
		specular = 1,
		shadowSoftness = 0.15,
		atmosphere = { density = 0.28, offset = 0.2, color = Color3.fromRGB(205, 186, 160), decay = Color3.fromRGB(110, 115, 128), glare = 0.35, haze = 1.4 },
		bloom = { intensity = 0.3, size = 28, threshold = 1.5 },
		grade = { brightness = 0, contrast = 0.06, saturation = 0.06, tint = Color3.fromRGB(255, 255, 255) },
		sunRays = { intensity = 0.04, spread = 0.55 },
	},
	-- the city at night: dark blue sky, a hazy horizon, strong bloom on lamps, signs and windows
	Night = {
		clockTime = 22.6,
		brightness = 1.2,
		latitude = 35,
		ambient = Color3.fromRGB(22, 24, 34),
		outdoorAmbient = Color3.fromRGB(64, 70, 96),
		exposure = 0.35,
		diffuse = 0.35,
		specular = 1,
		shadowSoftness = 0.3,
		atmosphere = { density = 0.34, offset = 0.05, color = Color3.fromRGB(54, 62, 86), decay = Color3.fromRGB(24, 26, 40), glare = 0, haze = 1.8 },
		bloom = { intensity = 0.9, size = 34, threshold = 0.85 },
		grade = { brightness = 0.02, contrast = 0.12, saturation = 0.08, tint = Color3.fromRGB(232, 236, 255) },
		sunRays = { intensity = 0, spread = 0.55 },
	},
}

local function ensure(className: string): Instance
	local object = Lighting:FindFirstChildOfClass(className)
	if object == nil then
		object = Instance.new(className)
		object.Parent = Lighting
	end
	return object
end

-- Apply a preset by name (unknown names fall back to the afternoon).
function MapLighting.apply(name: string?)
	local p = MapLighting.presets[name or "Afternoon"] or MapLighting.presets.Afternoon
	Lighting.ClockTime = p.clockTime
	Lighting.Brightness = p.brightness
	Lighting.GeographicLatitude = p.latitude
	Lighting.Ambient = p.ambient
	Lighting.OutdoorAmbient = p.outdoorAmbient
	Lighting.ExposureCompensation = p.exposure
	Lighting.EnvironmentDiffuseScale = p.diffuse
	Lighting.EnvironmentSpecularScale = p.specular
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = p.shadowSoftness

	local atmosphere = ensure("Atmosphere") :: Atmosphere
	atmosphere.Density = p.atmosphere.density
	atmosphere.Offset = p.atmosphere.offset
	atmosphere.Color = p.atmosphere.color
	atmosphere.Decay = p.atmosphere.decay
	atmosphere.Glare = p.atmosphere.glare
	atmosphere.Haze = p.atmosphere.haze

	local bloom = ensure("BloomEffect") :: BloomEffect
	bloom.Intensity = p.bloom.intensity
	bloom.Size = p.bloom.size
	bloom.Threshold = p.bloom.threshold

	local grade = ensure("ColorCorrectionEffect") :: ColorCorrectionEffect
	grade.Brightness = p.grade.brightness
	grade.Contrast = p.grade.contrast
	grade.Saturation = p.grade.saturation
	grade.TintColor = p.grade.tint

	local sunRays = ensure("SunRaysEffect") :: SunRaysEffect
	sunRays.Intensity = p.sunRays.intensity
	sunRays.Spread = p.sunRays.spread
end

return MapLighting
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX00000006">
<Properties>
<string name="Name">TrafficSystem</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000007">
<Properties>
<string name="Name">DriverProfiles</string>
<ProtectedString name="Source"><![CDATA[--[[
	Traffic driver profiles and the shared traffic settings.

	Each traffic car gets a profile, then its own desired speed within the profile's range, so no
	two cars drive alike. Values follow typical highway calibrations of the Intelligent Driver Model
	and MOBIL (Treiber and Kesting, "Traffic Flow Dynamics", 2013) and are tuned in testing.

	  speed       desired speed range, km/h
	  gap         desired time gap to the car ahead, s
	  minGap      gap kept when stopped, m
	  accel       comfortable acceleration, m/s^2
	  decel       comfortable braking, m/s^2
	  politeness  MOBIL politeness: how much the gains and losses of others count, 0 to 1
	  threshold   MOBIL threshold: how much better a lane must be before changing, m/s^2
	  length, width   body size, m
	  lateral     the most sideways acceleration the driver accepts in a curve, m/s^2; traffic slows
	              for curves so that it stays within this (comfortable values, Traffic Flow Dynamics
	              and highway design guides put typical drivers at 2 to 3 m/s^2)
	  rightLanes  if set, the profile only uses this many lanes on the right (trucks)
	  share       how common the profile is
]]

local DriverProfiles = {}

DriverProfiles.profiles = {
	cautious = { speed = { 95, 110 }, gap = 1.8, minGap = 2.5, accel = 1.0, decel = 1.5, politeness = 0.5, threshold = 0.3, length = 4.6, width = 1.8, lateral = 2.0, share = 0.25 },
	normal = { speed = { 110, 130 }, gap = 1.4, minGap = 2.0, accel = 1.4, decel = 2.0, politeness = 0.3, threshold = 0.2, length = 4.7, width = 1.85, lateral = 2.4, share = 0.45 },
	aggressive = { speed = { 130, 155 }, gap = 0.9, minGap = 1.5, accel = 2.0, decel = 2.5, politeness = 0.1, threshold = 0.1, length = 4.6, width = 1.85, lateral = 3.0, share = 0.15 },
	truck = { speed = { 80, 90 }, gap = 1.8, minGap = 3.0, accel = 0.6, decel = 1.5, politeness = 0.5, threshold = 0.3, length = 14.0, width = 2.5, lateral = 1.6, rightLanes = 2, share = 0.15 },
}
-- fixed order, so random choices are repeatable for a given seed
DriverProfiles.order = { "cautious", "normal", "aggressive", "truck" }

DriverProfiles.MAX_DECEL = 9.0 -- m/s^2, the hardest any car can brake
DriverProfiles.KEEP_RIGHT_BIAS = 0.25 -- m/s^2 added to the incentive for moving right
DriverProfiles.SAFE_DECEL = 4.0 -- m/s^2, the most a new follower may have to brake for a lane change
DriverProfiles.LANE_CHANGE_TIME = 3.0 -- seconds to move across one lane
DriverProfiles.DECISION_INTERVAL = { 1.0, 2.0 } -- seconds between a driver's lane-change decisions
DriverProfiles.MIN_TIME_IN_LANE = 4.0 -- seconds after a lane change before the next one
-- how traffic expects a player's car to brake, used in the lane-change safety check
DriverProfiles.PLAYER = { gap = 1.0, minGap = 2.0, accel = 3.0, decel = 6.0 }
-- Curves: each profile has a speed limit for every LIMIT_STEP metres of road, from its lateral
-- comfort and the curvature (RoadGeometry:speedLimits), lowered ahead of each curve so that slowing
-- at CURVE_DECEL gets there in time. A driver aims for the limit CURVE_LOOKAHEAD seconds ahead and
-- closes the difference over CURVE_RESPONSE seconds.
DriverProfiles.LIMIT_STEP = 10 -- m
DriverProfiles.CURVE_DECEL = 1.0 -- m/s^2
DriverProfiles.CURVE_LOOKAHEAD = 1.0 -- s
DriverProfiles.CURVE_RESPONSE = 1.0 -- s

return DriverProfiles
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000008">
<Properties>
<string name="Name">IDM</string>
<ProtectedString name="Source"><![CDATA[--[[
	Intelligent Driver Model (Treiber, Hennecke and Helbing, 2000): a car-following model that gives
	a driver's acceleration from their speed, the gap to the car ahead and how fast they are closing
	on it. It keeps a safe time gap, brakes smoothly and doesn't crash in normal traffic.
]]

local DriverProfiles = require(script.Parent.DriverProfiles)

local IDM = {}

--[[
	p: profile (accel, decel, gap, minGap). v: speed (m/s). v0: desired speed (m/s).
	gap: bumper-to-bumper distance to the leader (m), or nil on a free road.
	dv: closing speed, v minus the leader's speed (m/s).
	Returns acceleration in m/s^2, never below -MAX_DECEL.
]]
function IDM.acceleration(p, v: number, v0: number, gap: number?, dv: number): number
	local free = if v0 > 0 then 1 - (v / v0) ^ 4 else -1
	if gap == nil then
		return math.max(p.accel * free, -DriverProfiles.MAX_DECEL)
	end
	local desiredGap = p.minGap + math.max(0, v * p.gap + v * dv / (2 * math.sqrt(p.accel * p.decel)))
	local ratio = desiredGap / math.max(gap, 0.1)
	return math.max(p.accel * (free - ratio * ratio), -DriverProfiles.MAX_DECEL)
end

return IDM
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000009">
<Properties>
<string name="Name">MapRegistry</string>
<ProtectedString name="Source"><![CDATA[--[[
	MapRegistry: the game's maps, in the order the map key (N) cycles through them. Each map is a
	data module in TrafficSystem/Maps; its road (RoadGeometry) is built the first time it's asked for,
	on the server and on each client.

	A map: { id, displayName, data, road }. Both maps live in the same place, far apart: the oval at
	the world's origin and the city about 9 km away (see each map's origin).
]]

local RoadGeometry = require(script.Parent:WaitForChild("RoadGeometry"))
local Maps = script.Parent:WaitForChild("Maps")

local MapRegistry = {}

MapRegistry.order = { "Oval", "City" }
MapRegistry.default = "Oval"

local DATA = {
	Oval = require(Maps:WaitForChild("Oval")),
	City = require(Maps:WaitForChild("City")),
}

local built = {}

-- True if id names a map (for checking values that come from clients).
function MapRegistry.isMap(id: any): boolean
	return type(id) == "string" and DATA[id] ~= nil
end

function MapRegistry.get(id: string)
	local map = built[id]
	if map == nil then
		local data = DATA[id]
		assert(data ~= nil, "unknown map " .. tostring(id))
		map = { id = id, displayName = data.displayName, data = data, road = RoadGeometry.new(data) }
		built[id] = map
	end
	return map
end

-- The map after id in the cycle.
function MapRegistry.next(id: string): string
	for i, name in MapRegistry.order do
		if name == id then
			return MapRegistry.order[i % #MapRegistry.order + 1]
		end
	end
	return MapRegistry.default
end

return MapRegistry
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX0000000A">
<Properties>
<string name="Name">Maps</string>
</Properties>
<Item class="ModuleScript" referent="RBX0000000B">
<Properties>
<string name="Name">City</string>
<ProtectedString name="Source"><![CDATA[--[[
	Map data: Sekirei Bay Loop, a fictional night-time city expressway in the style of an elevated
	urban motorway: a 3-lane one-way loop of concrete viaducts with tight walls, two sodium-lit
	tunnels, sweeping junction curves, a 270-degree loop ramp that climbs over its own approach, and
	a 2.9 km straight along the bay. All names are invented.

	Route (s = 0 is the east end of the bay straight, heading west, bay on the left):
	  0 - 2600       Seaside Straight, on piers along the bay, 14 m up (continues from 12,387)
	  2600 - 3337    Kirameki JCT: right, R 380, climbing to 22 m
	  3337 - 5156    the Ward S-bends through dense city (R 260 left, R 240 right), then the descent
	  5100 - 7600    Kagerou Tunnel (2.5 km), with a gentle S (R 1100) near the far end
	  7600 - 9125    climb to the loop approach, 9 m up
	  9125 - 10225   Tsukimi JCT loop: left 270 degrees, R 210, climbing over the approach at s 10,382
	  10950 - 11550  Hotaru Tunnel (0.6 km) through the east S-bend
	  11587 - 12387  Umikaze JCT: right, R 420, back onto the bay

	Read by TrafficSystem/RoadGeometry (see there for the meaning of each field) and by
	tools/road_geometry.py, which reads only plain numbers, strings and tables, so keep this module
	free of expressions. The two long straights' lengths were solved so the loop closes exactly; if
	you change the plan, re-solve them (the road warns in Output when the loop doesn't close).
	Distances are metres, angles degrees; positive curve angles turn right.
]]

return {
	id = "City",
	displayName = "Sekirei Bay Loop",
	lanes = 3,
	laneWidth = 3.5,
	shoulderLeft = 0.75,
	shoulderRight = 1.25,
	origin = { 900, 0, 9000 },
	heading = 180,
	plan = {
		{ "straight", 2600 }, -- Seaside Straight
		{ "curve", 380, 90, 140 }, -- Kirameki JCT
		{ "straight", 400 },
		{ "curve", 260, -32, 90 }, -- Ward S-bends
		{ "straight", 160 },
		{ "curve", 240, 62, 90 },
		{ "straight", 250 },
		{ "curve", 300, 60, 110 }, -- down into Kagerou Tunnel
		{ "straight", 2087.939120501273 },
		{ "curve", 1100, 18, 120 },
		{ "straight", 500 },
		{ "curve", 1100, -18, 120 },
		{ "straight", 450 }, -- loop approach, under the loop's exit
		{ "curve", 210, -270, 110 }, -- Tsukimi JCT loop
		{ "straight", 300 },
		{ "curve", 450, 25, 120 }, -- east S-bend, through Hotaru Tunnel
		{ "straight", 250 },
		{ "curve", 450, -25, 120 },
		{ "straight", 179.59232962994145 },
		{ "curve", 420, 90, 140 }, -- Umikaze JCT
		{ "straight", 300 },
	},
	-- points { s, height above the street, vertical curve length }
	elevation = {
		{ 0, 14, 0 },
		{ 2350, 14, 300 },
		{ 3150, 22, 400 },
		{ 4250, 19, 300 },
		{ 4950, 0.5, 300 },
		{ 7700, 0.5, 300 },
		{ 8450, 9, 300 },
		{ 9000, 9, 300 },
		{ 10380, 21, 300 },
		{ 10850, 0.5, 300 },
		{ 11650, 0.5, 300 },
		{ 12150, 14, 300 },
	},
	sections = {
		{ kind = "tunnel", style = "box", from = 5100, to = 7600, name = "Kagerou Tunnel", reverb = 2.2 },
		{ kind = "tunnel", style = "box", from = 10950, to = 11550, name = "Hotaru Tunnel", reverb = 1.6 },
	},
	start = 150,
	lighting = "Night",
	traffic = { density = 6, seed = 1107, idBase = 30000, clearance = 200 },
	-- scenery for CityBuilder (and the map picture): the shore line (world z, m; water to the south,
	-- up to the far shore), and two decorative viaducts that cross the loop at a junction (s, at
	-- angle degrees to the road, deck top height in m) and run back and ahead (m) to ramps that meet
	-- the ground
	decor = {
		shore = 8970,
		farShore = 12500,
		flyovers = {
			{ name = "Kirameki Bay Viaduct", s = 2860, angle = 55, top = 6.5, back = 3750, ahead = 560, ramp = 300 },
			{ name = "Umikaze Bay Bridge", s = 12230, angle = -60, top = 23, back = 650, ahead = 3800, ramp = 420, towers = true },
		},
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000C">
<Properties>
<string name="Name">Oval</string>
<ProtectedString name="Source"><![CDATA[--[[
	Map data: Redline Proving Ground, a 4-lane highway oval with 2.4 km straights and 650 m radius
	curves eased in by 200 m transition curves. Flat, so acceleration, braking and top-speed runs
	on the main straight measure the car and nothing else. A 300 m covered gallery on the back
	straight gives tunnel sound something to test.

	Read by TrafficSystem/RoadGeometry (see there for the meaning of each field) and by
	tools/road_geometry.py, which reads only plain numbers, strings and tables, so keep this module
	free of expressions. Distances are metres, angles degrees; positive curve angles turn right.
]]

return {
	id = "Oval",
	displayName = "Redline Proving Ground",
	lanes = 4,
	laneWidth = 3.75,
	shoulderLeft = 3.0,
	shoulderRight = 3.0,
	-- where s = 0 is (the start of the main straight), and the direction of travel there (0 = +X)
	origin = { -1200, 0, -652.5701219231985 },
	heading = 0,
	plan = {
		{ "straight", 2400 }, -- main straight, along +X
		{ "curve", 650, 180, 200 },
		{ "straight", 2400 }, -- back straight
		{ "curve", 650, 180, 200 },
	},
	-- points { s, height, vertical curve length }: level all round
	elevation = {
		{ 0, 0, 0 },
	},
	sections = {
		{ kind = "tunnel", style = "gallery", from = 5600, to = 5900, name = "Back Straight Gallery", reverb = 0.8 },
	},
	start = 150, -- start line, m along the main straight
	lighting = "Afternoon",
	-- traffic: cars per km per lane, random seed, first car id (ids stay unique across maps), and the
	-- distance kept clear around the start grid when the server starts
	traffic = { density = 5, seed = 812, idBase = 0, clearance = 200 },
}
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBX0000000D">
<Properties>
<string name="Name">RoadGeometry</string>
<ProtectedString name="Source"><![CDATA[--[[
	RoadGeometry: the shape of a closed road, built from a map's data (TrafficSystem/Maps). Shared by
	the server (map building, traffic, spawning) and clients (drawing traffic, close-pass scoring).
	tools/road_geometry.py is a line-for-line Python copy with tests (closure, continuity, round
	trips, curve speeds, grades, speed). Keep the two in step.

	Coordinates are world metres (Y up). s is the distance along the road in plan view (a highway's
	chainage), from 0 at the map's origin to road.length, where the loop closes. offset is sideways
	from the centre line, positive to the driver's right. height is above the road surface. Lanes
	are numbered from the left: lane 1 is the fast lane. Every lane runs the same way round.

	Map data fields:
	  lanes, laneWidth            lane count and width (m)
	  shoulderLeft, shoulderRight paved width beyond the outer lanes (m)
	  origin, heading             where s = 0 is ({ x, base height, z }) and the direction of travel
	                              there, in degrees (0 = +X, 90 = +Z)
	  plan                        { "straight", length } and { "curve", radius, degrees, transition }:
	                              a curve turns by degrees (positive = right) on a circle, with a
	                              transition curve of the given length at each end whose curvature
	                              grows evenly from zero (a clothoid)
	  elevation                   points { s, height, vertical curve length }, joined by straight
	                              grades with a parabolic vertical curve centred on each point; it
	                              must start at s = 0 with no curve and be level at both ends
	  sections                    { kind = "tunnel", from, to, ... }: stretches the map builders treat
	                              specially

	Transition curves are stored as short arcs of stepped curvature, so every piece of the road is a
	straight or a circular arc, and positions, directions and projections are exact (to rounding).
	project() finds the pieces near a position through a grid, so it costs a few pieces per call.
]]

local RoadGeometry = {}
RoadGeometry.__index = RoadGeometry

local TAU = 2 * math.pi
local SPIRAL_STEP = 8 -- m: transition curves are split into arcs no longer than this
local BUCKET = 8 -- m: lookup buckets for finding the piece at a distance s
local CELL = 64 -- m: grid cells for finding the pieces near a position
local REACH = 40 -- m beyond the road's edges that the grid covers
local NEAR = 2 -- m: heights within this of 1 m above the road cost nothing when choosing a piece

local function wrapAngle(a: number): number
	return (a + math.pi) % TAU - math.pi
end

local function cellKey(cx: number, cz: number): number
	return (cx + 50000) * 100000 + (cz + 50000)
end

-- Position (x, z) and heading at distance t into a piece.
local function pointOnPiece(piece, t: number): (number, number, number)
	if piece.k == 0 then
		return piece.x + t * piece.cos, piece.z + t * piece.sin, piece.heading
	end
	local heading = piece.heading + piece.k * t
	return piece.cx + math.sin(heading) / piece.k, piece.cz - math.cos(heading) / piece.k, heading
end

-- Where a plan position (x, z) falls along a piece: distance t into it (not clamped: below 0 or
-- beyond its length means before or after it) and sideways offset from it.
local function projectOnPiece(piece, x: number, z: number): (number, number)
	if piece.k == 0 then
		local dx, dz = x - piece.x, z - piece.z
		return dx * piece.cos + dz * piece.sin, dz * piece.cos - dx * piece.sin
	end
	local dx, dz = x - piece.cx, z - piece.cz
	local distance = math.sqrt(dx * dx + dz * dz)
	local angle = if piece.k > 0 then math.atan2(dx, -dz) else math.atan2(-dx, dz)
	local middle = piece.heading + piece.k * piece.length / 2
	return piece.length / 2 + wrapAngle(angle - middle) / piece.k, 1 / piece.k - math.sign(piece.k) * distance
end

function RoadGeometry.new(data)
	local self = setmetatable({}, RoadGeometry)
	self.id = data.id
	self.data = data
	self.lanes = data.lanes
	self.laneWidth = data.laneWidth
	self.halfWidth = data.lanes * data.laneWidth / 2
	self.leftEdge = self.halfWidth + data.shoulderLeft
	self.rightEdge = self.halfWidth + data.shoulderRight
	self.base = data.origin[2]

	-- plan view: pieces of constant curvature (straights and arcs)
	local pieces = {}
	local x, z = data.origin[1], data.origin[3]
	local heading = math.rad(data.heading)
	local s = 0

	local function add(length: number, k: number)
		local piece = {
			s = s,
			length = length,
			x = x,
			z = z,
			heading = heading,
			k = k,
			cos = math.cos(heading),
			sin = math.sin(heading),
			cx = 0,
			cz = 0,
		}
		if k ~= 0 then
			piece.cx = x - piece.sin / k
			piece.cz = z + piece.cos / k
			heading += k * length
			x = piece.cx + math.sin(heading) / k
			z = piece.cz - math.cos(heading) / k
		else
			x += length * piece.cos
			z += length * piece.sin
		end
		s += length
		table.insert(pieces, piece)
	end

	for _, element in data.plan do
		if element[1] == "straight" then
			add(element[2], 0)
		else
			local radius, degrees = element[2], element[3]
			local spiral = element[4] or 0
			assert(degrees ~= 0, "a curve must turn")
			local k = math.sign(degrees) / radius
			local arc = math.rad(math.abs(degrees)) * radius - spiral
			assert(arc >= -1e-6, "transition curves longer than their curve in map " .. tostring(data.id))
			local n = math.ceil(spiral / SPIRAL_STEP)
			for i = 1, n do
				add(spiral / n, k * (i - 0.5) / n)
			end
			if arc > 1e-6 then
				add(arc, k)
			end
			for i = n, 1, -1 do
				add(spiral / n, k * (i - 0.5) / n)
			end
		end
	end
	self.pieces = pieces
	self.length = s
	self.closure = math.sqrt((x - data.origin[1]) ^ 2 + (z - data.origin[3]) ^ 2)
	self.headingError = wrapAngle(heading - math.rad(data.heading))
	if self.closure > 0.01 or math.abs(self.headingError) > 1e-4 then
		warn(string.format("[RoadGeometry] Map %s doesn't close: its end is %.3f m and %.4f degrees from its start",
			tostring(data.id), self.closure, math.deg(self.headingError)))
	end

	-- lookup buckets: the piece where each BUCKET-metre stretch starts
	local bucketCount = math.floor(self.length / BUCKET) + 1
	local buckets = table.create(bucketCount, 1)
	local index = 1
	for b = 1, bucketCount do
		local at = (b - 1) * BUCKET
		while index < #pieces and pieces[index + 1].s <= at do
			index += 1
		end
		buckets[b] = index
	end
	self.buckets = buckets

	-- elevation: pieces where height = y + grade * t + rate * t^2 / 2, t = s - start
	local points = data.elevation
	assert(points[1][1] == 0 and (points[1][3] or 0) == 0, "the elevation must start at s = 0 with no vertical curve")
	local count = #points
	local function pvi(i: number): (number, number, number)
		if i > count then
			return self.length, points[1][2], 0
		end
		local p = points[i]
		return p[1], p[2], p[3] or 0
	end
	local grades = {}
	for i = 1, count do
		local s0, y0 = pvi(i)
		local s1, y1 = pvi(i + 1)
		assert(s1 > s0, "elevation points out of order in map " .. tostring(data.id))
		grades[i] = (y1 - y0) / (s1 - s0)
	end
	local profile = { { s = 0, y = points[1][2], grade = grades[1], rate = 0 } }
	for i = 2, count do
		local si, yi, curve = pvi(i)
		if curve > 0 then
			table.insert(profile, { s = si - curve / 2, y = yi - grades[i - 1] * curve / 2, grade = grades[i - 1],
				rate = (grades[i] - grades[i - 1]) / curve })
			table.insert(profile, { s = si + curve / 2, y = yi + grades[i] * curve / 2, grade = grades[i], rate = 0 })
		else
			table.insert(profile, { s = si, y = yi, grade = grades[i], rate = 0 })
		end
	end
	for i = 2, #profile do
		assert(profile[i].s >= profile[i - 1].s, "vertical curves overlap in map " .. tostring(data.id))
	end
	assert(profile[#profile].s <= self.length, "the last vertical curve runs past the end of map " .. tostring(data.id))
	self.levelEnds = math.abs(grades[count] - grades[1]) < 1e-9
	if not self.levelEnds then
		warn("[RoadGeometry] Map " .. tostring(data.id) .. " isn't level where the loop closes")
	end
	self.profile = profile
	local profileBuckets = table.create(bucketCount, 1)
	index = 1
	for b = 1, bucketCount do
		local at = (b - 1) * BUCKET
		while index < #profile and profile[index + 1].s <= at do
			index += 1
		end
		profileBuckets[b] = index
	end
	self.profileBuckets = profileBuckets

	local sections = table.clone(data.sections or {})
	table.sort(sections, function(a, b)
		return a.from < b.from
	end)
	self.sections = sections

	-- grid of the pieces near each CELL x CELL square, for project()
	local grid = {}
	local reach = math.max(self.leftEdge, self.rightEdge) + REACH
	for i, piece in pieces do
		local steps = math.max(1, math.ceil(piece.length / 32))
		for j = 0, steps - 1 do
			local ax, az = pointOnPiece(piece, piece.length * j / steps)
			local bx, bz = pointOnPiece(piece, piece.length * (j + 1) / steps)
			for cx = math.floor((math.min(ax, bx) - reach) / CELL), math.floor((math.max(ax, bx) + reach) / CELL) do
				for cz = math.floor((math.min(az, bz) - reach) / CELL), math.floor((math.max(az, bz) + reach) / CELL) do
					local key = cellKey(cx, cz)
					local cell = grid[key]
					if cell == nil then
						cell = {}
						grid[key] = cell
					end
					if #cell == 0 or cell[#cell] ~= i then
						table.insert(cell, i)
					end
				end
			end
		end
	end
	self.grid = grid
	local all = table.create(#pieces, 0)
	for i = 1, #pieces do
		all[i] = i
	end
	self.all = all
	return self
end

-- Index of the piece containing distance s (0 <= s < length).
function RoadGeometry:pieceIndex(s: number): number
	local pieces = self.pieces
	local i = self.buckets[math.floor(s / BUCKET) + 1]
	while i < #pieces and pieces[i + 1].s <= s do
		i += 1
	end
	return i
end

-- Centre line in plan view at distance s: x, z (m), heading (radians, 0 = +X) and curvature
-- (1/m, positive turning right).
function RoadGeometry:planAt(s: number): (number, number, number, number)
	s %= self.length
	local piece = self.pieces[self:pieceIndex(s)]
	local x, z, heading = pointOnPiece(piece, s - piece.s)
	return x, z, heading, piece.k
end

-- Height of the road surface (m) and its grade (rise per metre) at distance s.
function RoadGeometry:heightAt(s: number): (number, number)
	s %= self.length
	local profile = self.profile
	local i = self.profileBuckets[math.floor(s / BUCKET) + 1]
	while i < #profile and profile[i + 1].s <= s do
		i += 1
	end
	local p = profile[i]
	local t = s - p.s
	return self.base + p.y + (p.grade + p.rate * t / 2) * t, p.grade + p.rate * t
end

function RoadGeometry:curvatureAt(s: number): number
	local _, _, _, k = self:planAt(s)
	return k
end

-- The section of a kind (or of any kind) that contains distance s, or nil.
function RoadGeometry:sectionAt(s: number, kind: string?)
	s %= self.length
	for _, section in self.sections do
		if (kind == nil or section.kind == kind) and s >= section.from and s < section.to then
			return section
		end
	end
	return nil
end

--[[
	Position (m) at distance s, sideways offset and height above the road surface, and the unit
	direction of travel there, which climbs with the grade. With no roll, a CFrame looking along
	that direction has the road's sideways direction as its RightVector.
]]
function RoadGeometry:frame(s: number, offset: number, height: number): (Vector3, Vector3)
	local x, z, heading = self:planAt(s)
	local y, grade = self:heightAt(s)
	local c, n = math.cos(heading), math.sin(heading)
	local scale = 1 / math.sqrt(1 + grade * grade)
	return Vector3.new(x - n * offset, y + height, z + c * offset), Vector3.new(c * scale, grade * scale, n * scale)
end

-- Centre of the road surface at distance s, and the direction of travel.
function RoadGeometry:centerline(s: number): (Vector3, Vector3)
	return self:frame(s, 0, 0)
end

-- Unit vector to the driver's right (level) at distance s.
function RoadGeometry:rightAt(s: number): Vector3
	local _, _, heading = self:planAt(s)
	return Vector3.new(-math.sin(heading), 0, math.cos(heading))
end

-- Lane position (1 = centre of the fast lane) from a sideways offset, and back.
function RoadGeometry:laneFromOffset(offset: number): number
	return offset / self.laneWidth + (self.lanes + 1) / 2
end

function RoadGeometry:offsetFromLane(lanePos: number): number
	return (lanePos - (self.lanes + 1) / 2) * self.laneWidth
end

-- Position and direction at distance s and lane position lanePos, at height above the road.
function RoadGeometry:pointAt(s: number, lanePos: number, height: number): (Vector3, Vector3)
	return self:frame(s, self:offsetFromLane(lanePos), height)
end

--[[
	The reverse of frame: road coordinates (s, offset, height above the road) of a world position
	(m). Where the road passes over itself, the level nearest the position wins. Exact on and near
	the road; for positions more than about 40 m off it, it searches every piece.
	planOnly ignores height (for placing scenery).
]]
function RoadGeometry:project(position: Vector3, planOnly: boolean?): (number, number, number)
	local x, y, z = position.X, position.Y, position.Z
	local candidates = self.grid[cellKey(math.floor(x / CELL), math.floor(z / CELL))] or self.all
	local bestScore, bestS, bestOffset, bestHeight = math.huge, 0, 0, 0
	for _, i in candidates do
		local piece = self.pieces[i]
		local t, offset = projectOnPiece(piece, x, z)
		local along = if t < 0 then -t elseif t > piece.length then t - piece.length else 0
		t = math.clamp(t, 0, piece.length)
		local s = piece.s + t
		local edge = if offset < 0 then self.leftEdge else self.rightEdge
		local outside = math.max(0, math.abs(offset) - edge)
		local score = outside * outside + along * along
		local height = 0
		if not planOnly then
			local surface = self:heightAt(s)
			height = y - surface
			local off = math.max(0, math.abs(height - 1) - NEAR)
			score += off * off
		end
		if score < bestScore then
			bestScore, bestS, bestOffset, bestHeight = score, s, offset, height
		end
	end
	return bestS % self.length, bestOffset, bestHeight
end

--[[
	Plan distance (m) from a position to the road's paved surface (0 on it), for placing scenery.
	Only road within about 40 m counts: farther returns math.huge. Road within skipRange metres of
	distance skipS is ignored, to ask about other parts of the loop than the one a point is beside.
]]
function RoadGeometry:distanceToRoad(position: Vector3, skipS: number?, skipRange: number?): number
	local x, z = position.X, position.Z
	local candidates = self.grid[cellKey(math.floor(x / CELL), math.floor(z / CELL))]
	if candidates == nil then
		return math.huge
	end
	local best = math.huge
	for _, i in candidates do
		local piece = self.pieces[i]
		local t, offset = projectOnPiece(piece, x, z)
		local along = if t < 0 then -t elseif t > piece.length then t - piece.length else 0
		local s = piece.s + math.clamp(t, 0, piece.length)
		if skipS == nil or math.abs(self:delta(skipS, s)) > (skipRange or 0) then
			local edge = if offset < 0 then self.leftEdge else self.rightEdge
			local outside = math.max(0, math.abs(offset) - edge)
			best = math.min(best, math.sqrt(outside * outside + along * along))
		end
	end
	return best
end

-- Signed shortest distance along the loop from sFrom to sTo.
function RoadGeometry:delta(sFrom: number, sTo: number): number
	return (sTo - sFrom + self.length / 2) % self.length - self.length / 2
end

--[[
	Highest speed (m/s) for each step-metre stretch of road, starting at s = 0: what keeps the
	innermost lane's sideways acceleration within lateral (m/s^2), lowered ahead of each curve so
	that slowing at decel (m/s^2) reaches the curve's speed in time. Never above top.
]]
function RoadGeometry:speedLimits(lateral: number, decel: number, step: number, top: number): { number }
	local n = math.ceil(self.length / step)
	local inner = self.halfWidth - self.laneWidth / 2 -- the innermost lane centre, from the centre line
	local limits = table.create(n, top)
	for _, piece in self.pieces do
		local k = math.abs(piece.k)
		if k > 0 then
			local kLane = k / (1 - k * inner)
			local v = math.min(top, math.sqrt(lateral / kLane))
			local first = math.floor(piece.s / step) + 1
			local last = math.min(n, math.floor((piece.s + piece.length) / step) + 1)
			for i = first, last do
				limits[i] = math.min(limits[i], v)
			end
		end
	end
	for _ = 1, 2 do -- twice round, so braking zones carry across the start line
		for i = n, 1, -1 do
			local following = limits[i % n + 1]
			limits[i] = math.min(limits[i], math.sqrt(following * following + 2 * decel * step))
		end
	end
	return limits
end

return RoadGeometry
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000E">
<Properties>
<string name="Name">TrafficSimulation</string>
<ProtectedString name="Source"><![CDATA[--[[
	TrafficSimulation: traffic on a multi-lane road, in road coordinates. Pure maths with no Roblox
	objects; tools/traffic_model.py is a line-for-line Python copy with tests (no collisions in light
	and heavy traffic, realistic flow, keeping right, safe lane changes around fast, slow and stopped
	players). Keep the two in step.

	Positions: s is the distance along the road (m); lanes are numbered from the left, 1 = fast lane;
	lanePos is the lateral position in lanes (2.5 = halfway between lanes 2 and 3).
	Car following: IDM. Lane changes: MOBIL with a keep-right bias and a safety limit on how hard the
	new follower would have to brake. Curves: with speed limits set (setSpeedLimits, made from the
	road's curvature by RoadGeometry:speedLimits), each driver slows ahead of a curve to keep their
	sideways acceleration comfortable. Players' cars are "obstacles": the simulation doesn't move them,
	but traffic follows them, yields to them and won't pull out in front of them unsafely.
]]

local DriverProfiles = require(script.Parent.DriverProfiles)
local IDM = require(script.Parent.IDM)

local PROFILES = DriverProfiles.profiles
local LANE_CHANGE_TIME = DriverProfiles.LANE_CHANGE_TIME
local MIN_TIME_IN_LANE = DriverProfiles.MIN_TIME_IN_LANE
local DECISION = DriverProfiles.DECISION_INTERVAL
local CURVE_LOOKAHEAD = DriverProfiles.CURVE_LOOKAHEAD
local CURVE_RESPONSE = DriverProfiles.CURVE_RESPONSE

local TrafficSimulation = {}
TrafficSimulation.__index = TrafficSimulation

local function vehicleLength(x): number
	return if x.profile then x.profile.length else (x.length or 4.7)
end

local function params(x)
	return x.profile or DriverProfiles.PLAYER
end

local function desiredSpeed(x): number
	return x.v0 or math.max(x.v, 1)
end

-- index of the first key greater than s (1-based; #keys + 1 if none)
local function upperBound(keys: { number }, s: number): number
	local lo, hi = 1, #keys + 1
	while lo < hi do
		local mid = (lo + hi) // 2
		if keys[mid] <= s then
			lo = mid + 1
		else
			hi = mid
		end
	end
	return lo
end

--[[
	length: road length (m). lanes: lane count. loop: true if the road joins itself (a ring).
	seed: random seed (optional).
]]
function TrafficSimulation.new(length: number, lanes: number, loop: boolean, seed: number?)
	local self = setmetatable({}, TrafficSimulation)
	self.length = length
	self.lanes = lanes
	self.loop = loop
	self.vehicles = {}
	self.obstacles = {} -- players: { s, lane (lanePos), v, length }
	self.random = Random.new(seed or 1)
	self.time = 0
	self.nextId = 1
	self.laneChanges = 0
	self.order = {}
	self.keys = {}
	self.limits = nil -- profile name -> speed limit (m/s) for each limitStep metres of road
	self.limitStep = DriverProfiles.LIMIT_STEP
	return self
end

-- limits: profile name -> { speed limit (m/s) for each step metres of road, from s = 0 }
function TrafficSimulation:setSpeedLimits(limits, step: number)
	self.limits = limits
	self.limitStep = step
end

-- The speed limit for a profile at distance s, or nil without limits.
function TrafficSimulation:limitAt(s: number, profileName: string): number?
	local limit = self.limits and self.limits[profileName]
	if limit == nil then
		return nil
	end
	if self.loop then
		s %= self.length
	end
	return limit[math.clamp(math.floor(s / self.limitStep) + 1, 1, #limit)]
end

-- The leftmost lane a profile may use (trucks keep to the lanes on the right).
function TrafficSimulation:laneMin(p): number
	return if p.rightLanes then math.max(1, self.lanes - p.rightLanes + 1) else 1
end

function TrafficSimulation:pickProfile(): string
	local r, total = self.random:NextNumber(), 0
	for _, name in DriverProfiles.order do
		total += PROFILES[name].share
		if r <= total then
			return name
		end
	end
	return "normal"
end

function TrafficSimulation:add(s: number, lane: number, profileName: string, v: number?)
	local p = PROFILES[profileName]
	local v0 = self.random:NextNumber(p.speed[1], p.speed[2]) / 3.6
	if v == nil then
		v = math.min(v0 * 0.85, self:limitAt(s, profileName) or math.huge)
	end
	local vehicle = {
		id = self.nextId,
		s = s % self.length,
		v = v,
		a = 0,
		lane = lane,
		lanePos = lane,
		fromLane = lane,
		change = 0,
		profile = p,
		profileName = profileName,
		v0 = v0,
		decision = self.random:NextNumber(DECISION[1], DECISION[2]),
		sinceChange = MIN_TIME_IN_LANE,
	}
	self.nextId += 1
	table.insert(self.vehicles, vehicle)
	return vehicle
end

-- Fill the road with perKmPerLane cars per kilometre in every lane.
function TrafficSimulation:populate(perKmPerLane: number)
	for lane = 1, self.lanes do
		local count = math.floor(perKmPerLane * self.length / 1000)
		local spacing = self.length / math.max(count, 1)
		for k = 0, count - 1 do
			local name = self:pickProfile()
			if self:laneMin(PROFILES[name]) > lane then
				name = "normal"
			end
			self:add(k * spacing + self.random:NextNumber(0, spacing * 0.4), lane, name)
		end
	end
end

function TrafficSimulation:ahead(sFrom: number, sTo: number): number
	local d = sTo - sFrom
	if self.loop then
		d %= self.length
	end
	return d
end

-- Per lane, everything occupying it (cars and players), sorted by position.
function TrafficSimulation:buildOrder()
	local order = {}
	for lane = 1, self.lanes do
		order[lane] = {}
	end
	for _, v in self.vehicles do
		table.insert(order[v.lane], v)
		if v.change > 0 and v.fromLane ~= v.lane then
			table.insert(order[v.fromLane], v) -- a car changing lanes blocks both
		end
	end
	for _, ob in self.obstacles do
		local base = math.floor(ob.lane + 0.5)
		local frac = ob.lane - base
		local extra = if frac > 0.2 then base + 1 elseif frac < -0.2 then base - 1 else nil
		for _, lane in { base, extra } do
			if lane and lane >= 1 and lane <= self.lanes then
				table.insert(order[lane], ob)
			end
		end
	end
	local keys = {}
	for lane = 1, self.lanes do
		table.sort(order[lane], function(a, b)
			return a.s < b.s
		end)
		local k = {}
		for i, x in order[lane] do
			k[i] = x.s
		end
		keys[lane] = k
	end
	self.order = order
	self.keys = keys
end

-- Leader, gap to it, follower, gap to it, in a lane, ignoring x itself. Gaps are bumper to bumper.
function TrafficSimulation:neighbours(x, lane: number)
	local items = self.order[lane]
	if not items or #items == 0 then
		return nil, nil, nil, nil
	end
	local n = #items
	local k = upperBound(self.keys[lane], x.s) -- first item ahead of x
	local lead = nil
	for j = 0, n - 1 do
		local idx = k + j
		if idx > n then
			if not self.loop then
				break
			end
			idx = (idx - 1) % n + 1
		end
		if items[idx] ~= x then
			lead = items[idx]
			break
		end
	end
	local follow = nil
	for j = 1, n do
		local idx = k - j
		if idx < 1 then
			if not self.loop then
				break
			end
			idx = (idx - 1) % n + 1
		end
		if items[idx] ~= x and items[idx] ~= lead then
			follow = items[idx]
			break
		end
	end
	local leadGap = if lead then self:ahead(x.s, lead.s) - (vehicleLength(x) + vehicleLength(lead)) / 2 else nil
	local followGap = if follow then self:ahead(follow.s, x.s) - (vehicleLength(x) + vehicleLength(follow)) / 2 else nil
	return lead, leadGap, follow, followGap
end

function TrafficSimulation:accel(x, leader, gap: number?): number
	local v = x.v
	return IDM.acceleration(params(x), v, desiredSpeed(x), gap, if leader then v - leader.v else 0)
end

-- MOBIL: should car v move to lane target?
function TrafficSimulation:wantsChange(v, target: number): boolean
	local p = v.profile
	if target < self:laneMin(p) or target > self.lanes then
		return false
	end
	local leadOld, gapOld, followOld, gapFollowOld = self:neighbours(v, v.lane)
	local leadNew, gapNew, followNew, gapFollowNew = self:neighbours(v, target)
	if gapNew ~= nil and gapNew < p.minGap then
		return false
	end
	if gapFollowNew ~= nil and gapFollowNew < params(followNew).minGap then
		return false
	end
	local aC = self:accel(v, leadOld, gapOld)
	local aCNew = self:accel(v, leadNew, gapNew)
	local aN, aNNew = 0, 0
	if followNew then
		local gapN = if gapNew ~= nil then gapFollowNew + gapNew + vehicleLength(v) else nil
		aN = self:accel(followNew, leadNew, gapN)
		aNNew = self:accel(followNew, v, gapFollowNew)
		if aNNew < -DriverProfiles.SAFE_DECEL then
			return false
		end
	end
	local aO, aONew = 0, 0
	if followOld and followOld.profile then
		local gapO = if gapOld ~= nil then gapFollowOld + gapOld + vehicleLength(v) else nil
		aO = self:accel(followOld, v, gapFollowOld)
		aONew = self:accel(followOld, leadOld, gapO)
	end
	local incentive = aCNew - aC + p.politeness * ((aNNew - aN) + (aONew - aO))
	local bias = if target > v.lane then DriverProfiles.KEEP_RIGHT_BIAS else -DriverProfiles.KEEP_RIGHT_BIAS
	return incentive + bias > p.threshold
end

function TrafficSimulation:step(dt: number)
	self:buildOrder()
	for _, v in self.vehicles do
		local lead, gap = self:neighbours(v, v.lane)
		local a = self:accel(v, lead, gap)
		if v.change > 0 and v.fromLane ~= v.lane then
			local lead2, gap2 = self:neighbours(v, v.fromLane)
			a = math.min(a, self:accel(v, lead2, gap2))
		end
		local limit = self:limitAt(v.s + v.v * CURVE_LOOKAHEAD, v.profileName)
		if limit then
			-- slow for the curve ahead
			a = math.min(a, math.max((limit - v.v) / CURVE_RESPONSE, -DriverProfiles.MAX_DECEL))
		end
		v.a = a
		v.decision -= dt
		v.sinceChange += dt
		if v.decision <= 0 and v.change <= 0 and v.sinceChange >= MIN_TIME_IN_LANE then
			v.decision = self.random:NextNumber(DECISION[1], DECISION[2])
			for _, target in { v.lane - 1, v.lane + 1 } do
				if self:wantsChange(v, target) then
					v.fromLane, v.lane = v.lane, target
					v.change, v.sinceChange = LANE_CHANGE_TIME, 0
					self.laneChanges += 1
					-- occupy the new lane at once, so nobody else picks the same gap this step
					local k = upperBound(self.keys[target], v.s)
					table.insert(self.keys[target], k, v.s)
					table.insert(self.order[target], k, v)
					break
				end
			end
		end
	end
	for _, v in self.vehicles do
		local speed = math.max(0, v.v + v.a * dt)
		local s = v.s + (v.v + speed) / 2 * dt
		v.s = if self.loop then s % self.length else s
		v.v = speed
		if v.change > 0 then
			v.change = math.max(0, v.change - dt)
			local t = 1 - v.change / LANE_CHANGE_TIME
			local smooth = t * t * (3 - 2 * t)
			v.lanePos = v.fromLane + (v.lane - v.fromLane) * smooth
			if v.change == 0 then
				v.fromLane = v.lane
			end
		else
			v.lanePos = v.lane
		end
	end
	self.time += dt
end

return TrafficSimulation
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX0000000F">
<Properties>
<string name="Name">VehicleSystem</string>
</Properties>
<Item class="Folder" referent="RBX00000010">
<Properties>
<string name="Name">Aerodynamics</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000011">
<Properties>
<string name="Name">Aero</string>
<ProtectedString name="Source"><![CDATA[--[[
	Aero
	Drag and downforce, both rising with the square of speed: F = 0.5 * rho * area * v^2.
	Downforce is split between the front and rear axles so aero parts change balance too.
]]

local Units = require(script.Parent.Parent.Units)

local Aero = {}

-- speed in m/s. Returns drag, front downforce and rear downforce in newtons.
function Aero.forces(spec, speed: number): (number, number, number)
	local q = 0.5 * Units.AIR_DENSITY * speed * speed
	return q * spec.dragArea, q * spec.downforceAreaFront, q * spec.downforceAreaRear
end

return Aero
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX00000012">
<Properties>
<string name="Name">CorePhysics</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000013">
<Properties>
<string name="Name">Brakes</string>
<ProtectedString name="Source"><![CDATA[--[[
	Brakes
	Brake torque per wheel from the pedal, with per-axle maximums (which set the front/rear bias),
	an ABS that releases pressure as a wheel starts to lock, and a rear handbrake.
]]

local Brakes = {}

--[[
	Returns brake torque magnitude (Nm) for one wheel.
	  isFront    front axle wheel
	  pedal      brake pedal 0 to 1
	  handbrake  0 to 1 (rear wheels only)
	  slipRatio  current slip ratio (negative when the wheel turns slower than the road)
	  absOn      whether ABS is active
]]
function Brakes.torque(spec, isFront: boolean, pedal: number, handbrake: number, slipRatio: number, absOn: boolean): number
	local torque = (if isFront then spec.maxTorqueFront else spec.maxTorqueRear) * pedal
	local handbrakeTorque = if isFront then 0 else spec.handbrakeTorque * handbrake

	if absOn and pedal > 0 and handbrakeTorque == 0 then
		local target = spec.abs.targetSlip
		if slipRatio < -target then
			local excess = (-slipRatio - target) / target
			torque *= math.clamp(1 - excess, 0.15, 1)
		end
	end
	return math.max(torque, handbrakeTorque)
end

return Brakes
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000014">
<Properties>
<string name="Name">Steering</string>
<ProtectedString name="Source"><![CDATA[--[[
	Steering
	Turns steering input into left and right road-wheel angles.
	  - The maximum angle shrinks with speed so keyboard players stay in control at 300 km/h.
	  - The wheels turn at a limited rate.
	  - Ackermann geometry turns the inside wheel more than the outside one.
	Positive angles steer to the right.
]]

local Steering = {}

function Steering.new(spec)
	return { spec = spec, angle = 0 } -- angle: average road-wheel angle, radians
end

function Steering.maxAngle(spec, speedKmh: number): number
	local t = math.clamp(speedKmh / spec.highSpeedKmh, 0, 1) ^ 0.7
	return math.rad(spec.maxAngleLowSpeed + (spec.maxAngleHighSpeed - spec.maxAngleLowSpeed) * t)
end

--[[
	input: -1 (full left) to 1 (full right). Returns left and right wheel angles (radians).
]]
function Steering.update(st, input: number, speedKmh: number, dt: number, wheelbase: number, track: number): (number, number)
	local spec = st.spec
	local target = input * Steering.maxAngle(spec, speedKmh)
	local maxStep = math.rad(spec.rate) * dt
	st.angle += math.clamp(target - st.angle, -maxStep, maxStep)

	local a = st.angle
	local magnitude = math.abs(a)
	if magnitude < 1e-4 then
		return a, a
	end
	local radius = wheelbase / math.tan(magnitude)
	local inner = math.atan(wheelbase / math.max(radius - track / 2, 0.1))
	local outer = math.atan(wheelbase / (radius + track / 2))
	local k = spec.ackermann
	local innerAngle = magnitude + (inner - magnitude) * k
	local outerAngle = magnitude + (outer - magnitude) * k
	if a > 0 then
		return outerAngle, innerAngle -- turning right: the right wheel is on the inside
	end
	return -innerAngle, -outerAngle
end

return Steering
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000015">
<Properties>
<string name="Name">VehicleSimulation</string>
<ProtectedString name="Source"><![CDATA[--[[
	VehicleSimulation
	The shared car simulation, driven entirely by a vehicle configuration. It works in SI units and
	never touches Roblox instances, so the same code runs every car.

	Each frame the client's VehicleController:
	  1. calls updateSteering() to get the front wheel angles,
	  2. raycasts each suspension and measures contact patch velocities in each wheel's frame,
	  3. calls step() with those contacts and the driver's inputs,
	  4. applies the returned wheel and aero forces to the car.

	Inside step(), wheel spin, clutch and engine are integrated in SUBSTEPS smaller steps with the
	car's velocity held constant, and tyre forces are averaged over them. This keeps the stiff parts
	(tyres, clutch, torque converter, differentials) stable while Roblox integrates the car body once
	per frame.

	The configuration chooses the gearbox (dual-clutch or torque-converter automatic), the drive
	layout (front, rear, or all-wheel drive with a fixed split or an on-demand centre coupling) and
	the engine's forced induction. docs/VEHICLE_CONFIG.md describes every setting. An automatic
	starts in park (neutral with the brakes holding the car) and pulls into drive when the driver
	first presses a pedal.
]]

local Units = require(script.Parent.Parent.Units)
local Engine = require(script.Parent.Parent.EngineSimulation.Engine)
local Transmission = require(script.Parent.Parent.TransmissionSimulation.Transmission)
local Differential = require(script.Parent.Parent.DifferentialSystem.Differential)
local Suspension = require(script.Parent.Parent.SuspensionSystem.Suspension)
local Tire = require(script.Parent.Parent.TireSimulation.Tire)
local Aero = require(script.Parent.Parent.Aerodynamics.Aero)
local Brakes = require(script.Parent.Brakes)
local Steering = require(script.Parent.Steering)

local VehicleSimulation = {}
VehicleSimulation.__index = VehicleSimulation

local SUBSTEPS = 8
local MAX_DAMPER_SPEED = 5 -- m/s; caps damper spikes from kerbs and landings
local MAX_BUMP_STOP_COMPRESSION = 0.08 -- m past the bump stop that still counts
local TC_REFERENCE_SPEED = 6 -- m/s; traction control allows more wheel slip below this speed
local WHEEL_IDS = { "FL", "FR", "RL", "RR" }
VehicleSimulation.WHEEL_IDS = WHEEL_IDS

local function sign(x: number): number
	if x > 0 then
		return 1
	elseif x < 0 then
		return -1
	end
	return 0
end

function VehicleSimulation.new(config)
	local self = setmetatable({}, VehicleSimulation)
	self.config = config

	local mass = config.mass
	local dims = config.dimensions
	self.massKg = mass.kerbKg + mass.driverKg
	local g = Units.GRAVITY
	local frontCornerLoad = self.massKg * g * mass.frontShare / 2
	local rearCornerLoad = self.massKg * g * (1 - mass.frontShare) / 2
	-- the centre of mass sits nearer the axle that carries more weight
	self.frontAxleZ = -dims.wheelbase * (1 - mass.frontShare)
	self.rearAxleZ = dims.wheelbase * mass.frontShare

	self.wheels = {}
	for _, id in WHEEL_IDS do
		local front = string.sub(id, 1, 1) == "F"
		local left = string.sub(id, 2, 2) == "L"
		local axle = if front then config.suspension.front else config.suspension.rear
		local tire = Tire.new(if front then config.tires.front else config.tires.rear, config.tires.compounds)
		local track = if front then dims.trackFront else dims.trackRear
		local cornerLoad = if front then frontCornerLoad else rearCornerLoad
		local suspension = Suspension.new(axle, cornerLoad)
		local wheelCentreY = tire.radius - mass.comHeight -- at the default ride height
		self.wheels[id] = {
			id = id,
			front = front,
			left = left,
			tire = tire,
			suspension = suspension,
			staticLoad = cornerLoad,
			-- suspension mount in metres, relative to the centre of mass
			mount = Vector3.new(
				(if left then -1 else 1) * track / 2,
				wheelCentreY + axle.staticLength,
				if front then self.frontAxleZ else self.rearAxleZ
			),
			staticLength = axle.staticLength,
			rayLength = suspension.maxLength + tire.radius,
			driven = false,
			share = 0,
			omega = 0,
			spin = 0,
			steer = 0,
			length = suspension.rideLength,
			lengthVelocity = 0,
			contact = false,
			load = 0,
			grip = 1,
			vLong = 0,
			vLat = 0,
			fx = 0,
			fy = 0,
			slipRatio = 0,
			slipAngle = 0,
			driveTorque = 0,
			brakeTorque = 0,
		}
	end

	self.engine = Engine.new(config.engine)
	self.transmission = Transmission.new(config.transmission)
	local tr = self.transmission
	if tr.automatic then
		-- the converter's capacity follows from its stall speed (see Transmission.converter)
		local stallRpm = config.transmission.converter.stallRpm
		tr.converterK = Engine.fullLoadTorque(config.engine, stallRpm) / Units.rpmToRadPerSec(stallRpm) ^ 2
		tr.gear = 0
		tr.fromGear = 0
	end
	self.parked = tr.automatic
	self.steering = Steering.new(config.steering)
	self.absEnabled = config.brakes.abs.enabled
	local tractionControl = config.drivetrain.tractionControl
	self.tcEnabled = tractionControl ~= nil and tractionControl.enabled
	self.tcCut = 0 -- share of engine torque traction control is removing, 0 to 1
	self.reverseTimer = 0
	self.lastForwardSpeed = 0
	self.axles = self:_buildAxles()
	self.telemetry = {}
	return self
end

-- Driven axles, front first. With an on-demand centre coupling both axles are driven and their
-- shares are the base split, which also weights the gearbox speed in _inputOmega.
function VehicleSimulation:_buildAxles()
	local drivetrain = self.config.drivetrain
	local coupling = if drivetrain.layout == "AWD" then drivetrain.centreCoupling else nil
	local frontShare
	if drivetrain.layout == "FWD" then
		frontShare = 1
	elseif drivetrain.layout == "RWD" then
		frontShare = 0
	elseif coupling then
		frontShare = math.clamp(coupling.baseFrontShare, 0, 1)
	else
		frontShare = math.clamp(drivetrain.frontTorqueShare, 0, 1)
	end
	self.coupling = coupling
	self.frontShare = frontShare
	local axles = {}
	if frontShare > 0 or coupling then
		table.insert(axles, { left = self.wheels.FL, right = self.wheels.FR, share = frontShare, diff = drivetrain.frontDifferential, torque = 0 })
	end
	if frontShare < 1 or coupling then
		table.insert(axles, { left = self.wheels.RL, right = self.wheels.RR, share = 1 - frontShare, diff = drivetrain.rearDifferential, torque = 0 })
	end
	for _, axle in axles do
		for _, w in { axle.left, axle.right } do
			w.driven = true
			w.share = axle.share
		end
	end
	return axles
end

-- Gearbox input speed implied by the driven wheels (rad/s).
function VehicleSimulation:_inputOmega(ratio: number): number
	if ratio == 0 then
		return 0
	end
	local sum, weight = 0, 0
	for _, axle in self.axles do
		sum += (axle.left.omega + axle.right.omega) / 2 * axle.share
		weight += axle.share
	end
	return ratio * sum / math.max(weight, 1e-6)
end

-- In automatic mode, holding the brake at a standstill selects reverse, and holding the
-- accelerator in reverse selects first again.
function VehicleSimulation:_autoReverse(dt: number, input, forwardSpeed: number)
	local tr = self.transmission
	if not tr.auto then
		self.reverseTimer = 0
		return
	end
	local stopped = math.abs(forwardSpeed) < 0.6
	local wantsReverse = tr.gear >= 1 and stopped and input.brake > 0.5 and input.throttle < 0.1
	local wantsForward = tr.gear <= 0 and stopped and input.throttle > 0.5 and input.brake < 0.1
	if wantsReverse or wantsForward then
		self.reverseTimer += dt
		if self.reverseTimer > 0.35 then
			Transmission.shift(tr, if wantsReverse then -1 else 1)
			self.reverseTimer = 0
		end
	else
		self.reverseTimer = 0
	end
end

-- Step 1 of a frame: front wheel angles (radians, positive = right). Returns left, right.
function VehicleSimulation:updateSteering(dt: number, steerInput: number, forwardSpeed: number): (number, number)
	local dims = self.config.dimensions
	local left, right = Steering.update(self.steering, steerInput, math.abs(forwardSpeed) * 3.6, dt, dims.wheelbase, dims.trackFront)
	self.wheels.FL.steer = left
	self.wheels.FR.steer = right
	return left, right
end

--[[
	Step 3 of a frame.
	  input     { throttle, brake, steer, handbrake } (0 to 1; steer -1 to 1)
	  contacts  [wheelId] = { hit, distance (m, mount to road), vLong, vLat (m/s), grip }
	  forwardSpeed  car speed along its heading (m/s)
	  speed         total car speed (m/s)
	Afterwards each wheel's load, fx and fy (N) are the forces to apply, and the return value
	holds the aero forces: { drag, downFront, downRear } in newtons.
]]
function VehicleSimulation:step(dt: number, input, contacts, forwardSpeed: number, speed: number)
	local cfg = self.config
	local tr = self.transmission
	local engine = self.engine
	local automatic = tr.automatic
	local g = Units.GRAVITY
	self.lastForwardSpeed = forwardSpeed

	-- an automatic leaves park for drive when the driver first presses a pedal
	if self.parked and (input.throttle > 0.05 or input.brake > 0.05) then
		self.parked = false
		Transmission.shift(tr, 1)
	end
	if not self.parked then
		self:_autoReverse(dt, input, forwardSpeed)
	end
	local pedal, brakePedal = input.throttle, input.brake
	if tr.gear == -1 then
		pedal, brakePedal = input.brake, input.throttle
	end
	local handbrake = input.handbrake
	-- in park the brakes hold the car, standing in for the parking pawl
	local holdBrake = if self.parked then 1 else brakePedal
	-- an electronic top-speed limiter closes the throttle over the last 3 km/h
	local enginePedal = pedal
	local speedLimit = cfg.engine.speedLimitKmh
	if speedLimit then
		enginePedal = math.min(pedal, math.clamp((speedLimit - math.abs(forwardSpeed) * 3.6) / 3, 0, 1))
	end

	-- suspension loads
	for _, id in WHEEL_IDS do
		local w = self.wheels[id]
		local c = contacts[id]
		local s = w.suspension
		local length = if c.hit then c.distance - w.tire.radius else math.huge
		if c.hit and length <= s.maxLength then
			local velocity = if w.contact then (length - w.length) / dt else 0
			velocity = math.clamp(velocity, -MAX_DAMPER_SPEED, MAX_DAMPER_SPEED)
			local forceLength = math.max(length, s.minLength - MAX_BUMP_STOP_COMPRESSION)
			w.length = length
			w.lengthVelocity = velocity
			w.load = math.min(Suspension.force(s, forceLength, velocity), w.staticLoad * 6)
			w.contact = w.load > 0
			w.grip = c.grip
			w.vLong = c.vLong
			w.vLat = c.vLat
		else
			w.contact = false
			w.load = 0
			w.length = s.maxLength
			w.lengthVelocity = 0
		end
	end
	for _, pair in { { "FL", "FR" }, { "RL", "RR" } } do
		local l, r = self.wheels[pair[1]], self.wheels[pair[2]]
		local addLeft, addRight = Suspension.antiRoll(l.suspension, l.length, r.length, l.contact, r.contact)
		l.load = math.max(l.load + addLeft, 0)
		r.load = math.max(r.load + addRight, 0)
	end

	-- automatic gear choice, from the speed the wheels imply at the gearbox input
	local inputRpmNow = Units.radPerSecToRpm(math.abs(self:_inputOmega(Transmission.ratio(tr))))
	Transmission.updateAuto(tr, dt, inputRpmNow, pedal)
	if automatic then
		Transmission.updateLockup(tr, dt, math.abs(forwardSpeed) * 3.6, Engine.rpm(engine), cfg.engine.idleRpm)
	end

	-- drivetrain and tyres, in sub-steps
	local h = dt / SUBSTEPS
	local engineInertia = cfg.engine.inertia
	local efficiency = cfg.transmission.efficiency
	local minOmega = Units.rpmToRadPerSec(cfg.engine.idleRpm * 0.55)
	local maxOmega = Units.rpmToRadPerSec(cfg.engine.limiterRpm + 400)
	local engineTorqueSum, clutchTorqueSum, engagementSum = 0, 0, 0
	local frontTorqueSum, driveTorqueSum = 0, 0
	local turbineOmega = 0
	for _, id in WHEEL_IDS do
		local w = self.wheels[id]
		w.fxSum = 0
		w.fySum = 0
	end

	for _ = 1, SUBSTEPS do
		local ratio = Transmission.ratio(tr)
		local inputOmega = self:_inputOmega(ratio)
		local engagement, capacity, engineTorque
		local shifting = false
		if automatic then
			-- The gearbox input (the converter's turbine) turns with the wheels, except in a shift,
			-- when the shift clutches slip and it moves from the old gear's speed to the new one's.
			if tr.shiftStart then
				tr.shiftStart = false
				tr.turbineOmega = self:_inputOmega(Transmission.gearRatio(tr, tr.fromGear))
			end
			shifting = tr.shifting
			turbineOmega = if shifting then tr.turbineOmega else inputOmega
			local direction = Transmission.shiftDirection(tr)
			engagement = tr.lockup
			capacity = engagement * tr.spec.lockup.maxTorque
			local shiftPedal = enginePedal
			if direction < 0 and engine.omega < inputOmega then
				shiftPedal = math.max(enginePedal, tr.spec.downshiftBlip or 0) -- blip to match revs
			end
			engineTorque = Engine.netTorque(engine, shiftPedal, h)
			if direction > 0 and engineTorque > 0 then
				engineTorque *= 1 - tr.spec.shiftTorqueReduction -- ignition cut back through the shift
			end
		else
			engagement = Transmission.engagement(tr, Engine.rpm(engine), Units.radPerSecToRpm(math.abs(inputOmega)), pedal, cfg.engine.idleRpm)
			capacity = engagement * cfg.transmission.clutchMaxTorque
			engineTorque = Engine.netTorque(engine, enginePedal, h)
		end

		-- Traction control, acting like a launch and traction system: it caps engine and clutch
		-- torque at what the driven tyres can put down (plus headroom), then trims further while
		-- the driven wheels still slip more than the target. Capping the clutch matters at a
		-- standing start, where the spinning engine would otherwise dump its energy into wheelspin.
		if self.tcEnabled and ratio ~= 0 then
			local tc = cfg.drivetrain.tractionControl
			local driveSlip, available = 0, 0
			for _, axle in self.axles do
				for _, w in { axle.left, axle.right } do
					if w.contact then
						-- measured against at least TC_REFERENCE_SPEED so a standing start isn't choked
						local slip = (w.omega * w.tire.radius - w.vLong) / math.max(math.abs(w.vLong), TC_REFERENCE_SPEED)
						driveSlip = math.max(driveSlip, slip * sign(ratio))
						available += Tire.peakForce(w.tire, w.load, w.grip) * w.tire.radius
					end
				end
			end
			local excess = driveSlip - tc.targetSlip
			if excess > 0 then
				self.tcCut = math.min(1, self.tcCut + h * tc.rate * excess / tc.targetSlip)
			else
				self.tcCut = math.max(0, self.tcCut - h * tc.recovery)
			end
			local limit = available / (math.abs(ratio) * efficiency) * tc.headroom * (1 - self.tcCut)
			if automatic then
				-- A slipping converter multiplies the engine's torque. Held on the brakes, this also works
				-- as launch control: the engine runs up against the converter only as far as the tyres
				-- could then take, so letting the brake off doesn't just spin the wheels.
				engineTorque = math.min(engineTorque, limit / Transmission.torqueRatio(tr, engine.omega, turbineOmega))
			else
				engineTorque = math.min(engineTorque, limit)
			end
			capacity = math.min(capacity, limit)
		else
			self.tcCut = 0
		end

		for _, id in WHEEL_IDS do
			local w = self.wheels[id]
			if w.contact then
				local fx, fy, slipRatio, slipAngle = Tire.forces(w.tire, w.load, w.vLong, w.vLat, w.omega * w.tire.radius, w.grip, h)
				w.fxStep, w.fyStep, w.slipRatio, w.slipAngle = fx, fy, slipRatio, slipAngle
			else
				w.fxStep, w.fyStep, w.slipRatio, w.slipAngle = 0, 0, 0, 0
				w.tire.slipAngle = 0
			end
			w.brakeTorque = Brakes.torque(cfg.brakes, w.front, holdBrake, handbrake, w.slipRatio, self.absEnabled)
		end

		local clutchTorque = 0 -- torque into the gearbox
		local engineLoad = 0 -- torque taken from the engine (a slipping converter multiplies it)
		local locked = false
		if ratio ~= 0 and (capacity > 0 or automatic) then
			-- the driven wheels as the gearbox input sees them: their inertia and the torque they resist with
			local inertiaInput = if automatic then 0 else 0.02 -- gearbox internals
			local loadTorque = 0
			if #self.axles == 1 then
				for _, axle in self.axles do
					for _, w in { axle.left, axle.right } do
						inertiaInput += w.tire.inertia / (ratio * ratio)
						local rolling = if w.contact then w.load * w.tire.compound.rollingResistance * w.tire.radius else 0
						local resist = w.fxStep * w.tire.radius + (w.brakeTorque + rolling) * sign(w.omega)
						loadTorque += resist / ratio
					end
				end
			else
				-- All-wheel drive splits the torque between the axles by their shares, so the input sees
				-- each axle's inertia and resistance weighted by its share, not as one rigid body. That
				-- keeps the implicit clutch and converter solves consistent with the wheels' own updates.
				local inverse, weighted = 0, 0
				for _, axle in self.axles do
					local axleInertia, axleResist = 0, 0
					for _, w in { axle.left, axle.right } do
						local rolling = if w.contact then w.load * w.tire.compound.rollingResistance * w.tire.radius else 0
						axleInertia += w.tire.inertia
						axleResist += w.fxStep * w.tire.radius + (w.brakeTorque + rolling) * sign(w.omega)
					end
					inverse += axle.share * axle.share / axleInertia
					weighted += axle.share * axleResist / axleInertia
				end
				inertiaInput += 1 / (ratio * ratio * inverse)
				loadTorque = weighted / (ratio * inverse)
			end
			if automatic and shifting then
				-- the turbine runs free of the wheels, held back (or pulled up) by the shift clutches,
				-- whose torque goes on to the wheels
				clutchTorque = Transmission.shiftClutchTorque(tr, turbineOmega, inputOmega, engineTorque, engineInertia)
				local delivered
				engineLoad, delivered = Transmission.automaticTorque(tr, engine.omega, turbineOmega, engineInertia,
					tr.turbineInertia, engineTorque, clutchTorque, capacity, h)
				tr.turbineOmega += h * (delivered - clutchTorque) / tr.turbineInertia
			elseif automatic then
				-- The converter sees the wheels through the gearbox's losses (their inertia and load
				-- grow by 1 / efficiency) plus its own turbine. The wheel update below carries the
				-- turbine's inertia too, so the implicit solve matches what the wheels then do.
				local lock
				engineLoad, clutchTorque, lock = Transmission.automaticTorque(tr, engine.omega, turbineOmega, engineInertia,
					tr.turbineInertia + inertiaInput / efficiency, engineTorque, loadTorque / efficiency, capacity, h)
				locked = capacity > 0 and math.abs(lock) < capacity * 0.999
			else
				clutchTorque = Transmission.clutchTorque(tr, engine.omega, inputOmega, engineInertia, inertiaInput, engineTorque, loadTorque, capacity, h)
				engineLoad = clutchTorque
				locked = math.abs(clutchTorque) < capacity * 0.999
			end
		end

		local outputRatio = ratio
		if shifting and tr.gear < tr.fromGear and clutchTorque > 0 then
			-- on a downshift under power the old gear's clutch still drives until the engine has risen
			outputRatio = Transmission.gearRatio(tr, tr.fromGear)
		end
		local wheelTorque = clutchTorque * outputRatio * efficiency
		if self.coupling then
			local front, rear = self.axles[1], self.axles[2]
			front.torque, rear.torque = Differential.centre(self.coupling, wheelTorque,
				(front.left.omega + front.right.omega) / 2, (rear.left.omega + rear.right.omega) / 2,
				front.left.tire.radius, rear.left.tire.radius, front.left.tire.inertia, rear.left.tire.inertia, h)
			frontTorqueSum += front.torque
			driveTorqueSum += wheelTorque
		else
			for _, axle in self.axles do
				axle.torque = wheelTorque * axle.share
			end
		end
		for _, axle in self.axles do
			local left, right = Differential.split(axle.diff, axle.torque, axle.left.omega, axle.right.omega, axle.left.tire.inertia, h)
			axle.left.driveTorque = left
			axle.right.driveTorque = right
		end

		engine.omega = math.clamp(engine.omega + h * (engineTorque - engineLoad) / engineInertia, minOmega, maxOmega)
		if shifting then
			Transmission.advanceShift(tr, h, inputOmega)
		end

		for _, id in WHEEL_IDS do
			local w = self.wheels[id]
			local r = w.tire.radius
			local inertia = w.tire.inertia
			if w.driven and automatic then
				-- the turbine, and the engine while the lock-up holds, turn with the wheels, except in
				-- a shift, when the shift clutches slip
				if not shifting then
					local geared = tr.turbineInertia + (if locked then engineInertia else 0)
					inertia += geared * efficiency * ratio * ratio * w.share / 2
				end
			elseif w.driven and locked then
				inertia += engineInertia * ratio * ratio * w.share / 2
			end
			local drive = if w.driven then w.driveTorque else 0
			local tireTorque = w.fxStep * r
			if w.contact then
				-- the tyre can't drive the wheel past the speed where its slip would be zero
				local limit = inertia * math.abs(w.omega - w.vLong / r) / h + math.abs(drive) + w.brakeTorque
				tireTorque = math.clamp(tireTorque, -limit, limit)
			end
			local rolling = if w.contact then w.load * w.tire.compound.rollingResistance * r else 0
			local newOmega = w.omega + h * (drive - tireTorque - rolling * sign(w.omega)) / inertia
			local brakeStep = h * w.brakeTorque / inertia
			if math.abs(newOmega) <= brakeStep then
				newOmega = 0 -- brakes hold the wheel but can't spin it backwards
			else
				newOmega -= sign(newOmega) * brakeStep
			end
			w.omega = newOmega
			w.fxSum += tireTorque / r
			w.fySum += w.fyStep
		end

		engineTorqueSum += engineTorque
		clutchTorqueSum += clutchTorque
		engagementSum += engagement
	end

	-- frame forces
	for _, id in WHEEL_IDS do
		local w = self.wheels[id]
		w.fx = w.fxSum / SUBSTEPS
		w.fy = w.fySum / SUBSTEPS
		if w.contact then
			-- lateral force can't do more than stop the sideways motion within one frame
			local maxLateral = (w.load / g) * math.abs(w.vLat) / dt
			w.fy = math.clamp(w.fy, -maxLateral, maxLateral)
		end
		w.spin = (w.spin + w.omega * dt) % (2 * math.pi)
	end

	-- parking hold: with the brakes on at a near standstill, static friction holds the car
	if speed < 0.4 and (holdBrake > 0.1 or handbrake > 0.1) then
		for _, id in WHEEL_IDS do
			local w = self.wheels[id]
			if w.contact then
				local mass = w.load / g
				local maxHold = Tire.peakForce(w.tire, w.load, w.grip)
				w.fx = math.clamp(-w.vLong * mass / dt, -maxHold, maxHold)
				w.fy = math.clamp(-w.vLat * mass / dt, -maxHold, maxHold)
			end
		end
	end

	local drag, downFront, downRear = Aero.forces(cfg.aero, speed)

	local t = self.telemetry
	t.rpm = Engine.rpm(engine)
	t.gear = if self.parked then "P" else Transmission.gearLabel(tr)
	t.gearNumber = tr.gear
	t.parked = self.parked
	t.auto = tr.auto
	t.shifting = Transmission.isShifting(tr)
	t.limiter = engine.limiterCut
	t.throttle = engine.throttle
	t.pedal = pedal
	t.brake = brakePedal
	t.handbrake = handbrake
	t.clutch = engagementSum / SUBSTEPS
	t.engineTorque = engineTorqueSum / SUBSTEPS
	t.clutchTorque = clutchTorqueSum / SUBSTEPS
	t.wheelTorque = t.clutchTorque * Transmission.ratio(tr) * efficiency
	t.speedKmh = speed * 3.6
	t.forwardKmh = forwardSpeed * 3.6
	t.steerDeg = math.deg(self.steering.angle)
	t.drag = drag
	t.downFront = downFront
	t.downRear = downRear
	t.abs = self.absEnabled
	t.tractionControl = self.tcEnabled
	t.tractionActive = self.tcCut > 0.02
	-- forced induction (the audio reads these): boost 0 to 1, gauge pressure in bar (negative under
	-- vacuum), and "Turbo", "Supercharger" or nil
	local fi = cfg.engine.forcedInduction
	t.boost = engine.boost
	t.boostBar = Engine.boostBar(engine)
	t.forcedInduction = if fi then fi.type else nil
	-- gearbox and drive
	t.transmissionType = cfg.transmission.type
	t.lockup = if automatic then tr.lockup else nil
	t.converterSlip = if automatic and Transmission.ratio(tr) ~= 0 then 1 - turbineOmega / engine.omega else nil
	if self.coupling then
		t.frontTorqueShare = if math.abs(driveTorqueSum) > 1 then frontTorqueSum / driveTorqueSum else self.frontShare
	else
		t.frontTorqueShare = self.frontShare
	end

	return { drag = drag, downFront = downFront, downRear = downRear }
end

-- Manual shifting. Selecting a paddle switches the gearbox to manual mode (and leaves park).
function VehicleSimulation:shiftUp()
	local tr = self.transmission
	tr.auto = false
	self.parked = false
	if tr.gear == -1 and math.abs(self.lastForwardSpeed) > 2 then
		return
	end
	Transmission.shift(tr, tr.gear + 1)
end

function VehicleSimulation:shiftDown()
	local tr = self.transmission
	tr.auto = false
	self.parked = false
	local target = tr.gear - 1
	if target == -1 and math.abs(self.lastForwardSpeed) > 2 then
		return -- no reverse while rolling
	end
	if target >= 1 then
		-- refuse a downshift that would over-rev the engine, like a real dual-clutch
		local spec = tr.spec
		local inputRpm = Units.radPerSecToRpm(math.abs(self:_inputOmega(Transmission.ratio(tr))))
		if inputRpm * spec.gearRatios[target] / spec.gearRatios[tr.gear] > self.config.engine.limiterRpm + 200 then
			return
		end
	end
	Transmission.shift(tr, target)
end

function VehicleSimulation:toggleAutomatic()
	local tr = self.transmission
	tr.auto = not tr.auto
	if tr.auto and tr.gear == 0 then
		Transmission.shift(tr, 1)
	end
end

function VehicleSimulation:toggleAbs()
	self.absEnabled = not self.absEnabled
end

function VehicleSimulation:toggleTractionControl()
	self.tcEnabled = not self.tcEnabled
end

return VehicleSimulation
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX00000016">
<Properties>
<string name="Name">DifferentialSystem</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000017">
<Properties>
<string name="Name">Differential</string>
<ProtectedString name="Source"><![CDATA[--[[
	Differential
	Splits an axle's drive torque between its left and right wheels.

	  Open         equal torque to both sides
	  LimitedSlip  clutch-type: moves torque from the faster wheel to the slower one, up to
	               preload + lock factor * input torque (separate lock factors on and off power)
	  Locked       a very stiff limited-slip

	The transfer is capped so it can never reverse the speed difference within one step,
	which keeps stiff settings stable.

	Differential.centre splits the drive between the axles of an on-demand all-wheel-drive car.
]]

local Differential = {}

--[[
	torqueIn: torque into the differential (Nm)
	omegaLeft, omegaRight: wheel speeds (rad/s)
	inertia: one wheel's inertia (kg*m^2); dt: time step (s)
	Returns torque to the left wheel and to the right wheel.
]]
function Differential.split(spec, torqueIn: number, omegaLeft: number, omegaRight: number, inertia: number, dt: number): (number, number)
	local kind = spec and spec.type or "Open"
	if kind == "Open" then
		return torqueIn / 2, torqueIn / 2
	end

	local stiffness, maxTransfer
	if kind == "Locked" then
		stiffness = 5000
		maxTransfer = math.huge
	else
		local lock = if torqueIn >= 0 then spec.powerLock else spec.coastLock
		stiffness = spec.stiffness
		maxTransfer = spec.preload + lock * math.abs(torqueIn)
	end

	local difference = omegaLeft - omegaRight
	local equalising = math.abs(difference) * inertia / dt -- transfer that would just equalise the speeds
	local transfer = math.clamp(stiffness * difference, -maxTransfer, maxTransfer)
	transfer = math.clamp(transfer, -equalising, equalising)
	return torqueIn / 2 - transfer / 2, torqueIn / 2 + transfer / 2
end

--[[
	Centre coupling for on-demand, rear-biased all-wheel drive (drivetrain.centreCoupling).
	baseFrontShare of the drive torque always goes to the front axle. Once the rear axle's tyres turn
	faster than the front's by more than slipThreshold of the road speed (the rear wheels spinning),
	a clutch sends more forward, stiffness Nm per m/s of the extra slip, up to maxFrontShare of the
	torque plus preload. If the front turns faster instead, it takes torque back, but never more than
	the base share plus preload, so the front is never driven backwards under power.
	Speeds are compared at the tyre surface (omega * radius), so different tyre sizes front and rear
	don't count as slip. The transfer is capped so it can't reverse the speed difference within one
	step, like Differential.split.
	  torqueIn  drive torque at the wheels, both axles together (Nm)
	  omegaFront, omegaRear  mean wheel speed of each axle (rad/s)
	  radiusFront, radiusRear  tyre radii (m); inertiaFront, inertiaRear  one wheel's inertia (kg*m^2)
	Returns the torque to the front axle and to the rear axle.
]]
function Differential.centre(spec, torqueIn: number, omegaFront: number, omegaRear: number, radiusFront: number, radiusRear: number, inertiaFront: number, inertiaRear: number, dt: number): (number, number)
	local base = spec.baseFrontShare
	local front = torqueIn * base
	local frontSpeed = omegaFront * radiusFront
	local difference = omegaRear * radiusRear - frontSpeed -- m/s, positive while the rear slips more
	local deadband = spec.slipThreshold * math.max(math.abs(frontSpeed), 3)
	local excess = math.max(math.abs(difference) - deadband, 0)
	if difference < 0 then
		excess = -excess
	end
	local preload = spec.preload or 0
	local maxForward = preload + (spec.maxFrontShare - base) * math.abs(torqueIn)
	local maxBack = preload + base * math.abs(torqueIn)
	-- transfer that would just bring the axles' speeds back inside the dead band within one step
	local equalising = math.abs(excess) / (dt * (radiusFront / (2 * inertiaFront) + radiusRear / (2 * inertiaRear)))
	local transfer = math.clamp(spec.stiffness * excess, -maxBack, maxForward)
	transfer = math.clamp(transfer, -equalising, equalising)
	front += transfer
	return front, torqueIn - front
end

return Differential
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX00000018">
<Properties>
<string name="Name">EngineSimulation</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000019">
<Properties>
<string name="Name">Engine</string>
<ProtectedString name="Source"><![CDATA[--[[
	Engine
	Full-throttle torque curve scaled by throttle, blended toward internal friction (engine
	braking) as the throttle closes, with an idle controller and a fuel-cut rev limiter with
	hysteresis.
	Engine speed is integrated by the vehicle simulation together with the clutch.

	Forced induction (optional, spec.forcedInduction; see docs/VEHICLE_CONFIG.md):
	  The torque curve is then the full-boost curve. With no boost the engine makes
	  offBoostTorqueShare of it, and boost adds the rest in proportion. The throttle is a torque
	  request: up to offBoostTorqueShare the engine needs no boost; above it, boost is asked for.
	  Boost can't pass a ceiling that rises from 0 at boostStartRpm to 1 at fullBoostRpm.
	  Turbo         boost builds toward the target at a rate that rises with rpm and engine load
	                (turbo lag), and dumps quickly when the throttle closes (blow-off).
	  Supercharger  positive displacement: boost follows engine speed and throttle with no lag.
]]

local Units = require(script.Parent.Parent.Units)

local Engine = {}

local MAX_VACUUM_BAR = 0.75 -- manifold vacuum the boost gauge shows with the throttle shut

function Engine.new(spec)
	local engine = {
		spec = spec,
		omega = Units.rpmToRadPerSec(spec.idleRpm), -- rad/s
		throttle = 0, -- throttle request, 0 to 1 (share of the full-throttle, full-boost torque)
		limiterCut = false,
		boost = 0, -- share of maximum boost, 0 to 1
		delivered = 0, -- share of the torque curve the engine is making now, 0 to 1
		spoolRate = 0, -- 1/s, turbo boost build rate at fullBoostRpm and full load
		dumpRate = 0, -- 1/s, turbo boost decay rate
	}
	local fi = spec.forcedInduction
	if fi and fi.type == "Turbo" then
		-- At full throttle and a steady rpm, the delivered share u = share + (1 - share) * boost
		-- follows the logistic du/dt = rate * u * (1 - u), so spoolTime (no boost to 90%) sets the rate.
		local share = math.clamp(fi.offBoostTorqueShare, 0.05, 0.95)
		local u90 = share + 0.9 * (1 - share)
		engine.spoolRate = math.log(((1 - share) / share) / ((1 - u90) / u90)) / fi.spoolTime
		engine.dumpRate = math.log(10) / fi.dumpTime -- boost falls to 10% in dumpTime
	end
	return engine
end

function Engine.rpm(engine): number
	return Units.radPerSecToRpm(engine.omega)
end

-- Full-throttle torque at an rpm, interpolated from the curve (Nm).
function Engine.curveTorque(spec, rpm: number): number
	local curve = spec.torqueCurve
	if rpm <= curve[1][1] then
		return curve[1][2] * math.clamp(rpm / curve[1][1], 0, 1)
	end
	for i = 1, #curve - 1 do
		local a, b = curve[i], curve[i + 1]
		if rpm <= b[1] then
			return a[2] + (b[2] - a[2]) * (rpm - a[1]) / (b[1] - a[1])
		end
	end
	return curve[#curve][2]
end

-- Forced induction: share of maximum boost the charger can make at this rpm (0 to 1).
function Engine.boostCeiling(fi, rpm: number): number
	return math.clamp((rpm - fi.boostStartRpm) / math.max(fi.fullBoostRpm - fi.boostStartRpm, 1), 0, 1)
end

-- Steady full-throttle torque at an rpm once boost has built (Nm). For an engine without forced
-- induction this is the torque curve itself. This is what a dyno would show.
function Engine.fullLoadTorque(spec, rpm: number): number
	local torque = Engine.curveTorque(spec, rpm)
	local fi = spec.forcedInduction
	if fi then
		local share = fi.offBoostTorqueShare
		torque *= share + (1 - share) * Engine.boostCeiling(fi, rpm)
	end
	return torque
end

-- Boost gauge reading in bar (gauge pressure). Negative under manifold vacuum at part throttle.
function Engine.boostBar(engine): number
	local fi = engine.spec.forcedInduction
	if not fi then
		return 0
	end
	local share = fi.offBoostTorqueShare
	if engine.delivered >= share then
		return (engine.delivered - share) / (1 - share) * fi.maxBoostBar
	end
	return (engine.delivered / share - 1) * MAX_VACUUM_BAR
end

-- Net crankshaft torque for this step (Nm). pedal: 0 to 1.
function Engine.netTorque(engine, pedal: number, dt: number): number
	local spec = engine.spec
	local rpm = Engine.rpm(engine)

	if rpm >= spec.limiterRpm then
		engine.limiterCut = true
	elseif rpm < spec.limiterRpm - spec.limiterHysteresisRpm then
		engine.limiterCut = false
	end

	local target = if engine.limiterCut then 0 else pedal
	if rpm < spec.idleRpm then
		-- idle control: open the throttle a little to hold idle speed
		target = math.max(target, math.clamp((spec.idleRpm - rpm) / 300, 0, 0.35))
	end
	engine.throttle += (target - engine.throttle) * math.clamp(spec.throttleResponse * dt, 0, 1)

	-- share of the torque curve delivered: the throttle request, limited by the boost available
	local delivered = engine.throttle
	local fi = spec.forcedInduction
	if fi then
		local share = fi.offBoostTorqueShare
		-- boost asked for: none until the request passes what the engine makes without boost
		local demand = math.clamp((engine.throttle - share) / (1 - share), 0, 1)
		local boostTarget = demand * Engine.boostCeiling(fi, rpm)
		if fi.type == "Supercharger" then
			engine.boost = boostTarget
		else
			local rate = engine.dumpRate
			if boostTarget > engine.boost then
				-- the turbo spools faster with more exhaust flow: higher rpm and more load
				local load = math.min(engine.throttle, share + (1 - share) * engine.boost)
				rate = engine.spoolRate * math.clamp(rpm / fi.fullBoostRpm, 0.1, 3) * load
			end
			engine.boost += (boostTarget - engine.boost) * math.clamp(rate * dt, 0, 1)
		end
		delivered = math.min(engine.throttle, share + (1 - share) * engine.boost)
	end
	engine.delivered = delivered

	-- The torque curve is the engine's net output at full throttle, which already includes its
	-- internal friction. With the throttle closed, that friction becomes engine braking.
	local drive = Engine.curveTorque(spec, rpm) * delivered
	local friction = if engine.omega > 0 then spec.friction.static + spec.friction.perRpm * rpm else 0
	return drive - friction * (1 - engine.throttle)
end

return Engine
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX0000001A">
<Properties>
<string name="Name">SuspensionSystem</string>
</Properties>
<Item class="ModuleScript" referent="RBX0000001B">
<Properties>
<string name="Name">Suspension</string>
<ProtectedString name="Source"><![CDATA[--[[
	Suspension
	One corner's spring, damper and bump stop, plus the anti-roll bar maths for an axle.

	Ride height is its own setting: the spring's free length is worked out from the corner's
	static load, so changing spring rate doesn't change ride height (like adjusting spring perches).
]]

local Suspension = {}

-- spec: one axle's suspension settings. cornerLoad: static load on one wheel (N).
function Suspension.new(spec, cornerLoad: number)
	local rideLength = spec.staticLength + spec.rideHeightOffset
	return {
		springRate = spec.springRate,
		bumpDamping = spec.bumpDamping,
		reboundDamping = spec.reboundDamping,
		rideLength = rideLength, -- mount to wheel centre at ride height, after the offset
		freeLength = rideLength + cornerLoad / spec.springRate,
		minLength = rideLength - spec.bumpTravel,
		maxLength = rideLength + spec.droopTravel,
		bumpStopRate = spec.bumpStopRate,
		antiRollRate = spec.antiRollRate,
		rollCenterHeight = spec.rollCenterHeight,
	}
end

--[[
	Spring, damper and bump stop force pushing the car up (N).
	  length    current mount to wheel centre length (m)
	  velocity  rate of change of length (m/s); negative while compressing
]]
function Suspension.force(s, length: number, velocity: number): number
	local compression = s.freeLength - length
	if compression <= 0 then
		return 0
	end
	local force = s.springRate * compression
	if velocity < 0 then
		force -= s.bumpDamping * velocity
	else
		force -= s.reboundDamping * velocity
	end
	if length < s.minLength then
		force += s.bumpStopRate * (s.minLength - length)
	end
	return math.max(force, 0)
end

--[[
	Anti-roll bar force for an axle. Returns the force to add to the left and right wheels.
	It pushes up harder on the more compressed side and eases off the other, resisting roll.
	Only wheels touching the road can take load, so an airborne wheel gets nothing.
]]
function Suspension.antiRoll(s, lengthLeft: number, lengthRight: number, leftContact: boolean, rightContact: boolean)
	if not (leftContact and rightContact) then
		return 0, 0
	end
	local difference = lengthRight - lengthLeft -- positive when the left side is more compressed
	local force = s.antiRollRate * difference
	return force, -force
end

return Suspension
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX0000001C">
<Properties>
<string name="Name">TireSimulation</string>
</Properties>
<Item class="ModuleScript" referent="RBX0000001D">
<Properties>
<string name="Name">Compounds</string>
<ProtectedString name="Source"><![CDATA[--[[
	Tyre compounds. All values are simulation estimates, to be tuned in testing.

	muLong / muLat      peak friction coefficient at the nominal load (braking/driving, cornering)
	peakSlipRatio       slip ratio where the braking/driving peak occurs
	peakSlipAngle       slip angle in degrees where the cornering peak occurs
	shapeLong/shapeLat  magic formula shape factor C; sliding grip settles at sin(C * pi / 2) of the peak
	loadSensitivity     grip lost per 100% extra load (heavily loaded tyres grip less per newton)
	nominalLoad         load in N where mu applies as written
	relaxationLength    metres of travel for the slip angle to build up (tyre lag)
	rollingResistance   rolling resistance coefficient

	A car that needs a particular tyre defines it in its own configuration (tires.compounds), based on
	one of these, instead of editing this file. See Tire.compound and docs/VEHICLE_CONFIG.md.
]]

return {
	Street = {
		muLong = 1.05,
		muLat = 0.98,
		peakSlipRatio = 0.12,
		peakSlipAngle = 9,
		shapeLong = 1.35,
		shapeLat = 1.45,
		loadSensitivity = 0.10,
		nominalLoad = 4000,
		relaxationLength = 0.40,
		rollingResistance = 0.013,
	},
	Sport = {
		muLong = 1.30,
		muLat = 1.12,
		peakSlipRatio = 0.11,
		peakSlipAngle = 8,
		shapeLong = 1.35,
		shapeLat = 1.45,
		loadSensitivity = 0.09,
		nominalLoad = 4200,
		relaxationLength = 0.30,
		rollingResistance = 0.012,
	},
	-- Stock tyre for the GT12 prototype (a road performance tyre on 20-inch wheels).
	Performance = {
		muLong = 1.45,
		muLat = 1.22,
		peakSlipRatio = 0.10,
		peakSlipAngle = 7.5,
		shapeLong = 1.35,
		shapeLat = 1.45,
		loadSensitivity = 0.08,
		nominalLoad = 4400,
		relaxationLength = 0.25,
		rollingResistance = 0.012,
	},
	SemiSlick = {
		muLong = 1.62,
		muLat = 1.38,
		peakSlipRatio = 0.09,
		peakSlipAngle = 6.5,
		shapeLong = 1.40,
		shapeLat = 1.55,
		loadSensitivity = 0.07,
		nominalLoad = 4600,
		relaxationLength = 0.20,
		rollingResistance = 0.011,
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001E">
<Properties>
<string name="Name">Tire</string>
<ProtectedString name="Source"><![CDATA[--[[
	Tire
	Combined-slip tyre model in the style of Pacejka's magic formula.

	Slip ratio and slip angle are each divided by the slip where that direction peaks, then
	combined into one slip value. The magic formula shape turns that into the share of available
	grip in use, and the force is split between the two directions in proportion to their slips.
	The result behaves like a friction ellipse: a tyre braking hard has less grip left for cornering.

	Low-speed handling: slip ratio uses at least 3 m/s as its reference speed, and the slip angle
	builds up over a relaxation length, so a parked or crawling car doesn't jitter.
]]

local Compounds = require(script.Parent.Compounds)

local Tire = {}

-- Radius in metres from a tyre size such as 275/35 R20.
function Tire.radiusFromSize(widthMm: number, aspect: number, rimInches: number): number
	return (rimInches * 25.4 + 2 * widthMm * aspect / 100) / 2000
end

-- Normalised magic formula: 0 at s = 0, peak of 1 at s = 1, settles toward sin(c * pi / 2).
local function shape(s: number, c: number): number
	local b = math.tan(math.pi / (2 * c))
	return math.sin(c * math.atan(b * s))
end

--[[
	The compound called name. A car can define its own compounds in config.tires.compounds
	(carCompounds): each names the compound it is based on (base, a name in Compounds or another of
	the car's own; "Performance" if left out) and lists only the values that differ, for example a
	road tyre against a track tyre. Unknown names fall back to Performance with a warning.
]]
function Tire.compound(name: string, carCompounds, depth: number?)
	local own = carCompounds and carCompounds[name]
	if own and (depth or 0) < 4 then
		local base = own.base or "Performance"
		local merged = table.clone(Tire.compound(base, if base == name then nil else carCompounds, (depth or 0) + 1))
		for key, value in own do
			if key ~= "base" then
				merged[key] = value
			end
		end
		return merged
	end
	local shared = Compounds[name]
	if not shared then
		warn("[Tire] Unknown tyre compound " .. tostring(name) .. "; using Performance")
		return Compounds.Performance
	end
	return shared
end

-- spec: one axle's tyre settings. carCompounds: config.tires.compounds, if the car has any.
function Tire.new(spec, carCompounds)
	local compound = Tire.compound(spec.compound, carCompounds)
	return {
		radius = Tire.radiusFromSize(spec.widthMm, spec.aspect, spec.rimInches),
		inertia = spec.inertia,
		compound = compound,
		peakSlipAngle = math.rad(compound.peakSlipAngle),
		slipAngle = 0, -- relaxed slip angle, radians
	}
end

--[[
	Forces on one tyre, in newtons.
	  load       normal load (N)
	  vLong      contact patch speed along the wheel's heading (m/s, forward positive)
	  vLat       contact patch speed to the wheel's right (m/s)
	  wheelSpeed wheel angular speed times radius (m/s)
	  grip       surface multiplier (1 = dry asphalt)
	  dt         time step (s)
	Returns longitudinal force (forward positive), lateral force (right positive),
	slip ratio and slip angle (radians).
]]
function Tire.forces(tire, load: number, vLong: number, vLat: number, wheelSpeed: number, grip: number, dt: number)
	if load <= 0 then
		tire.slipAngle = 0
		return 0, 0, 0, 0
	end
	local c = tire.compound

	local slipRatio = (wheelSpeed - vLong) / math.max(math.abs(vLong), 3)

	local targetAngle = math.atan2(vLat, math.max(math.abs(vLong), 0.5))
	local blend = math.clamp(math.abs(vLong) * dt / c.relaxationLength, 0.05, 1)
	tire.slipAngle += (targetAngle - tire.slipAngle) * blend

	local loadFactor = math.clamp(1 - c.loadSensitivity * (load / c.nominalLoad - 1), 0.7, 1.15)
	local muLong = c.muLong * grip * loadFactor
	local muLat = c.muLat * grip * loadFactor

	local sx = slipRatio / c.peakSlipRatio
	local sy = tire.slipAngle / tire.peakSlipAngle
	local s = math.sqrt(sx * sx + sy * sy)
	if s < 1e-6 then
		return 0, 0, slipRatio, tire.slipAngle
	end

	local fx = muLong * load * shape(s, c.shapeLong) * (sx / s)
	local fy = -muLat * load * shape(s, c.shapeLat) * (sy / s)
	return fx, fy, slipRatio, tire.slipAngle
end

-- Peak grip available right now, used to cap the parking hold force.
function Tire.peakForce(tire, load: number, grip: number): number
	return tire.compound.muLong * grip * math.max(load, 0)
end

return Tire
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX0000001F">
<Properties>
<string name="Name">TransmissionSimulation</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000020">
<Properties>
<string name="Name">Transmission</string>
<ProtectedString name="Source"><![CDATA[--[[
	Transmission
	Gear selection, automatic and manual modes, shift timing and the coupling between engine and
	gearbox. Gear numbers: -1 reverse, 0 neutral, 1 and up forward (up to 10). Two kinds (spec.type):

	DualClutch  The clutch is a stiff, torque-limited coupling solved implicitly (see
	            Transmission.clutchTorque), which stays stable even though the wheel side has very
	            little inertia once it is reflected through a low gear. It slips to launch the car
	            and runs at reduced capacity for shiftTime during a shift.
	Automatic   A torque converter with a lock-up clutch (Transmission.converter and
	            Transmission.automaticTorque). The converter slips and multiplies torque at low
	            speed, which gives the launch and idle creep. The lock-up clutch closes above a set
	            speed in the higher gears. In a shift the gearbox input (the converter's turbine) is
	            let go from the wheels: the shift clutches slip, and the gearbox control sets their
	            torque so the turbine, and the engine with it, reach the new gear's speed in shiftTime
	            while the engine's torque is cut back, the way modern 8- and 10-speed automatics
	            shift (Transmission.shiftClutchTorque).
]]

local Units = require(script.Parent.Parent.Units)

local Transmission = {}

local DEFAULT_TURBINE_INERTIA = 0.05 -- kg*m^2, converter turbine and gearbox input
local DEFAULT_LOCKUP_STIFFNESS = 400 -- Nm per rad/s of slip, as for the dual-clutch's clutch
local AUTO_SHIFT_MARGIN_RPM = 250 -- automatic: keeps a new gear clear of the next shift point
local MIN_SHIFT_REMAINING = 0.03 -- s; the shift control never plans to close a gap faster than this
local SHIFT_SYNC_RAD_S = 5 -- a shift clutch locks once the turbine is this close to the new gear's speed

function Transmission.new(spec)
	return {
		spec = spec,
		gear = 1,
		auto = true,
		shiftTimer = 0, -- seconds left in the current shift
		sinceShift = 10, -- seconds since the last shift
		automatic = spec.type == "Automatic",
		fromGear = 1, -- the gear the last shift left
		-- automatic gearboxes only
		shifting = false, -- in a shift's speed change, with the shift clutches slipping
		shiftStart = false, -- a shift has just begun (VehicleSimulation sets turbineOmega)
		shiftDuration = 0, -- planned length of the shift's speed change (s)
		shiftElapsed = 0, -- time into it (s)
		turbineOmega = 0, -- gearbox input speed during a shift (rad/s)
		lockup = 0, -- lock-up clutch engagement, 0 to 1
		converterK = 0, -- converter capacity factor, Nm per (rad/s)^2 (VehicleSimulation sets it)
		turbineInertia = spec.turbineInertia or DEFAULT_TURBINE_INERTIA,
	}
end

-- Overall ratio from engine to wheels in a given gear, negative in reverse, 0 in neutral.
function Transmission.gearRatio(tr, gear: number): number
	local spec = tr.spec
	if gear == 0 then
		return 0
	elseif gear < 0 then
		return -spec.reverseRatio * spec.finalDrive
	end
	return spec.gearRatios[gear] * spec.finalDrive
end

-- Overall ratio in the current gear.
function Transmission.ratio(tr): number
	return Transmission.gearRatio(tr, tr.gear)
end

function Transmission.gearCount(tr): number
	return #tr.spec.gearRatios
end

-- Request a gear. Returns true if the shift started.
function Transmission.shift(tr, newGear: number): boolean
	local spec = tr.spec
	newGear = math.clamp(newGear, -1, #spec.gearRatios)
	if newGear == tr.gear or tr.sinceShift < spec.minShiftInterval then
		return false
	end
	if tr.automatic and tr.shifting then
		return false -- an automatic finishes one shift before it starts the next
	end
	tr.fromGear = tr.gear
	tr.gear = newGear
	tr.shiftTimer = spec.shiftTime
	tr.sinceShift = 0
	if tr.automatic then
		-- only a change between forward gears needs the shift clutches to change the input speed
		tr.shifting = newGear >= 1 and tr.fromGear >= 1
		tr.shiftStart = tr.shifting
		tr.shiftDuration = if newGear < tr.fromGear then spec.downshiftTime or spec.shiftTime else spec.shiftTime
		tr.shiftElapsed = 0
		tr.shiftTimer = if tr.shifting then tr.shiftDuration else 0
	end
	return true
end

function Transmission.isShifting(tr): boolean
	if tr.automatic then
		return tr.shifting
	end
	return tr.shiftTimer > 0
end

-- Automatic gearboxes: 1 during an upshift, -1 during a downshift, 0 otherwise.
function Transmission.shiftDirection(tr): number
	if not (tr.automatic and tr.shifting) then
		return 0
	end
	return if tr.gear > tr.fromGear then 1 else -1
end

--[[
	Automatic gearboxes, during a shift: the torque the slipping shift clutches pass from the gearbox
	input (the turbine) to the output. The gearbox control sets it so the turbine, and the engine
	turning with it, close the gap to the new gear's input speed (targetOmega) by the end of the
	planned shift time: the engine's torque less what slowing (or speeding up) the engine and turbine
	takes. It only depends gently on the wheel speed, so it needs no implicit solve.
]]
function Transmission.shiftClutchTorque(tr, turbineOmega: number, targetOmega: number, engineTorque: number, inertiaEngine: number): number
	local remaining = math.max(tr.shiftDuration - tr.shiftElapsed, MIN_SHIFT_REMAINING)
	return engineTorque - (inertiaEngine + tr.turbineInertia) * (targetOmega - turbineOmega) / remaining
end

-- Automatic gearboxes: move the shift on by one step. It ends when the turbine is within
-- SHIFT_SYNC_RAD_S of the new gear's input speed (the shift clutch then locks), or at the latest after
-- three times its planned time.
function Transmission.advanceShift(tr, dt: number, targetOmega: number)
	if not tr.shifting then
		return
	end
	tr.shiftElapsed += dt
	local direction = if tr.gear > tr.fromGear then 1 else -1
	if (targetOmega - tr.turbineOmega) * direction >= -SHIFT_SYNC_RAD_S or tr.shiftElapsed >= 3 * tr.shiftDuration then
		tr.shifting = false
	end
end

--[[
	Automatic gearboxes: one gear up past the upshift point. Below the downshift point, down to the
	highest gear that lifts the engine clear of the downshift point, skipping gears if needed (a
	kickdown), but never into a gear that would put the engine within AUTO_SHIFT_MARGIN_RPM of the
	upshift point, so it can't hunt between gears whatever their number and spacing.
]]
local function chooseAutomaticGear(tr, inputRpm: number, up: number, down: number)
	local ratios = tr.spec.gearRatios
	if inputRpm > up then
		if tr.gear < #ratios then
			Transmission.shift(tr, tr.gear + 1)
		end
		return
	end
	if inputRpm >= down then
		return
	end
	local target = tr.gear
	for gear = tr.gear - 1, 1, -1 do
		local rpm = inputRpm * ratios[gear] / ratios[tr.gear]
		if rpm > up - AUTO_SHIFT_MARGIN_RPM then
			break
		end
		target = gear
		if rpm >= down + AUTO_SHIFT_MARGIN_RPM then
			break
		end
	end
	if target ~= tr.gear then
		Transmission.shift(tr, target)
	end
end

-- Automatic gear choice. inputRpm: gearbox input speed implied by the wheels. pedal: 0 to 1.
function Transmission.updateAuto(tr, dt: number, inputRpm: number, pedal: number)
	tr.sinceShift += dt
	tr.shiftTimer = math.max(0, tr.shiftTimer - dt)
	if not tr.auto or tr.gear <= 0 then
		return
	end
	local spec = tr.spec
	local up = spec.autoUpshiftRpm.light + (spec.autoUpshiftRpm.full - spec.autoUpshiftRpm.light) * pedal
	local down = spec.autoDownshiftRpm.light + (spec.autoDownshiftRpm.full - spec.autoDownshiftRpm.light) * pedal
	if tr.automatic then
		chooseAutomaticGear(tr, inputRpm, up, down)
	elseif inputRpm > up and tr.gear < #spec.gearRatios then
		Transmission.shift(tr, tr.gear + 1)
	elseif inputRpm < down and tr.gear > 1 then
		-- don't drop into a gear that would over-rev the engine
		local lowerRpm = inputRpm * spec.gearRatios[tr.gear - 1] / spec.gearRatios[tr.gear]
		if lowerRpm < spec.autoUpshiftRpm.full - 400 then
			Transmission.shift(tr, tr.gear - 1)
		end
	end
end

--[[
	Automatic gearboxes: the lock-up clutch closes over lockup.engageTime in gear lockup.minGear and
	up once the car passes lockup.minSpeedKmh. It opens four times as fast below that speed (less
	3 km/h, so it doesn't chatter), in neutral and reverse, or if the engine is dragged toward a stall.
]]
function Transmission.updateLockup(tr, dt: number, speedKmh: number, engineRpm: number, idleRpm: number)
	local lockup = tr.spec.lockup
	local threshold = if tr.lockup > 0 then lockup.minSpeedKmh - 3 else lockup.minSpeedKmh
	local step = dt / lockup.engageTime
	if tr.gear >= lockup.minGear and speedKmh > threshold and engineRpm > idleRpm - 150 then
		tr.lockup = math.min(1, tr.lockup + step)
	else
		tr.lockup = math.max(0, tr.lockup - 4 * step)
	end
end

--[[
	Clutch engagement from 0 (open) to 1 (fully engaged).
	  engineRpm  current engine speed
	  inputRpm   gearbox input speed implied by the wheels (absolute value)
	  pedal      accelerator for the current direction of travel, 0 to 1
	  idleRpm    engine idle speed
]]
function Transmission.engagement(tr, engineRpm: number, inputRpm: number, pedal: number, idleRpm: number): number
	local spec = tr.spec
	if tr.gear == 0 then
		return 0
	end
	local engagement = 1
	if math.abs(tr.gear) == 1 and inputRpm < engineRpm - 150 then
		-- launching: the clutch bites over the last 600 rpm below the launch speed, so the engine
		-- holds close to that speed while the car pulls away
		local launchTarget = spec.launchRpm.min + (spec.launchRpm.max - spec.launchRpm.min) * pedal
		engagement = math.clamp((engineRpm - (launchTarget - 600)) / 600, 0, 1)
	end
	if engineRpm < idleRpm - 150 then
		-- anti-stall: open the clutch as the engine is dragged below idle
		engagement = math.min(engagement, math.clamp((engineRpm - 600) / (idleRpm - 750), 0, 1))
	end
	if tr.shiftTimer > 0 then
		engagement = math.min(engagement, spec.shiftTorqueFraction)
	end
	return engagement
end

--[[
	Torque passed through the clutch (Nm, from the engine to the gearbox input), solved implicitly
	so a stiff coupling stays stable at any time step, then limited to the clutch's capacity.
	  omegaEngine, omegaInput  rad/s
	  inertiaEngine, inertiaInput  kg*m^2 (wheel-side inertia reflected to the input shaft)
	  engineTorque  net engine torque (Nm)
	  loadTorque    torque the wheels push back on the input shaft (Nm)
	  capacity      clutch torque capacity now (Nm)
]]
local function couplingTorque(stiffness: number, omegaEngine: number, omegaInput: number, inertiaEngine: number, inertiaInput: number, engineTorque: number, loadTorque: number, capacity: number, dt: number): number
	local predictedSlip = (omegaEngine - omegaInput) + dt * (engineTorque / inertiaEngine + loadTorque / inertiaInput)
	local torque = stiffness * predictedSlip / (1 + stiffness * dt * (1 / inertiaEngine + 1 / inertiaInput))
	return math.clamp(torque, -capacity, capacity)
end

function Transmission.clutchTorque(tr, omegaEngine: number, omegaInput: number, inertiaEngine: number, inertiaInput: number, engineTorque: number, loadTorque: number, capacity: number, dt: number): number
	if capacity <= 0 then
		return 0
	end
	return couplingTorque(tr.spec.clutchStiffness, omegaEngine, omegaInput, inertiaEngine, inertiaInput, engineTorque, loadTorque, capacity, dt)
end

--[[
	Torque converter (automatic gearboxes): a fluid coupling between the engine (impeller) and the
	gearbox input (turbine) that multiplies torque while it slips.
	  speed ratio s = turbine speed / impeller speed
	  Below the coupling point the impeller absorbs K * impeller speed^2. K comes from the stall
	  speed: the engine speed at which the converter, with the turbine held still, absorbs the
	  engine's steady full-throttle torque.
	  Turbine torque = torque ratio * impeller torque. The ratio falls in a straight line from
	  converter.torqueRatio at s = 0 to 1 at converter.couplingPoint.
	Past the coupling point it is a plain fluid coupling whose torque falls to zero at s = 1. When the
	turbine overruns the impeller (engine braking) the turbine pumps instead, at
	converter.overrunCapacity of the forward strength.
	Returns impeller and turbine torque (Nm), then the derivatives of each with respect to the
	impeller and turbine speeds, for the implicit solve.
]]
function Transmission.converter(tr, omegaImpeller: number, omegaTurbine: number): (number, number, number, number, number, number)
	local spec = tr.spec.converter
	local k = tr.converterK
	local a, b = omegaImpeller, omegaTurbine
	local stallRatio = spec.torqueRatio
	local coupling = spec.couplingPoint
	local s = b / a
	if s <= 0 then
		local impeller = k * a * a
		return impeller, stallRatio * impeller, 2 * k * a, 0, 2 * stallRatio * k * a, 0
	elseif s < coupling then
		local m = (stallRatio - 1) / coupling
		return k * a * a, k * (stallRatio * a * a - m * a * b), 2 * k * a, 0, k * (2 * stallRatio * a - m * b), -k * m * a
	elseif s <= 1 then
		local kc = k / (1 - coupling)
		local torque = kc * a * (a - b)
		return torque, torque, kc * (2 * a - b), -kc * a, kc * (2 * a - b), -kc * a
	end
	local ko = k / (1 - coupling) * (spec.overrunCapacity or 0.6)
	local torque = -ko * b * (b - a)
	return torque, torque, ko * b, -ko * (2 * b - a), ko * b, -ko * (2 * b - a)
end

-- Converter torque multiplication at these speeds (1 once it couples).
function Transmission.torqueRatio(tr, omegaImpeller: number, omegaTurbine: number): number
	local spec = tr.spec.converter
	local s = math.max(omegaTurbine / omegaImpeller, 0)
	if s >= spec.couplingPoint then
		return 1
	end
	return spec.torqueRatio - (spec.torqueRatio - 1) * s / spec.couplingPoint
end

--[[
	Automatic gearboxes: torque through the converter and its lock-up clutch for one step. The
	converter's torques are linearised and solved implicitly together with the engine and gearbox
	input speeds, like clutchTorque, so the light gearbox side stays stable. The lock-up clutch is
	then solved on top as a stiff coupling with lockupCapacity.
	  omegaEngine, omegaTurbine  rad/s now
	  inertiaInput, loadTorque   what the turbine drives: the wheels seen through the gearbox, or
	                             during a shift only the turbine itself, held back by the shift clutches
	  the rest as for clutchTorque
	Returns the torque taken from the engine, the torque delivered to the turbine, and the lock-up
	clutch's part of them.
]]
function Transmission.automaticTorque(tr, omegaEngine: number, omegaTurbine: number, inertiaEngine: number, inertiaInput: number, engineTorque: number, loadTorque: number, lockupCapacity: number, dt: number): (number, number, number)
	local impeller, turbine, pa, pb, qa, qb = Transmission.converter(tr, omegaEngine, omegaTurbine)
	-- [1 + alpha*pa, alpha*pb; -beta*qa, 1 - beta*qb] [da; db] = [alpha*(Te - impeller); beta*(turbine - load)]
	local alpha, beta = dt / inertiaEngine, dt / inertiaInput
	local m11, m12, m21, m22 = 1 + alpha * pa, alpha * pb, -beta * qa, 1 - beta * qb
	local r1, r2 = alpha * (engineTorque - impeller), beta * (turbine - loadTorque)
	local det = m11 * m22 - m12 * m21 -- at least 1 for this converter model
	local da = (r1 * m22 - m12 * r2) / det
	local db = (m11 * r2 - m21 * r1) / det
	impeller += pa * da + pb * db
	turbine += qa * da + qb * db

	local lock = 0
	if lockupCapacity > 0 then
		local stiffness = tr.spec.lockup.stiffness or DEFAULT_LOCKUP_STIFFNESS
		lock = couplingTorque(stiffness, omegaEngine, omegaTurbine, inertiaEngine, inertiaInput, engineTorque - impeller, loadTorque - turbine, lockupCapacity, dt)
	end
	return impeller + lock, turbine + lock, lock
end

function Transmission.gearLabel(tr): string
	if tr.gear == 0 then
		return "N"
	elseif tr.gear < 0 then
		return "R"
	end
	return tostring(tr.gear)
end

Transmission.rpmToRadPerSec = Units.rpmToRadPerSec

return Transmission
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ModuleScript" referent="RBX00000021">
<Properties>
<string name="Name">Units</string>
<ProtectedString name="Source"><![CDATA[--[[
	Units
	Converts between SI units (used by all vehicle maths) and Roblox units.

	Roblox Creator Hub, "Roblox units": 1 stud = 0.28 m and 1 RMU (Roblox mass unit) = 21.952 kg.
	The physics engine itself is unit-free, so these conversions only matter at the edges:
	positions and velocities coming in from Roblox, and forces going back out.
]]

local Units = {}

Units.METERS_PER_STUD = 0.28
Units.KG_PER_RMU = 21.952
Units.GRAVITY = 9.81 -- m/s^2
Units.AIR_DENSITY = 1.225 -- kg/m^3, sea level at 15 C

-- Real-world gravity expressed in studs/s^2. The Roblox default of 196.2 is far stronger.
Units.REALISTIC_GRAVITY = Units.GRAVITY / Units.METERS_PER_STUD

-- Roblox force units per newton (RMU * stud / s^2).
Units.FORCE_PER_NEWTON = 1 / (Units.KG_PER_RMU * Units.METERS_PER_STUD)

function Units.studsToMeters(studs: number): number
	return studs * Units.METERS_PER_STUD
end

function Units.metersToStuds(meters: number): number
	return meters / Units.METERS_PER_STUD
end

function Units.kgToRmu(kg: number): number
	return kg / Units.KG_PER_RMU
end

function Units.mpsToKmh(mps: number): number
	return mps * 3.6
end

function Units.rpmToRadPerSec(rpm: number): number
	return rpm * math.pi / 30
end

function Units.radPerSecToRpm(radPerSec: number): number
	return radPerSec * 30 / math.pi
end

return Units
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX00000022">
<Properties>
<string name="Name">VehicleAudio</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000023">
<Properties>
<string name="Name">AudioAssets</string>
<ProtectedString name="Source"><![CDATA[--[[
	Roblox asset IDs of the sound packs in assets/audio. Upload each file once (Creator Hub or
	Studio's Asset Manager, see docs/AUDIO.md), then paste its ID here, for example:
		GT12_Engine = "rbxassetid://1234567890",
	Several cars can share one pack (assets/audio/packs.json lists which); each car's sheet table
	names its pack. Leave a pack as "" to play without it. The game prints a reminder in the Output
	window while an ID is missing.
]]

return {
	GT12_Engine = "", -- the GT12's engine
	Driving_Effects = "", -- tyres, wind, road, gearbox, crackles, shifts, knocks, and traffic engines
	Engines_Pack1 = "", -- the next cars' engines (see assets/audio/packs.json)
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000024">
<Properties>
<string name="Name">EngineMix</string>
<ProtectedString name="Source"><![CDATA[--[[
	EngineMix: turns the car's state into a volume and playback speed for every sound layer, plus
	the one-shot sounds to start this frame. Pure maths with no Roblox objects, so it can be checked
	outside the game: tools/audio_preview.py is a line-for-line Python copy that renders what a drive
	sounds like. Keep the two in step.

	The engine sheet (VehicleAudio/Sheets, made by tools/synth_audio.py from the car's acoustic
	definition in assets/audio/engines) holds:
	  * pairs of loops, on and off throttle, made at several steady engine speeds. Each frame the two
	    speeds either side of the current rpm are crossfaded with equal power in log-rpm (even in
	    pitch), each loop is pitched by rpm / its own rpm, and on and off are crossfaded by engine
	    load, smoothed so it doesn't flutter. Each loop carries a gain worked out from the real
	    car's measured sound levels, so loudness follows rpm and load;
	  * two limiter loops with the car's cut pattern baked in, one free-revving and one in gear.
	    While the engine is on the limiter the mix switches to them with a fast attack, so hitting
	    the limiter is unmistakable;
	  * forced-induction layers: a turbo whistle pitched by boost plus blow-off one-shots when the
	    throttle shuts on boost, or supercharger whine loops pitched by rpm and raised by boost.
	Upshifts at high load add an ignition-cut "crack"; lifting off at high rpm sets off exhaust
	crackles for a moment.

	Inputs each frame:
	  rpm, load (0-1), pedal (0-1), clutch (0-1 engagement), gear, shifting (bool), limiter (bool:
	  the fuel cut is active), boost (0-1), speed (m/s), slip (largest combined tyre slip, 1 = at the
	  grip peak), slideSpeed (fastest tyre sliding speed, m/s), shaftRpm (driveshaft), bump (bump-stop
	  impact speed, m/s), interior (bool, cockpit camera)
	Events: { name, volume, speed, sheet } where sheet is "engine" or "effects".
]]

local EngineMix = {}

local HALF_PI = math.pi / 2

-- Equal-power crossfade weights over the recorded engine speeds (ascending), in log-rpm.
function EngineMix.rpmWeights(points: { number }, rpm: number, out: { number }): { number }
	local n = #points
	for i = 1, n do
		out[i] = 0
	end
	if rpm <= points[1] then
		out[1] = 1
		return out
	end
	if rpm >= points[n] then
		out[n] = 1
		return out
	end
	for i = 1, n - 1 do
		local a, b = points[i], points[i + 1]
		if rpm <= b then
			local t = math.log(rpm / a) / math.log(b / a)
			out[i] = math.cos(t * HALF_PI)
			out[i + 1] = math.sin(t * HALF_PI)
			break
		end
	end
	return out
end

local EFFECT_LOOPS = { "squeal", "road", "wind", "whine" }
EngineMix.EFFECT_LOOPS = EFFECT_LOOPS

--[[
	spec: the car configuration's audio table. engineSheet and effectsSheet: the sheet tables in
	VehicleAudio/Sheets. random: a Random object (optional).
]]
function EngineMix.new(spec, engineSheet, effectsSheet, random: Random?)
	local self = {
		spec = spec,
		points = {}, -- engine speeds of the on/off loop pairs, ascending
		onLoop = {}, -- index into engineSheet.loops of the on-throttle loop at each point
		offLoop = {},
		loopRpm = {}, -- engine speed each loop was made at
		loopGain = {}, -- playback gain of each loop (from the car's measured sound levels)
		hasGains = false,
		engineVolume = {}, -- per engine-sheet loop, indexed like engineSheet.loops
		engineSpeed = {},
		limiterFree = nil, -- index of the free-revving limiter loop
		limiterLoad = nil, -- and of the in-gear one
		turboLoop = nil,
		turboBaseHz = 1,
		turboMinHz = 1,
		turboMaxHz = 1,
		blowOffNames = {},
		whineLoops = {}, -- supercharger whine loops, ascending rpm
		whineRpm = {},
		whineBaseHz = {},
		whineWeights = {},
		whineHzPerRpm = 0, -- rotor pulses per second per crank rpm
		effects = {}, -- per effect loop name: { volume, speed }
		events = {}, -- one-shots to start this frame: { name, volume, speed, sheet }
		weights = {},
		load = 0,
		lastGear = 0,
		upshiftTimer = 0,
		sinceHighLoad = math.huge,
		crackleTime = 0,
		bumpCooldown = 0,
		crackleNames = {},
		whineHz = 1000,
		limiterSeen = math.huge, -- seconds since the fuel cut was last active
		sinceShift = math.huge, -- seconds since the gearbox last changed gear
		limiterMix = 0, -- 0 = normal loops, 1 = limiter loops
		freeMix = 0, -- 0 = in-gear limiter loop, 1 = free-revving one
		limiterRpm = 0, -- smoothed rpm while on the limiter
		limiterRpmSheet = engineSheet.limiterRpm or math.huge, -- where the car's limiter is
		pedalPeak = 0,
		boostPeak = 0,
		blowOffCooldown = 0,
		random = random or Random.new(),
	}

	local byRpm = {}
	for i, loop in engineSheet.loops do
		self.loopRpm[i] = loop.rpm or 0
		self.loopGain[i] = loop.gain or 1
		self.hasGains = self.hasGains or loop.gain ~= nil
		self.engineVolume[i] = 0
		self.engineSpeed[i] = 1
		if loop.load == "on" or loop.load == "off" then
			local key = math.floor(loop.rpm + 0.5)
			local pair = byRpm[key]
			if not pair then
				pair = { rpm = loop.rpm }
				byRpm[key] = pair
				table.insert(self.points, pair)
			end
			pair[loop.load] = i
		elseif loop.load == "limiter" then
			if loop.kind == "free" then
				self.limiterFree = i
			else
				self.limiterLoad = i
			end
		elseif loop.layer == "turbo" then
			self.turboLoop = i
			self.turboBaseHz = loop.baseHz
		elseif loop.layer == "supercharger" then
			table.insert(self.whineLoops, i)
		end
	end
	table.sort(self.points, function(a, b)
		return a.rpm < b.rpm
	end)
	for k, pair in self.points do
		self.onLoop[k] = pair.on or pair.off
		self.offLoop[k] = pair.off or pair.on
		self.points[k] = pair.rpm
	end
	self.limiterFree = self.limiterFree or self.limiterLoad
	self.limiterLoad = self.limiterLoad or self.limiterFree
	if engineSheet.turbo then
		self.turboMinHz = engineSheet.turbo.minHz
		self.turboMaxHz = engineSheet.turbo.maxHz
	end
	for _, shot in engineSheet.oneShots or {} do
		if shot.layer == "blowoff" then
			table.insert(self.blowOffNames, shot.name)
		end
	end
	table.sort(self.whineLoops, function(a, b)
		return engineSheet.loops[a].rpm < engineSheet.loops[b].rpm
	end)
	for k, index in self.whineLoops do
		self.whineRpm[k] = engineSheet.loops[index].rpm
		self.whineBaseHz[k] = engineSheet.loops[index].baseHz
		self.whineWeights[k] = 0
	end
	if engineSheet.supercharger then
		self.whineHzPerRpm = engineSheet.supercharger.driveRatio * engineSheet.supercharger.pulsesPerRev / 60
	end

	for _, name in EFFECT_LOOPS do
		self.effects[name] = { volume = 0, speed = 1 }
	end
	if effectsSheet then
		for _, loop in effectsSheet.loops do
			if loop.name == "whine" and loop.baseHz then
				self.whineHz = loop.baseHz
			end
		end
		for _, shot in effectsSheet.oneShots do
			if string.sub(shot.name, 1, 8) == "crackle_" then
				table.insert(self.crackleNames, shot.name)
			end
		end
	end
	return self
end

local function event(self, name: string, volume: number, speed: number, sheet: string?)
	table.insert(self.events, { name = name, volume = volume, speed = speed, sheet = sheet or "effects" })
end

function EngineMix.update(self, dt: number, input)
	local spec = self.spec
	table.clear(self.events)
	local rpm = math.max(input.rpm, 1)
	local interior = spec.interior
	local engineGain = if input.interior then interior.engine else 1
	-- Sheets made from an acoustic definition carry per-loop gains for the loudness curve; older
	-- sheets without them use the configured curve.
	local loud = if self.hasGains
		then spec.engineVolume * engineGain
		else spec.engineVolume * engineGain
			* (spec.idleLevel + (1 - spec.idleLevel) * math.clamp(rpm / spec.redlineRpm, 0, 1.1) ^ spec.rpmCurve)

	-- time since the gearbox last changed gear: its shifting flag, or a new gear (which also covers
	-- a gearbox that doesn't report shifting)
	local gear = input.gear
	if input.shifting or gear ~= self.lastGear then
		self.sinceShift = 0
	else
		self.sinceShift += dt
	end

	-- gear changes: an ignition-cut crack on full-throttle upshifts, a clunk on every shift
	if gear ~= self.lastGear then
		if gear > self.lastGear and self.lastGear >= 1 then
			if self.load > 0.5 and input.load > 0.5 and rpm > spec.shiftCutMinRpm then
				self.upshiftTimer = spec.shiftCutTime
				event(self, "shift_cut", spec.shiftCutVolume * loud, 1)
			end
			event(self, "shift_clunk", spec.shiftClunkVolume * engineGain, 1)
		elseif self.lastGear ~= 0 and gear ~= 0 then
			event(self, "shift_clunk", spec.shiftClunkVolume * 0.7 * engineGain, 0.9)
		end
		self.lastGear = gear
	end
	self.upshiftTimer = math.max(0, self.upshiftTimer - dt)

	-- smoothed engine load
	local target = math.clamp(input.load, 0, 1)
	if self.upshiftTimer > 0 then
		target *= 0.3
	end
	local rate = if target > self.load then spec.loadAttack else spec.loadRelease
	self.load += (target - self.load) * math.clamp(rate * dt, 0, 1)
	local load = self.load

	-- the rev limiter: switch to the limiter loops while the fuel cut keeps coming back with the
	-- pedal down (a fast attack so the first cut is heard), and back when it stops. A gear change
	-- flares the engine into the fuel cut for a moment while the clutch slips. That isn't the
	-- limiter, so cuts during a shift and for limiterShiftMask seconds after it are ignored.
	if input.limiter and self.sinceShift > (spec.limiterShiftMask or 0.15) then
		self.limiterSeen = 0
	else
		self.limiterSeen += dt
	end
	local nearLimit = rpm > 0.92 * self.limiterRpmSheet -- an upshift off the limiter releases it at once
	local limiterTarget = if self.limiterFree and self.limiterSeen < spec.limiterHold and input.pedal > 0.5 and nearLimit
		then 1
		else 0
	local limiterRate = if limiterTarget > self.limiterMix then spec.limiterAttack else spec.limiterRelease
	self.limiterMix += (limiterTarget - self.limiterMix) * math.clamp(limiterRate * dt, 0, 1)
	local freeTarget = if input.gear == 0 or input.clutch < 0.5 then 1 else 0
	self.freeMix += (freeTarget - self.freeMix) * math.clamp(8 * dt, 0, 1)
	self.limiterRpm += (rpm - self.limiterRpm) * math.clamp(3 * dt, 0, 1)
	local keep = 1 - self.limiterMix

	-- engine loops
	local on = math.sqrt(load)
	local off = math.sqrt(1 - load) * (if self.hasGains then 1 else spec.offThrottleLevel)
	EngineMix.rpmWeights(self.points, rpm, self.weights)
	for k, w in self.weights do
		local onIndex, offIndex = self.onLoop[k], self.offLoop[k]
		self.engineVolume[onIndex] = loud * w * on * keep * self.loopGain[onIndex]
		self.engineSpeed[onIndex] = math.clamp(rpm / self.loopRpm[onIndex], spec.minPitch, spec.maxPitch)
		if offIndex ~= onIndex then
			self.engineVolume[offIndex] = loud * w * off * keep * self.loopGain[offIndex]
			self.engineSpeed[offIndex] = math.clamp(rpm / self.loopRpm[offIndex], spec.minPitch, spec.maxPitch)
		end
	end
	if self.limiterFree then
		local free, inGear = self.limiterFree, self.limiterLoad
		local mix = self.limiterMix
		if free == inGear then
			self.engineVolume[free] = loud * mix * self.loopGain[free]
		else
			self.engineVolume[free] = loud * mix * math.sqrt(self.freeMix) * self.loopGain[free]
			self.engineVolume[inGear] = loud * mix * math.sqrt(1 - self.freeMix) * self.loopGain[inGear]
			self.engineSpeed[inGear] = math.clamp(self.limiterRpm / self.loopRpm[inGear], 0.97, 1.03)
		end
		self.engineSpeed[free] = math.clamp(self.limiterRpm / self.loopRpm[free], 0.97, 1.03)
	end

	-- forced induction: turbo whistle pitched by boost (shaft speed rises about as the square root
	-- of boost pressure), blow-off when the throttle shuts on boost, supercharger whine by rpm
	local boost = math.clamp(input.boost, 0, 1)
	if self.turboLoop then
		local hz = self.turboMinHz + (self.turboMaxHz - self.turboMinHz) * math.sqrt(boost)
		self.engineVolume[self.turboLoop] = spec.turboVolume * engineGain * boost ^ 1.2 * (0.35 + 0.65 * load)
		self.engineSpeed[self.turboLoop] = math.clamp(hz / self.turboBaseHz, 0.3, 3)
	end
	self.pedalPeak = math.max(input.pedal, self.pedalPeak - 3 * dt)
	self.boostPeak = math.max(boost, self.boostPeak - 2 * dt)
	self.blowOffCooldown = math.max(0, self.blowOffCooldown - dt)
	if #self.blowOffNames > 0 and input.pedal < 0.2 and self.pedalPeak > 0.6
		and self.boostPeak > spec.blowOffMinBoost and self.blowOffCooldown <= 0
	then
		self.blowOffCooldown = 1
		self.pedalPeak = 0
		local name = self.blowOffNames[self.random:NextInteger(1, #self.blowOffNames)]
		event(self, name, spec.blowOffVolume * engineGain * self.boostPeak, 0.95 + 0.1 * self.random:NextNumber(), "engine")
	end
	if #self.whineLoops > 0 then
		EngineMix.rpmWeights(self.whineRpm, rpm, self.whineWeights)
		-- optional shape settings (the defaults give the original shape): the share of the whine left
		-- with no boost, the engine speed where it reaches full level, and the share left at low rpm
		local idleShare = spec.superchargerIdleShare or 0.2
		local fullRpm = spec.superchargerFullRpm or 2500
		local rpmFloor = spec.superchargerRpmFloor or 0.3
		local level = spec.superchargerVolume * engineGain * (idleShare + (1 - idleShare) * boost)
			* math.clamp(rpm / fullRpm, rpmFloor, 1)
		for k, index in self.whineLoops do
			self.engineVolume[index] = level * self.whineWeights[k]
			self.engineSpeed[index] = math.clamp(rpm * self.whineHzPerRpm / self.whineBaseHz[k], 0.25, 4)
		end
	end

	-- exhaust crackles after lifting off at high rpm
	if load > 0.6 then
		self.sinceHighLoad = 0
	else
		self.sinceHighLoad += dt
	end
	if self.crackleTime <= 0 and input.load < 0.1 and self.sinceHighLoad < 0.3 and rpm > spec.crackleMinRpm
		and not input.limiter and #self.crackleNames > 0
	then
		self.crackleTime = spec.crackleDuration
	end
	if self.crackleTime > 0 then
		self.crackleTime -= dt
		if input.load > 0.3 then
			self.crackleTime = 0
		end
		local remaining = math.clamp(self.crackleTime / spec.crackleDuration, 0, 1)
		local rpmShare = math.clamp(rpm / 7000, 0.4, 1)
		local chance = spec.crackleRate * remaining * remaining * rpmShare * dt
		if self.random:NextNumber() < chance then
			local name = self.crackleNames[self.random:NextInteger(1, #self.crackleNames)]
			local volume = spec.crackleVolume * engineGain * (0.4 + 0.6 * self.random:NextNumber()) * rpmShare
			event(self, name, volume, 0.85 + 0.35 * self.random:NextNumber())
		end
	end

	-- suspension hitting its bump stops
	self.bumpCooldown = math.max(0, self.bumpCooldown - dt)
	if input.bump > spec.bumpMinSpeed and self.bumpCooldown <= 0 then
		self.bumpCooldown = 0.15
		event(self, "bump_knock", spec.bumpVolume * math.clamp(input.bump / 2, 0.3, 1), 1)
	end

	-- tyres, road, wind and gearbox
	local speed = input.speed
	local fx = self.effects
	local slipOver = input.slip - spec.squealStart
	local squeal = math.clamp(slipOver / spec.squealRange, 0, 1) * math.clamp(input.slideSpeed / 1.5, 0, 1)
	fx.squeal.volume = spec.squealVolume * squeal ^ 1.5 * (if input.interior then interior.squeal else 1)
	fx.squeal.speed = 0.92 + 0.18 * math.clamp(slipOver, 0, 1)

	fx.road.volume = spec.roadVolume * math.clamp(speed / 45, 0, 1) ^ 1.2 * (if input.interior then interior.road else 1)
	fx.road.speed = 0.75 + 0.5 * math.clamp(speed / 80, 0, 1)

	local wind = math.clamp(speed / 95, 0, 1.15)
	fx.wind.volume = spec.windVolume * wind * wind * (if input.interior then interior.wind else 1)
	fx.wind.speed = 0.7 + 0.6 * math.clamp(speed / 95, 0, 1)

	local shaftRpm = math.abs(input.shaftRpm)
	fx.whine.volume = if gear ~= 0
		then spec.whineVolume * engineGain * math.clamp(shaftRpm / 7000, 0, 1) * (0.4 + 0.6 * load)
		else 0
	fx.whine.speed = math.clamp(shaftRpm / 60 * spec.whineTeeth / self.whineHz, 0.2, 3)
end

return EngineMix
]]></ProtectedString>
</Properties>
</Item>
<Item class="Folder" referent="RBX00000025">
<Properties>
<string name="Name">Sheets</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000026">
<Properties>
<string name="Name">Driving_Effects</string>
<ProtectedString name="Source"><![CDATA[--[[
	Regions of assets/audio/Driving_Effects.flac, in seconds, for the driving effects.
	Generated by tools/synth_audio.py; don't edit by hand. Loops: the game plays start..stop and
	loops loopStart..loopEnd; gain is the loop's playback gain from the car's measured sound levels.
]]

return {
	asset = "Driving_Effects",
	length = 14.800748,
	loops = {
		{ name = "squeal", start = 0.02, loopStart = 0.02, loopEnd = 2.42, stop = 2.67 },
		{ name = "road", start = 2.71, loopStart = 2.71, loopEnd = 3.91, stop = 4.16 },
		{ name = "wind", start = 4.2, loopStart = 4.2, loopEnd = 5.4, stop = 5.65 },
		{ name = "whine", start = 5.69, loopStart = 5.69, loopEnd = 6.19, stop = 6.44, baseHz = 1000 },
		{ name = "tyre_roll", start = 6.48, loopStart = 6.48, loopEnd = 7.68, stop = 7.93 },
	},
	oneShots = {
		{ name = "crackle_1", start = 7.95, stop = 8.09 },
		{ name = "crackle_2", start = 8.11, stop = 8.25 },
		{ name = "crackle_3", start = 8.27, stop = 8.41 },
		{ name = "crackle_4", start = 8.43, stop = 8.57 },
		{ name = "crackle_5", start = 8.59, stop = 8.73 },
		{ name = "crackle_6", start = 8.75, stop = 8.89 },
		{ name = "shift_cut", start = 8.91, stop = 9.11 },
		{ name = "shift_clunk", start = 9.13, stop = 9.28 },
		{ name = "bump_knock", start = 9.3, stop = 9.55 },
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000027">
<Properties>
<string name="Name">GT12_Engine</string>
<ProtectedString name="Source"><![CDATA[--[[
	Regions of assets/audio/GT12_Engine.flac, in seconds, for Prototype812 (assets/audio/engines/Prototype812.json).
	Generated by tools/synth_audio.py; don't edit by hand. Loops: the game plays start..stop and
	loops loopStart..loopEnd; gain is the loop's playback gain from the car's measured sound levels.
]]

return {
	asset = "GT12_Engine",
	length = 23.56195,
	car = "Prototype812",
	idleRpm = 1000,
	limiterRpm = 8900,
	loops = {
		{ name = "on_1000", start = 0.02, loopStart = 0.02, loopEnd = 0.98, stop = 1.23, rpm = 1000, load = "on", gain = 0.2541 },
		{ name = "off_1000", start = 1.27, loopStart = 1.27, loopEnd = 2.23, stop = 2.48, rpm = 1000, load = "off", gain = 0.12735 },
		{ name = "on_1500", start = 2.52, loopStart = 2.52, loopEnd = 3.48, stop = 3.73, rpm = 1500, load = "on", gain = 0.31728 },
		{ name = "off_1500", start = 3.77, loopStart = 3.77, loopEnd = 4.73, stop = 4.98, rpm = 1500, load = "off", gain = 0.15902 },
		{ name = "on_2200", start = 5.02, loopStart = 5.02, loopEnd = 6.001814, stop = 6.251814, rpm = 2200.009, load = "on", gain = 0.39134 },
		{ name = "off_2200", start = 6.291814, loopStart = 6.291814, loopEnd = 7.273628, stop = 7.523628, rpm = 2200.009, load = "off", gain = 0.19613 },
		{ name = "on_3200", start = 7.563628, loopStart = 7.563628, loopEnd = 8.576122, stop = 8.826122, rpm = 3200.018, load = "on", gain = 0.48049 },
		{ name = "off_3200", start = 8.866122, loopStart = 8.866122, loopEnd = 9.878617, stop = 10.128617, rpm = 3200.018, load = "off", gain = 0.24081 },
