<Item class="ModuleScript" referent="RBX00000030">
<Properties>
<string name="Name">TrafficMix</string>
<ProtectedString name="Source"><![CDATA[--[[
	TrafficMix: the maths of traffic sound heard from outside. Pure functions with no Roblox objects
	(apart from Vector3), used by Client/TrafficAudio and copied line for line in
	tools/audio_preview.py, which renders a roadside drive-by. Keep the two in step.

	Roblox spatializes each traffic Sound itself (direction, and distance with RollOffMode
	InverseTapered between ROLLOFF_MIN_M and ROLLOFF_MAX_M). On top of that:
	  * engine speed and load come from the car's road speed and acceleration through a simple
	    automatic gearbox, so a car pulling away revs and a cruising car hums;
	  * Doppler: pitch times (c + listener speed toward the source) / (c - source speed toward the
	    listener);
	  * air absorption: the equaliser's mid and high bands lose level with distance.
]]

local TrafficMix = {}

TrafficMix.SPEED_OF_SOUND = 343 -- m/s, air at 20 C
TrafficMix.ROLLOFF_MIN_M = 6 -- full volume within this distance
TrafficMix.ROLLOFF_MAX_M = 450 -- silent beyond it
TrafficMix.ENGINE_VOLUME = 1.6 -- Sound volume of a traffic engine at full load, within ROLLOFF_MIN_M
TrafficMix.TYRE_VOLUME = 0.9 -- tyre roar at 110 km/h

-- [E] Generic automatic gearboxes, only for the engine note (traffic moves without physics).
TrafficMix.PROFILES = {
	car = {
		wheelRadius = 0.32,
		gears = { 3.6, 2.1, 1.4, 1.0, 0.8, 0.66 },
		finalDrive = 3.9,
		idleRpm = 800,
		maxRpm = 6000,
		cruiseRpm = 1700, -- the gearbox keeps the engine at least this fast at light load
		pullRpm = 3800, -- and this fast at full load
	},
	truck = {
		wheelRadius = 0.52,
		gears = { 9.5, 6.6, 4.7, 3.4, 2.4, 1.7, 1.3, 1.0 },
		finalDrive = 3.4,
		idleRpm = 600,
		maxRpm = 2100,
		cruiseRpm = 1150,
		pullRpm = 1700,
	},
}

-- Engine speed for a road speed (m/s) and load (0-1): the highest gear that keeps the engine at or
-- above a target speed that rises with load. Returns rpm and gear.
function TrafficMix.engineRpm(profile, speed: number, load: number): (number, number)
	local wheelRpm = math.max(speed, 0) / (2 * math.pi * profile.wheelRadius) * 60
	local want = profile.cruiseRpm + (profile.pullRpm - profile.cruiseRpm) * load
	local gears = profile.gears
	local chosen = 1
	for g = #gears, 1, -1 do
		if wheelRpm * gears[g] * profile.finalDrive >= want then
			chosen = g
			break
		end
	end
	local rpm = wheelRpm * gears[chosen] * profile.finalDrive
	return math.clamp(rpm, profile.idleRpm, profile.maxRpm), chosen
end

-- Load (0-1) from the car's smoothed acceleration (m/s^2): cruising needs some, pulling away more.
function TrafficMix.load(accel: number): number
	return math.clamp(0.3 + accel / 2.0, 0, 1)
end

-- Engine and tyre volumes (before distance) for a road speed, load and engine speed.
function TrafficMix.levels(profile, speed: number, load: number, rpm: number): (number, number)
	local engine = TrafficMix.ENGINE_VOLUME * (0.35 + 0.65 * load) * math.clamp(rpm / profile.pullRpm, 0.2, 1.5) ^ 0.7
	local tyre = TrafficMix.TYRE_VOLUME * math.clamp(speed / 30.5, 0, 1.4) ^ 1.6
	return engine, tyre
end

-- Doppler pitch factor. offset: source position minus listener position (m); velocities in m/s.
function TrafficMix.doppler(offset: Vector3, sourceVel: Vector3, listenerVel: Vector3): number
	local distance = offset.Magnitude
	if distance < 0.01 then
		return 1
	end
	local toListener = -offset / distance
	local c = TrafficMix.SPEED_OF_SOUND
	local approach = math.clamp(sourceVel:Dot(toListener), -0.5 * c, 0.5 * c) -- source moving toward the listener
	local meet = math.clamp(-listenerVel:Dot(toListener), -0.5 * c, 0.5 * c) -- listener moving toward the source
	return math.clamp((c + meet) / (c - approach), 0.5, 2)
end

-- [E] Treble lost to the air (dB for the equaliser's mid and high bands) over a distance in metres.
-- ISO 9613-1 gives roughly 5 dB/km at 1 kHz and 20-80 dB/km at 4-8 kHz (20 C, 70% humidity); these
-- are stronger so that distance reads clearly in a game.
function TrafficMix.airAbsorption(distanceM: number): (number, number)
	return -math.min(distanceM * 0.012, 8), -math.min(distanceM * 0.06, 30)
end

-- Roblox's InverseTapered roll-off (the lesser of inverse and linear-squared). The game doesn't
-- call this (Roblox applies it); the preview does.
function TrafficMix.rollOff(distanceM: number): number
	local near, far = TrafficMix.ROLLOFF_MIN_M, TrafficMix.ROLLOFF_MAX_M
	if distanceM <= near then
		return 1
	end
	if distanceM >= far then
		return 0
	end
	local linear = (far - distanceM) / (far - near)
	return math.min(near / distanceM, linear * linear)
end

return TrafficMix
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX00000031">
<Properties>
<string name="Name">VehicleConfigurations</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000032">
<Properties>
<string name="Name">Prototype812</string>
<ProtectedString name="Source"><![CDATA[--[[
	Valenza GT12 prototype (internal ID: Prototype812)

	An original car built on the publicly documented engineering of the Ferrari 812 Superfast.
	No Ferrari names, logos or designs are used in the game. See docs/PROTOTYPE_GT12.md for
	sources and for how each estimate was made.

	Every value is tagged:
	  [F] factory figure published by Ferrari
	  [P] published figure from third-party spec sheets
	  [E] estimate made for the simulation
	  [A] assumption
	Units: metres, kilograms, newtons, seconds and rpm unless a name says otherwise.

	Positions use the car's own axes: X to the right, Y up, -Z forward (Roblox LookVector).

	docs/VEHICLE_CONFIG.md describes every field, including the optional ones this naturally aspirated,
	dual-clutch, rear-drive car doesn't use (forcedInduction, the automatic's converter and lock-up,
	drivetrain.centreCoupling, tires.compounds, engine.speedLimitKmh).
]]

return {
	id = "Prototype812",
	displayName = "Valenza GT12",
	reference = "Ferrari 812 Superfast (engineering reference only)",

	mass = {
		dryKg = 1525, -- [F]
		kerbKg = 1630, -- [F] DIN kerb weight
		driverKg = 75, -- [A] the simulation carries one driver
		frontShare = 0.47, -- [F] 47% front / 53% rear
		comHeight = 0.45, -- [E] centre of mass above the ground at ride height
		-- [E] Size of the invisible box that carries the car's mass. It sets the rotational
		-- inertia (about 2,600 kg*m^2 in yaw), so it should roughly match where the mass sits.
		inertiaBox = { width = 1.80, height = 0.80, length = 4.00 },
	},

	dimensions = {
		length = 4.657, -- [P]
		width = 1.971, -- [P]
		height = 1.276, -- [P]
		wheelbase = 2.720, -- [P]
		trackFront = 1.672, -- [P]
		trackRear = 1.645, -- [P]
		frontOverhang = 1.000, -- [E] front axle to the nose
	},

	engine = {
		layout = "65-degree V12", -- [F]
		displacementCc = 6496, -- [F]
		aspiration = "NaturallyAspirated", -- [F]
		peakPowerKw = 588, -- [F] 800 CV
		peakPowerRpm = 8500, -- [F]
		peakTorqueNm = 718, -- [F]
		peakTorqueRpm = 7000, -- [F]
		idleRpm = 1000, -- [E]
		limiterRpm = 8900, -- [P] max revs on the 812 GTS spec sheet (same engine)
		limiterHysteresisRpm = 150, -- [E]
		inertia = 0.20, -- [E] kg*m^2 for crank, flywheel and clutch
		-- [E] Full-throttle torque curve, {rpm, Nm}. Anchored to the factory figures:
		-- 718 Nm at 7,000 rpm, 661 Nm at 8,500 rpm (= 588 kW), and Ferrari's claim of
		-- 80% of peak torque available at 3,500 rpm.
		torqueCurve = {
			{ 1000, 330 },
			{ 2000, 450 },
			{ 3000, 540 },
			{ 3500, 574 },
			{ 4500, 620 },
			{ 5500, 665 },
			{ 6500, 705 },
			{ 7000, 718 },
			{ 7500, 712 },
			{ 8000, 690 },
			{ 8500, 661 },
			{ 8900, 625 },
		},
		-- [E] Internal friction, felt as engine braking with the throttle closed: static + perRpm * rpm (Nm).
		-- The torque curve above is net output, so friction isn't subtracted at full throttle.
		friction = { static = 20, perRpm = 0.0085 },
		throttleResponse = 18, -- [E] 1/s, how quickly the throttle follows the pedal
	},

	transmission = {
		type = "DualClutch", -- [F] 7-speed dual-clutch
		-- [E] Ratios fitted so the model reaches the factory 0-100, 0-200 and top speed figures.
		gearRatios = { 2.980, 2.436, 1.992, 1.629, 1.331, 1.089, 0.890 },
		reverseRatio = 2.80, -- [E]
		finalDrive = 4.00, -- [E]
		efficiency = 0.92, -- [E] typical for a dual-clutch gearbox and final drive
		shiftTime = 0.06, -- [E] seconds of reduced torque during a shift
		shiftTorqueFraction = 0.35, -- [E] share of clutch capacity kept during a shift
		clutchMaxTorque = 1100, -- [E] Nm
		clutchStiffness = 400, -- [E] Nm per rad/s of slip, how firmly an engaged clutch couples
		launchRpm = { min = 2200, max = 4500 }, -- [E] engine speed the launch clutch holds, by pedal
		autoUpshiftRpm = { light = 6200, full = 8750 }, -- [E] by pedal position
		autoDownshiftRpm = { light = 2600, full = 5200 }, -- [E] by pedal position
		minShiftInterval = 0.25, -- [E] seconds between shifts
	},

	drivetrain = {
		layout = "RWD", -- [F]
		frontTorqueShare = 0, -- used by AWD layouts (0 to 1)
		-- [E] The real car has an electronic limited-slip differential; this is a clutch-type
		-- approximation: preload in Nm, lock factors as shares of input torque.
		rearDifferential = { type = "LimitedSlip", preload = 120, powerLock = 0.35, coastLock = 0.20, stiffness = 180 },
		frontDifferential = { type = "Open" },
		-- [E] Traction control (the real car has one). It caps engine and clutch torque at headroom
		-- times what the driven tyres can grip, and trims further while they slip more than
		-- targetSlip. rate and recovery are how fast that trim builds and fades (per second).
		tractionControl = { enabled = true, targetSlip = 0.11, rate = 15, recovery = 2, headroom = 1.3 },
	},

	-- [E] Springs and dampers are estimated from target ride frequencies of 1.8 Hz front and
	-- 2.0 Hz rear with damping ratios of about 0.3 in bump and 0.5 in rebound.
	suspension = {
		front = {
			springRate = 51000, -- N/m at the wheel
			bumpDamping = 2700, -- N*s/m
			reboundDamping = 4500, -- N*s/m
			staticLength = 0.25, -- mount to wheel centre at ride height
			bumpTravel = 0.08, -- from ride height
			droopTravel = 0.07, -- from ride height
			bumpStopRate = 250000, -- N/m
			antiRollRate = 32000, -- N/m of left-right travel difference
			rollCenterHeight = 0.06, -- lateral tyre force acts this high above the road
			rideHeightOffset = 0, -- positive raises the car
		},
		rear = {
			springRate = 71000,
			bumpDamping = 3400,
			reboundDamping = 5700,
			staticLength = 0.25,
			bumpTravel = 0.08,
			droopTravel = 0.07,
			bumpStopRate = 250000,
			antiRollRate = 20000,
			rollCenterHeight = 0.10,
			rideHeightOffset = 0,
		},
	},

	tires = {
		front = { widthMm = 275, aspect = 35, rimInches = 20, compound = "Performance", inertia = 1.6 }, -- [P] size, [E] inertia (kg*m^2)
		rear = { widthMm = 315, aspect = 35, rimInches = 20, compound = "Performance", inertia = 2.0 }, -- [P] size, [E] inertia (kg*m^2)
	},

	brakes = {
		discs = "Carbon-ceramic, 398 mm front, 360 mm rear", -- [P]
		maxTorqueFront = 3800, -- [E] Nm per wheel
		maxTorqueRear = 2000, -- [E] Nm per wheel
		handbrakeTorque = 2500, -- [E] Nm per rear wheel
		abs = { enabled = true, targetSlip = 0.12 }, -- [E]
	},

	aero = {
		dragArea = 0.70, -- [E] CdA in m^2, fitted so the car tops out near 340 km/h on its gearing
		downforceAreaFront = 0.18, -- [E] ClA in m^2
		downforceAreaRear = 0.27, -- [E] ClA in m^2
	},

	steering = {
		maxAngleLowSpeed = 30, -- [E] road-wheel degrees when slow
		maxAngleHighSpeed = 4.5, -- [E] road-wheel degrees at highSpeedKmh and above
		highSpeedKmh = 250, -- [E]
		rate = 220, -- [E] degrees per second the road wheels can turn
		ackermann = 0.6, -- [E] 0 = parallel steering, 1 = full Ackermann
	},

	-- [E] Sound. The engine sheet is made from the car's acoustic definition,
	-- assets/audio/engines/Prototype812.json, by tools/synth_audio.py; sheets are regions of packed
	-- sound files (VehicleAudio/Sheets, see docs/AUDIO.md). Volumes are Roblox Sound volumes. The
	-- engine's loudness curve over rpm and load comes from the sheet's per-loop gains (from the
	-- real car's measured sound levels); engineVolume scales all of it. Tuned by ear in testing.
	audio = {
		engineSheet = "GT12_Engine",
		effectsSheet = "Driving_Effects",
		engineVolume = 1.0, -- overall engine level (1 = the sheet's calibrated gains)
		-- used only with a sheet that has no per-loop gains:
		idleLevel = 0.3, -- loudness at idle as a share of engineVolume
		rpmCurve = 1.0, -- how loudness rises with rpm (1 = in proportion)
		redlineRpm = 8900,
		offThrottleLevel = 0.55, -- off-throttle loops relative to on-throttle
		loadAttack = 25, -- 1/s, how fast the mix follows the throttle opening
		loadRelease = 12, -- 1/s, and closing
		minPitch = 0.5,
		maxPitch = 2.0,
		-- rev limiter: the limiter loops take over while the fuel cut keeps coming back
		limiterHold = 0.3, -- s after the last cut before the normal loops return (cuts come about 4 times a second)
		limiterAttack = 40, -- 1/s, how fast the limiter loops come in (about 25 ms)
		limiterRelease = 10, -- 1/s, and go out
		limiterShiftMask = 0.15, -- s: fuel cuts during a gear change and this long after it aren't the limiter
		-- forced induction (only used by turbo or supercharged engine sheets)
		turboVolume = 0.35, -- whistle at full boost
		blowOffVolume = 0.6,
		blowOffMinBoost = 0.35, -- boost (0-1) needed for a blow-off when the throttle shuts
		superchargerVolume = 0.3, -- whine at full boost
		-- optional whine shape (these values are the defaults): the share left with no boost, the
		-- engine speed where the whine reaches full level, and the share left at very low rpm
		superchargerIdleShare = 0.2,
		superchargerFullRpm = 2500,
		superchargerRpmFloor = 0.3,
		shiftCutTime = 0.08, -- seconds of ignition cut heard on a full-throttle upshift
		shiftCutMinRpm = 4500,
		shiftCutVolume = 0.6,
		shiftClunkVolume = 0.25,
		crackleMinRpm = 4000, -- exhaust crackles after lifting off above this
		crackleDuration = 1.2,
		crackleRate = 14, -- crackles per second at first, fading out
		crackleVolume = 0.5,
		bumpMinSpeed = 0.6, -- m/s into the bump stops before a knock is heard
		bumpVolume = 0.5,
		squealVolume = 0.5,
		squealStart = 1.2, -- tyres start to squeal past this multiple of their peak slip
		squealRange = 1.5, -- and reach full volume this much further past it
		roadVolume = 0.35,
		windVolume = 0.5,
		whineVolume = 0.06,
		whineTeeth = 31, -- final drive pinion teeth, sets the gearbox whine pitch
		-- cockpit camera: level changes and an equaliser (dB) for the cabin
		interior = { engine = 0.8, wind = 0.45, road = 1.25, squeal = 0.7, lowGain = 3, midGain = -2, highGain = -12 },
	},

	-- [F] Factory figures the telemetry timer compares against.
	performanceTargets = { zeroTo100 = 2.9, zeroTo200 = 7.9, topSpeedKmh = 340 },

	visual = {
		bodyColor = Color3.fromRGB(150, 12, 18),
		driverSide = "Left", -- [F] left-hand drive
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000033">
<Properties>
<string name="Name">Ref720S</string>
<ProtectedString name="Source"><![CDATA[--[[
	Ashcombe AR-7 (internal ID: Ref720S)

	An original mid-engined two-seat coupe from the fictional British maker Ashcombe, built on the
	publicly documented engineering of the McLaren 720S coupe (2017-2023). No McLaren names, logos
	or designs are used in the game. Sources, estimates and validation: docs/cars/Ref720S.md; the
	research behind them: research_notes/cars/Ref720S.json and .md.

	Every value is tagged:
	  [F] factory figure (McLaren 2017 launch press release, 2021 brochure "Technical Highlights")
	  [P] published third-party figure (spec sheets, US OEM data feeds, Wikipedia, evo)
	  [M] measured in a magazine or independent test
	  [E] estimate made for the simulation (method given here or in the doc)
	  [A] assumption
	Units: metres, kilograms, newtons, seconds and rpm unless a name says otherwise.

	Positions use the car's own axes: X to the right, Y up, -Z forward (Roblox LookVector).

	What the simulation can't represent, and how it is approximated (details in the doc):
	  * the real rev limit is 8,100 rpm in 1st and 2nd and 8,200 rpm above; the game has one limiter,
	    so it uses 8,200 (full-throttle automatic upshifts come at 8,100, the real 1st-2nd limit);
	  * the rear differential is open and McLaren's Brake Steer brakes the spinning rear wheel; this
	    is approximated with a no-preload, power-only limited slip (drivetrain);
	  * the active rear wing (Driver Downforce, DRS and airbrake modes) is one fixed drag area and
	    one fixed downforce area per axle (aero);
	  * Proactive Chassis Control II has no anti-roll bars; its hydraulic roll stiffness is given as
	    anti-roll rates (suspension).
]]

return {
	id = "Ref720S",
	displayName = "Ashcombe AR-7",
	reference = "McLaren 720S (engineering reference only)",

	mass = {
		dryKg = 1322, -- [F] dry, base car (1,283 kg with the lightest options [F])
		kerbKg = 1419, -- [F] DIN kerb weight: fluids and 90% fuel (US curb 1,424 kg with a full tank [F])
		driverKg = 75, -- [A] the simulation carries one driver: 1,494 kg simulated
		frontShare = 0.41, -- [F] 41% front / 59% rear, coupe (Autocar weighed 42/58, AMS 41.5/58.5 [M])
		comHeight = 0.42, -- [E] not published; carbon tub, dry-sump V8 low behind the seats ("3% lower than the 650S" [F])
		-- [E] Box that carries the mass, sized for about 2,150 kg*m^2 in yaw, 460 in roll and 1,810 in
		-- pitch: a dynamic index k^2/(a*b) of about 0.84, typical of a compact mid-engined car (the mass
		-- sits between the axles, so the polar moment is lower than a front-engined GT's).
		inertiaBox = { width = 1.80, height = 0.70, length = 3.75 },
	},

	dimensions = {
		length = 4.543, -- [F]
		width = 1.930, -- [P] body without mirrors (motor1.de, CarExpert); 2,161 mm with mirrors [F]
		height = 1.196, -- [F]
		wheelbase = 2.670, -- [F]
		trackFront = 1.674, -- [F] contact-patch centres
		trackRear = 1.629, -- [F]
		frontOverhang = 1.058, -- [F] (1,058 + 2,670 + 816 mm rear overhang = 4,544 mm)
	},

	engine = {
		layout = "90-degree V8, flat-plane crank, twin-turbo, dry sump (M840T)", -- [F] code and turbos; [P] crank, bank angle
		displacementCc = 3994, -- [F] bore 93.0 mm, stroke 73.5 mm [P]
		aspiration = "Turbo", -- [F] two twin-scroll turbochargers, one per bank
		peakPowerKw = 530, -- [F] 720 PS
		peakPowerRpm = 7500, -- [F] 2017 press release (the 2021 coupe sheet prints 7,250 rpm)
		peakTorqueNm = 770, -- [F]
		peakTorqueRpm = 5500, -- [F]
		idleRpm = 800, -- [E] not published
		-- [F] max revs are 8,100 rpm in 1st and 2nd and 8,200 rpm in 3rd to 7th. One limiter per car in
		-- this simulation, so 8,200.
		limiterRpm = 8200,
		limiterHysteresisRpm = 150, -- [E] research: an ignition cut with about 100-150 rpm of bounce
		-- [E] kg*m^2: crank, flywheel and the dual-clutch's input side. "Stiffer, lighter crankshaft",
		-- lighter pistons and rods [F]: under the GT12's V12 (0.20). (0.13 was tried: 0.02 s quicker.)
		inertia = 0.15,
		-- Full-BOOST torque curve, {rpm, Nm} (docs/VEHICLE_CONFIG.md, "Turbo and supercharger torque
		-- curves"). With forcedInduction below, the steady full-throttle curve the game produces passes
		-- exactly through the research curve at every point listed: an estimate [E] shaped through
		-- McLaren's two figures, 770 Nm at 5,500 rpm and 530 kW at 7,500 rpm (675 Nm) [F]. Below
		-- 5,000 rpm each value is research / (0.39 + 0.61 x boost ceiling); the mid-range bulge (up to
		-- 863 Nm) is torque the calibration holds back by ramping boost through the mid-range (evo: "a
		-- real build-up of boost through the mid-range"; tuners gain most near 3,700 rpm).
		torqueCurve = {
			{ 800, 667 }, -- [E] x 0.390 = 260 Nm (no boost)
			{ 1000, 769 }, -- [E] x 0.390 = 300 Nm (no boost: sets offBoostTorqueShare)
			{ 1500, 772 }, -- [E] x 0.466 = 360 Nm
			{ 2000, 793 }, -- [E] x 0.543 = 430 Nm
			{ 2500, 840 }, -- [E] x 0.619 = 520 Nm
			{ 3000, 863 }, -- [E] x 0.695 = 600 Nm
			{ 3500, 862 }, -- [E] x 0.771 = 665 Nm
			{ 4000, 838 }, -- [E] x 0.848 = 710 Nm
			{ 4500, 803 }, -- [E] x 0.924 = 742 Nm
			{ 5000, 762 }, -- [E] full boost from here: steady = curve
			{ 5500, 770 }, -- [F] peak torque
			{ 6000, 763 }, -- [E]
			{ 6500, 746 }, -- [E]
			{ 7000, 713 }, -- [E]
			{ 7500, 675 }, -- [F] 530 kW peak power
			{ 8000, 628 }, -- [E]
			{ 8200, 605 }, -- [E] at the limiter (520 kW)
		},
		-- [E] Engine braking with the throttle shut: static + perRpm * rpm (Nm), about 24 Nm at 800 rpm
		-- and 90 Nm at 8,000 rpm (friction mean effective pressure of about 2.8 bar at 8,000 rpm on 4.0 L).
		friction = { static = 17, perRpm = 0.0091 },
		throttleResponse = 18, -- [E] 1/s, drive-by-wire throttle; the lag is in the turbos
		forcedInduction = {
			type = "Turbo", -- [F] two twin-scroll, low-inertia turbos (titanium-aluminide turbines)
			maxBoostBar = 1.3, -- [P] "over 1.3 bar" (Wikipedia, uncited); gauge and sound only
			-- [E] 300 Nm at 1,000 rpm with no boost / 770 Nm (the research curve at 1,000 rpm against the
			-- peak); 1 / (1 + 1.3 bar) = 0.43 by pressure ratio agrees roughly
			offBoostTorqueShare = 0.39,
			-- [E] The research curve is already 430 Nm (56% of peak) at 2,000 rpm, well above the ~300 Nm
			-- the engine makes with no boost, so in this model boost starts building above 1,000 rpm; the
			-- research's "boost onset about 2,000 rpm" is where the build becomes strong.
			boostStartRpm = 1000,
			fullBoostRpm = 5000, -- [E] research: full boost about 5,000 rpm, torque peak at 5,500
			-- [E] "Ultra-low-inertia" twin-scroll turbos [F]: the quick end of the 0.8-1.0 s starting range.
			-- Floored at 3,800 rpm in 3rd, 90% boost comes after about 1.3 s; at 6,600 rpm, 0.7 s.
			spoolTime = 0.8,
			dumpTime = 0.15, -- [E] electronically controlled dump valve [F] releases boost quickly
		},
	},

	transmission = {
		type = "DualClutch", -- [F] 7-speed Seamless Shift Gearbox (SSG), dual-clutch (Graziano [P])
		gearRatios = { 3.98, 2.61, 1.91, 1.48, 1.16, 0.91, 0.69 }, -- [P] US OEM data (carspecs.us, Motor Matchup)
		reverseRatio = 2.80, -- [P]
		finalDrive = 3.30, -- [P] (the 750S's is 15% shorter [P])
		efficiency = 0.92, -- [E] typical for a dual-clutch gearbox and final drive
		shiftTime = 0.05, -- [E] not published; ignition-cut shifts [F]
		-- [E] Share of clutch capacity kept during a shift, as the GT12. Known artefact (reported as a
		-- shared-code problem, docs/cars/Ref720S.md): 0.35 x 1,150 = 400 Nm is less than this engine's
		-- 620-770 Nm, so each full-throttle upshift flares about 200 rpm into the limiter, whose cut closes
		-- the throttle and dumps about half the boost. A real ignition-cut upshift keeps the boost. At 0.6
		-- the flare and the dump go away, but 0-200 km/h then runs 0.3 s under McLaren's figure.
		shiftTorqueFraction = 0.35,
		clutchMaxTorque = 1150, -- [E] Nm, about 1.5 x peak torque
		clutchStiffness = 400, -- [E] Nm per rad/s of slip
		-- [E] engine speed the launch clutch holds, by pedal. Launch control [F]; its rpm isn't published
		-- (research: about 3,500, likely 3,000-4,000).
		launchRpm = { min = 2200, max = 3500 },
		-- [E] Full-throttle upshifts at 8,100 rpm: the real 1st-2nd limit, 100 rpm under the 8,200 limiter.
		-- 7th is an overdrive: the car tops out in 6th at about 7,970 rpm (research: 341 km/h at the end of
		-- 6th), so 8,100 leaves a margin against an upshift into 7th, where it would top out near 331 km/h.
		autoUpshiftRpm = { light = 3500, full = 8100 },
		autoDownshiftRpm = { light = 1500, full = 4900 }, -- [E]
		minShiftInterval = 0.25, -- [E] seconds between shifts
	},

	drivetrain = {
		layout = "RWD", -- [F]
		frontTorqueShare = 0, -- used by AWD layouts (0 to 1)
		-- [E] The real car has an OPEN rear differential [P, evo]; McLaren's Brake Steer brakes the
		-- spinning or inside rear wheel to give a limited-slip effect [F]. The simulation has no brake-
		-- based torque vectoring, so the nearest honest stand-in is a clutch-type limited slip with no
		-- preload and no coast locking (Brake Steer acts only when a wheel spins under power) and a
		-- modest power lock. Unlike Brake Steer it wastes no energy as brake heat, and it can't add yaw
		-- on turn-in by braking the inside rear wheel as Brake Steer does.
		rearDifferential = { type = "LimitedSlip", preload = 0, powerLock = 0.25, coastLock = 0, stiffness = 150 },
		frontDifferential = { type = "Open" }, -- undriven
		-- [E] Traction control (ESC with Variable Drift Control [F]; launch control [F]). It caps engine
		-- and clutch torque at headroom times what the driven tyres can grip, and trims further while they
		-- slip more than targetSlip. rate and recovery are how fast that trim builds and fades (per second).
		-- headroom 1.3 tested best of 1.15-1.5 (the cap must also cover spinning up the engine and wheels
		-- in 1st). recovery 8 (the GT12 uses 2): the trim fades in about 0.12 s, like a modern launch and
		-- traction system; at 2 a single wheelspin spike at launch held the car back for half a second and
		-- 0-100 km/h swung between 3.0 and 3.3 s with small changes to grip or launch rpm.
		tractionControl = { enabled = true, targetSlip = 0.11, rate = 15, recovery = 8, headroom = 1.3 },
	},

	-- [E] Proactive Chassis Control II: adaptive dampers hydraulically interlinked at each corner and NO
	-- anti-roll bars [F]. Springs from ride frequencies of 1.6 Hz front and 1.8 Hz rear (research) with
	-- the game's whole corner mass on the springs (306 kg front, 441 kg rear); damping ratios of about
	-- 0.3 in bump and 0.5 in rebound; the anti-roll rates stand in for PCC II's hydraulic roll
	-- stiffness (research: about 25,000 and 18,000 N/m), about 1.2 degrees of roll per g.
	suspension = {
		front = {
			springRate = 31000, -- N/m at the wheel
			bumpDamping = 1850, -- N*s/m
			reboundDamping = 3100, -- N*s/m
			staticLength = 0.25, -- mount to wheel centre at ride height
			bumpTravel = 0.08, -- from ride height
			droopTravel = 0.07, -- from ride height
			bumpStopRate = 250000, -- N/m
			antiRollRate = 25000, -- N/m of left-right travel difference
			rollCenterHeight = 0.06, -- aluminium double wishbones [F]
			rideHeightOffset = 0, -- positive raises the car
		},
		rear = {
			springRate = 56400,
			bumpDamping = 3000,
			reboundDamping = 5000,
			staticLength = 0.25,
			bumpTravel = 0.08,
			droopTravel = 0.07,
			bumpStopRate = 250000,
			antiRollRate = 18000,
			rollCenterHeight = 0.09, -- double wishbones [F]
			rideHeightOffset = 0,
		},
	},

	tires = {
		-- [E] The car's own compounds (engineering references only). AR7Road is the standard tyre, a
		-- McLaren-specific Pirelli P Zero in the real car [F/P]: a road performance tyre. Its braking/
		-- driving grip is 1.42, a little under the shared Performance compound's 1.45, because the model
		-- stops shorter than the real car (doc: Braking); 1.42 trades about 0.05 s of 0-100 km/h for
		-- 0.6 m of 100-0 km/h braking (1.40-1.45 tested). AR7Track is the optional P Zero Corsa class [F],
		-- which McLaren says gives "six percent more mechanical grip" than the 650S had: about 6% more
		-- grip here. Not fitted by default.
		compounds = {
			AR7Road = { base = "Performance", muLong = 1.42, muLat = 1.22 },
			AR7Track = { base = "Performance", muLong = 1.54, muLat = 1.29, peakSlipRatio = 0.095, peakSlipAngle = 7.0, relaxationLength = 0.22 },
		},
		front = { widthMm = 245, aspect = 35, rimInches = 19, compound = "AR7Road", inertia = 1.35 }, -- [F] 245/35 ZR19 on 19 x 9.0J forged; [E] inertia (kg*m^2)
		rear = { widthMm = 305, aspect = 30, rimInches = 20, compound = "AR7Road", inertia = 1.75 }, -- [F] 305/30 ZR20 on 20 x 11.0J forged; [E] inertia
	},

	brakes = {
		discs = "Carbon-ceramic, 390 mm front with 6-piston calipers, 380 mm rear with 4-piston calipers", -- [F]
		maxTorqueFront = 2800, -- [E] Nm per wheel, enough to lock the fronts at about 1.4 g (research)
		maxTorqueRear = 1800, -- [E] Nm per wheel (about 61% front)
		handbrakeTorque = 2200, -- [E] Nm per rear wheel
		abs = { enabled = true, targetSlip = 0.12 }, -- [E]
	},

	aero = {
		-- [E] CdA in m^2. McLaren publishes no Cd. Fitted so the car tops out at the factory 341 km/h in
		-- 6th, below the upshift point (7th is an overdrive), on the factory power: 341 km/h at about
		-- 7,970 rpm. It lumps in the partly deployed rear wing and cooling drag (Cd about 0.47 on an
		-- estimated 1.85 m^2). The research's 0.85-0.91 used a 0.335 m rolling radius; the game uses the
		-- unloaded radius from the tyre size.
		dragArea = 0.875,
		-- [E] ClA in m^2. McLaren gives downforce only relative to the 650S: about 50% more [F]. The 675LT
		-- has 40% more than the 650S and the 675LT-based MSO HS makes 220 kg at 241 km/h [P], so the
		-- 650S makes at most about 157 kg there and the 720S at most about 235 kg (ClA 0.84). Taken as
		-- about 195 kg at 241 km/h (ClA 0.70), 36% on the front axle like the research's split.
		downforceAreaFront = 0.25,
		downforceAreaRear = 0.45,
	},

	steering = {
		maxAngleLowSpeed = 30, -- [E] mean road-wheel lock from the 12.4 m turning circle [F] (inner 34, outer 25.5)
		maxAngleHighSpeed = 4.5, -- [E] road-wheel degrees at highSpeedKmh and above
		highSpeedKmh = 250, -- [E]
		rate = 220, -- [E] degrees per second the road wheels can turn (2.46 turns lock to lock [F])
		ackermann = 0.6, -- [E] 0 = parallel steering, 1 = full Ackermann
	},

	-- [E] Sound. The engine sheet is made from the car's acoustic definition,
	-- assets/audio/engines/Ref720S.json (firing order 1-8-3-6-4-5-2-7, flat-plane crank, each bank into
	-- its own twin-scroll turbo, then catalysts and one silencer to two high centre tailpipes), by
	-- tools/synth_audio.py; see docs/AUDIO.md. Its per-loop gains follow the car's measured cabin level
	-- (Car and Driver: 95 dBA at full throttle [M]); engineVolume scales all of it. The rev limiter is
	-- heard through the sheet's baked limiter loops (ignition cut, 8,200 rpm). Tune by ear in testing.
	audio = {
		engineSheet = "Ref720S_Engine",
		effectsSheet = "Driving_Effects",
		engineVolume = 1.0, -- overall engine level (1 = the sheet's calibrated gains)
		-- used only with a sheet that has no per-loop gains:
		idleLevel = 0.3,
		rpmCurve = 1.0,
		redlineRpm = 8200, -- [F] 3rd-7th (8,100 in 1st-2nd)
		offThrottleLevel = 0.55,
		loadAttack = 25, -- 1/s, how fast the mix follows the throttle opening
		loadRelease = 12, -- 1/s, and closing
		minPitch = 0.5,
		maxPitch = 2.0,
		-- rev limiter: the limiter loops take over while the cut keeps coming back
		limiterHold = 0.3, -- s after the last cut (the simulation cuts about 4.5 times a second)
		limiterAttack = 40, -- 1/s, about 25 ms
		limiterRelease = 10,
		-- [E] Turbo whistle at full boost, about 12 dB (A-weighted) under the engine: clearly there, as in
		-- evo's "rushing whoosh of the turbochargers" and Autocar's "whoosh and fizz", without screaming
		-- over the exhaust (0.42 measured only 3-7 dB under it). Pitch rises with boost (shaft speed).
		turboVolume = 0.16,
		-- [A] Lift-off flutter (the sheet's blow-off one-shots are the "flutter" kind): wastegate and
		-- dump-valve chatter when the throttle shuts on boost. Not described by the sources read.
		blowOffVolume = 0.85, -- the flutter is short chuffs (RMS about 1/20 of its peak): 0.5 was barely above coasting
		blowOffMinBoost = 0.4, -- boost (0-1) needed for the flutter when the throttle shuts
		superchargerVolume = 0, -- no supercharger
		-- [E] Ignition-cut upshifts [F]: a short crack on full-throttle upshifts, as long as the shift.
		shiftCutTime = 0.05,
		shiftCutMinRpm = 4500,
		shiftCutVolume = 0.6,
		shiftClunkVolume = 0.2,
		-- [A] Overrun crackle: light, the stock car is described as muted (research: light crackle in
		-- Sport and Track, little in Comfort; crackles from about 4,000 rpm).
		crackleMinRpm = 4000,
		crackleDuration = 0.8,
		crackleRate = 8,
		crackleVolume = 0.3,
		bumpMinSpeed = 0.6, -- m/s into the bump stops before a knock is heard
		bumpVolume = 0.5,
		squealVolume = 0.5,
		squealStart = 1.2,
		squealRange = 1.5,
		roadVolume = 0.35,
		windVolume = 0.5,
		whineVolume = 0.05,
		whineTeeth = 10, -- [E] final drive pinion teeth (10:33 gives the 3.30 final drive [P]); sets the whine pitch
		-- [E] cockpit camera: the engine and its intake plenum sit right behind the cabin's rear glass,
		-- so more engine and less treble cut than the front-engined GT12
		interior = { engine = 0.9, wind = 0.4, road = 1.2, squeal = 0.7, lowGain = 3, midGain = 0, highGain = -9 },
	},

	performanceTargets = {
		zeroTo60Mph = 2.8, -- [F] McLaren (taken as from a standstill [A])
		zeroTo60MphRollout = 2.7, -- [M] Car and Driver and Road & Track, 2018 coupe, 1-ft rollout (Motor Trend 2.5 s)
		zeroTo100 = 2.9, -- [F] McLaren (AMS 2.8 s, Motoring SA 2.85 s [M])
		zeroTo100Mph = 5.6, -- [M] Autocar 2017, two people and a full tank (C/D Spider 5.5 s, DragTimes 5.2 s)
		zeroTo200 = 7.8, -- [F] McLaren (AMS 7.4 s, Autozeitung 7.1 s [M])
		quarterMile = 10.3, -- [F] McLaren (C/D 10.2 s, MT 10.1 s, R&T 9.9 s with rollout; Autocar 10.4 s [M])
		quarterMileKmh = 233.4, -- [M] Car and Driver 2018: 145 mph (MT 141.5 mph, R&T 148.2 mph)
		topSpeedKmh = 341, -- [F] 212 mph
		brake100To0 = 30, -- [F] McLaren (AMS 33.2 m from cold [M])
		brake70MphTo0 = 39.9, -- [M] Autocar 2017 (C/D 2019 Spider: 141 ft = 43.0 m)
	},

	visual = {
		bodyColor = Color3.fromRGB(230, 90, 20), -- [A] approximation of Azores, an orange launch colour
		driverSide = "Left", -- [A] left-hand drive (EU and US cars; right-hand drive was also built)
		-- [E] Side profile judged from near-profile photos (research, about +/-0.03 of length), placed on
		-- the published axles (0.233 and 0.821 of the length [F]). Highest point = published height.
		-- Cab forward: the windscreen starts just behind the front wheels and the roof peaks over the
		-- seats; the glass canopy sweeps down into a low engine cover ("the rear 145 mm lower than the
		-- 650S's" [F]), ending in a short tail with the wing as its trailing edge.
		blockout = {
			profile = {
				{ 0.000, 0.46 }, -- nose
				{ 0.030, 0.56 },
				{ 0.120, 0.63 },
				{ 0.233, 0.69 }, -- front axle: wing crowns
				{ 0.310, 0.84 }, -- windscreen base
				{ 0.400, 1.12 },
				{ 0.470, 1.185 },
				{ 0.520, 1.196 }, -- roof peak, over the seats: published height [F]
				{ 0.600, 1.15 },
				{ 0.700, 1.00 }, -- the glass canopy ends on the engine cover
				{ 0.821, 0.95 }, -- rear axle
				{ 0.940, 0.93 },
				{ 0.975, 0.98 }, -- wing lip
				{ 1.000, 0.92 },
			},
			greenhouse = { 0.31, 0.70 },
			-- The builder draws the lower body as one box up to the beltline, so the beltline is also the
			-- height of the nose and tail. The real window line is about 0.80 m (research); 0.62 keeps the
			-- nose low like the real car's (0.5-0.7 m), at the cost of side glass that looks taller.
			beltline = 0.62,
			cabinWidth = 0.68, -- narrow teardrop canopy on a 1.93 m body
			sill = 0.107, -- [F] ground clearance 107 mm
		},
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000034">
<Properties>
<string name="Name">RefC8Stingray</string>
<ProtectedString name="Source"><![CDATA[--[[
	Ridgeway Halcyon S (internal ID: RefC8Stingray)

	An original mid-engined American sports coupe from the fictional maker Ridgeway, built to the
	publicly documented engineering of the Chevrolet Corvette Stingray coupe (C8, 2020-2026, LT2 engine)
	with the Z51 Performance Package. No Chevrolet or Corvette names, badges or body design are used in
	the game; real names appear only in this header, `reference` and the docs, as engineering
	references. Spec sheet, sources and validation: docs/cars/RefC8Stingray.md. Research notes:
	research_notes/cars/RefC8Stingray.json and .md (source ids S01-S41 below refer to them).

	Every value is tagged:
	  [F] manufacturer figure (GM, Tremec)
	  [P] published third-party figure (spec sheets, magazines' data pages, engineering articles)
	  [M] measured in a magazine or independent test, or read from GM's published chart
	  [E] estimate made for the simulation (method in the comment or the spec sheet)
	  [A] assumption
	Units: metres, kilograms, newtons, seconds and rpm unless a name says otherwise.
	Positions use the car's own axes: X to the right, Y up, -Z forward (Roblox LookVector).

	Not used by this naturally aspirated, dual-clutch, rear-drive car: engine.forcedInduction,
	engine.speedLimitKmh (the Z51 car is drag-limited at 184 mph), the automatic's converter and
	lock-up, drivetrain.centreCoupling.
]]

return {
	id = "RefC8Stingray",
	displayName = "Ridgeway Halcyon S",
	reference = "Chevrolet Corvette Stingray Z51 (C8) (engineering reference only)",

	mass = {
		dryKg = 1530, -- [F] GM dry weight, no fluids (S01)
		kerbKg = 1654, -- [M] Car and Driver's Z51 3LT test car with Magnetic Ride, US curb (full fluids, no driver), Oct 2019 (S13); GM's 1LT coupe without Z51 is 1,603 kg [P] (S31)
		driverKg = 75, -- [A] the simulation carries one driver
		frontShare = 0.394, -- [M] 39.4 / 60.6 measured by Car and Driver on the same car (S13); 40 / 60 in a leaked GM document [P] (S32)
		comHeight = 0.44, -- [E] not published; about 0.36 of the 1.234 m roof, as the GT12's estimate, with the dry-sump V8 mounted low (crank below the half-shafts, S07)
		-- [E] Size of the invisible box that carries the mass. It sets rotational inertia: about 2,550 kg*m^2
		-- in yaw, a radius of gyration of 1.21 m, whose square is 0.83 of (front axle to CoM x CoM to rear
		-- axle): a mid-engine car's mass sits nearer the middle than the GT12's (2,700 kg*m^2).
		inertiaBox = { width = 1.80, height = 0.70, length = 3.80 },
	},

	dimensions = {
		length = 4.630, -- [F] 182.3 in (S01); EU sheets 4,634 mm
		width = 1.934, -- [F] without mirrors (S01); 2,025 mm with mirrors
		height = 1.234, -- [F] 48.6 in (S01)
		wheelbase = 2.722, -- [F] 107.2 in (S01)
		trackFront = 1.648, -- [F] (S01)
		trackRear = 1.586, -- [F] (S01)
		frontOverhang = 0.850, -- [E] front axle to the nose, from two 3/4 photos averaged, +/-0.08 m (S36); leaves a 1.058 m rear overhang
	},

	engine = {
		layout = "90-degree V8, cross-plane crank, pushrod, 2 valves per cylinder, dry sump", -- [F] GM LT2 (S01, S07)
		displacementCc = 6162, -- [F] 6.2 L, 103.25 mm bore x 92.0 mm stroke (S01, S19)
		aspiration = "NaturallyAspirated", -- [F]
		peakPowerKw = 369, -- [F] 495 hp SAE J1349 with the Z51's NPP performance exhaust (S03)
		peakPowerRpm = 6450, -- [F] (S01, S03)
		peakTorqueNm = 637, -- [F] 470 lb-ft with NPP (S01)
		peakTorqueRpm = 5150, -- [F] (S01)
		idleRpm = 600, -- [E] not published; typical Gen V warm idle 550-650 rpm (research note)
		limiterRpm = 6600, -- [P] fuel-cut "Engine Overspeed Protection" at about 6,600 rpm in manual mode (S27); GM's torque chart ends at about 6,620 rpm (S12)
		limiterHysteresisRpm = 120, -- [E] the cut's bounce depth is undocumented; the research suggests a hard cut with a 100-150 rpm bounce
		inertia = 0.18, -- [E] kg*m^2: forged steel crank (about 0.045), damper (0.015), flexplate and torsional damper (0.05), the DCT's outer clutch drum (0.05), rods and pistons (0.015)
		-- [M] Full-throttle crank torque, {rpm, Nm}: GM's published LT2 chart (S12) read by pixel
		-- extraction, +/-4 Nm, SAE-rated with the NPP exhaust. The 5,150 and 6,450 rpm points are pinned
		-- to GM's 637 Nm and 495 hp (546 Nm = 369 kW) [F]. GM's chart ends at the 6,600 rpm cut.
		torqueCurve = {
			{ 1000, 433 }, -- [M] 319 lb-ft
			{ 1500, 491 }, -- [M] 362 lb-ft
			{ 2000, 530 }, -- [M] 391 lb-ft
			{ 2500, 545 }, -- [M] 402 lb-ft
			{ 3000, 553 }, -- [M] 408 lb-ft
			{ 3500, 567 }, -- [M] 418 lb-ft
			{ 4000, 599 }, -- [M] 442 lb-ft
			{ 4500, 624 }, -- [M] 460 lb-ft
			{ 5000, 630 }, -- [M] 465 lb-ft
			{ 5150, 637 }, -- [F] peak torque, 470 lb-ft
			{ 5500, 616 }, -- [M] 454 lb-ft
			{ 6000, 580 }, -- [M] 428 lb-ft
			{ 6450, 546 }, -- [F] peak power, 495 hp
			{ 6500, 538 }, -- [M] 397 lb-ft
			{ 6600, 525 }, -- [M] 387 lb-ft, end of GM's chart
		},
		-- [E] Closed-throttle engine braking, static + perRpm * rpm (Nm): a 6.2 L two-valve V8's friction
		-- (about 1.5-2 bar FMEP) plus pumping against a shut throttle, about 60 Nm at 3,000 rpm and 100 Nm
		-- at 6,000. The torque curve is net output, so friction isn't subtracted at full throttle.
		friction = { static = 25, perRpm = 0.0125 },
		throttleResponse = 16, -- [E] 1/s: one 87 mm drive-by-wire throttle feeding a plenum (S07, S08)
	},

	transmission = {
		type = "DualClutch", -- [F] Tremec TR-9080 (GM RPO M1L) 8-speed dual-clutch transaxle (S04)
		gearRatios = { 2.91, 1.76, 1.22, 0.88, 0.65, 0.51, 0.40, 0.33 }, -- [F] (S02, S05, S06)
		reverseRatio = 2.63, -- [F] (S02)
		finalDrive = 5.17, -- [F] Z51 with eLSD: 1.4545 transfer gear x 3.55 ring and pinion (S04); 4.89 without Z51
		efficiency = 0.88, -- [E] DCT transaxle with a transfer gear; stock Z51 cars read 424-429 whp on wheel dynos, 86-87% of 495 hp including tyre losses (S28, S39)
		shiftTime = 0.10, -- [F] upshift clutch overlap "lasts 100 milliseconds" with no torque interruption (S04)
		-- [E] share of clutch capacity kept during a shift. GM/Tremec: the oncoming clutch takes over with
		-- "no interruption of torque delivery" [F] (S04), so it keeps about the engine's full torque
		-- (0.65 x 950 Nm = 620 Nm). The GT12's 0.35 lets the engine flare into the fuel cut on every
		-- full-throttle upshift (6,690 rpm on this car), which the real gearbox doesn't do.
		shiftTorqueFraction = 0.65,
		clutchMaxTorque = 950, -- [E] Nm, about 1.5 x peak torque; the gearbox's 800 Nm input rating [F] (S04) is a design rating, not the clutch's slip capacity
		clutchStiffness = 400, -- [E] Nm per rad/s of slip, how firmly an engaged clutch couples
		launchRpm = { min = 1600, max = 3500 }, -- [F] max: launch control holds 3,500 rpm (S03, S04); [E] min: a light-pedal pull-away
		autoUpshiftRpm = { light = 2000, full = 6450 }, -- [E] by pedal: early shifts in Tour (70 mph in 8th is about 1,500 rpm); full throttle at peak power
		autoDownshiftRpm = { light = 1100, full = 3600 }, -- [E] by pedal
		minShiftInterval = 0.25, -- [E] seconds between shifts
	},

	drivetrain = {
		layout = "RWD", -- [F] mid-engine, rear-wheel drive (S10)
		frontTorqueShare = 0, -- [F] rear-wheel drive: nothing to the front (the field is used by AWD layouts)
		-- [E] The Z51's electronic limited-slip differential (a clutch pack modulated from open to locked,
		-- S04) as a clutch-type LSD; GM's calibration isn't published. Values from the research note.
		rearDifferential = { type = "LimitedSlip", preload = 100, powerLock = 0.45, coastLock = 0.30, stiffness = 180 },
		frontDifferential = { type = "Open" }, -- [F] the front axle isn't driven
		-- [E] Traction control (the real car has Performance Traction Management): caps engine and clutch
		-- torque at headroom times what the driven tyres can grip, and trims while they slip past targetSlip.
		-- headroom: 1.3 to 2.0 were tried; launch times moved by under 0.05 s (spec sheet), so it stays at 1.3.
		tractionControl = { enabled = true, targetSlip = 0.11, rate = 15, recovery = 2, headroom = 1.3 },
	},

	-- [E] Not published. Springs from ride frequencies of 1.7 Hz front and 1.9 Hz rear (Z51 springs are
	-- stiffer than the base car's, S10; reviewers praise the ride), at corner masses of 341 and 524 kg.
	-- Dampers at about 0.3 of critical in bump and 0.5 in rebound. Anti-roll bars give the front axle about
	-- 52% of the roll stiffness against its 39% of the weight (about 1.4 degrees of roll per g); with the
	-- tyres' nominal loads below, a steady-state estimate puts the car at neutral on the limit. The real
	-- car has SLA double wishbones and 46 mm monotube coil-overs at both ends [F] (S01).
	suspension = {
		front = {
			springRate = 38900, -- [E] N/m at the wheel, 1.7 Hz
			bumpDamping = 2200, -- [E] N*s/m
			reboundDamping = 3640, -- [E] N*s/m
			staticLength = 0.25, -- [E] mount to wheel centre at ride height
			bumpTravel = 0.07, -- [E] from ride height (the real car offers a front lift for kerbs, S10)
			droopTravel = 0.07, -- [E]
			bumpStopRate = 250000, -- [E] N/m
			antiRollRate = 30000, -- [E] N/m of left-right travel difference
			rollCenterHeight = 0.05, -- [E] SLA double wishbone
			rideHeightOffset = 0, -- [E] positive raises the car
		},
		rear = {
			springRate = 74700, -- [E] 1.9 Hz
			bumpDamping = 3750, -- [E]
			reboundDamping = 6250, -- [E]
			staticLength = 0.25, -- [E]
			bumpTravel = 0.08, -- [E]
			droopTravel = 0.07, -- [E]
			bumpStopRate = 250000, -- [E]
			antiRollRate = 12000, -- [E]
			rollCenterHeight = 0.09, -- [E]
			rideHeightOffset = 0, -- [E]
		},
	},

	tires = {
		compounds = {
			-- [E] The Z51's tyre: a max-performance summer road tyre in the Michelin Pilot Sport 4S class,
			-- GM "TPC" spec [F] (S01, S19), ZP run-flat per Car and Driver's data panel [P] (engineering
			-- reference only). muLong 1.25 [E, tuned]: the model then matches Motor Trend's 97 ft 60-0 mph
			-- (S18) and Car and Driver's 3.5 s rolling 5-60 mph; Car and Driver's 149 ft 70-0 mph would need
			-- 1.10 (spec sheet). muLat 1.06 [E, tuned]: a steady 1.036 g on a skidpad, against the measured
			-- 1.03 g (S13) and 1.04 g (S18).
			-- nominalLoad [E] scales with each size's load index, 89 and 99 (580 and 775 kg, Car and Driver's
			-- data panel): the game's tyre has no width, and this is what makes the wide rear tyre carry its
			-- 61% of the weight without letting go first (neutral balance at the limit).
			RoadPerformance = { base = "Performance", muLong = 1.25, muLat = 1.06, nominalLoad = 3770 },
			RoadPerformanceRear = { base = "RoadPerformance", nominalLoad = 5030 },
		},
		front = { widthMm = 245, aspect = 35, rimInches = 19, compound = "RoadPerformance", inertia = 1.5 }, -- [F] 245/35ZR19 on 19 x 8.5 (S01); [E] inertia, wheel, tyre and 345 mm iron disc (kg*m^2)
		rear = { widthMm = 305, aspect = 30, rimInches = 20, compound = "RoadPerformanceRear", inertia = 2.1 }, -- [F] 305/30ZR20 on 20 x 11 (S01); [E] inertia, wheel, tyre and 350 mm iron disc
	},

	brakes = {
		discs = "Iron, ventilated: 345 x 30 mm front, 350 x 27 mm rear; Brembo 4-piston monobloc calipers; eBoost electric booster", -- [F] Z51 (S01, S29)
		maxTorqueFront = 3000, -- [E] Nm per wheel, about 1.5 x what locks a front wheel at 1.25 g
		maxTorqueRear = 2100, -- [E] Nm per wheel; 59% front bias, near the 57% ideal for a 39/61 car
		handbrakeTorque = 2000, -- [E] Nm per rear wheel (electric parking brake)
		abs = { enabled = true, targetSlip = 0.12 }, -- [E]
	},

	aero = {
		dragArea = 0.88, -- [E, tuned] CdA in m^2, fitted so the car's drag-limited top speed is the factory 296 km/h (184 mph), in 6th at 6,060 rpm; GM publishes no Cd (a forum 0.322 is unverified, S30)
		-- [E] ClA in m^2: the Z51 splitter and spoiler add 400 lb (1,779 N) of downforce [F] (S22), taken
		-- at 184 mph, split 40 / 60 with the weight; the base car's own lift is taken as zero [A].
		downforceAreaFront = 0.175, -- [E]
		downforceAreaRear = 0.263, -- [E]
	},

	steering = {
		maxAngleLowSpeed = 31, -- [E] road-wheel degrees when slow: with ackermann 0.6 the outer front tyre then traces the factory 11.6 m kerb-to-kerb turning circle [F] (S01)
		maxAngleHighSpeed = 4.5, -- [E] at highSpeedKmh and above, keyboard-friendly as the GT12
		highSpeedKmh = 250, -- [E]
		rate = 220, -- [E] degrees per second the road wheels can turn
		ackermann = 0.6, -- [E] 0 = parallel steering, 1 = full Ackermann
	},

	-- Sound. The engine sheet is made from the car's acoustic definition,
	-- assets/audio/engines/RefC8Stingray.json, by tools/synth_audio.py (docs/AUDIO.md). The loudness
	-- over rpm and load comes from the sheet's per-loop gains, calibrated to Car and Driver's measured
	-- 47 / 92 dBA (idle / full throttle). Values are [E] unless tagged, tuned from the research notes.
	audio = {
		engineSheet = "RefC8Stingray_Engine",
		effectsSheet = "Driving_Effects",
		engineVolume = 1.0, -- overall engine level (1 = the sheet's calibrated gains)
		-- used only with a sheet that has no per-loop gains:
		idleLevel = 0.3,
		rpmCurve = 1.0,
		redlineRpm = 6600, -- [P] fuel cut (S27)
		offThrottleLevel = 0.55,
		loadAttack = 25, -- 1/s, how fast the mix follows the throttle opening
		loadRelease = 12, -- 1/s, and closing
		minPitch = 0.5,
		maxPitch = 2.0,
		-- rev limiter: the limiter loops take over while the fuel cut keeps coming back
		limiterHold = 0.35, -- s after the last cut before the normal loops return: the cuts come every 0.20-0.27 s on this car (drivetrain model)
		limiterAttack = 40, -- 1/s, about 25 ms
		limiterRelease = 10, -- 1/s
		-- forced induction: not used by this naturally aspirated engine
		turboVolume = 0,
		blowOffVolume = 0,
		blowOffMinBoost = 0.35,
		superchargerVolume = 0,
		-- DCT upshifts hand torque over with no interruption (S04), so the shift cut is short and soft
		shiftCutTime = 0.05,
		shiftCutMinRpm = 4000,
		shiftCutVolume = 0.35,
		shiftClunkVolume = 0.2,
		-- overrun: no factory crackle map; owners call the stock NPP exhaust "not very aggressive even in
		-- Track" (S26), so a few short, quiet pops after a high-rpm lift
		crackleMinRpm = 3500,
		crackleDuration = 0.5,
		crackleRate = 6,
		crackleVolume = 0.3,
		bumpMinSpeed = 0.6, -- m/s into the bump stops before a knock is heard
		bumpVolume = 0.5,
		squealVolume = 0.5,
		squealStart = 1.2, -- tyres start to squeal past this multiple of their peak slip
		squealRange = 1.5,
		roadVolume = 0.35,
		windVolume = 0.5,
		whineVolume = 0.05,
		-- ring-and-pinion mesh: 32 ring teeth per wheel turn (3.555 = 32 / 9, S03, S04) is 6.19 teeth per
		-- turn of the shaft the game measures (wheel speed x 5.17); GM publishes no tooth counts [E]
		whineTeeth = 6.19,
		-- cockpit camera: level changes and an equaliser (dB). The engine sits right behind the seats
		-- (mid-engine, rear-facing intake, S07), so the cabin hears more engine and less treble cut.
		-- road 2.2: Car and Driver measured 74 dBA in the cabin at 70 mph [M] (S16), when the engine's
		-- modelled share in 8th is about 63 dBA, so tyre and wind noise lead the engine by about 11 dB,
		-- 5.5 dB at the game's level compression (1.25 gave 0.8 dB; measured with tools/audio_preview.py).
		interior = { engine = 0.9, wind = 0.45, road = 2.2, squeal = 0.7, lowGain = 4, midGain = -1, highGain = -9 },
	},

	-- Published figures the telemetry overlay and tools/drivetrain_model.py compare against. US figures
	-- for 0-60 mph and the quarter mile are timed after a one-foot rollout (drag-strip style) where
	-- stated; the game times from a true standstill (see the spec sheet).
	performanceTargets = {
		zeroTo60Mph = 2.9, -- [F] GM, Z51 with launch control (S03); GM doesn't say whether it uses a one-foot rollout
		zeroTo60MphRollout = 2.8, -- [M] Car and Driver (S14) and Motor Trend (S18), Oct 2019, one-foot rollout
		quarterMile = 11.2, -- [F] GM 11.2 s (S03); [M] Car and Driver 11.2 s, Motor Trend 11.1 s
		quarterMileKmh = 194.7, -- [F] 121 mph (S03); [M] Car and Driver 122 mph, Motor Trend 123.2 mph
		topSpeedKmh = 296, -- [F] 184 mph with Z51 (S22); 194 mph without Z51's aero
		brake70MphTo0 = 45.4, -- [M] 149 ft, Car and Driver, Oct 2019 (S13); 154 ft in its Sept 2020 test (S15)
		brake60MphTo0 = 29.6, -- [M] 97 ft, Motor Trend, Oct 2019 (S18)
	},

	visual = {
		bodyColor = Color3.fromRGB(20, 84, 168), -- [A] an RGB approximation of Rapid Blue, a 2020 launch colour
		driverSide = "Left", -- [F] left-hand drive (US)
		-- [E] Stand-in body side profile from photos (S36): mid-engine, cab-forward proportions. Research
		-- shares of the length from the nose: front axle 0.18, windscreen base 0.29, header 0.42, roof
		-- peak 0.50, roof end and engine cover 0.59, rear axle 0.77, spoiler lip 0.98 (+/-0.05); heights
		-- +/-10% except the roof, the factory 1.234 m [F]. The builder draws everything below the beltline
		-- as one full-length box, so the nose shows at the beltline (the real one is lower: about 0.45 m at
		-- the leading edge, 0.68 m at the bonnet's front). The glass runs on over the slope behind the
		-- roof, as the real car's rear glass and glass engine cover do, so the cabin stands apart from the
		-- engine deck; the deck sits at the low end of the research's 1.10 m (+/-10%) for the same reason.
		-- Chosen from renders of seven variants (docs/cars/RefC8Stingray.md).
		blockout = {
			profile = {
				{ 0, 0.76 }, -- [E] nose (hidden in the box below the beltline)
				{ 0.08, 0.78 }, -- [E] front of the bonnet
				{ 0.18, 0.81 }, -- [E] front axle (research 0.18)
				{ 0.28, 0.89 }, -- [E] windscreen base (research 0.29)
				{ 0.42, 1.20 }, -- [E] windscreen header (research 0.42)
				{ 0.50, 1.234 }, -- roof peak, the factory height [F]
				{ 0.56, 1.21 }, -- [E] roof end (research 0.59)
				{ 0.64, 1.05 }, -- [E] foot of the rear glass, start of the engine deck
				{ 0.95, 1.01 }, -- [E] engine deck over and behind the rear axle (axle at 0.77)
				{ 0.98, 1.05 }, -- [E] ducktail spoiler lip (research 0.98, about 1.10 m +/-10%)
				{ 1, 0.97 }, -- [E] tail
			},
			greenhouse = { 0.28, 0.64 }, -- [E] cabin glass, windscreen base to the foot of the rear glass
			beltline = 0.76, -- [E] side window sill, m
			cabinWidth = 0.68, -- [E] greenhouse width as a share of body width
			sill = 0.12, -- [E] bottom of the body sides, m
		},
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000035">
<Properties>
<string name="Name">RefC8Z06</string>
<ProtectedString name="Source"><![CDATA[--[[
	Ridgeway Halcyon Z (internal ID: RefC8Z06)

	An original mid-engine coupe from Ridgeway, a fictional American brand, built on the publicly
	documented engineering of the Chevrolet Corvette Z06 coupe (C8, model year 2023 onward), base car
	without the Z07 package. No Chevrolet names, logos or designs are used in the game.
	docs/cars/RefC8Z06.md has the sources, how each estimate was made and the validation;
	research_notes/cars/RefC8Z06.json has the research itself (source ids such as S02 refer to it).

	Every value is tagged:
	  [F] manufacturer figure (GM/Chevrolet)
	  [P] published third-party figure (spec sheets, Wikipedia, magazine spec boxes)
	  [M] measured in a magazine or independent test
	  [E] estimate made for the simulation (the doc says how)
	  [A] assumption
	Units: metres, kilograms, newtons, seconds and rpm unless a name says otherwise.
	Positions use the car's own axes: X to the right, Y up, -Z forward (Roblox LookVector).

	Z07 package variant (Cup 2 R tyres, carbon-ceramic brakes, 734 lb of downforce, 189 mph): the
	TrackTyre compounds below are ready for it; docs/cars/RefC8Z06.md lists every value it changes.
]]

return {
	id = "RefC8Z06",
	displayName = "Ridgeway Halcyon Z",
	reference = "Chevrolet Corvette Z06 (C8) (engineering reference only)",

	mass = {
		dryKg = 1558, -- [P] GM dry weight as copied by spec sites, for a Z07 coupe with carbon wheels (S04, S05)
		kerbKg = 1680, -- [E] US curb weight, base coupe: C/D's measured Z07 coupe (1,663 kg [M]) plus iron brakes, minus Z07 aero, aluminium wheels
		driverKg = 75, -- [A] the simulation carries one driver
		frontShare = 0.40, -- [P] about 40% front / 60% rear (S26; the Stingray's official split is 39.4/60.6)
		comHeight = 0.44, -- [E] low mid-engine coupe with a dry-sump engine
		-- [E] Size of the invisible box that carries the car's mass (about 2,700 kg*m^2 in yaw).
		inertiaBox = { width = 1.85, height = 0.75, length = 3.90 },
	},

	dimensions = {
		length = 4.689, -- [P] 184.6 in (S04, S05, S06); 4.722 m with the Z07 splitter
		width = 2.024, -- [P] 79.7 in without mirrors, about 91 mm wider than the Stingray
		height = 1.234, -- [P] 48.6 in
		wheelbase = 2.723, -- [P] 107.2 in
		trackFront = 1.684, -- [P] 66.3 in
		trackRear = 1.679, -- [P] 66.1 in
		frontOverhang = 0.960, -- [E] measured from a side photo (S29a), scaled to the published length
	},

	engine = {
		layout = "90-degree V8, flat-plane crank, mid-mounted", -- [F] LT6, DOHC, 32 valves, dry sump
		displacementCc = 5463, -- [P] from the 104.25 x 80.0 mm bore and stroke (5.5 L nominal [F])
		aspiration = "NaturallyAspirated", -- [F]
		peakPowerKw = 500, -- [F] 670 hp SAE J1349 (US engine)
		peakPowerRpm = 8400, -- [F]
		peakTorqueNm = 624, -- [F] 460 lb-ft SAE J1349
		peakTorqueRpm = 6300, -- [F]
		idleRpm = 900, -- [E] not published; warm idle of a high-revving DOHC V8
		limiterRpm = 8600, -- [F] redline 8,600 rpm; fuel cut at 8,600 [P] (S19)
		limiterHysteresisRpm = 150, -- [E] typical fuel-cut bounce
		inertia = 0.14, -- [E] kg*m^2: crank, rods' share, damper and the dual-clutch drum
		-- [F] Full-throttle crank torque, {rpm, Nm}, read from GM's chart "US LT6 SAE Torque and
		-- Power" (S01) by pixel digitising, times 1.006 so it meets GM's own ratings (the chart reads
		-- about 1% under them; with the factor: 500 kW at 8,400 rpm, 622 Nm at 6,300). The chart's
		-- shape is kept: flat about 400-415 Nm to 3,000 rpm with a dip at 2,900, the intake-resonance
		-- step to 574 Nm by 3,500, a peak at 3,800, a dip at 4,200, the 605-611 Nm plateau, the peak
		-- at 6,300 and the gentle fall to 550 Nm at 8,600. The 1,000 and 1,500 rpm points are below
		-- the chart's start (1,800 rpm) and are estimates [E].
		torqueCurve = {
			{ 1000, 340 }, -- [E]
			{ 1500, 385 }, -- [E]
			{ 1800, 397 },
			{ 2000, 401 },
			{ 2500, 414 },
			{ 2600, 414 },
			{ 2900, 401 },
			{ 3000, 409 },
			{ 3500, 574 },
			{ 3800, 603 },
			{ 4000, 595 },
			{ 4200, 583 },
			{ 4500, 605 },
			{ 4600, 611 },
			{ 5000, 606 },
			{ 5500, 608 },
			{ 6000, 611 },
			{ 6300, 622 },
			{ 6500, 614 },
			{ 7000, 602 },
			{ 7500, 594 },
			{ 8000, 582 },
			{ 8400, 569 },
			{ 8500, 559 },
			{ 8600, 550 },
		},
		-- [E] Internal friction, felt as engine braking with the throttle closed: static + perRpm * rpm (Nm).
		friction = { static = 20, perRpm = 0.0085 },
		throttleResponse = 18, -- [E] 1/s, how quickly the throttle follows the pedal
	},

	transmission = {
		type = "DualClutch", -- [F] Tremec TR-9080 8-speed dual-clutch transaxle (GM M1L)
		gearRatios = { 2.91, 1.76, 1.22, 0.88, 0.65, 0.51, 0.40, 0.33 }, -- [P] the Stingray's ratios (S04, S05, S11)
		reverseRatio = 2.63, -- [P]
		finalDrive = 5.56, -- [F] (Stingray: 5.17 Z51, 4.89 base)
		efficiency = 0.90, -- [E] crank to wheel, from stock wheel dynos (600-611 whp from 670 hp, S25)
		shiftTime = 0.10, -- [P] about 100 ms clutch overlap (TR-9080, S10; no Z06 figure published)
		-- [E] Share of clutch capacity kept during a shift. The TR-9080 hands torque from clutch to
		-- clutch with no gap (S10), so the oncoming clutch keeps 0.7 x 940 = 658 Nm, above peak torque:
		-- it pulls the engine down to the new gear's speed instead of letting it flare into the limiter.
		shiftTorqueFraction = 0.70,
		clutchMaxTorque = 940, -- [E] Nm, 1.5 x peak torque
		clutchStiffness = 400, -- [E] Nm per rad/s of slip, how firmly an engaged clutch couples
		launchRpm = { min = 2000, max = 4500 }, -- [P] launch control holds 4,500 rpm by default (S23; driver-adjustable 3,500-5,000); min [E]
		-- full [P]: full-throttle upshifts complete at about 8,500 rpm (S19), just under the 8,600 cut.
		-- light [E]: a Sport-mode calibration. Lifting off holds the gear below 4,500 rpm, and braking
		-- downshifts one gear at a time at 2,200 rpm, the clutch spinning the engine up to match.
		autoUpshiftRpm = { light = 4500, full = 8500 },
		autoDownshiftRpm = { light = 2200, full = 4800 }, -- [E] by pedal position; up/down stays above 1.77 so it can't hunt
		minShiftInterval = 0.25, -- [E] seconds between shifts
	},

	drivetrain = {
		layout = "RWD", -- [F] mid-engine, rear-wheel drive
		frontTorqueShare = 0, -- used by AWD layouts (0 to 1)
		-- [E] The real car has an electronic limited-slip differential (standard on every Z06 [F]);
		-- this is a clutch-type approximation: preload in Nm, lock factors as shares of input torque.
		rearDifferential = { type = "LimitedSlip", preload = 100, powerLock = 0.45, coastLock = 0.30, stiffness = 180 },
		frontDifferential = { type = "Open" },
		-- [E] Traction control (Performance Traction Management and launch control on the real car,
		-- which let the driver set the allowed tyre slip, S23). It caps engine and clutch torque at
		-- headroom times what the driven tyres can grip, and trims further while they slip more than
		-- targetSlip. The shared defaults, as the GT12. Not tuned while the shared engine-inertia fix
		-- is pending: before it, the launch hunted at 45-60 fps (docs/cars/RefC8Z06.md).
		tractionControl = { enabled = true, targetSlip = 0.11, rate = 15, recovery = 2, headroom = 1.3 },
	},

	-- [E] Springs and dampers from target ride frequencies of 1.9 Hz front and 2.1 Hz rear (magnetic
	-- dampers, base chassis; the Z07's FE7 setup is stiffer) with damping ratios of about 0.3 in bump
	-- and 0.5 in rebound, on corner masses of 351 kg front and 527 kg rear. Anti-roll bars put 57% of
	-- the roll stiffness at the front (52% of the lateral load transfer with the roll centres), for a
	-- mildly understeering limit on these tyres; roll is about 1.0 degree per g.
	suspension = {
		front = {
			springRate = 50000, -- N/m at the wheel
			bumpDamping = 2500, -- N*s/m
			reboundDamping = 4200, -- N*s/m
			staticLength = 0.25, -- mount to wheel centre at ride height
			bumpTravel = 0.07, -- from ride height
			droopTravel = 0.07, -- from ride height
			bumpStopRate = 250000, -- N/m
			antiRollRate = 50000, -- N/m of left-right travel difference
			rollCenterHeight = 0.05, -- lateral tyre force acts this high above the road
			rideHeightOffset = 0, -- positive raises the car
		},
		rear = {
			springRate = 91700,
			bumpDamping = 4200,
			reboundDamping = 6900,
			staticLength = 0.25,
			bumpTravel = 0.07,
			droopTravel = 0.07,
			bumpStopRate = 250000,
			antiRollRate = 12000,
			rollCenterHeight = 0.08,
			rideHeightOffset = 0,
		},
	},

	tires = {
		-- [E] The car's own tyres (docs/cars/RefC8Z06.md). muLong is the research's estimate (1.40 road,
		-- 1.50 track); with the game's keyboard brake ramp the road tyre stops from 60 mph in MT's 29 m.
		-- muLat is set from the skidpad: about 1.11 g on the road tyre (tests 1.10-1.12 g) and 1.16 g on
		-- the track tyre (1.16 g), after the tyre model's load sensitivity. Nominal loads are the shared compounds'
		-- values scaled by tread width (275 and 345 mm, against 295 mm), so the wider rear tyre loses
		-- less grip to its heavier load.
		compounds = {
			-- road tyre in the Michelin Pilot Sport 4S ZP class (base car), 275/30 front
			RoadPerformance = { base = "Performance", muLong = 1.40, muLat = 1.14, nominalLoad = 4100 },
			-- the same tyre in the 345/25 rear size
			RoadPerformanceRear = { base = "RoadPerformance", nominalLoad = 5150 },
			-- track tyre in the Pilot Sport Cup 2 R ZP class (Z07 package), 275/30 front
			TrackTyre = { base = "SemiSlick", muLong = 1.50, muLat = 1.18, nominalLoad = 4300 },
			-- the same tyre in the 345/25 rear size
			TrackTyreRear = { base = "TrackTyre", nominalLoad = 5380 },
		},
		front = { widthMm = 275, aspect = 30, rimInches = 20, compound = "RoadPerformance", inertia = 1.5 }, -- [F] 275/30ZR20 on 20 x 10 in, [E] inertia (kg*m^2)
		rear = { widthMm = 345, aspect = 25, rimInches = 21, compound = "RoadPerformanceRear", inertia = 2.1 }, -- [F] 345/25ZR21 on 21 x 13 in, [E] inertia (kg*m^2)
	},

	brakes = {
		discs = "Iron, 370 x 34 mm front, 380 x 34 mm rear; 6-piston front, 4-piston rear monobloc calipers", -- [P] (S05, S06)
		maxTorqueFront = 3000, -- [E] Nm per wheel, enough to lock the wheels near 1.3 g
		maxTorqueRear = 2000, -- [E] Nm per wheel (60% front)
		handbrakeTorque = 2200, -- [E] Nm per rear wheel (electric parking brake on the rear calipers)
		abs = { enabled = true, targetSlip = 0.12 }, -- [E]
	},

	aero = {
		dragArea = 0.895, -- [E] CdA in m^2, fitted so the car tops out at 195 mph (314 km/h [F]) in 6th, about 6,760 rpm
		-- [P] 365 lb (1,624 N) of downforce at 186 mph (S19, S02): ClA 0.383 m^2 at the game's air
		-- density. Split 40% front / 60% rear [E], with the weight (the split isn't published).
		downforceAreaFront = 0.153, -- [E] ClA in m^2
		downforceAreaRear = 0.230, -- [E] ClA in m^2
	},

	steering = {
		maxAngleLowSpeed = 34, -- [E] mean road-wheel lock from the 11.6 m turning circle [P] (S06)
		maxAngleHighSpeed = 4.5, -- [E] road-wheel degrees at highSpeedKmh and above
		highSpeedKmh = 250, -- [E]
		rate = 220, -- [E] degrees per second the road wheels can turn
		ackermann = 0.6, -- [E] 0 = parallel steering, 1 = full Ackermann
	},

	-- [E] Sound. The engine sheet is made by tools/synth_audio.py from the car's acoustic definition,
	-- assets/audio/engines/RefC8Z06.json: firing order 1-4-3-8-7-6-5-2 on a flat-plane crank (each bank
	-- fires every 180 degrees, so a clean shriek and no cross-plane burble), 4-2-1 headers per bank,
	-- a valved exhaust with centre tips, the 8,600 rpm fuel cut and C/D's 94 dBA at full throttle. The
	-- loudness over rpm and load is in the sheet's per-loop gains; engineVolume scales all of it.
	-- docs/AUDIO.md explains every setting; docs/cars/RefC8Z06.md has the measurements.
	audio = {
		engineSheet = "RefC8Z06_Engine",
		effectsSheet = "Driving_Effects",
		engineVolume = 1.0, -- overall engine level (1 = the sheet's calibrated gains)
		-- used only with a sheet that has no per-loop gains:
		idleLevel = 0.3,
		rpmCurve = 1.0,
		redlineRpm = 8600,
		offThrottleLevel = 0.55,
		loadAttack = 25, -- 1/s, how fast the mix follows the throttle opening
		loadRelease = 12, -- 1/s, and closing
		minPitch = 0.5,
		maxPitch = 2.0,
		-- rev limiter: the limiter loops take over while the fuel cut keeps coming back. In gear this
		-- car's simulated cut returns 3-4 times a second, up to 0.33 s apart (4th gear), so the hold
		-- is longer than the GT12's 0.3 s.
		limiterHold = 0.45,
		limiterAttack = 40, -- 1/s, how fast the limiter loops come in (about 25 ms)
		limiterRelease = 10, -- 1/s, and go out
		-- forced induction: not used by this naturally aspirated engine
		turboVolume = 0.35,
		blowOffVolume = 0.6,
		blowOffMinBoost = 0.35,
		superchargerVolume = 0.3,
		-- the dual-clutch hands torque over with no gap (S10): a short, soft dip on full-throttle
		-- upshifts rather than an ignition-cut crack
		shiftCutTime = 0.05,
		shiftCutMinRpm = 4500,
		shiftCutVolume = 0.15,
		shiftClunkVolume = 0.15,
		-- no source describes overrun pops: a light crackle at most, as in Sport and Track
		crackleMinRpm = 4500,
		crackleDuration = 0.8,
		crackleRate = 8,
		crackleVolume = 0.2,
		bumpMinSpeed = 0.6, -- m/s into the bump stops before a knock is heard
		bumpVolume = 0.5,
		squealVolume = 0.5,
		squealStart = 1.2, -- tyres start to squeal past this multiple of their peak slip
		squealRange = 1.5,
		roadVolume = 0.4, -- run-flat 20/21-inch tyres are noisy (research estimate: 72 dBA at 70 mph)
		windVolume = 0.5,
		whineVolume = 0.06,
		-- ring-and-pinion mesh. The 5.56 final drive is a 1.566 transfer gear times a 3.55 ring and
		-- pinion (S11); 71/20 teeth assumed (not published), and the pinion turns at 3.55 / 5.56 of the
		-- shaft speed the mixer uses, so 20 x 0.639 = 12.8.
		whineTeeth = 12.8,
		-- cockpit camera: the engine and its twin throttle bodies sit right behind the seats and the tip
		-- bezels reflect sound up to the cabin (S24), so the engine stays at full level, mids are kept
		-- (the firing order is 60-573 Hz, its harmonics 120-1,150 Hz) and the highs are cut less than
		-- the front-engined GT12's
		interior = { engine = 1.0, wind = 0.45, road = 1.25, squeal = 0.7, lowGain = 2, midGain = 0, highGain = -7 },
	},

	-- [M] Published figures the telemetry timer and tools/drivetrain_model.py compare against.
	-- The magazine figures are for the Z07 coupe (the coupe tests on file; the base car is close)
	-- and use a one-foot rollout, as US magazines do. The game's timer starts from a true
	-- standstill, which adds about 0.2-0.3 s.
	performanceTargets = {
		zeroTo60MphRollout = 2.6, -- [M] C/D, Z07 coupe (S13); GM claims 2.6 s with the Z07 [F] (S02)
		zeroTo100Mph = 5.9, -- [M] C/D, one-foot rollout
		quarterMile = 10.5, -- [M] C/D, one-foot rollout; GM's preliminary figure is 10.6 s [F]
		quarterMileKmh = 210.8, -- [M] C/D, 131 mph
		topSpeedKmh = 314, -- [F] 195 mph for the base car (S17); 189 mph with the Z07
		brake60MphTo0 = 29.0, -- [M] MT, Z07 coupe: 95 ft (S16)
		brake70MphTo0 = 42.4, -- [M] C/D, Z07 coupe: 139 ft (S13)
	},

	visual = {
		bodyColor = Color3.fromRGB(208, 72, 22), -- [A] RGB approximation of the launch colour Amplify Orange, a deep metallic orange (redder than the AR-7's)
		driverSide = "Left", -- [F] left-hand drive (right-hand drive is built for export)
		-- [E] Stand-in body (VehicleModelBuilder), from the research's side-photo proportions (S29a,
		-- about +-3-5% of length): nose 0.45 m, front axle at 0.205 of the length (fender 0.71 m),
		-- windscreen base 0.27 (0.80 m), windscreen top 0.41 (1.20 m), roof peak 0.46 at the published
		-- 1.234 m height, roof end 0.57 (1.19 m), then the buttresses down to a long, nearly flat deck
		-- and the 1.05 m ducktail lip; rear axle at 0.785. The beltline is 0.64 m, not the real 0.81 m
		-- door line, because the builder fills everything below the beltline with one full-length box:
		-- at 0.81 the nose would be a 0.7 m wall. The narrow canopy (66% of the 2.02 m width) leaves the
		-- wide shoulders a mid-engine car reads by.
		blockout = {
			profile = {
				{ 0, 0.45 }, -- nose leading edge
				{ 0.05, 0.55 },
				{ 0.205, 0.71 }, -- front fender over the axle
				{ 0.27, 0.80 }, -- windscreen base (cowl)
				{ 0.41, 1.20 }, -- windscreen top
				{ 0.435, 1.228 },
				{ 0.46, 1.234 }, -- roof peak: the published height
				{ 0.51, 1.222 },
				{ 0.57, 1.19 }, -- roof rear end
				{ 0.64, 1.07 }, -- buttresses meet the deck
				{ 0.72, 1.02 },
				{ 0.90, 1.00 }, -- engine deck
				{ 0.97, 1.03 },
				{ 1, 1.05 }, -- ducktail lip
			},
			greenhouse = { 0.27, 0.62 }, -- windscreen base to the small rear window between the buttresses
			beltline = 0.64,
			cabinWidth = 0.66,
			sill = 0.12, -- about 0.10 m ground clearance (not published)
		},
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000036">
<Properties>
<string name="Name">RefCamaroZL1</string>
<ProtectedString name="Source"><![CDATA[--[[
	Ridgeway Ironside SC (internal ID: RefCamaroZL1)

	An original front-engined, supercharged V8 muscle coupe from the fictional American brand
	Ridgeway, built on the publicly documented engineering of the Chevrolet Camaro ZL1 coupe
	(6th generation, 2017-2024) with the 10-speed automatic. No Chevrolet names, logos or designs are
	used in the game. docs/cars/RefCamaroZL1.md has the sources, how each estimate was made and the
	validation; research_notes/cars/RefCamaroZL1.json has the research behind every figure.

	Every value is tagged:
	  [F] manufacturer figure (GM product guide, press material or GM service bulletin)
	  [P] published third-party figure
	  [M] measured in a magazine or independent test
	  [E] estimate made for the simulation
	  [A] assumption
	Units: metres, kilograms, newtons, seconds and rpm unless a name says otherwise.

	Positions use the car's own axes: X to the right, Y up, -Z forward (Roblox LookVector).

	docs/VEHICLE_CONFIG.md describes every field. This car uses the supercharger, the torque-converter
	automatic and its own tyre compound; it doesn't use drivetrain.centreCoupling or
	engine.speedLimitKmh (the real car is drag-limited at 198 mph, not electronically limited).
]]

return {
	id = "RefCamaroZL1",
	displayName = "Ridgeway Ironside SC",
	reference = "Chevrolet Camaro ZL1 (engineering reference only)",

	mass = {
		kerbKg = 1789, -- [F] GM curb weight, coupe with the 10-speed automatic (US convention: full fluids, no driver). Manual coupe 1,761 kg [F]; C/D's test car weighed 1,784 kg [M]
		driverKg = 75, -- [A] the simulation carries one driver
		frontShare = 0.53, -- [E] not published: supercharger, intercooler and 11 heat exchangers sit up front; the Camaro SS is quoted near 52/48
		comHeight = 0.49, -- [E] centre of mass above the ground at ride height: tall V8 and blower, 1,330 mm roof
		-- [E] Size of the invisible box that carries the car's mass. It sets the rotational
		-- inertia: about 3,300 kg*m^2 in yaw (radius of gyration 1.33 m, near half the wheelbase).
		inertiaBox = { width = 1.75, height = 0.80, length = 4.25 },
	},

	dimensions = {
		length = 4.812, -- [F] 190.2 in, 2019-on (2017-18 cars: 4.783 m [P])
		width = 1.897, -- [F] 74.7 in, without mirrors
		height = 1.330, -- [F] 52.4 in
		wheelbase = 2.811, -- [F] 110.7 in
		trackFront = 1.610, -- [F] 63.4 in
		trackRear = 1.591, -- [F] 62.6 in
		frontOverhang = 0.925, -- [E] front axle to the nose: side-photo overhang ratio applied to length minus wheelbase (rear overhang about 1.075 m)
	},

	engine = {
		layout = "90-degree V8, OHV pushrod, 2 valves per cylinder, direct injection, wet sump", -- [F] LT4 (Gen V small-block)
		displacementCc = 6162, -- [F] 376 cu in; bore x stroke 103.25 x 92.0 mm [F]; compression 10.0:1 [F]
		aspiration = "Supercharged", -- [P] Eaton R1740 TVS twin-rotor (Roots-type) blower with an air-to-liquid intercooler
		peakPowerKw = 485, -- [F] 650 hp (SAE certified)
		peakPowerRpm = 6400, -- [F]
		peakTorqueNm = 881, -- [F] 650 lb-ft (SAE certified); GM's 868 Nm is the older 640 lb-ft rating
		peakTorqueRpm = 3600, -- [F]
		idleRpm = 650, -- [E] warm idle; not published (Gen V LT V8s idle at about 600-700 rpm)
		limiterRpm = 6600, -- [P] GM's 6,600 rpm maximum engine speed for the LT4; the tachometer redline is 6,500 rpm [P]. Fuel-cut limiter there [E]
		limiterHysteresisRpm = 120, -- [E] research estimate 100-150 rpm
		inertia = 0.28, -- [E] kg*m^2: forged crank, flexplate, converter cover and impeller, plus the blower rotors (3.10 x crank speed, about 0.05 seen at the crank)
		-- [E] Full-BOOST torque curve, {rpm, Nm} (see docs/VEHICLE_CONFIG.md, "Turbo and supercharger
		-- torque curves"). The steady full-throttle torque the simulation makes is this curve times
		-- (0.68 + 0.32 x boost ceiling), the ceiling rising from 0 at 650 rpm to 1 at 2,800 rpm. Below
		-- 2,800 rpm the points are set so that product equals the research's crank estimate exactly:
		--   1,000: 620   1,500: 705   2,000: 770   2,500: 813   2,800: 847 Nm
		-- (620 Nm "just off idle" [P], 847 Nm by 2,800 rpm [P], at least 793 Nm from 2,500 to 5,400 [P]).
		-- From 2,800 rpm the curve is the crank estimate as it is: 881 Nm at 3,600 [F] and 723 Nm at
		-- 6,400 rpm (= 485 kW) [F], shaped between them like the K&N wheel-dyno curve [M].
		torqueCurve = {
			{ 1000, 847 },
			{ 1500, 874 },
			{ 2000, 874 },
			{ 2500, 851 },
			{ 2800, 847 },
			{ 3000, 861 },
			{ 3500, 879 },
			{ 3600, 881 },
			{ 4000, 872 },
			{ 4500, 851 },
			{ 5000, 830 },
			{ 5500, 800 },
			{ 6000, 762 },
			{ 6400, 723 },
			{ 6500, 708 },
			{ 6600, 685 },
		},
		-- [E] Internal friction, felt as engine braking with the throttle closed: static + perRpm * rpm (Nm).
		-- A 6.2-litre pushrod V8 with a blower that still turns (bypass valve open). The torque curve
		-- is net output, so friction isn't subtracted at full throttle.
		friction = { static = 25, perRpm = 0.012 },
		throttleResponse = 20, -- [E] 1/s, how quickly the throttle follows the pedal (87 mm electronic throttle [P]); with the hysteresis it gives about 4 limiter cuts a second
		-- [P]/[E] Eaton R1740 TVS: 1.74 L per rotor revolution, two 4-lobe rotors with 160-degree twist,
		-- driven at 3.10 x crank speed (20,150 rotor rpm at 6,500) [P]. A positive-displacement blower:
		-- boost follows rpm and throttle with no lag.
		forcedInduction = {
			type = "Supercharger", -- [P]
			maxBoostBar = 0.65, -- [P] 9.4 psi (EngineLabs, GM's launch figure; Corvette Action Center gives 9.7 psi)
			-- [E] share of the full-boost curve made with no boost (bypass valve open): about 580-600 Nm,
			-- between the naturally aspirated LT1's 630 Nm at 11.5:1 and what 10.0:1 and the blower in the
			-- intake path allow. The pressure ratio alone (1 / 1.65 = 0.61) ignores the hotter boosted
			-- charge and the blower's drive power, which both raise the share.
			offBoostTorqueShare = 0.68,
			boostStartRpm = 650, -- [E] at idle: a Roots blower starts building boost as soon as the bypass closes
			fullBoostRpm = 2800, -- [E] where GM's torque reaches 847 Nm (96% of peak) [P]
		},
	},

	transmission = {
		type = "Automatic", -- [F] Hydra-Matic 10L90 10-speed automatic with paddles (RPO MGL)
		gearRatios = { 4.70, 2.99, 2.15, 1.80, 1.52, 1.28, 1.00, 0.85, 0.69, 0.64 }, -- [F] GM
		reverseRatio = 4.87, -- [F]
		finalDrive = 2.85, -- [F] automatic coupe (the automatic convertible uses 2.77 [P])
		efficiency = 0.88, -- [E] ten-speed planetary gearbox with the lock-up closed, plus the final drive
		shiftTime = 0.12, -- [E] upshift speed change. GM: 1-2 upshifts 36% quicker than Porsche's PDK [F]; no absolute times published
		downshiftTime = 0.20, -- [E]
		shiftTorqueReduction = 0.40, -- [E] spark retard during power-on upshifts
		downshiftBlip = 0.35, -- [E] the 1LE automatic's Track mode rev-matches every downshift [F]
		turbineInertia = 0.06, -- [E] kg*m^2, 260 mm converter's turbine and the gearbox input
		minShiftInterval = 0.25, -- [E]
		-- GM's Track shift pattern for the 1LE automatic (bulletin 19-NA-038 [F]), applied to this car [A]:
		-- in normal driving it upshifts at about 3,000 rpm and downshifts at about 2,000; driven hard it
		-- holds gears to near the redline. (It cruises at 70 mph in 6th at about 3,150 rpm; Tour mode would
		-- be 10th at about 1,600.)
		autoUpshiftRpm = { light = 3000, full = 6450 }, -- [F]/[A] light; [E] full, just under the 6,500 rpm redline [P]
		autoDownshiftRpm = { light = 2000, full = 4000 }, -- [F]/[A] light; [E] full: the kickdown target
		converter = {
			stallRpm = 2600, -- [E] research estimate for a 260 mm converter [F] behind 881 Nm; not published
			torqueRatio = 1.9, -- [E]
			couplingPoint = 0.87, -- [E]
			overrunCapacity = 0.6, -- [E]
		},
		lockup = {
			minGear = 2, -- [E]
			minSpeedKmh = 20, -- [E]
			engageTime = 0.4, -- [E] electronically controlled capacity clutch (ECCC) [F]
			maxTorque = 1300, -- [E] Nm, about 1.5 x peak torque
		},
	},

	drivetrain = {
		layout = "RWD", -- [F]
		frontTorqueShare = 0, -- used by AWD layouts (0 to 1)
		-- [E] The real car has an electronic limited-slip differential: a hydraulic clutch pack giving
		-- 0-200 Nm of "breakaway torque" between the rear wheels, fully engaged in 0.15 s [F]. This is
		-- a clutch-type approximation: preload in Nm, lock factors as shares of input torque.
		rearDifferential = { type = "LimitedSlip", preload = 100, powerLock = 0.35, coastLock = 0.20, stiffness = 180 },
		frontDifferential = { type = "Open" },
		-- [E] Traction control. The real car's Performance Traction Management and launch control hold
		-- a wheel-slip target of 5-15% [F]. It caps engine torque at headroom times what the rear tyres
		-- can grip, and trims further while they slip more than targetSlip. rate and recovery are how
		-- fast that trim builds and fades (per second).
		-- recovery is quick (the cut fades in about 0.08 s), so a launch doesn't bog after the first slip.
		tractionControl = { enabled = true, targetSlip = 0.10, rate = 15, recovery = 12, headroom = 1.3 },
	},

	-- [E] Not published (gap): Magnetic Ride Control dampers, MacPherson-type front strut and five-link
	-- rear [F]. Springs from target ride frequencies of 1.6 Hz front and 1.8 Hz rear (k = corner
	-- mass x (2 pi f)^2), dampers from damping ratios of about 0.3 in bump and 0.5 in rebound.
	suspension = {
		front = {
			springRate = 50000, -- N/m at the wheel
			bumpDamping = 3000, -- N*s/m
			reboundDamping = 5000, -- N*s/m
			staticLength = 0.25, -- mount to wheel centre at ride height
			bumpTravel = 0.08, -- from ride height
			droopTravel = 0.07, -- from ride height
			bumpStopRate = 250000, -- N/m
			antiRollRate = 36000, -- N/m of left-right travel difference (front takes about 57% of the roll stiffness)
			rollCenterHeight = 0.06, -- strut front: low roll centre
			rideHeightOffset = 0, -- positive raises the car
		},
		rear = {
			springRate = 56000,
			bumpDamping = 3000,
			reboundDamping = 4950,
			staticLength = 0.25,
			bumpTravel = 0.08,
			droopTravel = 0.07,
			bumpStopRate = 250000,
			antiRollRate = 18000,
			rollCenterHeight = 0.10, -- five-link rear
			rideHeightOffset = 0,
		},
	},

	tires = {
		-- [E] Road tyres in the Goodyear Eagle F1 Supercar 3 class (summer tyres with a Camaro-specific
		-- compound [F]; engineering reference only). Lateral grip is the same front and rear: about 1.03 g
		-- on a 300 ft skidpad by a steady-state estimate (GM 1.02 g [F], C/D 1.04 g [M]). Longitudinal
		-- grip is fitted per axle, because the straight-line tests load the axles differently: the rear
		-- tyres alone drive the car, so theirs is fitted to GM's 0-60 mph and quarter mile; the front
		-- tyres do about 73% of a hard stop and none of the driving, so theirs is fitted to the 60-0 and
		-- 70-0 mph stops. With one value for both, the model either stops 9% short or launches 0.3 s slow:
		-- it brakes instantly with near-ideal ABS, while real stops include pedal build-up and ABS cycling.
		compounds = {
			MaxSummerFront = { base = "Performance", muLong = 1.16, muLat = 1.10 },
			MaxSummerRear = { base = "Performance", muLong = 1.30, muLat = 1.10 },
		},
		front = { widthMm = 285, aspect = 30, rimInches = 20, compound = "MaxSummerFront", inertia = 1.7 }, -- [F] 285/30ZR20 on 20 x 10 forged wheels, [E] inertia (kg*m^2, with the 390 mm rotor)
		rear = { widthMm = 305, aspect = 30, rimInches = 20, compound = "MaxSummerRear", inertia = 1.9 }, -- [F] 305/30ZR20 on 20 x 11 forged wheels, [E] inertia (kg*m^2, with rotor and half-shaft)
	},

	brakes = {
		discs = "Brembo: 6-piston monobloc front calipers on 390 x 36 mm two-piece vented rotors; 4-piston rear calipers on 365 x 28 mm vented rotors", -- [F]
		maxTorqueFront = 4200, -- [E] Nm per wheel: enough to lock the front tyres
		maxTorqueRear = 2200, -- [E] Nm per wheel (about 66% front bias)
		handbrakeTorque = 2200, -- [E] Nm per rear wheel
		abs = { enabled = true, targetSlip = 0.12 }, -- [E] four-channel ABS [F]
	},

	aero = {
		-- [E] CdA in m^2. GM never published a Cd. Fitted so 650 hp gives the 198 mph top speed in 8th
		-- (research: 0.90-0.99 for 85-90% driveline efficiency). A lap-sim's 0.364 x 2.07 m^2 = 0.75
		-- would let the car reach about 210 mph.
		dragArea = 0.92,
		-- [E] GM: the ZL1's splitter and pedestal spoiler "reduce lift" with no significant drag penalty
		-- [F], no figures. Near-zero net lift.
		downforceAreaFront = 0.0,
		downforceAreaRear = 0.05,
	},

	steering = {
		maxAngleLowSpeed = 34, -- [E] mean road-wheel angle that gives GM's 11.7 m turning circle [F]
		maxAngleHighSpeed = 4.5, -- [E] road-wheel degrees at highSpeedKmh and above (keyboard-friendly)
		highSpeedKmh = 250, -- [E]
		rate = 210, -- [E] degrees per second the road wheels can turn (ZF electric rack [F], ratio not published)
		ackermann = 0.6, -- [E] 0 = parallel steering, 1 = full Ackermann
	},

	-- [E] Sound. The engine sheet is made from the car's acoustic definition,
	-- assets/audio/engines/RefCamaroZL1.json (firing order 1-8-7-2-6-5-4-3 with GM bank numbering,
	-- cross-plane crank, valved dual exhaust, the Eaton blower's whine at 3.10 x crank speed and 8
	-- pulses per rotor turn, the fuel-cut limiter at 6,600 rpm and the estimated cabin levels, each
	-- with its source), by tools/synth_audio.py; docs/AUDIO.md explains sheets and the mixer. Volumes
	-- are Roblox Sound volumes; the loudness over rpm and load comes from the sheet's per-loop gains.
	-- Set by measurement (docs/cars/RefCamaroZL1.md); tune by ear in testing.
	audio = {
		engineSheet = "RefCamaroZL1_Engine",
		effectsSheet = "Driving_Effects",
		engineVolume = 1.0, -- overall engine level (1 = the sheet's calibrated gains)
		-- used only with a sheet that has no per-loop gains:
		idleLevel = 0.3,
		rpmCurve = 1.0,
		redlineRpm = 6500, -- [P] tachometer redline
		offThrottleLevel = 0.55,
		loadAttack = 25, -- 1/s, how fast the mix follows the throttle opening
		loadRelease = 12, -- 1/s, and closing
		minPitch = 0.5,
		maxPitch = 2.0,
		-- rev limiter: the limiter loops take over while the fuel cut keeps coming back
		limiterHold = 0.3, -- s after the last cut before the normal loops return (the model cuts about 4 times a second, cut active most of the time)
		limiterAttack = 40, -- 1/s (about 25 ms)
		limiterRelease = 10, -- 1/s
		-- forced induction: no turbo, so the turbo and blow-off settings are unused
		turboVolume = 0.35,
		blowOffVolume = 0.6,
		blowOffMinBoost = 0.35,
		-- [E] Supercharger whine (0.4133 x rpm Hz, plus a weaker line at half that pitch from the sheet).
		-- Reviewers hear it most at low revs and part throttle, faintly at a quiet idle, and covered by the
		-- exhaust at high revs [P]. Level = superchargerVolume x (idleShare + (1 - idleShare) x boost) x
		-- clamp(rpm / fullRpm, rpmFloor, 1). Measured against the rest of the mix: about 11-13 dB(A) under
		-- in full-throttle pulls from 1,500 to 4,500 rpm, 15-17 under at part throttle, 16 under at full
		-- throttle above 4,500 rpm and 21 under at idle.
		superchargerVolume = 0.06,
		superchargerIdleShare = 0.4, -- the rotors still sweep their pockets with the bypass valve open
		superchargerFullRpm = 1500,
		superchargerRpmFloor = 0.5,
		-- 10-speed upshifts at full throttle: a short torque cut; GM says pops during wide-open-throttle
		-- manoeuvres in Sport or Track are normal [F]
		shiftCutTime = 0.06,
		shiftCutMinRpm = 4500,
		shiftCutVolume = 0.5,
		shiftClunkVolume = 0.15, -- smooth planetary automatic: a soft clunk
		crackleMinRpm = 3500, -- overrun pops after lifting off above this ("exhaust blatting on the overrun" [P])
		crackleDuration = 1.0,
		crackleRate = 10,
		crackleVolume = 0.45,
		bumpMinSpeed = 0.6,
		bumpVolume = 0.5,
		squealVolume = 0.5,
		squealStart = 1.2,
		squealRange = 1.5,
		roadVolume = 0.35,
		windVolume = 0.5,
		whineVolume = 0.05,
		whineTeeth = 13, -- [E] rear-axle pinion: a 37:13 ring and pinion gives the 2.85 final drive
		-- cockpit camera: level changes and an equaliser (dB) for the cabin
		interior = { engine = 0.85, wind = 0.45, road = 1.0, squeal = 0.7, lowGain = 3, midGain = -1, highGain = -10 },
	},

	-- Published figures the telemetry timer and tools/drivetrain_model.py compare against. US figures
	-- (GM's included) are taken with a one-foot rollout, as SAE J1491 and the drag strip do; the
	-- in-game timer starts from a true standstill, so it reads about 0.3 s more (0.32-0.36 s in the model).
	performanceTargets = {
		zeroTo60MphRollout = 3.5, -- [F] GM, 10-speed coupe, OE tyres on a non-prepped surface. Tests [M]: C/D 3.4 s, Motor Trend 3.5 s, MotorWeek 3.5 s, Hennessey 3.6 s
		zeroTo100Mph = 7.6, -- [M] Hennessey's stock 10-speed baseline run
		quarterMile = 11.4, -- [F] GM (with rollout). Tests [M]: C/D and Motor Trend 11.5 s at 125 mph, MotorWeek 11.5 s at 127 mph
		quarterMileKmh = 204.4, -- [F] 127 mph
		topSpeedKmh = 319, -- [F] 198 mph, two-way average at Papenburg (202.3 / 193.3 mph), stock 10-speed car
		brake60MphTo0 = 32.6, -- [F] 107 ft (GM's guide misprints the metric figure as 35 m)
		brake70MphTo0 = 43.6, -- [M] Car and Driver, 143 ft, automatic coupe, March 2017
	},

	visual = {
		bodyColor = Color3.fromRGB(196, 22, 28), -- [A] approximation of the launch-year solid red ("Red Hot")
		driverSide = "Left", -- [F] left-hand drive
		-- [E] Stand-in body (VehicleModelBuilder). Long-hood, short-deck 2+2 fastback with a high
		-- beltline and a low, narrow ("gun-slit") greenhouse, judged from freely licensed photos (research
		-- notes, "Visual blockout"): front axle at 0.19 of the length, windscreen base 0.34, windscreen
		-- header 0.48, roof peak 0.57 at the published 1,330 mm [F], rear window base 0.83, rear axle 0.78;
		-- cowl about 0.93 m, hood leading edge about 0.77 m, spoiler lip about 1.04 m.
		-- The builder's lower body is one box up to the beltline, so the real window line (about 0.93 m)
		-- would bury the hood's rise to the cowl; the beltline sits at 0.85 m so the hood reads, and the
		-- side glass is then about 0.41 m tall (real daylight opening about 0.37 m). The side glass stops
		-- at 0.76, leaving the thick C-pillar sail painted down to the deck.
		blockout = {
			profile = {
				{ 0, 0.72 }, -- front fascia top (below the beltline: the nose shows at 0.85 m)
				{ 0.03, 0.79 }, -- hood leading edge
				{ 0.19, 0.87 }, -- over the front axle
				{ 0.34, 0.93 }, -- cowl, windscreen base
				{ 0.48, 1.30 }, -- windscreen header
				{ 0.57, 1.33 }, -- roof peak, the published height [F]
				{ 0.66, 1.29 }, -- rear edge of the roof
				{ 0.76, 1.11 }, -- end of the side glass; C-pillar sail behind it
				{ 0.83, 1.01 }, -- rear window base, short high deck
				{ 0.97, 1.04 }, -- spoiler lip
				{ 1, 0.97 }, -- tail panel top
			},
			greenhouse = { 0.34, 0.76 },
			beltline = 0.85,
			cabinWidth = 0.70, -- narrow greenhouse on a wide body
			sill = 0.13, -- about 130 mm at the sills [E]
		},
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000037">
<Properties>
<string name="Name">RefM3G80</string>
<ProtectedString name="Source"><![CDATA[--[[
	Brandt Kestrel RS (internal ID: RefM3G80)

	An original four-door sports sedan from the fictional German maker Brandt, built on the publicly
	documented engineering of the BMW M3 Competition sedan (G80): rear-wheel drive, 8-speed
	torque-converter automatic. No BMW names, logos or designs are used in the game. Sources, the
	estimates and how each was made are in docs/cars/RefM3G80.md; the research behind them is
	research_notes/cars/RefM3G80.json (source ids such as BMW_SPEC_M3 below refer to it).

	Every value is tagged:
	  [F] factory figure published by the maker
	  [P] published figure from a third party (spec sheet, parts catalogue)
	  [M] measured in a magazine or independent test
	  [E] estimate made for the simulation (method given)
	  [A] assumption
	Units: metres, kilograms, newtons, seconds and rpm unless a name says otherwise.

	Positions use the car's own axes: X to the right, Y up, -Z forward (Roblox LookVector).
	docs/VEHICLE_CONFIG.md describes every field.
]]

return {
	id = "RefM3G80",
	displayName = "Brandt Kestrel RS",
	reference = "BMW M3 Competition (G80) (engineering reference only)",

	mass = {
		dryKg = 1660, -- [E] not published: DIN kerb minus 40 kg of fuel (59 L x 90%) and about 30 kg of oil, coolant and ATF
		kerbKg = 1730, -- [F] DIN kerb weight, 90% fuel, no driver (BMW_SPEC_M3); US curb 3,890 lb = 1,764 kg with full fuel
		driverKg = 75, -- [A] one driver; 1,730 + 75 = 1,805 kg, BMW's EU unladen weight [F]
		frontShare = 0.531, -- [F] 53.1% front / 46.9% rear (BMW US spec, BMW_US21); MotorTrend measured 53/47 [M]
		comHeight = 0.49, -- [E] not published; typical lowered sedan with a carbon roof (research estimate)
		-- [E] Box that carries the mass, sized for a yaw inertia of about 3,300 kg*m^2 (dynamic index about
		-- 0.9 for a 2,857 mm wheelbase and 53/47 split, usual for a front-engined sedan). Roll inertia
		-- comes out near 580 kg*m^2 and pitch near 2,900 kg*m^2.
		inertiaBox = { width = 1.80, height = 0.80, length = 4.30 },
	},

	dimensions = {
		length = 4.794, -- [F] BMW_SPEC_M3
		width = 1.903, -- [F] without mirrors (2,068 mm with)
		height = 1.433, -- [F] unladen
		wheelbase = 2.857, -- [F]
		trackFront = 1.617, -- [F]
		trackRear = 1.605, -- [F]
		frontOverhang = 0.860, -- [F] BMW's dimension drawing (rear overhang 1,077 mm)
	},

	engine = {
		layout = "Inline-6, front, longitudinal", -- [F] S58B30T0
		displacementCc = 2993, -- [F] 84.0 mm bore x 90.0 mm stroke, 9.3:1 compression
		aspiration = "Turbocharged", -- [F] two mono-scroll turbochargers, one per three cylinders (1-3 and 4-6)
		peakPowerKw = 375, -- [F] 510 PS / 503 hp; BMW's diagram holds 375 kW from 5,600 to 7,200 rpm
		peakPowerRpm = 6250, -- [F]
		peakTorqueNm = 650, -- [F] from 2,750 to 5,500 rpm
		peakTorqueRpm = 2750, -- [F] start of the 650 Nm plateau
		idleRpm = 700, -- [E] not published; warm idle of BMW's B58/S58 automatics is about 650-750 rpm
		limiterRpm = 7250, -- [P] evo: "the limiter coming in at 7250rpm"; redline 7,200 rpm [F]
		-- [E] fuel returns 100 rpm below the limiter: a tight, quick cut. With inertia and throttleResponse the
		-- free rev bounces 7,140-7,470 rpm about 4.5 times a second, and 7,150-7,270 rpm in gear.
		limiterHysteresisRpm = 100,
		inertia = 0.20, -- [E] kg*m^2: crank (21.2 kg forged [F]), rods, pistons, damper, flexplate and converter impeller
		-- Full-throttle torque at FULL BOOST, {rpm, Nm} (see "Turbo and supercharger torque curves" in
		-- docs/VEHICLE_CONFIG.md). From 2,744 rpm it is BMW's full-load diagram exactly [F] (the vertices of
		-- the vector drawing in BMW_SPEC_M4, the same 375 kW / 650 Nm engine): 650 Nm to 5,500 rpm, then
		-- constant 375 kW to 7,198 rpm. Below 2,744 rpm the points are [E]: each is BMW's torque at that rpm
		-- divided by the boost factor there (offBoostTorqueShare + (1 - share) x boost ceiling), so the
		-- steady full-throttle torque the game makes equals BMW's diagram at every vertex: 245 Nm at
		-- 1,000, 295 at 1,500, 345 at 2,000, 460 at 2,500, 570 at 2,651, 650 at 2,744 rpm.
		torqueCurve = {
			{ 1000, 650.0 }, -- [E] steady 245 Nm [F]
			{ 1500, 782.7 }, -- [E] steady 295 Nm [F] (no boost yet here, so this value is only reached part-throttle)
			{ 2000, 646.5 }, -- [E] steady 345 Nm [F]
			{ 2500, 543.1 }, -- [E] steady 460 Nm [F]
			{ 2651, 605.3 }, -- [E] steady 570 Nm [F]
			{ 2744, 650 }, -- [F] start of the 650 Nm plateau
			{ 5500, 650 }, -- [F] end of the plateau
			{ 5593, 639 }, -- [F] constant 375 kW from here
			{ 6000, 597 }, -- [F]
			{ 6500, 551 }, -- [F]
			{ 7000, 511 }, -- [F]
			{ 7198, 497 }, -- [F] end of BMW's curve
			{ 7250, 494 }, -- [E] 375 kW held to the limiter
		},
		-- [E] Engine braking with the throttle shut: static + perRpm * rpm (Nm). From a friction mean
		-- effective pressure of about 1.1 bar at 3,000 rpm and 2.3 bar at 7,000 rpm, plus about 0.9 bar
		-- of closed-throttle pumping loss, for 2,993 cc: about 47 Nm at 3,000 rpm and 75 Nm at 7,000.
		friction = { static = 25, perRpm = 0.0072 },
		throttleResponse = 20, -- [E] 1/s, electronic throttle with VALVETRONIC [F] (turbo lag is modelled separately)
		speedLimitKmh = 290, -- [F] with the M Driver's Package (BMW_SPEC_M3); the standard car is limited to 250 km/h [F]
		forcedInduction = {
			type = "Turbo", -- [F] twin mono-scroll MHI turbochargers, electric wastegates, air-to-water charge cooling
			maxBoostBar = 1.7, -- [P] auto motor und sport "max. Ladedruck 1,7 bar"; Car and Driver 24.7 psi
			-- [E] 245 Nm at 1,000 rpm [F] / 650 Nm = 0.377, which is also 1 / (1 + 1.7 bar): torque in
			-- proportion to manifold pressure
			offBoostTorqueShare = 0.377,
			-- [E] Boost starts here, so steady full throttle at 2,000 rpm shows 0.43 bar: the pressure that
			-- BMW's 345 Nm implies there (345 / 245 x 1 bar absolute). The real rise is convex (slow, then
			-- steep near 2,500 rpm); a linear ramp can't follow it, so the curve points above carry the shape.
			boostStartRpm = 1750,
			fullBoostRpm = 2744, -- [F] BMW's diagram reaches 650 Nm here (spec sheet: 2,750 rpm)
			-- [E] s to 90% boost when floored at 2,744 rpm in a held gear: the middle of the 0.6-0.8 s starting
			-- range (docs/VEHICLE_CONFIG.md); testers note lag below about 2,750 rpm. Checked against BMW's and
			-- The Citizen's in-gear 80-120 km/h times (docs/cars/RefM3G80.md), not fitted to them.
			spoolTime = 0.7,
			dumpTime = 0.2, -- [E] electric wastegates, no blow-off valve documented (recirculation is internal)
		},
	},

	transmission = {
		type = "Automatic", -- [F] 8-speed M Steptronic with Drivelogic, ZF 8HP76 torque-converter automatic
		gearRatios = { 5.000, 3.200, 2.143, 1.720, 1.313, 1.000, 0.823, 0.640 }, -- [F] BMW_SPEC_M3
		reverseRatio = 3.478, -- [F]
		finalDrive = 3.154, -- [F]
		efficiency = 0.89, -- [E] rear-drive automatic with lock-up closed, final drive and clutch-pack differential
		shiftTime = 0.15, -- [E] s; research: 0.10-0.15 s torque dip in the sportiest Drivelogic setting, 0.3-0.4 s in comfort
		downshiftTime = 0.20, -- [E]
		downshiftBlip = 0.3, -- [E] BMW: automatic rev-matching on downshifts [F]
		shiftTorqueReduction = 0.4, -- [E] ignition retard during a power-on upshift
		turbineInertia = 0.05, -- [E] kg*m^2, converter turbine and gearbox input
		minShiftInterval = 0.3, -- [E] s
		-- [E] gearbox input rpm. Full throttle upshifts 200 rpm under the limiter (BMW's power plateau runs to
		-- 7,200 rpm), so the car tops out against the 290 km/h limiter in 7th, not on the rev limiter in 6th.
		-- A steady 100 km/h (about 20% pedal) holds 8th at 1,580 rpm (MotorTrend: 1,500 rpm at 60 mph in 8th
		-- [M]); full-pedal kickdown keeps the engine above 4,200 rpm, below every upshift's landing speed.
		autoUpshiftRpm = { light = 1700, full = 7050 },
		autoDownshiftRpm = { light = 900, full = 4200 },
		converter = {
			-- [E] not published. Launch control holds about 2,700 rpm [P] with about 1.0 bar of boost [M], so the
			-- converter absorbs about 480 Nm at 2,700 rpm; the same converter takes the full 650 Nm at 3,100 rpm.
			stallRpm = 3100,
			torqueRatio = 1.9, -- [E] typical for a sports converter
			couplingPoint = 0.87, -- [E]
			overrunCapacity = 0.6, -- [E]
		},
		lockup = {
			minGear = 1, -- [F] BMW: the lock-up clutch is "fully engaged the moment the car has pulled away"
			minSpeedKmh = 10, -- [E] "the moment the car has pulled away" [F]
			engageTime = 0.3, -- [E] s
			maxTorque = 910, -- [E] Nm, 1.4 x peak engine torque
		},
	},

	drivetrain = {
		layout = "RWD", -- [F]
		frontTorqueShare = 0, -- used by AWD layouts (0 to 1)
		-- [E] Active M Differential: an electronically controlled multi-plate limited-slip differential,
		-- 0-100% locking [F]. BMW publishes no preload or lock values; this clutch-type approximation uses
		-- the research estimate of a light preload, with strong locking on power.
		rearDifferential = { type = "LimitedSlip", preload = 80, powerLock = 0.45, coastLock = 0.25, stiffness = 200 },
		frontDifferential = { type = "Open" },
		-- [E] DSC with slip control in the engine ECU [F] (M Traction Control, 10 stages). Caps engine torque at
		-- headroom x what the rear tyres can grip and trims while they slip past targetSlip. The shared starting
		-- values (docs/VEHICLE_CONFIG.md); BMW says its ECU-based slip control acts up to 10 times more often [F],
		-- which would support a faster rate and recovery: see docs/cars/RefM3G80.md before changing them.
		tractionControl = { enabled = true, targetSlip = 0.11, rate = 15, recovery = 2, headroom = 1.3 },
	},

	-- [E] Spring and damper rates are not published. Springs from the research's ride frequencies of
	-- 1.6 Hz front and 1.8 Hz rear on the game's corner masses (the game has no separate unsprung mass:
	-- 479 kg front, 423 kg rear per corner): k = corner mass x (2 pi f)^2. Dampers at about 0.3 of
	-- critical in bump and 0.5 in rebound (adaptive M dampers in Sport). Anti-roll bars give about 56%
	-- of the roll stiffness at the front (front weight 53%) for mild understeer, and a roll gradient
	-- near 1.6 degrees per g.
	suspension = {
		front = {
			springRate = 48400, -- N/m at the wheel (research: 43,000 on the real car's sprung mass)
			bumpDamping = 2900, -- N*s/m
			reboundDamping = 4800, -- N*s/m
			staticLength = 0.25, -- mount to wheel centre at ride height
			bumpTravel = 0.08, -- from ride height
			droopTravel = 0.08, -- from ride height
			bumpStopRate = 250000, -- N/m
			antiRollRate = 32000, -- N/m of left-right travel difference
			rollCenterHeight = 0.06, -- [E] BMW: double-joint strut axle with a lowered roll centre [F]
			rideHeightOffset = 0, -- positive raises the car
		},
		rear = {
			springRate = 54100, -- research: 48,000 on the real car's sprung mass
			bumpDamping = 2900,
			reboundDamping = 4800,
			staticLength = 0.25,
			bumpTravel = 0.08,
			droopTravel = 0.08,
			bumpStopRate = 250000,
			antiRollRate = 18000,
			rollCenterHeight = 0.10, -- [E] five-link rear axle [F]
			rideHeightOffset = 0,
		},
	},

	tires = {
		compounds = {
			-- [E] Road tyre in the class of the Michelin Pilot Sport 4S fitted to every test car (engineering
			-- reference only). muLong fitted between the measured braking (MotorTrend 60-0 mph 1.18 g, Car and
			-- Driver 70-0 mph 1.09 g mean, both including brake build-up) and the traction-limited launch
			-- (MotorTrend about 0.73 g average to 50 mph, 1-2 shift included); muLat for the 1.03 g skidpad
			-- (Car and Driver, MotorTrend). See docs/cars/RefM3G80.md.
			RoadPerformance = { base = "Performance", muLong = 1.25, muLat = 1.08 },
			-- [E] Track tyre in the class of the optional Pilot Sport Cup 2, about 12% more grip (not fitted by default).
			TrackTyre = { base = "SemiSlick", muLong = 1.40, muLat = 1.21, rollingResistance = 0.012 },
		},
		-- [F] 275/35 ZR19 front, 285/30 ZR20 rear on forged wheels: optional on the RWD car, and fitted to every
		-- magazine test car (standard is 275/40 ZR18 and 285/35 ZR19). [E] inertia: wheel, tyre and brake disc.
		front = { widthMm = 275, aspect = 35, rimInches = 19, compound = "RoadPerformance", inertia = 1.7 },
		rear = { widthMm = 285, aspect = 30, rimInches = 20, compound = "RoadPerformance", inertia = 1.95 },
	},

	brakes = {
		-- [F] M Compound brakes; magazine test cars had the M Carbon ceramic option (400 mm front, 380 mm rear)
		discs = "M Compound, 380 x 36 mm front with 6-piston fixed calipers, 370 x 24 mm rear with single-piston floating calipers",
		maxTorqueFront = 3600, -- [E] Nm per wheel; about 2,600 Nm locks a front wheel at 1.2 g
		maxTorqueRear = 1700, -- [E] Nm per wheel; about 68% front bias for a 53/47 car
		handbrakeTorque = 2000, -- [E] Nm per rear wheel (electric parking brake in the rear calipers [F])
		abs = { enabled = true, targetSlip = 0.12 }, -- [E]
	},

	aero = {
		dragArea = 0.772, -- [F] BMW's "cd x A": Cd 0.33 x 2.34 m^2
		-- [E] Lift is not published. BMW says the sills and aprons add underbody downforce; the research
		-- suggests near-zero net lift, 0.05-0.10 m^2 per axle (about 240 N front, 320 N rear at 290 km/h).
		downforceAreaFront = 0.06,
		downforceAreaRear = 0.08,
	},

	steering = {
		-- [E] 32 degrees average road-wheel angle reproduces the 12.2 m turning circle [F] on the 2,857 mm
		-- wheelbase. The 15:1 centre ratio [F] is variable (quicker toward lock), so 2.0 turns lock to lock [M].
		maxAngleLowSpeed = 32,
		maxAngleHighSpeed = 4.5, -- [E] road-wheel degrees at highSpeedKmh and above
		highSpeedKmh = 250, -- [E]
		rate = 220, -- [E] degrees per second the road wheels can turn
		ackermann = 0.6, -- [E] 0 = parallel steering, 1 = full Ackermann
	},

	-- [E] Sound. The engine sheet is made from the car's acoustic definition,
	-- assets/audio/engines/RefM3G80.json (firing order 1-5-3-6-2-4, turbo branches 1-3 and 4-6, valved
	-- dual-branch exhaust, 7,250 rpm fuel-cut limiter), by tools/synth_audio.py; see docs/AUDIO.md. Its
	-- per-loop gains come from the measured cabin levels (auto motor und sport: idle 45, full throttle
	-- 82 dB(A)) with the Active Sound Design share taken out, so outside cameras hear the engine itself.
	-- Volumes are Roblox Sound volumes; tune by ear in testing.
	audio = {
		engineSheet = "RefM3G80_Engine",
		effectsSheet = "Driving_Effects",
		engineVolume = 1.0, -- overall engine level (1 = the sheet's calibrated gains)
		-- used only with a sheet that has no per-loop gains:
		idleLevel = 0.3, -- loudness at idle as a share of engineVolume
		rpmCurve = 1.0, -- how loudness rises with rpm (1 = in proportion)
		redlineRpm = 7250, -- [P] the limiter
		offThrottleLevel = 0.55, -- off-throttle loops relative to on-throttle
		loadAttack = 25, -- 1/s, how fast the mix follows the throttle opening
		loadRelease = 12, -- 1/s, and closing
		minPitch = 0.5,
		maxPitch = 2.0,
		-- rev limiter: the limiter loops take over while the fuel cut keeps coming back. This car's
		-- simulation cuts 4.5 times a second free-revving and 2.7-3.8 times in 2nd-4th, with at most 0.15 s
		-- between cuts; in 5th (manual) the engine needs about 0.35 s to climb back to the cut, so the
		-- hold is 0.4 s rather than the GT12's 0.3 s.
		limiterHold = 0.4,
		limiterAttack = 40, -- 1/s, how fast the limiter loops come in (about 25 ms)
		limiterRelease = 10, -- 1/s, and go out
		-- forced induction: no tester describes a turbo whistle (they note lag below 2,750 rpm), and there
		-- is no atmospheric blow-off valve [E], so both layers are kept quiet
		turboVolume = 0.04, -- whistle at full boost: about 20 dB under the engine (A-weighted)
		blowOffVolume = 0.2, -- internal recirculation whoosh
		blowOffMinBoost = 0.35, -- boost (0-1) needed for a blow-off when the throttle shuts
		superchargerVolume = 0.3, -- not used (turbo engine)
		-- the torque-converter automatic retards the ignition on upshifts: a milder crack than a dual-clutch's
		shiftCutTime = 0.08, -- seconds of ignition cut heard on a full-throttle upshift
		shiftCutMinRpm = 4500,
		shiftCutVolume = 0.4,
		shiftClunkVolume = 0.15,
		-- mild lift-off burble (SPORT; muted by the EU particulate filters), research estimate
		crackleMinRpm = 4000, -- exhaust crackles after lifting off above this
		crackleDuration = 0.8,
		crackleRate = 8, -- crackles per second at first, fading out
		crackleVolume = 0.25,
		bumpMinSpeed = 0.6, -- m/s into the bump stops before a knock is heard
		bumpVolume = 0.5,
		squealVolume = 0.5,
		squealStart = 1.2, -- tyres start to squeal past this multiple of their peak slip
		squealRange = 1.5, -- and reach full volume this much further past it
		roadVolume = 0.35,
		windVolume = 0.5,
		whineVolume = 0.04, -- quiet: ZF automatic and a clutch-pack differential
		whineTeeth = 13, -- [E] final drive 3.154 = 41:13, so a 13-tooth pinion sets the whine pitch
		-- cockpit camera. Active Sound Design plays engine orders through the speakers [F]: about half of the
		-- cabin engine sound under load (research estimate), +3 dB, which is +1.5 dB at the game's 0.5 level
		-- compression, so engine = 1.19. road and wind set so steady 100 and 130 km/h sit about 11.5 and
		-- 14.4 dB (A) over idle in the preview's mix, against the measured 12.5 and 14.0 (auto motor und sport,
		-- halved). The equaliser lifts the low orders the speakers add and cuts the treble the cabin keeps out.
		interior = { engine = 1.19, wind = 0.55, road = 1.6, squeal = 0.7, lowGain = 4, midGain = -1, highGain = -12 },
	},

	-- [F] Factory figures (zeroTo60Mph, zeroTo100, zeroTo200, topSpeedKmh) and [M] magazine figures. US
	-- magazines time from a one-foot rollout (about 0.2-0.3 s quicker than a true standstill).
	performanceTargets = {
		zeroTo60Mph = 3.8, -- [F] BMW USA (BMW_US21)
		zeroTo100 = 3.9, -- [F] BMW_SPEC_M3
		zeroTo200 = 12.5, -- [F] BMW_PK
		topSpeedKmh = 290, -- [F] with the M Driver's Package (250 km/h without)
		zeroTo60MphRollout = 3.5, -- [M] Car and Driver and MotorTrend, both 3.5 s with a one-foot rollout
		zeroTo100Mph = 7.6, -- [M] Car and Driver, one-foot rollout (MotorTrend 7.5 s)
		quarterMile = 11.6, -- [M] Car and Driver and MotorTrend 11.6 s (one-foot rollout); The Citizen 11.58 s
		quarterMileKmh = 199.6, -- [M] Car and Driver 124 mph (MotorTrend 125.6 mph = 202.1 km/h; The Citizen 201.2 km/h)
		brake60MphTo0 = 31.1, -- [M] MotorTrend 102 ft
		brake70MphTo0 = 45.7, -- [M] Car and Driver 150 ft
	},

	visual = {
		bodyColor = Color3.fromRGB(18, 84, 62), -- [A] RGB approximation of the launch colour, a deep metallic green
		driverSide = "Left", -- [A] left-hand drive (EU and US cars)
		-- [E] Stand-in body. Profile: the research's trace of BMW's side drawing (heights normalised to the
		-- 1,433 mm roof [F]; front axle at 0.179 and rear axle at 0.775 of the length [F]). Its 0.81 and 0.87
		-- points are left out (both within 11 mm of the line) so the rear screen stays one glass plane.
		blockout = {
			profile = {
				{ 0.00, 0.640 }, { 0.03, 0.771 }, { 0.06, 0.833 }, { 0.09, 0.880 }, { 0.12, 0.912 }, { 0.16, 0.935 },
				{ 0.19, 0.949 }, { 0.22, 0.963 }, { 0.25, 0.971 }, { 0.28, 0.982 }, { 0.31, 0.993 }, { 0.34, 1.087 },
				{ 0.37, 1.174 }, { 0.40, 1.254 }, { 0.43, 1.327 }, { 0.46, 1.378 }, { 0.50, 1.403 }, { 0.53, 1.418 },
				{ 0.56, 1.426 }, { 0.59, 1.433 }, { 0.62, 1.429 }, { 0.65, 1.426 }, { 0.68, 1.414 }, { 0.74, 1.389 },
				{ 0.77, 1.320 }, { 0.84, 1.200 }, { 0.90, 1.076 }, { 0.93, 1.051 }, { 0.96, 1.037 }, { 0.99, 0.600 },
			},
			-- windscreen base (0.31) to just above the boot lid, so a painted strip marks the notchback's boot step
			greenhouse = { 0.31, 0.86 },
			-- the real side-window sill is about 1.0 m (cowl 0.99 m); 0.92 keeps the high shoulder and still shows
			-- the bonnet rising to the windscreen (the builder draws everything below the beltline as one box)
			beltline = 0.92,
			cabinWidth = 0.76, -- about 1.45 m of glasshouse inside the 1,903 mm flared body
			sill = 0.15, -- side sills; 120 mm ground clearance [F] is at the lowest point underneath
		},
	},
}
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000038">
<Properties>
<string name="Name">RefM5F90</string>
<ProtectedString name="Source"><![CDATA[--[[
	Brandt Nordwind RS (internal ID: RefM5F90)

	An original four-door super-saloon from the fictional German maker Brandt, built on the publicly
	documented engineering of the BMW M5 Competition (F90), LCI (2021-2023) EU specification. No BMW
	names, logos or designs are used in the game. Sources, estimates and validation:
	docs/cars/RefM5F90.md; the research behind them: research_notes/cars/RefM5F90.json and .md.

	Every value is tagged:
	  [F] factory figure (BMW AG or BMW of North America press kits and specification sheets)
	  [P] published third-party figure, or BMW material for the sister S63TU engine
	  [M] measured in a magazine or independent test
	  [E] estimate made for the simulation (method given)
	  [A] assumption
	Units: metres, kilograms, newtons, seconds and rpm unless a name says otherwise.

	Positions use the car's own axes: X to the right, Y up, -Z forward (Roblox LookVector).

	Default drive set-up: M xDrive in "4WD Sport" (drivetrain.centreCoupling), the 8-speed torque-
	converter automatic in D with sporty shift times, the M Driver's Package 305 km/h limiter, and
	the exhaust and Active Sound Design in SPORT (see audio).
]]

return {
	id = "RefM5F90",
	displayName = "Brandt Nordwind RS",
	reference = "BMW M5 Competition (F90) (engineering reference only)",

	mass = {
		-- BMW publishes no dry weight for the F90.
		kerbKg = 1895, -- [F] DIN kerb weight, LCI (BMW 06/2020): fuel, no driver. US curb 4,345 lb = 1,971 kg [F]
		driverKg = 75, -- [A] one driver: 1,970 kg simulated = BMW's EU kerb mass (DIN + 75 kg) [F]
		frontShare = 0.544, -- [F] 54.4 % front / 45.6 % rear (BMW NA 2021)
		comHeight = 0.50, -- [E] not published; large saloon, V8 high in the hot-V, CFRP roof: 0.48-0.53 m
		-- [E] Box that carries the mass, sized for about 3,700 kg*m^2 in yaw (research: uniform-box value
		-- m(L^2+W^2)/12 = 4,660 scaled by 0.8 for mass between the axles), about 680 in roll, 3,250 in pitch.
		inertiaBox = { width = 1.85, height = 0.85, length = 4.37 },
	},

	dimensions = {
		length = 4.983, -- [F] LCI (pre-LCI 4.966)
		width = 1.903, -- [F] without mirrors (2.126 with)
		height = 1.469, -- [F] Competition, 7 mm lower than the M5
		wheelbase = 2.982, -- [F]
		trackFront = 1.625, -- [F] Competition (more negative camber)
		trackRear = 1.594, -- [F]
		frontOverhang = 0.888, -- [F] LCI dimension drawing (888 + 2,982 + 1,113 = 4,983 mm)
	},

	engine = {
		layout = "90-degree V8, twin-turbo hot-V (S63B44T4)", -- [F] code and turbos; [P] hot-V layout
		displacementCc = 4395, -- [F] bore 89.0 mm, stroke 88.3 mm, compression 10.0:1
		aspiration = "Turbo", -- [F] two twin-scroll turbos, cross-bank exhaust manifolds
		peakPowerKw = 460, -- [F] 625 PS / 617 hp
		peakPowerRpm = 6000, -- [F] (flat 460 kW from about 5,860 rpm on BMW's chart)
		peakTorqueNm = 750, -- [F]
		peakTorqueRpm = 1800, -- [F] start of the 750 Nm plateau, which runs to 5,860 rpm (LCI)
		idleRpm = 600, -- [E] not published; warm idle of the N63/S63 family 550-650 rpm
		limiterRpm = 7200, -- [F] BMW NA: redline 7,200 rpm (M5 CS, same engine); [P] S63TU manual: cut-off 7,200
		limiterHysteresisRpm = 150, -- [E] research suggests a 150-250 rpm bounce
		-- [E] kg*m^2: crank, flexplate and the converter's cover and impeller. Research estimate 0.30; a
		-- component sum (crank and pistons about 0.08, flexplate 0.025, converter primary side with oil
		-- about 0.10) gives about 0.21. Middle value.
		inertia = 0.25,
		-- Full-BOOST torque curve, {rpm, Nm} (docs/VEHICLE_CONFIG.md, "Turbo and supercharger torque
		-- curves"). With forcedInduction below, the steady full-throttle curve the game produces passes
		-- through BMW's 06/2020 chart: 400 Nm at 1,000 rpm, 480.5 at 1,244, 600 at 1,500, 750 from 1,800
		-- to 5,860, 732.5 at 6,000 (= 460 kW), 647.4 at 6,600, 587 at 7,000, 564 at 7,200 (all [F], read
		-- from the chart's vector paths; its power curve agrees within 0.5 kW).
		torqueCurve = {
			{ 600, 562 }, -- [E] gives the research's estimate of 300 Nm at 600 rpm (x 0.533 off boost)
			{ 800, 656 }, -- [E] gives 350 Nm at 800 rpm
			{ 1000, 750 }, -- [F] gives 400 Nm at 1,000 rpm
			{ 1244, 763.5 }, -- [E] full-boost value chosen so the steady curve gives the chart's 480.5 Nm
			{ 1500, 750 }, -- [F] gives 600 Nm at 1,500 rpm
			{ 1800, 750 }, -- [F] 750 Nm plateau from 1,800 rpm
			{ 5860, 750 }, -- [F] to 5,860 rpm (LCI; the chart's plotted plateau ends at 5,859)
			{ 6000, 732.5 }, -- [F] chart: 460 kW
			{ 6600, 647.4 }, -- [F] chart
			{ 7000, 587 }, -- [F] chart
			{ 7200, 564 }, -- [F] chart, where BMW's curve ends (cut-off)
		},
		-- [E] Engine braking with the throttle shut: static + perRpm * rpm (Nm): about 31 Nm at 1,000 rpm,
		-- 79 at 6,000 and 90 at 7,200. Motoring friction of a 4.4 L V8 (about 1.6 bar FMEP at 6,000 rpm, 55 Nm)
		-- plus closed-throttle pumping, which VALVETRONIC keeps low (about 0.5 bar), plus accessories.
		friction = { static = 22, perRpm = 0.0095 },
		throttleResponse = 16, -- [E] 1/s
		speedLimitKmh = 305, -- [F] M Driver's Package limit (BMW Ireland's LCI release says 304). Without it: 250 [F]
		forcedInduction = {
			type = "Turbo", -- [F] two twin-scroll turbochargers inside the V
			maxBoostBar = 1.75, -- [E] base M5 24.46 psi = 1.69 bar [F]; Competition estimated 1.7-1.8 bar
			offBoostTorqueShare = 0.533, -- derived from the [F] chart: 400 Nm at 1,000 rpm / 750 Nm
			boostStartRpm = 1100, -- [E] chart: torque starts climbing from naturally-aspirated level at 1,000-1,200 rpm
			fullBoostRpm = 1800, -- [F] full 750 Nm from 1,800 rpm
			spoolTime = 0.6, -- [E] twin-scroll turbos close to the ports; reviewers report essentially no lag
			dumpTime = 0.3, -- [E] no blow-off valve [P]: boost bleeds off through the engine and wastegates
		},
	},

	transmission = {
		type = "Automatic", -- [F] 8-speed M Steptronic torque-converter automatic (ZF 8HP: M8HP76 / GA8HP75Z)
		gearRatios = { 5.000, 3.200, 2.143, 1.720, 1.313, 1.000, 0.823, 0.640 }, -- [F]
		reverseRatio = 3.478, -- [F] EU sheet (BMW NA prints 3.38)
		finalDrive = 3.154, -- [F] (front and rear axle drives; transfer case 1:1 [A])
		efficiency = 0.88, -- [E] locked converter, transfer case and two axle drives: 0.85-0.90
		shiftTime = 0.2, -- [E] upshift speed change, Drivelogic 2 (research: about 0.35 / 0.22 / 0.12 s in Drivelogic 1 / 2 / 3)
		downshiftTime = 0.2, -- [E]
		shiftTorqueReduction = 0.4, -- [E] ignition retard during power-on upshifts
		downshiftBlip = 0.3, -- [E] rev-matching blip on downshifts
		turbineInertia = 0.05, -- [E] converter turbine and gearbox input
		converter = {
			stallRpm = 2500, -- [E] not published; research: converter flares to 2,500-3,000 rpm at full throttle from rest
			torqueRatio = 1.9, -- [E]
			couplingPoint = 0.87, -- [E]
		},
		lockup = {
			minGear = 1, -- [F] BMW: the lock-up clutch "fully engages once the car has pulled away"
			minSpeedKmh = 12, -- [E]
			engageTime = 0.4, -- [E]
			maxTorque = 1100, -- [E] about 1.5 x peak torque
		},
		autoUpshiftRpm = { light = 1700, full = 7050 }, -- [E] in D at full throttle it upshifts just before the cut-off [P]
		autoDownshiftRpm = { light = 1000, full = 4500 }, -- [E]
		minShiftInterval = 0.3, -- [E]
	},

	drivetrain = {
		layout = "AWD", -- [F] M xDrive: rear-biased all-wheel drive, 2WD selectable with DSC off
		-- [E] The electronically controlled multi-plate centre clutch in "4WD Sport" (M Dynamic Mode or DSC
		-- off): the rear axle is always driven and the front is brought in only when the rear can't take more
		-- torque [F]. BMW publishes no split; research estimate: up to about 35 % to the front in 4WD Sport
		-- (about 50 % in 4WD, 0 % in 2WD).
		-- The game's coupling only reacts to slip, while M xDrive also acts ahead of it, so the threshold is
		-- small (1.5 %) and the coupling stiff: this car puts up to about 10,000 Nm through the wheels in 1st.
		centreCoupling = { baseFrontShare = 0.05, maxFrontShare = 0.35, slipThreshold = 0.015, stiffness = 6000, preload = 0 },
		-- [E] Active M Differential: electronically controlled multi-plate rear differential, 0-100 % locking
		-- [F]. Approximated with a clutch-type limited slip.
		rearDifferential = { type = "LimitedSlip", preload = 100, powerLock = 0.40, coastLock = 0.20, stiffness = 200 },
		frontDifferential = { type = "Open" }, -- [A] no front limited slip in any BMW material
		-- [E] DSC with M xDrive and launch control [F/P]; automatic launches rely on it. The target sits a
		-- little past the tyre's peak slip (0.10), as launch control does; recovery 4/s so one slip spike at
		-- a standing start doesn't hold the torque down for half a second.
		tractionControl = { enabled = true, targetSlip = 0.12, rate = 15, recovery = 4, headroom = 1.3 },
	},

	-- [E] Not published. Ride frequencies of 1.7 Hz front and 1.85 Hz rear (research) with the game's whole
	-- corner mass on the springs (536 kg front, 449 kg rear), damping ratios of about 0.3 in bump and 0.5 in
	-- rebound, and the research's anti-roll-bar estimates (Competition: firmer rear bar [F]).
	suspension = {
		front = {
			springRate = 61000, -- N/m at the wheel
			bumpDamping = 3400, -- N*s/m
			reboundDamping = 5700, -- N*s/m
			staticLength = 0.25, -- mount to wheel centre at ride height
			bumpTravel = 0.09, -- from ride height
			droopTravel = 0.08, -- from ride height
			bumpStopRate = 250000, -- N/m
			antiRollRate = 30000, -- N/m of left-right travel difference
			rollCenterHeight = 0.07, -- double wishbone [F]
			rideHeightOffset = 0, -- positive raises the car
		},
		rear = {
			springRate = 60700,
			bumpDamping = 3100,
			reboundDamping = 5200,
			staticLength = 0.25,
			bumpTravel = 0.09,
			droopTravel = 0.08,
			bumpStopRate = 250000,
			antiRollRate = 22000,
			rollCenterHeight = 0.11, -- five-link [F]
			rideHeightOffset = 0,
		},
	},

	tires = {
		-- [E] The OE tyre is the Pirelli P Zero (star) [M] (engineering reference only), a road performance
		-- tyre. muLong is fitted to Car and Driver's 70-0 mph stop in 139 ft (42.4 m, about 1.18 g mean on a
		-- 1,970 kg car); muLat aims at C/D's 0.95-1.00 g skidpad once load transfer and load sensitivity take
		-- their share (untested: needs Studio). The rest is the shared Performance compound.
		compounds = {
			NordwindRoad = { base = "Performance", muLong = 1.23, muLat = 1.08 },
		},
		front = { widthMm = 275, aspect = 35, rimInches = 20, compound = "NordwindRoad", inertia = 1.7 }, -- [F] 275/35 ZR20 on 9.5J; [E] inertia (kg*m^2)
		rear = { widthMm = 285, aspect = 35, rimInches = 20, compound = "NordwindRoad", inertia = 1.9 }, -- [F] 285/35 ZR20 on 10.5J; [E] inertia
	},

	brakes = {
		discs = "M Compound, 395 x 36 mm front with 6-piston fixed calipers, 380 x 28 mm rear with 1-piston floating calipers", -- [F]
		maxTorqueFront = 4200, -- [E] Nm per wheel, enough to lock the wheels (research)
		maxTorqueRear = 2200, -- [E] Nm per wheel (about 66 % front)
		handbrakeTorque = 2200, -- [E] Nm per rear wheel (electric parking brake in the rear calipers [F])
		abs = { enabled = true, targetSlip = 0.12 }, -- [E]
	},

	aero = {
		dragArea = 0.77, -- [F] CdA, LCI M5 Competition (BMW 06/2020); Cd 0.31 [F] (BMW NA)
		-- [E] Not published; road saloon with a boot-lid Gurney: slight net lift, about 240 N at 250 km/h
		-- (negative = lift).
		downforceAreaFront = -0.05,
		downforceAreaRear = -0.03,
	},

	steering = {
		maxAngleLowSpeed = 33, -- [E] mean road-wheel angle from the 12.6 m turning circle [F] (inner 38, outer 29)
		maxAngleHighSpeed = 4.5, -- [E] road-wheel degrees at highSpeedKmh and above
		highSpeedKmh = 250, -- [E]
		rate = 200, -- [E] degrees per second the road wheels can turn
		ackermann = 0.6, -- [E] 0 = parallel steering, 1 = full Ackermann
	},

	-- [E] Sound. The engine sheet is made from the car's acoustic definition, assets/audio/engines/RefM5F90.json
	-- (firing order 1-5-4-8-6-3-7-2, cross-plane crank, hot-V cross-bank manifolds giving each twin-scroll
	-- turbo an even 180-degree pulse train, valved dual-branch exhaust, fuel-cut limiter at 7,200 rpm), by
	-- tools/synth_audio.py; see docs/AUDIO.md and docs/cars/RefM5F90.md. The exhaust and Active Sound Design
	-- are in SPORT. Loudness over rpm and load comes from the sheet's per-loop gains (research estimate of
	-- the cabin levels: idle 47, full throttle 79 dBA); engineVolume scales all of it. Volumes are Roblox
	-- Sound volumes. To be tuned by ear in testing.
	audio = {
		engineSheet = "RefM5F90_Engine",
		effectsSheet = "Driving_Effects",
		engineVolume = 1.0, -- overall engine level (1 = the sheet's calibrated gains)
		-- used only with a sheet that has no per-loop gains:
		idleLevel = 0.3,
		rpmCurve = 1.0,
		redlineRpm = 7200, -- [F]
		offThrottleLevel = 0.55,
		loadAttack = 25, -- 1/s, how fast the mix follows the throttle opening
		loadRelease = 12, -- 1/s, and closing
		minPitch = 0.5,
		maxPitch = 2.0,
		-- rev limiter: the limiter loops take over while the fuel cut keeps coming back. In the simulation the
		-- cut flag is on about 88 % of the time at the limiter, with gaps of at most 0.09 s, inside the hold.
		limiterHold = 0.3,
		limiterAttack = 40,
		limiterRelease = 10,
		-- forced induction: a subdued whistle (research), about 11 dB under the engine at 3,000 rpm on full
		-- boost; no blow-off valve [P], so no blow-off sound (the sheet has none either)
		turboVolume = 0.05,
		blowOffVolume = 0,
		blowOffMinBoost = 0.35,
		superchargerVolume = 0,
		-- torque-converter upshifts: a short torque dip, no dual-clutch "bark" (research)
		shiftCutTime = 0.08,
		shiftCutMinRpm = 4500,
		shiftCutVolume = 0.12,
		shiftClunkVolume = 0.15,
		-- SPORT: occasional light burble on lift-off; the EU particulate filter softens it
		crackleMinRpm = 3500,
		crackleDuration = 1.0,
		crackleRate = 5,
		crackleVolume = 0.25,
		bumpMinSpeed = 0.6,
		bumpVolume = 0.5,
		squealVolume = 0.5,
		squealStart = 1.2,
		squealRange = 1.5,
		roadVolume = 0.35,
		windVolume = 0.5,
		whineVolume = 0.04,
		whineTeeth = 13, -- [E] final drive 41:13 = 3.1538, which matches the published 3.154 [F]
		-- cockpit camera: the engine at its calibrated cabin level (the measured cabin levels include Active
		-- Sound Design), a low-frequency lift for ASD's speaker layer of low engine orders (at most about 6 dB
		-- at full throttle in SPORT [E]), and a well-insulated cabin ("mellow from inside", a quiet idle)
		interior = { engine = 1.0, wind = 0.4, road = 1.0, squeal = 0.7, lowGain = 5, midGain = -2, highGain = -12 },
	},

	performanceTargets = {
		zeroTo60Mph = 3.1, -- [F] BMW NA 2021 (taken as from a standstill [A])
		zeroTo60MphRollout = 2.8, -- [M] Car and Driver, 2021 M5 Competition, with a 1-ft rollout
		zeroTo100 = 3.3, -- [F] BMW 06/2020 (The Citizen measured 3.28 s [M])
		zeroTo100Mph = 6.7, -- [M] Car and Driver 2021, with a 1-ft rollout
		zeroTo200 = 10.8, -- [F] BMW 06/2020
		quarterMile = 11.22, -- [M] The Citizen 2021, LCI, from a standstill [A]; C/D: 10.9 s with a 1-ft rollout
		quarterMileKmh = 206.6, -- [M] The Citizen; C/D 128 mph = 206 km/h
		topSpeedKmh = 305, -- [F] with the M Driver's Package (250 without)
		brake70MphTo0 = 42.4, -- [M] Car and Driver 2021: 139 ft
		-- no 100-0 km/h figure is published; C/D's 70-0 mph scales to about 33.5 m [E]
	},

	visual = {
		bodyColor = Color3.fromRGB(30, 88, 170), -- [A] approximation of Marina Bay Blue, a launch colour
		driverSide = "Left", -- [F] left-hand drive (EU reference car)
		-- [E] Side profile measured by the research on BMW's LCI side-view dimension drawing (06/2020, page 6),
		-- scaled by the 4,983 mm length (measurement only; nothing traced), +/- 0.01 of length. A Commons
		-- near-profile photo agrees within 0.01-0.02. The highest point is the published height [F].
		blockout = {
			profile = {
				{ 0.000, 0.62 }, -- nose: near-vertical face (sets the headlight height)
				{ 0.025, 0.77 }, -- bonnet leading edge
				{ 0.050, 0.83 },
				{ 0.100, 0.90 },
				{ 0.200, 0.97 },
				{ 0.305, 1.00 }, -- windscreen base (cowl)
				{ 0.350, 1.15 },
				{ 0.400, 1.29 }, -- windscreen rake about 27 degrees
				{ 0.470, 1.42 }, -- windscreen header
				{ 0.590, 1.469 }, -- roof peak = published height 1,469 mm [F]
				{ 0.700, 1.455 }, -- rear window top
				{ 0.800, 1.30 },
				{ 0.885, 1.10 }, -- rear window base, start of the boot deck
				{ 0.950, 1.06 },
				{ 0.975, 1.045 }, -- boot-lid spoiler lip
				{ 1.000, 0.95 }, -- tail
			},
			greenhouse = { 0.305, 0.885 }, -- cowl to rear-window base
			-- The stand-in's lower body is a box up to the beltline over the whole length, so this sits
			-- between the real side-window sill (about 1.0 m) and the bonnet's leading edge (0.77 m).
			beltline = 0.94,
			cabinWidth = 0.76,
			sill = 0.17, -- research: sills about 0.175 m off the ground (ground clearance 128 mm [F])
		},
	},
}
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="Folder" referent="RBX00000039">
<Properties>
<string name="Name">VehicleTelemetry</string>
</Properties>
<Item class="ModuleScript" referent="RBX0000003A">
<Properties>
<string name="Name">Telemetry</string>
<ProtectedString name="Source"><![CDATA[--[[
	Telemetry
	Shares the latest simulation numbers with the HUD, and times standard performance runs so
	they can be compared with the factory figures (the car's performanceTargets):
	  0-60 mph, 0-100 and 0-200 km/h, and the quarter mile (time and speed at the line): start from a
	  standstill and accelerate; timing starts when the car moves (no rollout), and braking ends the run.
	  100-0 km/h braking: brake fully from above 100 km/h and hold the pedal until stopped.
	  Top speed: the highest speed reached since the car spawned.
]]

local Telemetry = {}

local QUARTER_MILE = 402.336 -- m
local SPEED_MARKS = { zeroTo60Mph = 96.56064, zeroTo100 = 100, zeroTo200 = 200 } -- km/h

Telemetry.sim = nil -- the active VehicleSimulation
Telemetry.frame = {} -- extra per-frame values from the controller (G-forces, fps)
Telemetry.results = { zeroTo100 = nil, zeroTo200 = nil, zeroTo60Mph = nil, quarterMile = nil, quarterMileKmh = nil, brake100 = nil, topSpeed = 0 }

local function newRun()
	return { armed = false, start = nil, distance = 0, lastPosition = nil, done = {}, brakeStart = nil, previousKmh = 0 }
end

local run = newRun()

function Telemetry.reset()
	Telemetry.results = { zeroTo100 = nil, zeroTo200 = nil, zeroTo60Mph = nil, quarterMile = nil, quarterMileKmh = nil, brake100 = nil, topSpeed = 0 }
	run = newRun()
end

-- now: seconds; speedKmh: car speed; brake: brake pedal 0-1; position: Vector3 in metres
function Telemetry.updateTimers(now: number, speedKmh: number, brake: number, position: Vector3)
	local results = Telemetry.results
	results.topSpeed = math.max(results.topSpeed, speedKmh)

	if speedKmh < 0.5 then
		if run.brakeStart then
			results.brake100 = (position - run.brakeStart).Magnitude
			run.brakeStart = nil
		end
		run.armed = true
		run.start = nil
		run.distance = 0
		run.done = {}
	elseif run.armed then
		run.start = run.start or now
		if run.lastPosition then
			run.distance += (position - run.lastPosition).Magnitude
		end
		if brake > 0.5 then
			run.armed = false -- braking ends an acceleration run
		else
			local elapsed = now - run.start
			local finished = true
			for key, kmh in SPEED_MARKS do
				if not run.done[key] and speedKmh >= kmh then
					results[key] = elapsed
					run.done[key] = true
				end
				finished = finished and run.done[key] == true
			end
			if not run.done.quarterMile and run.distance >= QUARTER_MILE then
				results.quarterMile = elapsed
				results.quarterMileKmh = speedKmh
				run.done.quarterMile = true
			end
			if finished and run.done.quarterMile then
				run.armed = false
			end
		end
	end
	run.lastPosition = position

	if brake > 0.9 and speedKmh <= 100 and run.previousKmh > 100 then
		run.brakeStart = position
	elseif brake < 0.5 then
		run.brakeStart = nil -- the pedal was released, so the stop doesn't count
	end
	run.previousKmh = speedKmh
end

return Telemetry
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX0000003B">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Folder" referent="RBX0000003C">
<Properties>
<string name="Name">Server</string>
</Properties>
<Item class="ModuleScript" referent="RBX0000003D">
<Properties>
<string name="Name">CityBuilder</string>
<ProtectedString name="Source"><![CDATA[--[[
	CityBuilder
	Builds Sekirei Bay Loop, the city map (TrafficSystem/Maps/City): a fictional night-time urban
	expressway. The road is a concrete viaduct with tight parapet walls on T-shaped piers, dropping
	onto embankments and into two sodium-lit box tunnels under built-over decks ("podiums"), with
	lamps on the parapets, sign gantries, noise screens through the S-bends, two decorative viaducts
	across the bay, a dense backdrop of buildings with lit windows and billboards, the bay and a far
	shore.

	The road's shape comes from the map's data through RoadGeometry; RoadKit makes the parts. Sizes
	are in metres. The street level is the map's base height (0 m); the bay is south of the shore.
	Part counts are kept down by using long boxes where the road is straight and lighting only
	every other lamp; the builder prints how many parts it made.
]]

local Workspace = game:GetService("Workspace")

local RoadKit = require(script.Parent.RoadKit)

local M = RoadKit.M
local C = RoadKit.COLORS

local CityBuilder = {}

-- cross-section
local SLAB = 0.6 -- m, the road deck
local GIRDER = 1.8 -- m, the box girder under raised road
local WALL_WIDTH = 0.5
local WALL_HEIGHT = 1.1 -- parapet above the road
local PIER_MIN = 6 -- m: road at least this high stands on piers; lower, on a solid embankment
local GRADE = 0.8 -- m: road lower than this sits on the street
local PIER_SPACING = 34 -- m
local DASH, GAP = 8, 12 -- lane lines: metres painted and bare, expressway style
local LAMP_SPACING = 40 -- m between lamps, alternating sides
-- tunnels
local TUNNEL_HEIGHT = 6.4 -- m, road to ceiling
local TUNNEL_WALL = 0.8
local ROOF = 1.0
local PODIUM = 22 -- m of built-over deck beside each tunnel wall
local TUNNEL_LAMP_SPACING = 12 -- m between lamps on each wall
-- the bay
local SEA_LEVEL = -1.2 -- m below the street
local SEA_BED = -8
local NOISE_SCREENS = { { 3380, 5000 } } -- s ranges with tall glass screens on both parapets

local COLORS = {
	ground = Color3.fromRGB(38, 40, 44),
	water = Color3.fromRGB(14, 28, 44),
	farShore = Color3.fromRGB(30, 32, 34),
	deck = Color3.fromRGB(150, 150, 146),
	girder = Color3.fromRGB(112, 114, 112),
	podium = Color3.fromRGB(96, 98, 100),
	park = Color3.fromRGB(34, 58, 38),
	screen = Color3.fromRGB(150, 190, 200),
	exitSign = Color3.fromRGB(40, 220, 110),
	lampLed = Color3.fromRGB(255, 238, 210),
	aviation = Color3.fromRGB(255, 40, 30),
	buildings = {
		Color3.fromRGB(58, 62, 70), Color3.fromRGB(72, 76, 84), Color3.fromRGB(44, 48, 56), Color3.fromRGB(88, 90, 96),
		Color3.fromRGB(66, 60, 56), Color3.fromRGB(52, 58, 66), Color3.fromRGB(96, 92, 86),
	},
	windows = {
		Color3.fromRGB(235, 196, 128), Color3.fromRGB(190, 210, 240), Color3.fromRGB(226, 226, 214),
		Color3.fromRGB(240, 180, 110), Color3.fromRGB(170, 230, 220),
	},
	neonSigns = { Color3.fromRGB(255, 70, 120), Color3.fromRGB(60, 200, 255), Color3.fromRGB(255, 190, 40), Color3.fromRGB(150, 90, 255) },
}

local GANTRIES = {
	{ s = 500, lines = { "KIRAMEKI JCT  2 km", "Seaside Straight" } },
	{ s = 2350, lines = { "KIRAMEKI JCT", "Ward S-bends ahead" } },
	{ s = 4600, lines = { "KAGEROU TUNNEL  2.5 km", "Lights on   Keep your distance" } },
	{ s = 8000, lines = { "TSUKIMI JCT", "Loop ahead   60 km/h" } },
	{ s = 10560, lines = { "HOTARU TUNNEL", "Umikaze JCT  1 km" } },
	{ s = 12450, lines = { "SEASIDE STRAIGHT", "Kirameki JCT  3 km" } },
}

local BILLBOARDS = {
	"HOSHIMI COFFEE", "SEKIREI DENKI", "KAZE RAMEN", "MIDNIGHT FM 88.1", "AOZORA BEER", "REDLINE MOTORS",
	"BLUE LINE BANK", "TSUBAME TYRES", "NEON TONIGHT", "KITE CAMERA", "SHINKAI HOTEL", "TOKAI DRINKS",
}

local function heightAbove(road, s: number): number
	local y = road:heightAt(s)
	return y - road.base
end

local function inTunnel(road, s: number)
	return road:sectionAt(s, "tunnel")
end

-- Points where the road's support changes (pier, embankment, street), found every metre.
local function supportBreaks(road): { number }
	local breaks = {}
	local function kind(s: number): number
		local h = heightAbove(road, s)
		return if h >= PIER_MIN then 2 elseif h >= GRADE then 1 else 0
	end
	local previous = kind(0)
	for s = 1, math.floor(road.length) do
		local k = kind(s)
		if k ~= previous then
			table.insert(breaks, s)
			previous = k
		end
	end
	for _, range in NOISE_SCREENS do
		table.insert(breaks, range[1])
		table.insert(breaks, range[2])
	end
	return breaks
end

local function screened(s: number): boolean
	for _, range in NOISE_SCREENS do
		if s >= range[1] and s < range[2] then
			return true
		end
	end
	return false
end

--[[
	The road deck all round: asphalt, parapets (or tunnel walls), edge lines, and what holds it up:
	a box girder where it's raised, a solid embankment where it's low.
]]
local function buildDeck(folder: Folder, road, points: { number })
	local deck = RoadKit.folder(folder, "Road")
	local walls = RoadKit.folder(folder, "Walls")
	local structure = RoadKit.folder(folder, "Structure")
	local markings = RoadKit.folder(folder, "Markings")
	local width = road.leftEdge + road.rightEdge
	local centre = (road.rightEdge - road.leftEdge) / 2
	local leftWall = -(road.leftEdge + WALL_WIDTH / 2)
	local rightWall = road.rightEdge + WALL_WIDTH / 2
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local mid = (a + b) / 2
		local extend = RoadKit.overlap(road, a, b, width + 2 * WALL_WIDTH)
		RoadKit.strip(deck, road, "Asphalt", a, b, centre, width, SLAB, 0, C.asphalt, Enum.Material.Asphalt, true, extend)
		local ha, hb = heightAbove(road, a), heightAbove(road, b)
		local low, high = math.min(ha, hb), math.max(ha, hb)
		if not inTunnel(road, mid) then
			local depth = WALL_HEIGHT + SLAB + (if low >= PIER_MIN then GIRDER * 0.4 else 0)
			for _, offset in { leftWall, rightWall } do
				RoadKit.strip(walls, road, "Parapet", a, b, offset, WALL_WIDTH, depth, WALL_HEIGHT, COLORS.deck, Enum.Material.Concrete,
					true, RoadKit.overlap(road, a, b, WALL_WIDTH))
				if screened(mid) then
					local screen = RoadKit.strip(walls, road, "NoiseScreen", a, b, offset, 0.12, 2.6, WALL_HEIGHT + 2.6, COLORS.screen,
						Enum.Material.Glass, true, RoadKit.overlap(road, a, b, 0.12))
					if screen then
						screen.Transparency = 0.55
						screen.CastShadow = false
					end
				end
			end
			if low >= PIER_MIN then
				RoadKit.strip(structure, road, "Girder", a, b, centre, width * 0.55, GIRDER, -SLAB, COLORS.girder, Enum.Material.Concrete,
					true, RoadKit.overlap(road, a, b, width * 0.55))
			elseif high >= GRADE then
				-- a solid embankment with concrete sides, reaching below the street
				RoadKit.strip(structure, road, "Embankment", a, b, centre, width + 2 * WALL_WIDTH, high + 1, -SLAB, COLORS.girder,
					Enum.Material.Concrete, true, extend)
			end
		end
	end
	RoadKit.solidLine(markings, road, points, -road.halfWidth, 0.15, C.line)
	RoadKit.solidLine(markings, road, points, road.halfWidth, 0.15, C.line)
	for k = 1, road.lanes - 1 do
		RoadKit.dashes(markings, road, 0, road.length, (k - road.lanes / 2) * road.laneWidth, DASH, GAP, 0.15, C.line)
	end
	RoadKit.strip(markings, road, "StartLine", road.data.start, road.data.start + 0.6, 0, road.lanes * road.laneWidth, 0.02, 0.02,
		C.line, Enum.Material.SmoothPlastic, false)
end

-- Distances along the loop near which piers must not stand (where a viaduct passes under the road).
local function pierExclusions(map): { number }
	local out = {}
	for _, flyover in map.data.decor.flyovers do
		if flyover.top < heightAbove(map.road, flyover.s) then
			table.insert(out, flyover.s)
		end
	end
	return out
end

-- T-shaped piers under raised road: a square column and a cap beam across the deck.
local function buildPiers(folder: Folder, map)
	local road = map.road
	local piers = RoadKit.folder(folder, "Piers")
	local shore = map.data.decor.shore
	local exclusions = pierExclusions(map)
	local width = road.leftEdge + road.rightEdge
	local centre = (road.rightEdge - road.leftEdge) / 2
	local s = PIER_SPACING / 2
	while s < road.length do
		local h = heightAbove(road, s)
		local clear = h >= PIER_MIN and heightAbove(road, s - 3) >= PIER_MIN and heightAbove(road, s + 3) >= PIER_MIN and not inTunnel(road, s)
		for _, at in exclusions do
			if math.abs(road:delta(at, s)) < 22 then
				clear = false
			end
		end
		local foot = RoadKit.point(road, s, centre, 0)
		-- never stand on another part of the loop
		if clear and road:distanceToRoad(foot, s, 80) < 4 then
			clear = false
		end
		if clear then
			local underside = h - SLAB - GIRDER
			local bottom = if foot.Z > shore then SEA_BED else -0.5
			local capDepth = 1.4
			local columnHeight = underside - capDepth - bottom
			local base = RoadKit.levelCFrame(road, s, centre, -h)
			RoadKit.part(piers, "Column", Vector3.new(2.6, columnHeight, 2.6), base * CFrame.new(0, (bottom + columnHeight / 2) / M, 0),
				COLORS.deck, Enum.Material.Concrete, true)
			RoadKit.part(piers, "Cap", Vector3.new(width * 0.85, capDepth, 2.6), base * CFrame.new(0, (underside - capDepth / 2) / M, 0),
				COLORS.deck, Enum.Material.Concrete, true)
		end
		s += PIER_SPACING
	end
end

-- Lamps on the parapets, alternating sides, reaching over the road; every other one lights it.
-- None where a viaduct passes low overhead.
local function buildLamps(folder: Folder, map)
	local road = map.road
	local lamps = RoadKit.folder(folder, "Lamps")
	local overhead = {}
	for _, flyover in map.data.decor.flyovers do
		if flyover.top > heightAbove(road, flyover.s) then
			table.insert(overhead, flyover.s)
		end
	end
	local s = 10
	local n = 0
	while s < road.length do
		local clear = not inTunnel(road, s) and not inTunnel(road, s + 15) and not inTunnel(road, s - 15)
		for _, at in overhead do
			if math.abs(road:delta(at, s)) < 25 then
				clear = false
			end
		end
		local side = if n % 2 == 0 then -1 else 1
		local offset = if side < 0 then -(road.leftEdge + WALL_WIDTH / 2) else road.rightEdge + WALL_WIDTH / 2
		-- nor under another part of the loop (where it passes over itself)
		if clear and road:distanceToRoad(RoadKit.point(road, s, offset, 0), s, 80) < 6 then
			clear = false
		end
		if clear then
			local base = RoadKit.levelCFrame(road, s, offset, WALL_HEIGHT)
			local poleHeight = 8
			RoadKit.part(lamps, "Pole", Vector3.new(0.25, poleHeight, 0.25), base * CFrame.new(0, poleHeight / 2 / M, 0), C.steel,
				Enum.Material.Metal, false)
			-- the arm reaches toward the road's centre (-side along the base's X axis)
			RoadKit.part(lamps, "Arm", Vector3.new(2.6, 0.15, 0.15), base * CFrame.new(-side * 1.3 / M, poleHeight / M, 0), C.steel,
				Enum.Material.Metal, false)
			local head = RoadKit.part(lamps, "Lamp", Vector3.new(1.2, 0.22, 0.5), base * CFrame.new(-side * 2.5 / M, (poleHeight - 0.15) / M, 0),
				COLORS.lampLed, Enum.Material.Neon, false)
			head.CastShadow = false
			if n % 2 == 0 then
				local light = Instance.new("SpotLight")
				light.Face = Enum.NormalId.Bottom
				light.Angle = 110
				light.Range = 60
				light.Brightness = 3
				light.Color = COLORS.lampLed
				light.Shadows = false
				light.Parent = head
			end
		end
		n += 1
		s += LAMP_SPACING
	end
end

--[[
	A box tunnel from section.from to section.to: tiled walls, the roof, a built-over deck beside it
	(the podium) for buildings or a park on top, headwalls with the tunnel's name at the portals,
	sodium lamps on both walls, emergency signs, jet fans, and the TunnelZone boxes.
]]
local function buildTunnel(folder: Folder, map, section)
	local road = map.road
	local tunnel = RoadKit.folder(folder, section.name or "Tunnel")
	local s0, s1 = section.from, section.to
	local points = RoadKit.pieces(road, s0, s1)
	local leftFace, rightFace = -road.leftEdge, road.rightEdge
	local outerLeft, outerRight = leftFace - TUNNEL_WALL, rightFace + TUNNEL_WALL
	local podiumLeft, podiumRight = outerLeft - PODIUM, outerRight + PODIUM
	local podiumCentre = (podiumLeft + podiumRight) / 2
	local podiumWidth = podiumRight - podiumLeft
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local high = math.max(heightAbove(road, a), heightAbove(road, b))
		local extend = RoadKit.overlap(road, a, b, podiumWidth)
		for _, offset in { leftFace - TUNNEL_WALL / 2, rightFace + TUNNEL_WALL / 2 } do
			RoadKit.strip(tunnel, road, "TunnelWall", a, b, offset, TUNNEL_WALL, TUNNEL_HEIGHT + SLAB, TUNNEL_HEIGHT, C.tunnelTile,
				Enum.Material.SmoothPlastic, true, RoadKit.overlap(road, a, b, TUNNEL_WALL))
		end
		RoadKit.strip(tunnel, road, "Roof", a, b, podiumCentre, podiumWidth, ROOF, TUNNEL_HEIGHT + ROOF, COLORS.podium,
			Enum.Material.Concrete, true, extend)
		-- the podium's solid sides, from the street up to the roof
		for _, offset in { (podiumLeft + outerLeft) / 2, (outerRight + podiumRight) / 2 } do
			RoadKit.strip(tunnel, road, "Podium", a, b, offset, PODIUM, TUNNEL_HEIGHT + high + 1, TUNNEL_HEIGHT, COLORS.podium,
				Enum.Material.Concrete, true, RoadKit.overlap(road, a, b, PODIUM))
		end
	end
	-- headwalls above the portals, with the tunnel's name facing approaching cars at the entrance
	for _, at in { s0, s1 } do
		local base = RoadKit.levelCFrame(road, at, podiumCentre, TUNNEL_HEIGHT + ROOF)
		RoadKit.part(tunnel, "Headwall", Vector3.new(podiumWidth, 2.4, 1.0), base * CFrame.new(0, 1.2 / M, 0), COLORS.podium,
			Enum.Material.Concrete, true)
	end
	local nameCFrame = RoadKit.levelCFrame(road, s0 - 0.6, 0, TUNNEL_HEIGHT + 1.5) * CFrame.Angles(0, math.pi, 0)
	local length = s1 - s0
	RoadKit.sign(tunnel, "TunnelName", Vector3.new(14, 1.8, 0.2), nameCFrame, Color3.fromRGB(16, 20, 28),
		{ string.upper(section.name or "Tunnel") .. string.format("   %.1f km", length / 1000) }, Color3.fromRGB(255, 255, 255))

	-- sodium lamps on both walls, staggered; one in four lights the tunnel, alternating walls
	local lamps = RoadKit.folder(tunnel, "Lamps")
	local n = 0
	local s = s0 + TUNNEL_LAMP_SPACING / 2
	while s < s1 - 2 do
		local onLeft = n % 2 == 0
		local offset = if onLeft then leftFace + 0.2 else rightFace - 0.2
		local fixture = RoadKit.part(lamps, "SodiumLamp", Vector3.new(0.35, 0.3, 1.6), RoadKit.cframe(road, s, offset, TUNNEL_HEIGHT - 1.2),
			C.sodium, Enum.Material.Neon, false)
		fixture.CastShadow = false
		if n % 8 == 0 or n % 8 == 5 then
			local light = Instance.new("PointLight")
			light.Range = 50
			light.Brightness = 2.4
			light.Color = C.sodium
			light.Shadows = false
			light.Parent = fixture
		end
		n += 1
		s += TUNNEL_LAMP_SPACING / 2
	end
	-- emergency exit signs and jet fans
	s = s0 + 75
	while s < s1 - 20 do
		local sign = RoadKit.part(tunnel, "ExitSign", Vector3.new(0.15, 0.45, 0.9), RoadKit.cframe(road, s, leftFace + 0.1, 2.4),
			COLORS.exitSign, Enum.Material.Neon, false)
		sign.CastShadow = false
		s += 150
	end
	s = s0 + 160
	while s < s1 - 100 do
		for _, offset in { -2.6, 2.6 } do
			local fan = RoadKit.part(tunnel, "JetFan", Vector3.new(4, 1.2, 1.2), RoadKit.cframe(road, s, offset, TUNNEL_HEIGHT - 0.9)
				* CFrame.Angles(0, math.pi / 2, 0), C.steel, Enum.Material.Metal, false)
			fan.Shape = Enum.PartType.Cylinder
		end
		s += 350
	end
	RoadKit.tunnelZones(tunnel, road, s0, s1, leftFace, rightFace, TUNNEL_HEIGHT, {
		ReverbDecay = section.reverb or 1.6,
		TunnelName = section.name or "Tunnel",
		MapId = map.id,
	})
	return podiumLeft, podiumRight
end

local function buildGantries(folder: Folder, map)
	local road = map.road
	local gantries = RoadKit.folder(folder, "Gantries")
	for _, g in GANTRIES do
		-- the posts stand on the parapets
		RoadKit.gantry(gantries, road, g.s, -(road.leftEdge + WALL_WIDTH / 2) + 0.6, road.rightEdge + WALL_WIDTH / 2 - 0.6, 5.6, {
			{ offset = 0, width = road.lanes * road.laneWidth * 0.85, lines = g.lines },
		})
	end
end

-- The plan-view centre line of a decorative viaduct: start point, direction and length.
local function flyoverLine(road, flyover): (Vector3, Vector3, number)
	local x, z, heading = road:planAt(flyover.s)
	local angle = heading + math.rad(flyover.angle)
	local direction = Vector3.new(math.cos(angle), 0, math.sin(angle))
	local start = Vector3.new(x, 0, z) - direction * flyover.back
	return start, direction, flyover.back + flyover.ahead
end

local function distanceToSegment(p: Vector3, a: Vector3, direction: Vector3, length: number): number
	local d = p - a
	local t = math.clamp(d.X * direction.X + d.Z * direction.Z, 0, length)
	local q = a + direction * t
	return math.sqrt((p.X - q.X) ^ 2 + (p.Z - q.Z) ^ 2)
end

-- Decorative viaducts: level deck at the junction, ramps down to the ground at both ends, piers
-- that keep off the loop, dotted lights along both edges, and suspension towers if asked.
local function buildFlyover(folder: Folder, map, flyover)
	local road = map.road
	local viaduct = RoadKit.folder(folder, flyover.name or "Viaduct")
	local start, direction, length = flyoverLine(road, flyover)
	local shore = map.data.decor.shore
	local farShore = map.data.decor.farShore
	local deckWidth, deckDepth = 12, 1.6
	local top = flyover.top
	local ramp = flyover.ramp
	local function topAt(t: number): number
		return top * math.clamp(math.min(t, length - t) / ramp, 0, 1)
	end
	local function ground(p: Vector3): number
		return if p.Z > shore and p.Z < farShore then SEA_BED else -0.5
	end
	local right = Vector3.new(-direction.Z, 0, direction.X)
	-- deck in three straight boxes per side of the junction: ramp, level, level, ramp
	local cuts = { 0, ramp, length / 2, length - ramp, length }
	for i = 1, #cuts - 1 do
		local t0, t1 = cuts[i], cuts[i + 1]
		local piece = math.ceil((t1 - t0) / 380)
		for j = 0, piece - 1 do
			local a0 = t0 + (t1 - t0) * j / piece
			local a1 = t0 + (t1 - t0) * (j + 1) / piece
			local pa = start + direction * a0 + Vector3.new(0, topAt(a0), 0)
			local pb = start + direction * a1 + Vector3.new(0, topAt(a1), 0)
			local mid = (pa + pb) / 2
			local axis = CFrame.lookAt(mid / M, pb / M)
			local span = (pb - pa).Magnitude
			RoadKit.part(viaduct, "Deck", Vector3.new(deckWidth, deckDepth, span + 0.3), axis * CFrame.new(0, -deckDepth / 2 / M, 0),
				COLORS.deck, Enum.Material.Concrete, true)
			for _, side in { -1, 1 } do
				RoadKit.part(viaduct, "Parapet", Vector3.new(0.4, 1.1, span + 0.3), axis * CFrame.new(side * (deckWidth / 2 - 0.2) / M, 0.55 / M, 0),
					COLORS.deck, Enum.Material.Concrete, true)
			end
		end
	end
	-- piers and edge lights
	local t = 20
	while t < length - 20 do
		local h = topAt(t)
		local foot = start + direction * t
		if h > 5 and road:distanceToRoad(foot) > 3 then
			local bottom = ground(foot)
			local height = h - deckDepth - bottom
			RoadKit.part(viaduct, "Pier", Vector3.new(2.2, height, 2.2), CFrame.new((foot + Vector3.new(0, bottom + height / 2, 0)) / M),
				COLORS.deck, Enum.Material.Concrete, true)
		end
		if h > 2 then
			for _, side in { -1, 1 } do
				local p = foot + right * side * (deckWidth / 2 - 0.2) + Vector3.new(0, h + 1.2, 0)
				local dot = RoadKit.part(viaduct, "EdgeLight", Vector3.new(0.3, 0.3, 0.3), CFrame.new(p / M), COLORS.lampLed, Enum.Material.Neon, false)
				dot.CastShadow = false
			end
		end
		t += 45
	end
	if flyover.towers then
		-- two suspension towers over the water, with lit cables between them
		local over = {}
		t = 0
		while t < length do
			local p = start + direction * t
			if p.Z > shore + 300 and p.Z < farShore - 300 then
				table.insert(over, t)
			end
			t += 10
		end
		if #over > 2 then
			local first, last = over[1], over[#over]
			local towers = { first + (last - first) * 0.3, first + (last - first) * 0.7 }
			local towerHeight = top + 90
			for _, at in towers do
				local foot = start + direction * at
				for _, side in { -1, 1 } do
					local p = foot + right * side * (deckWidth / 2 + 1.5)
					RoadKit.part(viaduct, "Tower", Vector3.new(3, towerHeight - SEA_BED, 3), CFrame.new((p + Vector3.new(0, (towerHeight + SEA_BED) / 2, 0)) / M),
						COLORS.deck, Enum.Material.Concrete, true)
					local beacon = RoadKit.part(viaduct, "Beacon", Vector3.new(1.2, 1.2, 1.2), CFrame.new((p + Vector3.new(0, towerHeight + 0.6, 0)) / M),
						COLORS.aviation, Enum.Material.Neon, false)
					beacon.CastShadow = false
				end
				RoadKit.part(viaduct, "TowerBeam", Vector3.new(deckWidth + 6, 3, 3),
					CFrame.lookAt((foot + Vector3.new(0, towerHeight - 8, 0)) / M, (foot + Vector3.new(0, towerHeight - 8, 0) + right) / M)
						* CFrame.Angles(0, math.pi / 2, 0), COLORS.deck, Enum.Material.Concrete, false)
			end
			-- main cables: sagging between the towers, straight down to the deck beyond them
			for _, side in { -1, 1 } do
				local function cablePoint(u: number): Vector3
					local tAt = towers[1] + (towers[2] - towers[1]) * u
					local sag = 4 * u * (1 - u)
					local p = start + direction * tAt + right * side * (deckWidth / 2 + 1.5)
					return p + Vector3.new(0, towerHeight - 2 - (towerHeight - top - 6) * sag, 0)
				end
				local segments = 10
				for k = 0, segments - 1 do
					local pa, pb = cablePoint(k / segments), cablePoint((k + 1) / segments)
					local cable = RoadKit.part(viaduct, "Cable", Vector3.new(0.35, 0.35, (pb - pa).Magnitude), CFrame.lookAt(((pa + pb) / 2) / M, pb / M),
						COLORS.lampLed, Enum.Material.Neon, false)
					cable.CastShadow = false
				end
				for index, at in { towers[1], towers[2] } do
					local outward = if index == 1 then -1 else 1
					local pa = start + direction * at + right * side * (deckWidth / 2 + 1.5) + Vector3.new(0, towerHeight - 2, 0)
					local pb = start + direction * (at + outward * 300) + right * side * (deckWidth / 2) + Vector3.new(0, top + 1, 0)
					local cable = RoadKit.part(viaduct, "Cable", Vector3.new(0.35, 0.35, (pb - pa).Magnitude), CFrame.lookAt(((pa + pb) / 2) / M, pb / M),
						COLORS.lampLed, Enum.Material.Neon, false)
					cable.CastShadow = false
				end
			end
		end
	end
	return start, direction, length
end

-- The street, the bay, the sea wall and the far shore.
local function buildGround(folder: Folder, map): (number, number, number, number)
	local road = map.road
	local ground = RoadKit.folder(folder, "Ground")
	local shore = map.data.decor.shore
	local farShore = map.data.decor.farShore
	local minX, maxX, minZ = math.huge, -math.huge, math.huge
	for s = 0, road.length, 25 do
		local x, z = road:planAt(s)
		minX, maxX, minZ = math.min(minX, x), math.max(maxX, x), math.min(minZ, z)
	end
	minX, maxX, minZ = minX - 900, maxX + 900, minZ - 900
	local tile = 2000 * M
	local function tiles(name: string, x0: number, x1: number, z0: number, z1: number, top: number, color: Color3, material: Enum.Material)
		local x = x0
		while x < x1 do
			local z = z0
			while z < z1 do
				local sizeX, sizeZ = math.min(tile, x1 - x), math.min(tile, z1 - z)
				RoadKit.part(ground, name, Vector3.new(sizeX, 2, sizeZ), CFrame.new(Vector3.new(x + sizeX / 2, road.base + top - 1, z + sizeZ / 2) / M),
					color, material, true)
				z += tile
			end
			x += tile
		end
	end
	tiles("Street", minX, maxX, minZ, shore, 0, COLORS.ground, Enum.Material.Asphalt)
	tiles("Bay", minX, maxX, shore, farShore, SEA_LEVEL, COLORS.water, Enum.Material.Glass)
	tiles("FarShore", minX, maxX, farShore, farShore + 1100, 0, COLORS.farShore, Enum.Material.Concrete)
	for _, part in ground:GetChildren() do
		if part.Name == "Bay" then
			(part :: BasePart).Reflectance = 0.12
		end
	end
	-- sea walls along both shores
	local x = minX
	while x < maxX do
		local sizeX = math.min(tile, maxX - x)
		for _, z in { shore, farShore } do
			RoadKit.part(ground, "SeaWall", Vector3.new(sizeX, 2.2, 1.5), CFrame.new(Vector3.new(x + sizeX / 2, road.base - 0.6, z) / M),
				COLORS.girder, Enum.Material.Concrete, true)
		end
		x += tile
	end
	return minX, maxX, minZ, shore
end

type Footprint = { centre: Vector3, right: Vector3, forward: Vector3, width: number, depth: number }

local function footprintPoints(f: Footprint): { Vector3 }
	local points = {}
	for _, u in { -0.5, 0, 0.5 } do
		for _, v in { -0.5, 0, 0.5 } do
			table.insert(points, f.centre + f.right * (u * f.width) + f.forward * (v * f.depth))
		end
	end
	return points
end

--[[
	A building: a box with bands of lit windows on the face toward the road (night), and a red light
	on the roof of tall ones. base is the height (m) it stands on.
]]
local function building(parent: Instance, random: Random, f: Footprint, base: number, height: number, towardRoad: Vector3)
	local cf = CFrame.fromMatrix(Vector3.zero, f.right, Vector3.yAxis, -f.forward)
	local position = f.centre + Vector3.new(0, base + height / 2, 0)
	local color = COLORS.buildings[random:NextInteger(1, #COLORS.buildings)]
	local material = if random:NextNumber() < 0.35 then Enum.Material.Glass else Enum.Material.Concrete
	RoadKit.part(parent, "Building", Vector3.new(f.width, height, f.depth), (cf + position / M), color, material, true)
	-- window bands on the face toward the road
	local faceAcross = math.abs(towardRoad:Dot(f.forward)) > math.abs(towardRoad:Dot(f.right))
	local faceNormal = if faceAcross then f.forward * math.sign(towardRoad:Dot(f.forward)) else f.right * math.sign(towardRoad:Dot(f.right))
	local faceWidth = if faceAcross then f.width else f.depth
	local faceDistance = if faceAcross then f.depth / 2 else f.width / 2
	local bands = random:NextInteger(1, math.clamp(math.floor(height / 12), 1, 3))
	local windowColor = COLORS.windows[random:NextInteger(1, #COLORS.windows)]
	for _ = 1, bands do
		local y = base + random:NextNumber(4, math.max(4.5, height - 3))
		local bandHeight = random:NextNumber(0.5, 1.6)
		local centre = f.centre + faceNormal * (faceDistance + 0.12) + Vector3.new(0, y, 0)
		local band = RoadKit.part(parent, "Windows", Vector3.new(faceWidth * random:NextNumber(0.5, 0.9), bandHeight, 0.2),
			CFrame.lookAt(centre / M, (centre + faceNormal) / M), windowColor, Enum.Material.Neon, false)
		band.CastShadow = false
	end
	if height > 70 then
		local beacon = RoadKit.part(parent, "Beacon", Vector3.new(0.8, 0.8, 0.8), CFrame.new((f.centre + Vector3.new(0, base + height + 0.4, 0)) / M),
			COLORS.aviation, Enum.Material.Neon, false)
		beacon.CastShadow = false
	end
end

local function billboard(parent: Instance, random: Random, f: Footprint, base: number, height: number, towardRoad: Vector3, text: string)
	local width = math.min(f.width, 18)
	local centre = f.centre + Vector3.new(0, base + height + 3.2, 0)
	local cf = CFrame.lookAt(centre / M, (centre + Vector3.new(towardRoad.X, 0, towardRoad.Z)) / M)
	RoadKit.sign(parent, "Billboard", Vector3.new(width, 5, 0.4), cf, Color3.fromRGB(12, 12, 16), { text },
		COLORS.neonSigns[random:NextInteger(1, #COLORS.neonSigns)])
	RoadKit.part(parent, "BillboardFrame", Vector3.new(width * 0.6, 1.2, 0.6), cf * CFrame.new(0, -3 / M, 0.4 / M), C.steel, Enum.Material.Metal, false)
end

--[[
	The city: buildings along both sides of the loop in a near band (facing the road, 6 to 30 m from
	its edge) and a far band (the skyline), on the podiums over the tunnels, and low lit sheds on the
	far shore. Every footprint keeps clear of the road (all of it, including where the loop doubles
	back), the viaducts, the podiums and the water.
]]
local function buildCity(folder: Folder, map, random: Random, flyovers, podiums)
	local road = map.road
	local city = RoadKit.folder(folder, "City")
	local shore = map.data.decor.shore
	local farShore = map.data.decor.farShore
	local billboardIndex = 0

	local function clear(f: Footprint, roadMargin: number): boolean
		for _, p in footprintPoints(f) do
			if p.Z > shore - 10 then
				return false
			end
			local distance = road:distanceToRoad(p)
			if distance < roadMargin then
				return false
			end
			-- beside a tunnel, keep off its podium too
			if distance < PODIUM + TUNNEL_WALL + 4 and inTunnel(road, road:project(p, true)) then
				return false
			end
			for _, line in flyovers do
				if distanceToSegment(p, line[1], line[2], line[3]) < 6 + 6 then
					return false
				end
			end
		end
		return true
	end

	local function place(s: number, side: number, near: boolean)
		local x, z, heading = road:planAt(s)
		local forward = Vector3.new(math.cos(heading), 0, math.sin(heading))
		local right = Vector3.new(-forward.Z, 0, forward.X)
		local width = random:NextNumber(14, if near then 40 else 60)
		local depth = random:NextNumber(14, if near then 34 else 60)
		local edge = if side < 0 then road.leftEdge else road.rightEdge
		local distance = if near then edge + random:NextNumber(6, 30) + depth / 2 else edge + random:NextNumber(70, 420)
		local centre = Vector3.new(x, 0, z) + right * side * distance
		-- the near band faces the road; the far band is turned a little at random
		local turn = if near then 0 else random:NextNumber(-0.5, 0.5)
		local f: Footprint = {
			centre = centre,
			forward = (forward * math.cos(turn) + right * math.sin(turn)).Unit,
			right = (right * math.cos(turn) - forward * math.sin(turn)).Unit,
			width = depth,
			depth = width,
		}
		if not clear(f, 6) then
			return
		end
		local height
		if near then
			height = random:NextNumber(14, 55) * (if random:NextNumber() < 0.12 then 2.2 else 1)
		else
			height = random:NextNumber(30, 150)
		end
		local towardRoad = right * -side
		building(city, random, f, road.base, height, towardRoad)
		if near and height < 45 and random:NextNumber() < 0.06 then
			billboardIndex = billboardIndex % #BILLBOARDS + 1
			billboard(city, random, f, road.base, height, towardRoad, BILLBOARDS[billboardIndex])
		end
	end

	local s = 0
	while s < road.length do
		for _, side in { -1, 1 } do
			if random:NextNumber() < 0.72 then
				place(s + random:NextNumber(-6, 6), side, true)
			end
		end
		s += 21
	end
	s = 0
	while s < road.length do
		for _, side in { -1, 1 } do
			if random:NextNumber() < 0.6 then
				place(s, side, false)
			end
		end
		s += 55
	end

	-- buildings on the tunnel podiums (a park with trees on the short tunnel)
	for _, podium in podiums do
		local section, left, right = podium[1], podium[2], podium[3]
		local isPark = (section.to - section.from) < 1000
		local at = section.from + 25
		while at < section.to - 25 do
			local x, z, heading = road:planAt(at)
			local y = road:heightAt(at) + TUNNEL_HEIGHT + ROOF
			local forward = Vector3.new(math.cos(heading), 0, math.sin(heading))
			local sideways = Vector3.new(-forward.Z, 0, forward.X)
			if isPark then
				for _, offset in { left + 6, right - 6, (left + right) / 2 } do
					if random:NextNumber() < 0.7 then
						local p = Vector3.new(x, y, z) + sideways * (offset + random:NextNumber(-3, 3))
						local trunk = 3
						RoadKit.part(city, "Trunk", Vector3.new(0.4, trunk, 0.4), CFrame.new((p + Vector3.new(0, trunk / 2, 0)) / M),
							Color3.fromRGB(60, 46, 36), Enum.Material.Wood, false)
						local size = random:NextNumber(3, 5)
						local crown = RoadKit.part(city, "Crown", Vector3.new(size, size, size), CFrame.new((p + Vector3.new(0, trunk + size * 0.35, 0)) / M),
							COLORS.park, Enum.Material.LeafyGrass, false)
						crown.Shape = Enum.PartType.Ball
					end
				end
			else
				for _, lane in { { left + 9, 14 }, { (left + right) / 2, 12 }, { right - 9, 14 } } do
					if random:NextNumber() < 0.65 then
						local f: Footprint = {
							centre = Vector3.new(x, 0, z) + sideways * lane[1],
							forward = forward,
							right = sideways,
							width = lane[2] + random:NextNumber(0, 4),
							depth = random:NextNumber(18, 34),
						}
						local height = random:NextNumber(18, 85)
						building(city, random, f, y, height, sideways * -math.sign(lane[1] + 0.001))
					end
				end
			end
			at += if isPark then 30 else 42
		end
		if isPark then
			local points = RoadKit.pieces(road, section.from, section.to)
			for i = 1, #points - 1 do
				RoadKit.strip(city, road, "Park", points[i], points[i + 1], (left + right) / 2, right - left, 0.3, TUNNEL_HEIGHT + ROOF + 0.3,
					COLORS.park, Enum.Material.Grass, true, RoadKit.overlap(road, points[i], points[i + 1], right - left))
			end
		end
	end

	-- the far shore: low warehouses with a few lights
	for _ = 1, 45 do
		local x = random:NextNumber(-3400, 3400)
		local z = random:NextNumber(farShore + 60, farShore + 700)
		local f: Footprint = { centre = Vector3.new(x, 0, z), forward = Vector3.zAxis, right = Vector3.xAxis,
			width = random:NextNumber(30, 90), depth = random:NextNumber(20, 60) }
		local clearOfViaducts = true
		for _, line in flyovers do
			for _, p in footprintPoints(f) do
				if distanceToSegment(p, line[1], line[2], line[3]) < 14 then
					clearOfViaducts = false
				end
			end
		end
		if clearOfViaducts then
			building(city, random, f, road.base, random:NextNumber(8, 24), -Vector3.zAxis)
		end
	end
end

-- Build the city into Workspace.Maps. Returns the number of parts made.
function CityBuilder.build(map): number
	local maps = Workspace:FindFirstChild("Maps") or Instance.new("Folder")
	maps.Name = "Maps"
	maps.Parent = Workspace
	local existing = maps:FindFirstChild(map.id)
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = map.id
	local road = map.road
	local random = Random.new(2611)

	local points = RoadKit.loopPieces(road, supportBreaks(road))
	buildDeck(folder, road, points)
	buildPiers(folder, map)
	buildLamps(folder, map)
	local podiums = {}
	for _, section in road.sections do
		if section.kind == "tunnel" then
			local left, right = buildTunnel(folder, map, section)
			table.insert(podiums, { section, left, right })
		end
	end
	buildGantries(folder, map)
	local flyovers = {}
	local decor = RoadKit.folder(folder, "Viaducts")
	for _, flyover in map.data.decor.flyovers do
		local start, direction, length = buildFlyover(decor, map, flyover)
		table.insert(flyovers, { start, direction, length })
	end
	buildGround(folder, map)
	buildCity(folder, map, random, flyovers, podiums)
	folder.Parent = maps
	return RoadKit.countParts(folder)
end

return CityBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX0000003E">
<Properties>
<string name="Name">Main</string>
<ProtectedString name="Source"><![CDATA[--[[
	Server entry point: sets realistic gravity and the default (afternoon) lighting, creates the
	remotes, builds both maps (the oval proving ground and the city expressway, far apart in the same
	place), starts spawning cars and runs each map's traffic.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Units = require(ReplicatedStorage:WaitForChild("VehicleSystem"):WaitForChild("Units"))
local MapRegistry = require(ReplicatedStorage:WaitForChild("TrafficSystem"):WaitForChild("MapRegistry"))
local MapLighting = require(ReplicatedStorage:WaitForChild("Gameplay"):WaitForChild("MapLighting"))
local MapService = require(script.Parent.MapService)
local VehicleSpawner = require(script.Parent.VehicleSpawner)
local TrafficService = require(script.Parent.TrafficService)

-- 9.81 m/s^2 at 0.28 m per stud. Character jumps feel lower than default Roblox; cars feel right.
Workspace.Gravity = Units.REALISTIC_GRAVITY

-- Late-afternoon light, the oval's look. Each client switches to its own map's look (the city is at
-- night). For the best look, also set Lighting.Technology to Future in Studio (scripts can't).
MapLighting.apply("Afternoon")

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
for _, name in { "VehicleSpawned", "RequestRespawn", "RequestMapSwitch", "RequestVehicle" } do
	local event = Instance.new("RemoteEvent")
	event.Name = name
	event.Parent = remotes
end
remotes.Parent = ReplicatedStorage

local started = os.clock()
MapService.build()
print(string.format("[Redline] Maps built in %.2f s", os.clock() - started))

VehicleSpawner.init(remotes)
TrafficService.init(remotes, MapService.mapOf)
for _, id in MapRegistry.order do
	TrafficService.start(MapRegistry.get(id))
end
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000003F">
<Properties>
<string name="Name">MapService</string>
<ProtectedString name="Source"><![CDATA[--[[
	MapService: the server's side of the maps. Builds every map at startup (TrackBuilder for the
	oval, CityBuilder for the city), remembers which map each player is on (also published as the
	Player attribute "MapId" for clients), and gives spawn and respawn positions on a map's road.
	VehicleSpawner handles the switch request itself (it respawns the car).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local MapRegistry = require(ReplicatedStorage:WaitForChild("TrafficSystem"):WaitForChild("MapRegistry"))
local Units = require(ReplicatedStorage:WaitForChild("VehicleSystem"):WaitForChild("Units"))
local TrackBuilder = require(script.Parent.TrackBuilder)
local CityBuilder = require(script.Parent.CityBuilder)

local M = Units.METERS_PER_STUD
local GRID_BACK = 10 -- m from the start line back to the first grid row
local GRID_ROW = 12 -- m between rows: room for any car up to about 8 m long
local SPAWN_LIFT = 0.12 -- m above ride height, so a new car settles onto its suspension (road boxes
-- follow the road to within 8 cm, so on a crest the surface can be a little above its exact height)

local MapService = {}

local BUILDERS = {
	Oval = TrackBuilder,
	City = CityBuilder,
}

local playerMaps: { [Player]: string } = {}

-- Build every map. Prints what each took.
function MapService.build()
	for _, id in MapRegistry.order do
		local started = os.clock()
		local map = MapRegistry.get(id)
		local parts = BUILDERS[id].build(map)
		print(string.format("[Redline] Map %s (%s) built in %.2f s: %.1f km, %d lanes, %d parts", id, map.displayName,
			os.clock() - started, map.road.length / 1000, map.road.lanes, parts))
	end
end

function MapService.mapOf(player: Player): string
	return playerMaps[player] or MapRegistry.default
end

function MapService.setMap(player: Player, id: string)
	playerMaps[player] = id
	player:SetAttribute("MapId", id)
end

function MapService.forget(player: Player)
	playerMaps[player] = nil
end

-- A CFrame (studs) at distance s and sideways offset on a map's road, raised by height (m), facing
-- along the road and pitched with its grade.
local function roadCFrame(map, s: number, offset: number, height: number): CFrame
	local p, direction = map.road:frame(s, offset, height)
	return CFrame.lookAt(p / M, (p + direction) / M)
end

-- Where to place a car's centre of mass for grid slot n (1-based) on a map. comHeight: the car's
-- centre of mass above the ground at ride height (m), from its configuration.
function MapService.gridCFrame(mapId: string, slot: number, comHeight: number): CFrame
	local map = MapRegistry.get(mapId)
	local road = map.road
	local lane = (slot - 1) % road.lanes + 1
	local row = math.floor((slot - 1) / road.lanes)
	local s = map.data.start - GRID_BACK - row * GRID_ROW
	return roadCFrame(map, s, road:offsetFromLane(lane), comHeight + SPAWN_LIFT)
end

-- The nearest lane centre on a map's road to a position (studs), as a CFrame facing along the road.
function MapService.nearestCFrame(mapId: string, positionStuds: Vector3, comHeight: number): CFrame
	local map = MapRegistry.get(mapId)
	local road = map.road
	local s, offset = road:project(positionStuds * M)
	local lane = math.clamp(math.floor(road:laneFromOffset(offset) + 0.5), 1, road.lanes)
	return roadCFrame(map, s, road:offsetFromLane(lane), comHeight + SPAWN_LIFT)
end

return MapService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000040">
<Properties>
<string name="Name">RoadKit</string>
<ProtectedString name="Source"><![CDATA[--[[
	RoadKit: building blocks for maps made from a RoadGeometry road: road surfaces and markings that
	follow its curves and grades, walls and barriers, supports under raised road, tunnels with walls,
	ceiling, lights and "TunnelZone" boxes, sign gantries, and part helpers. Used by TrackBuilder
	(the oval) and CityBuilder (the city).

	Sizes and positions are in metres and converted to studs when parts are made. Long features are
	made of straight boxes ("pieces") between points along the road, as long as possible while
	staying within a few centimetres of the true curve, so straights take few parts.

	TunnelZone boxes (for the tunnel sound, see docs/MAPS.md): invisible, non-colliding,
	non-queryable blocks covering each tunnel's inside from the road to the ceiling and wall to wall,
	ending exactly at the portals and overlapping by 1 m where they join, tagged "TunnelZone" with
	CollectionService, with attributes ReverbDecay (s), TunnelName and MapId.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Units = require(ReplicatedStorage:WaitForChild("VehicleSystem"):WaitForChild("Units"))

local M = Units.METERS_PER_STUD

local RoadKit = {}

RoadKit.M = M
RoadKit.TUNNEL_TAG = "TunnelZone"
RoadKit.MAX_PIECE = 400 -- m, the longest box (parts can't exceed 2,048 studs)
RoadKit.SAG = 0.08 -- m, how far a box may stray from the curve it follows

RoadKit.COLORS = {
	asphalt = Color3.fromRGB(46, 48, 52),
	line = Color3.fromRGB(232, 232, 226),
	yellowLine = Color3.fromRGB(226, 178, 52),
	concrete = Color3.fromRGB(176, 174, 166),
	darkConcrete = Color3.fromRGB(120, 120, 116),
	pole = Color3.fromRGB(118, 122, 126),
	lamp = Color3.fromRGB(255, 244, 214),
	sodium = Color3.fromRGB(255, 150, 54),
	signGreen = Color3.fromRGB(22, 104, 66),
	signText = Color3.fromRGB(245, 245, 240),
	tunnelTile = Color3.fromRGB(196, 190, 170),
	steel = Color3.fromRGB(96, 100, 106),
}

-- An anchored part. sizeMeters in metres, cframe in studs. Parts that don't collide aren't
-- queryable either, so raycasts (suspension, camera) ignore markings and decorations.
function RoadKit.part(parent: Instance, name: string, sizeMeters: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, collide: boolean): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = sizeMeters / M
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.CanCollide = collide
	part.CanQuery = collide
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

function RoadKit.folder(parent: Instance, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- A point (m) at distance s, sideways offset and height above the road surface.
function RoadKit.point(road, s: number, offset: number, height: number): Vector3
	local p = road:frame(s, offset, height)
	return p
end

-- A CFrame (studs) at a point on the road, looking along it (pitched with the grade).
function RoadKit.cframe(road, s: number, offset: number, height: number): CFrame
	local p, direction = road:frame(s, offset, height)
	return CFrame.lookAt(p / M, (p + direction) / M)
end

-- A level CFrame (studs) at a point on the road, looking along it: for upright things.
function RoadKit.levelCFrame(road, s: number, offset: number, height: number): CFrame
	local p, direction = road:frame(s, offset, height)
	local flat = Vector3.new(direction.X, 0, direction.Z)
	return CFrame.lookAt(p / M, (p + flat) / M)
end

-- The sharpest plan curvature (1/m) and vertical curvature (rate of grade change, 1/m) between
-- distances a and b.
function RoadKit.bend(road, a: number, b: number): (number, number)
	local k = 0
	local pieces = road.pieces
	local i = road:pieceIndex(a % road.length)
	while i <= #pieces and pieces[i].s < b do
		k = math.max(k, math.abs(pieces[i].k))
		i += 1
	end
	local r = 0
	local profile = road.profile
	local j = 1
	while j < #profile and profile[j + 1].s <= a do
		j += 1
	end
	while j <= #profile and profile[j].s < b do
		r = math.max(r, math.abs(profile[j].rate))
		j += 1
	end
	return k, r
end

--[[
	Split [s0, s1] into pieces that straight boxes can follow: each piece is as long as maxLength
	allows while its chord stays within sag metres of the road, in plan and in elevation. Returns
	the points between pieces, s0 first and s1 last.
]]
function RoadKit.pieces(road, s0: number, s1: number, maxLength: number?, sag: number?): { number }
	local longest = maxLength or RoadKit.MAX_PIECE
	local tolerance = sag or RoadKit.SAG
	local points = { s0 }
	local s = s0
	while s1 - s > 1e-6 do
		local length = math.min(longest, s1 - s)
		for _ = 1, 4 do
			local k, r = RoadKit.bend(road, s, s + length)
			local limit = longest
			if k > 0 then
				limit = math.min(limit, math.sqrt(8 * tolerance / k))
			end
			if r > 0 then
				limit = math.min(limit, math.sqrt(8 * tolerance / r))
			end
			if limit >= length then
				break
			end
			length = limit
		end
		s = if s1 - (s + length) < 0.5 then s1 else s + length
		table.insert(points, s)
	end
	return points
end

-- Pieces all the way round the loop, broken at the given distances (and at every section's ends),
-- so features can change exactly where a tunnel or bridge starts.
function RoadKit.loopPieces(road, breaks: { number }?): { number }
	local cuts = {}
	for _, s in breaks or {} do
		table.insert(cuts, s)
	end
	for _, section in road.sections do
		table.insert(cuts, section.from)
		table.insert(cuts, section.to)
	end
	table.sort(cuts)
	local points = { 0 }
	local from = 0
	for _, cut in cuts do
		if cut > from + 0.5 and cut < road.length - 0.5 then
			local part = RoadKit.pieces(road, from, cut)
			for i = 2, #part do
				table.insert(points, part[i])
			end
			from = cut
		end
	end
	local part = RoadKit.pieces(road, from, road.length)
	for i = 2, #part do
		table.insert(points, part[i])
	end
	return points
end

--[[
	A box along the road from s0 to s1 at a sideways offset: width across, thickness deep, its top
	`top` metres above the road surface. extend lengthens it (m) to close gaps on curves.
]]
function RoadKit.strip(parent: Instance, road, name: string, s0: number, s1: number, offset: number, width: number,
	thickness: number, top: number, color: Color3, material: Enum.Material, collide: boolean, extend: number?): Part?
	local a = RoadKit.point(road, s0, offset, 0)
	local b = RoadKit.point(road, s1, offset, 0)
	local length = (b - a).Magnitude
	if length < 1e-3 then
		return nil
	end
	local centre = (a + b) / 2
	local cframe = CFrame.lookAt(centre / M, b / M) * CFrame.new(0, (top - thickness / 2) / M, 0)
	return RoadKit.part(parent, name, Vector3.new(width, thickness, length + (extend or 0)), cframe, color, material, collide)
end

-- How much a box of this width needs lengthening to close the wedge-shaped gaps between boxes
-- on the outside of a curve.
function RoadKit.overlap(road, s0: number, s1: number, width: number): number
	local k = RoadKit.bend(road, s0, s1)
	return 0.05 + width / 2 * k * (s1 - s0)
end

-- Dashed line at a sideways offset from s0 to s1: dash metres painted, gap metres bare.
function RoadKit.dashes(parent: Instance, road, s0: number, s1: number, offset: number, dash: number, gap: number, width: number, color: Color3)
	local s = s0
	while s + dash <= s1 do
		local line = RoadKit.strip(parent, road, "Dash", s, s + dash, offset, width, 0.02, 0.02, color, Enum.Material.SmoothPlastic, false)
		if line then
			line.CastShadow = false
		end
		s += dash + gap
	end
end

-- Solid line along [s0, s1] at a sideways offset, in pieces.
function RoadKit.solidLine(parent: Instance, road, points: { number }, offset: number, width: number, color: Color3)
	for i = 1, #points - 1 do
		local line = RoadKit.strip(parent, road, "Line", points[i], points[i + 1], offset, width, 0.02, 0.02, color,
			Enum.Material.SmoothPlastic, false, RoadKit.overlap(road, points[i], points[i + 1], width))
		if line then
			line.CastShadow = false
		end
	end
end

--[[
	TunnelZone boxes covering a tunnel from s0 to s1 (the portals): from just below the road to
	`height` above it, between the left and right walls' inner faces (sideways offsets, m). Long or
	curved tunnels get a chain of boxes overlapping by 1 m; the first and last end at the portals.
]]
function RoadKit.tunnelZones(parent: Instance, road, s0: number, s1: number, left: number, right: number, height: number, attributes: { [string]: any }): { Part }
	local zones = {}
	local sag = 0.5
	local points = RoadKit.pieces(road, s0, s1, RoadKit.MAX_PIECE, sag)
	local centre = (left + right) / 2
	local width = right - left + 2 * sag
	for i = 1, #points - 1 do
		local a = RoadKit.point(road, points[i], centre, -0.3)
		local b = RoadKit.point(road, points[i + 1], centre, -0.3)
		local axis = (b - a).Unit
		if i > 1 then
			a -= axis * 0.5
		end
		if i < #points - 1 then
			b += axis * 0.5
		end
		local length = (b - a).Magnitude
		local mid = (a + b) / 2
		local zoneHeight = height + 0.3
		local cframe = CFrame.lookAt(mid / M, b / M) * CFrame.new(0, zoneHeight / 2 / M, 0)
		local zone = RoadKit.part(parent, "TunnelZone", Vector3.new(width, zoneHeight, length), cframe,
			Color3.fromRGB(255, 160, 60), Enum.Material.SmoothPlastic, false)
		zone.Transparency = 1
		zone.CastShadow = false
		for key, value in attributes do
			zone:SetAttribute(key, value)
		end
		CollectionService:AddTag(zone, RoadKit.TUNNEL_TAG)
		table.insert(zones, zone)
	end
	return zones
end

-- A sign panel facing oncoming traffic, with lines of text that glow (they ignore lighting).
function RoadKit.sign(parent: Instance, name: string, sizeMeters: Vector3, cframe: CFrame, background: Color3, lines: { string }, textColor: Color3?): Part
	local panel = RoadKit.part(parent, name, sizeMeters, cframe, background, Enum.Material.SmoothPlastic, false)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.Brightness = 1.4
	gui.Parent = panel
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = background
	frame.BorderSizePixel = 0
	frame.Parent = gui
	local count = #lines
	for i, text in lines do
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.new(0.92, 0, 0.8 / count, 0)
		label.Position = UDim2.new(0.04, 0, 0.1 + 0.8 * (i - 1) / count, 0)
		label.Font = if i == 1 then Enum.Font.GothamBlack else Enum.Font.GothamBold
		label.TextScaled = true
		label.TextColor3 = textColor or RoadKit.COLORS.signText
		label.Text = text
		label.Parent = frame
	end
	return panel
end

--[[
	An overhead sign gantry at distance s: posts just outside left and right (sideways offsets of
	the walls, m), a beam at clearance metres, and sign panels { offset, width, lines } facing
	approaching traffic.
]]
function RoadKit.gantry(parent: Instance, road, s: number, left: number, right: number, clearance: number, panels)
	local base = RoadKit.levelCFrame(road, s, 0, 0)
	local folder = RoadKit.folder(parent, "Gantry")
	local postHeight = clearance + 1.6
	for _, offset in { left - 0.6, right + 0.6 } do
		RoadKit.part(folder, "Post", Vector3.new(0.6, postHeight, 0.6), base * CFrame.new(offset / M, postHeight / 2 / M, 0),
			RoadKit.COLORS.steel, Enum.Material.Metal, true)
	end
	local span = right - left + 1.2
	RoadKit.part(folder, "Beam", Vector3.new(span, 0.5, 0.8), base * CFrame.new((left + right) / 2 / M, (clearance + 1.3) / M, 0),
		RoadKit.COLORS.steel, Enum.Material.Metal, false)
	for _, panel in panels do
		-- the panel's front face (-Z of its CFrame) looks back at approaching cars
		local cf = base * CFrame.new(panel.offset / M, (clearance + 1.2) / M, 0.5 / M) * CFrame.Angles(0, math.pi, 0)
		RoadKit.sign(folder, "Sign", Vector3.new(panel.width, 2.2, 0.15), cf, panel.color or RoadKit.COLORS.signGreen, panel.lines)
	end
end

-- Count the parts under an instance.
function RoadKit.countParts(root: Instance): number
	local count = 0
	for _, item in root:GetDescendants() do
		if item:IsA("BasePart") then
			count += 1
		end
	end
	return count
end

return RoadKit
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000041">
<Properties>
<string name="Name">TrackBuilder</string>
<ProtectedString name="Source"><![CDATA[--[[
	TrackBuilder
	Builds the Redline Proving Ground, the oval map (TrafficSystem/Maps/Oval): a flat 4-lane highway
	loop with two 2.4 km straights joined by 650 m radius curves with transition curves (9.3 km per
	lap). It has lane markings, concrete barriers, light poles, sign gantries, two overpasses, a
	300 m covered gallery on the back straight (with lights and a TunnelZone for tunnel sound),
	distance boards on the main straight for acceleration and braking tests, trees, grass and
	distant buildings for a sense of speed, and the paddock where players spawn.

	The shape comes from the map's data through RoadGeometry; RoadKit makes the parts. Sizes are in
	metres and converted to studs when parts are made. The lap runs along +X on the main straight;
	every curve turns right, so the infield is on the right.
]]

local Workspace = game:GetService("Workspace")

local RoadKit = require(script.Parent.RoadKit)

local M = RoadKit.M
local C = RoadKit.COLORS

local TrackBuilder = {}

local ROAD_THICKNESS = 1.0
local DASH, GAP = 3, 9
local LINE_WIDTH = 0.15
local EDGE_LINE_WIDTH = 0.2
local BARRIER_HEIGHT, BARRIER_WIDTH = 0.9, 0.5
local POLE_SPACING = 60
local GALLERY_HEIGHT = 6.0 -- m, clear height under the gallery roof
local OVERPASSES = { 1900, 6600 } -- s of the two bridges across the road
local TREES = 260

local COLORS = {
	grass = Color3.fromRGB(76, 102, 56),
	board = Color3.fromRGB(240, 240, 238),
	pad = Color3.fromRGB(120, 120, 118),
	trunk = Color3.fromRGB(92, 72, 52),
	leaves = { Color3.fromRGB(64, 92, 52), Color3.fromRGB(80, 104, 58), Color3.fromRGB(58, 82, 50) },
}

local function inGallery(map, s: number): boolean
	return map.road:sectionAt(s, "tunnel") ~= nil
end

local function nearOverpass(s: number, margin: number): boolean
	for _, at in OVERPASSES do
		if math.abs(s - at) < margin then
			return true
		end
	end
	return false
end

local function buildRoad(folder: Folder, map, points: { number })
	local road = map.road
	local surface = RoadKit.folder(folder, "Road")
	local width = road.leftEdge + road.rightEdge
	local centre = (road.rightEdge - road.leftEdge) / 2
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		RoadKit.strip(surface, road, "Asphalt", a, b, centre, width, ROAD_THICKNESS, 0, C.asphalt, Enum.Material.Asphalt, true,
			RoadKit.overlap(road, a, b, width))
	end
end

local function buildMarkings(folder: Folder, map, points: { number })
	local road = map.road
	local markings = RoadKit.folder(folder, "Markings")
	for k = 1, road.lanes - 1 do
		RoadKit.dashes(markings, road, 0, road.length, (k - road.lanes / 2) * road.laneWidth, DASH, GAP, LINE_WIDTH, C.line)
	end
	for _, side in { -1, 1 } do
		RoadKit.solidLine(markings, road, points, side * road.halfWidth, EDGE_LINE_WIDTH, C.line)
	end
	local start = map.data.start
	RoadKit.strip(markings, road, "StartLine", start, start + 0.6, 0, road.lanes * road.laneWidth, 0.02, 0.02, C.line,
		Enum.Material.SmoothPlastic, false)
end

local function buildBarriers(folder: Folder, map, points: { number })
	local road = map.road
	local barriers = RoadKit.folder(folder, "Barriers")
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		-- the gallery's outer wall replaces the left barrier there
		if not inGallery(map, (a + b) / 2) then
			RoadKit.strip(barriers, road, "Barrier", a, b, -(road.leftEdge + BARRIER_WIDTH / 2), BARRIER_WIDTH, BARRIER_HEIGHT,
				BARRIER_HEIGHT, C.concrete, Enum.Material.Concrete, true, RoadKit.overlap(road, a, b, BARRIER_WIDTH))
		end
		RoadKit.strip(barriers, road, "Barrier", a, b, road.rightEdge + BARRIER_WIDTH / 2, BARRIER_WIDTH, BARRIER_HEIGHT,
			BARRIER_HEIGHT, C.concrete, Enum.Material.Concrete, true, RoadKit.overlap(road, a, b, BARRIER_WIDTH))
	end
end

-- Light poles on the outside of the lap, with their lamps reaching over the road.
local function buildPoles(folder: Folder, map)
	local road = map.road
	local poles = RoadKit.folder(folder, "LightPoles")
	local poleHeight = 11
	local offset = -(road.leftEdge + 2)
	local s = 0
	while s < road.length do
		if not inGallery(map, s) and not nearOverpass(s, 20) then
			local base = RoadKit.levelCFrame(road, s, offset, 0)
			local pole = RoadKit.part(poles, "LightPole", Vector3.new(poleHeight, 0.3, 0.3),
				base * CFrame.new(0, poleHeight / 2 / M, 0) * CFrame.Angles(0, 0, math.rad(90)), C.pole, Enum.Material.Metal, true)
			pole.Shape = Enum.PartType.Cylinder
			-- the arm reaches toward the road (to the right of the travel direction)
			RoadKit.part(poles, "LightArm", Vector3.new(3, 0.15, 0.15), base * CFrame.new(1.5 / M, poleHeight / M, 0), C.pole,
				Enum.Material.Metal, false)
			local lamp = RoadKit.part(poles, "Lamp", Vector3.new(0.9, 0.12, 0.5), base * CFrame.new(2.9 / M, (poleHeight - 0.12) / M, 0),
				C.lamp, Enum.Material.Neon, false)
			lamp.CastShadow = false
		end
		s += POLE_SPACING
	end
end

-- Distance boards beside the main straight, every 100 m from the start line.
local function buildBoards(folder: Folder, map)
	local road = map.road
	local boards = RoadKit.folder(folder, "DistanceBoards")
	local start = map.data.start
	for k = 1, 20 do
		local s = start + k * 100
		-- the board's front face points back toward approaching cars
		local cf = RoadKit.levelCFrame(road, s, road.rightEdge + 3, 1.8) * CFrame.Angles(0, math.pi, 0)
		local board = RoadKit.part(boards, "DistanceBoard", Vector3.new(2.4, 1.4, 0.1), cf, COLORS.board, Enum.Material.SmoothPlastic, true)
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.CanvasSize = Vector2.new(240, 140)
		gui.Parent = board
		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.GothamBlack
		text.TextScaled = true
		text.TextColor3 = Color3.fromRGB(20, 20, 22)
		text.Text = string.format("%d m", k * 100)
		text.Parent = gui
		RoadKit.part(boards, "BoardPost", Vector3.new(0.12, 1.1, 0.12), cf * CFrame.new(0, -1.25 / M, 0), C.pole, Enum.Material.Metal, false)
	end
end

--[[
	The covered gallery: a concrete roof over the road, a solid wall on the outside, open columns on
	the infield side, lamps under the roof, earth over the top, and TunnelZone boxes inside.
]]
local function buildGallery(folder: Folder, map, section)
	local road = map.road
	local gallery = RoadKit.folder(folder, "Gallery")
	local s0, s1 = section.from, section.to
	local points = RoadKit.pieces(road, s0, s1)
	local wall = 0.8
	local outer = -(road.leftEdge + wall / 2)
	-- the roof spans from the outer wall to just past the columns on the infield side
	local roofLeft, roofRight = -(road.leftEdge + wall), road.rightEdge + BARRIER_WIDTH + 1.2
	local width = roofRight - roofLeft
	local centre = (roofLeft + roofRight) / 2
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		RoadKit.strip(gallery, road, "Roof", a, b, centre, width, 0.8, GALLERY_HEIGHT + 0.8, C.darkConcrete, Enum.Material.Concrete, true)
		RoadKit.strip(gallery, road, "OuterWall", a, b, outer, wall, GALLERY_HEIGHT, GALLERY_HEIGHT, C.concrete, Enum.Material.Concrete, true)
		RoadKit.strip(gallery, road, "Earth", a, b, centre - 2, width + 4, 0.6, GALLERY_HEIGHT + 1.4, COLORS.grass, Enum.Material.Grass, true)
		-- an earth bank sloping away from the outer wall
		local length = (RoadKit.point(road, b, 0, 0) - RoadKit.point(road, a, 0, 0)).Magnitude
		local bankWidth = 12
		local bank = Instance.new("WedgePart")
		bank.Name = "EarthBank"
		bank.Anchored = true
		bank.Size = Vector3.new(length, GALLERY_HEIGHT + 1.4, bankWidth) / M
		-- the wedge's tall face (+Z) leans on the wall; its slope runs down and away from the road
		bank.CFrame = RoadKit.levelCFrame(road, (a + b) / 2, -(road.leftEdge + wall + bankWidth / 2), (GALLERY_HEIGHT + 1.4) / 2)
			* CFrame.Angles(0, math.pi / 2, 0)
		bank.Color = COLORS.grass
		bank.Material = Enum.Material.Grass
		bank.CanTouch = false
		bank.Parent = gallery
	end
	-- columns on the infield side, lamps and lights under the roof
	local s = s0 + 5
	local n = 0
	while s < s1 - 2 do
		local base = RoadKit.levelCFrame(road, s, road.rightEdge + BARRIER_WIDTH + 0.6, 0)
		RoadKit.part(gallery, "Column", Vector3.new(0.8, GALLERY_HEIGHT, 0.8), base * CFrame.new(0, GALLERY_HEIGHT / 2 / M, 0), C.concrete,
			Enum.Material.Concrete, true)
		local lamp = RoadKit.part(gallery, "Lamp", Vector3.new(0.4, 0.12, 1.6), RoadKit.levelCFrame(road, s, 0, GALLERY_HEIGHT - 0.06),
			C.lamp, Enum.Material.Neon, false)
		lamp.CastShadow = false
		if n % 2 == 0 then
			local light = Instance.new("PointLight")
			light.Brightness = 1.6
			light.Range = 42
			light.Color = Color3.fromRGB(255, 232, 196)
			light.Shadows = false
			light.Parent = lamp
		end
		n += 1
		s += 10
	end
	RoadKit.tunnelZones(gallery, road, s0, s1, -road.leftEdge, road.rightEdge, GALLERY_HEIGHT, {
		ReverbDecay = section.reverb or 0.8,
		TunnelName = section.name or "Gallery",
		MapId = map.id,
	})
end

-- A bridge across the road at distance s: deck, parapets, columns beside the road and abutments.
local function buildOverpass(folder: Folder, map, s: number)
	local road = map.road
	local bridge = RoadKit.folder(folder, "Overpass")
	local base = RoadKit.levelCFrame(road, s, 0, 0)
	local span = road.leftEdge + road.rightEdge + 30
	local clearance = 6.5
	local deck = 1.2
	-- the deck runs across the road (along the base's X axis)
	RoadKit.part(bridge, "Deck", Vector3.new(span, deck, 9), base * CFrame.new(0, (clearance + deck / 2) / M, 0), C.concrete, Enum.Material.Concrete, true)
	for _, side in { -1, 1 } do
		RoadKit.part(bridge, "Parapet", Vector3.new(span, 1.0, 0.3), base * CFrame.new(0, (clearance + deck + 0.5) / M, side * 4.35 / M),
			C.concrete, Enum.Material.Concrete, true)
		local columnX = side * (road.rightEdge + 4)
		for _, z in { -2.5, 2.5 } do
			RoadKit.part(bridge, "Column", Vector3.new(1.0, clearance, 1.0), base * CFrame.new(columnX / M, clearance / 2 / M, z / M),
				C.concrete, Enum.Material.Concrete, true)
		end
		local abutmentX = side * (span / 2 + 6)
		RoadKit.part(bridge, "Abutment", Vector3.new(12, clearance + deck, 11), base * CFrame.new(abutmentX / M, (clearance + deck) / 2 / M, 0),
			COLORS.grass, Enum.Material.Grass, true)
	end
end

local GANTRIES = {
	{ s = 700, lines = { "REDLINE PROVING GROUND", "Lap 9.3 km   4 lanes" } },
	{ s = 2250, lines = { "CURVE 1   R 650 m", "Keep right except to pass" } },
	{ s = 5000, lines = { "GALLERY 600 m", "Back straight 2.4 km" } },
	{ s = 6950, lines = { "START / FINISH 2.5 km", "Paddock: keep right" } },
}

local function buildGantries(folder: Folder, map)
	local road = map.road
	local gantries = RoadKit.folder(folder, "Gantries")
	for _, g in GANTRIES do
		RoadKit.gantry(gantries, road, g.s, -road.leftEdge - BARRIER_WIDTH, road.rightEdge + BARRIER_WIDTH, 6.0, {
			{ offset = 0, width = road.lanes * road.laneWidth * 0.8, lines = g.lines },
		})
	end
end

local function buildTrees(folder: Folder, map, random: Random)
	local road = map.road
	local trees = RoadKit.folder(folder, "Trees")
	local start = map.data.start
	local placed = 0
	local tries = 0
	while placed < TREES and tries < TREES * 4 do
		tries += 1
		local s = random:NextNumber(0, road.length)
		local outside = random:NextNumber() < 0.6
		local offset = if outside then -(road.leftEdge + random:NextNumber(10, 70)) else road.rightEdge + random:NextNumber(10, 45)
		local clear = not inGallery(map, s) and not inGallery(map, s + 30) and not inGallery(map, s - 30) and not nearOverpass(s, 40)
		-- keep the paddock and the distance boards' sight lines open
		if not outside and (math.abs(road:delta(start, s)) < 120 or (s > start and s < start + 2100)) then
			clear = false
		end
		if clear then
			local height = random:NextNumber(5, 9)
			local base = RoadKit.levelCFrame(road, s, offset, 0)
			RoadKit.part(trees, "Trunk", Vector3.new(0.5, height * 0.5, 0.5), base * CFrame.new(0, height * 0.25 / M, 0), COLORS.trunk,
				Enum.Material.Wood, true)
			local size = random:NextNumber(3.5, 6)
			local crown = RoadKit.part(trees, "Crown", Vector3.new(size, size, size), base * CFrame.new(0, (height * 0.5 + size * 0.35) / M, 0),
				COLORS.leaves[random:NextInteger(1, #COLORS.leaves)], Enum.Material.LeafyGrass, false)
			crown.Shape = Enum.PartType.Ball
			placed += 1
		end
	end
end

local function buildSurroundings(folder: Folder, map, random: Random)
	local road = map.road
	local surroundings = RoadKit.folder(folder, "Surroundings")

	-- grass over the whole area, tiled because parts are limited to 2,048 studs a side
	local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
	for s = 0, road.length, 25 do
		local x, z = road:planAt(s)
		minX, maxX = math.min(minX, x), math.max(maxX, x)
		minZ, maxZ = math.min(minZ, z), math.max(maxZ, z)
	end
	minX, maxX, minZ, maxZ = minX - 700, maxX + 700, minZ - 700, maxZ + 700
	local tile = 2000 * M
	local x = minX
	while x < maxX do
		local z = minZ
		while z < maxZ do
			local sizeX = math.min(tile, maxX - x)
			local sizeZ = math.min(tile, maxZ - z)
			local centre = Vector3.new(x + sizeX / 2, road.base - 0.55, z + sizeZ / 2)
			RoadKit.part(surroundings, "Grass", Vector3.new(sizeX, 1, sizeZ), CFrame.new(centre / M), COLORS.grass, Enum.Material.Grass, true)
			z += tile
		end
		x += tile
	end

	-- distant buildings outside the lap give the eye something to measure speed against
	local palette = { Color3.fromRGB(150, 154, 160), Color3.fromRGB(110, 118, 128), Color3.fromRGB(176, 170, 160), Color3.fromRGB(86, 96, 110) }
	for _ = 1, 70 do
		local s = random:NextNumber(0, road.length)
		local offset = -(road.leftEdge + random:NextNumber(120, 520))
		local height = random:NextNumber(25, 180)
		local size = Vector3.new(random:NextNumber(20, 60), height, random:NextNumber(20, 60))
		local centre = RoadKit.point(road, s, offset, height / 2)
		local material = if random:NextNumber() < 0.4 then Enum.Material.Glass else Enum.Material.Concrete
		RoadKit.part(surroundings, "Building", size, CFrame.new(centre / M) * CFrame.Angles(0, random:NextNumber(0, math.pi), 0),
			palette[random:NextInteger(1, #palette)], material, true)
	end

	-- infield pad with the player spawn point, beside the start line
	local padPosition = RoadKit.point(road, map.data.start - 40, road.rightEdge + 30, 0)
	RoadKit.part(surroundings, "Paddock", Vector3.new(60, 0.4, 30), CFrame.new((padPosition - Vector3.new(0, 0.15, 0)) / M), COLORS.pad,
		Enum.Material.Concrete, true)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "PaddockSpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(4, 0.2, 4) / M
	spawn.CFrame = CFrame.new((padPosition + Vector3.new(0, 0.15, 0)) / M)
	spawn.Color = Color3.fromRGB(70, 70, 74)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Parent = surroundings
end

-- Build the oval into Workspace.Maps. Returns the number of parts made.
function TrackBuilder.build(map): number
	local maps = Workspace:FindFirstChild("Maps") or Instance.new("Folder")
	maps.Name = "Maps"
	maps.Parent = Workspace
	local existing = maps:FindFirstChild(map.id)
	if existing then
		existing:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = map.id
	local road = map.road
	local random = Random.new(42)
	local points = RoadKit.loopPieces(road, OVERPASSES)
	buildRoad(folder, map, points)
	buildMarkings(folder, map, points)
	buildBarriers(folder, map, points)
	buildPoles(folder, map)
	buildBoards(folder, map)
	for _, section in road.sections do
		if section.kind == "tunnel" then
			buildGallery(folder, map, section)
		end
	end
	for _, s in OVERPASSES do
		buildOverpass(folder, map, s)
	end
	buildGantries(folder, map)
	buildTrees(folder, map, random)
	buildSurroundings(folder, map, random)
	folder.Parent = maps
	return RoadKit.countParts(folder)
end

return TrackBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000042">
<Properties>
<string name="Name">TrafficService</string>
<ProtectedString name="Source"><![CDATA[--[[
	TrafficService: runs highway traffic on the server, one simulation per map, and streams each
	map's traffic to the players on that map.

	Each simulation (TrafficSystem/TrafficSimulation: IDM car following, MOBIL lane changes, slowing
	for curves) runs 20 times a second on the server, which owns it. Players' cars on that map are fed
	in as obstacles, so traffic follows them, yields to them and won't pull out in front of them
	unsafely. Ten times a second, each player is sent the traffic of their own map within SEND_RANGE
	of their car, packed into a buffer, and their client draws it (TrafficRenderer). Traffic cars
	aren't physical objects on the server. Car ids are unique across maps (each map's traffic starts
	at its own idBase).

	Snapshot (RemoteEvent "TrafficState"): FireClient(player, mapId, serverTime, buffer), where
	serverTime is Workspace:GetServerTimeNow() at the step, and the buffer holds, little-endian,
	  per car, 12 bytes: id u16, s f32 (m), lanePos u16 (lanes * 1000), speed u16 (cm/s),
	  profile u8 (index in DriverProfiles.order), unused u8
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local TrafficSystem = ReplicatedStorage:WaitForChild("TrafficSystem")
local TrafficSimulation = require(TrafficSystem:WaitForChild("TrafficSimulation"))
local DriverProfiles = require(TrafficSystem:WaitForChild("DriverProfiles"))
local Units = require(ReplicatedStorage:WaitForChild("VehicleSystem"):WaitForChild("Units"))

local STEP = 1 / 20 -- simulation step, s
local SEND_INTERVAL = 0.1 -- s between snapshots
local SEND_RANGE = 1200 -- m ahead of and behind each player
local ROAD_MARGIN = 1 -- m beyond the road's edges where a player's car still counts as on it
local ROAD_HEIGHT = 4 -- m above or below the road surface where a player's car still counts as on it
local RECORD_BYTES = 12

local TrafficService = {}
TrafficService.__index = TrafficService

local services = {} -- map id -> service
local remote: RemoteEvent
local mapOf: (Player) -> string
local profileIndex = {}
for i, name in DriverProfiles.order do
	profileIndex[name] = i
end

-- Each profile's curve speed limits on a road (also made this way by tools/traffic_model.py).
function TrafficService.speedLimits(road)
	local limits = {}
	for name, p in DriverProfiles.profiles do
		limits[name] = road:speedLimits(p.lateral, DriverProfiles.CURVE_DECEL, DriverProfiles.LIMIT_STEP, p.speed[2] / 3.6)
	end
	return limits
end

-- Players' cars on this map become obstacles in road coordinates.
function TrafficService:updateObstacles()
	local sim, road = self.sim, self.road
	table.clear(sim.obstacles)
	local folder = Workspace:FindFirstChild("Vehicles")
	if not folder then
		return
	end
	for _, model in folder:GetChildren() do
		local root = model:IsA("Model") and model.PrimaryPart
		if root and model:GetAttribute("MapId") == self.map.id then
			local s, offset, height = road:project(root.Position * Units.METERS_PER_STUD)
			local onRoad = offset >= -(road.leftEdge + ROAD_MARGIN) and offset <= road.rightEdge + ROAD_MARGIN
			if onRoad and math.abs(height) <= ROAD_HEIGHT then
				local _, direction = road:centerline(s)
				local velocity = root.AssemblyLinearVelocity * Units.METERS_PER_STUD
				table.insert(sim.obstacles, {
					s = s,
					lane = road:laneFromOffset(offset),
					v = math.max(0, velocity:Dot(direction)),
					length = model:GetAttribute("LengthM") or 4.7,
					owner = model:GetAttribute("OwnerUserId"),
				})
			end
		end
	end
end

function TrafficService:pack(centre: number): buffer
	local sim = self.sim
	local nearby = {}
	for _, v in sim.vehicles do
		local d = math.min(sim:ahead(centre, v.s), sim:ahead(v.s, centre))
		if d <= SEND_RANGE then
			table.insert(nearby, v)
		end
	end
	local b = buffer.create(#nearby * RECORD_BYTES)
	for i, v in nearby do
		local o = (i - 1) * RECORD_BYTES
		buffer.writeu16(b, o, v.id % 65536)
		buffer.writef32(b, o + 2, v.s)
		buffer.writeu16(b, o + 6, math.clamp(math.floor(v.lanePos * 1000 + 0.5), 0, 65535))
		buffer.writeu16(b, o + 8, math.clamp(math.floor(v.v * 100 + 0.5), 0, 65535))
		buffer.writeu8(b, o + 10, profileIndex[v.profileName] or 2)
		buffer.writeu8(b, o + 11, 0)
	end
	return b
end

function TrafficService:send()
	for _, player in Players:GetPlayers() do
		if mapOf(player) == self.map.id then
			local centre = nil
			for _, ob in self.sim.obstacles do
				if ob.owner == player.UserId then
					centre = ob.s
				end
			end
			if centre == nil then
				-- not on the road: send what's near the character, if any
				local character = player.Character
				local rootPart = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if rootPart then
					centre = self.road:project(rootPart.Position * Units.METERS_PER_STUD)
				end
			end
			if centre then
				remote:FireClient(player, self.map.id, self.stepTime, self:pack(centre))
			end
		end
	end
end

function TrafficService:update(dt: number)
	self.accumulator = math.min(self.accumulator + dt, 0.25)
	while self.accumulator >= STEP do
		self.accumulator -= STEP
		self:updateObstacles()
		self.sim:step(STEP)
		self.stepTime = Workspace:GetServerTimeNow()
	end
	self.sendTimer += dt
	if self.sendTimer >= SEND_INTERVAL then
		self.sendTimer = 0
		self:send()
	end
end

-- Create the snapshot remote and start stepping. mapOfPlayer tells which map a player is on.
function TrafficService.init(remotes: Folder, mapOfPlayer: (Player) -> string)
	remote = Instance.new("RemoteEvent")
	remote.Name = "TrafficState"
	remote.Parent = remotes
	mapOf = mapOfPlayer
	RunService.Heartbeat:Connect(function(dt)
		for _, service in services do
			service:update(dt)
		end
	end)
end

-- Start traffic on a map (from MapRegistry), using the map's traffic settings.
function TrafficService.start(map)
	local road = map.road
	local settings = map.data.traffic
	local sim = TrafficSimulation.new(road.length, road.lanes, true, settings.seed)
	sim.nextId = settings.idBase + 1
	sim:setSpeedLimits(TrafficService.speedLimits(road), DriverProfiles.LIMIT_STEP)
	sim:populate(settings.density)
	-- keep the start grid clear when the server starts (the grid is just behind the start line)
	for i = #sim.vehicles, 1, -1 do
		if math.abs(road:delta(map.data.start, sim.vehicles[i].s)) < settings.clearance then
			table.remove(sim.vehicles, i)
		end
	end
	local self = setmetatable({
		map = map,
		road = road,
		sim = sim,
		accumulator = 0,
		sendTimer = 0,
		stepTime = 0,
	}, TrafficService)
	services[map.id] = self
	print(string.format("[Redline] Traffic on %s: %d cars on %.1f km of %d-lane road", map.id, #sim.vehicles, road.length / 1000, road.lanes))
	return self
end

return TrafficService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000043">
<Properties>
<string name="Name">VehicleModelBuilder</string>
<ProtectedString name="Source"><![CDATA[--[[
	VehicleModelBuilder
	Builds a car model from a vehicle configuration.

	Physics comes from one invisible part, MassBox, placed at the centre of mass and sized like
	the car's mass distribution, with its density set so it weighs exactly the configured mass.
	Everything else is massless, so mass, centre of mass and rotational inertia are all correct.

	The visible body here is a stand-in (blockout) built to the real dimensions. Its side profile
	comes from the config's visual.blockout table (the top line of the body from nose to tail, where
	the cabin glass is, the window sill height and the cabin width); configs without one get a long-
	bonnet GT shape. The body is drawn as slices along the car, painted outside the cabin and glass
	inside it. visual.exhaustTips lists the tailpipes as { offset from the centre line, height } in
	metres (visual.exhaustTipDiameter sets their size). The Phase 2 Blender model replaces the "Body"
	model and the Wheel_* parts and must keep these names:
	  MassBox                          the physics root (keep as is)
	  Body                             a Model of visual parts, welded to MassBox
	  Wheel_FL, Wheel_FR, Wheel_RL, Wheel_RR   visual wheels, moved by Motor6Ds WheelJoint_*
	  DriverSeat                       a Seat where the driver sits
	  ChaseCamTarget, HoodCam, CockpitCam      camera attachments on MassBox
	  ForcePoint_*, WheelForce_*, CenterPoint, DragForce, AeroFront*, AeroRear*   physics (keep as is)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VehicleSystem = ReplicatedStorage:WaitForChild("VehicleSystem")
local Units = require(VehicleSystem:WaitForChild("Units"))
local Tire = require(VehicleSystem:WaitForChild("TireSimulation"):WaitForChild("Tire"))

local M = Units.METERS_PER_STUD
local WHEEL_IDS = { "FL", "FR", "RL", "RR" }

local VehicleModelBuilder = {}

local function studs(v: Vector3): Vector3
	return v / M
end

local function weld(part0: BasePart, part1: BasePart)
	local constraint = Instance.new("WeldConstraint")
	constraint.Part0 = part0
	constraint.Part1 = part1
	constraint.Parent = part1
end

local function attachment(root: BasePart, name: string, positionMeters: Vector3): Attachment
	local a = Instance.new("Attachment")
	a.Name = name
	a.Position = studs(positionMeters)
	a.Parent = root
	return a
end

local function vectorForce(root: BasePart, name: string, at: Attachment, atCentreOfMass: boolean): VectorForce
	local force = Instance.new("VectorForce")
	force.Name = name
	force.Attachment0 = at
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.ApplyAtCenterOfMass = atCentreOfMass
	force.Force = Vector3.zero
	force.Parent = root
	return force
end

-- A massless visual part, positioned in the car's frame (metres) and welded to the root.
local function visual(parent: Instance, root: BasePart, name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material, options: { [string]: any }?): Part
	local part = Instance.new("Part")
	part.Name = name
	if options and options.shape then
		part.Shape = options.shape
	end
	part.Size = studs(size)
	part.CFrame = CFrame.new(studs(position)) * (if options and options.rotation then options.rotation else CFrame.identity)
	part.Color = color
	part.Material = material
	part.Massless = true
	part.CanCollide = options ~= nil and options.collide == true
	part.CanQuery = false
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if options and options.transparency then
		part.Transparency = options.transparency
	end
	part.Parent = parent
	weld(root, part)
	return part
end

-- Default stand-in shape: a front-engined GT with a long bonnet and a fastback.
local DEFAULT_BLOCKOUT = {
	profile = { { 0, 0.5 }, { 0.03, 0.66 }, { 0.42, 0.86 }, { 0.56, 1.25 }, { 0.63, 1.276 }, { 0.8, 1.02 }, { 0.95, 0.93 }, { 1, 0.9 } },
	greenhouse = { 0.42, 0.8 },
	beltline = 0.86,
	cabinWidth = 0.72,
	sill = 0.14,
}
local SLICES = 24

-- Height of the body's top line at a share of the length from the nose (linear between points).
local function profileHeight(profile, share: number): number
	if share <= profile[1][1] then
		return profile[1][2]
	end
	for i = 1, #profile - 1 do
		local a, b = profile[i], profile[i + 1]
		if share <= b[1] then
			local t = if b[1] > a[1] then (share - a[1]) / (b[1] - a[1]) else 0
			return a[2] + (b[2] - a[2]) * t
		end
	end
	return profile[#profile][2]
end
VehicleModelBuilder.profileHeight = profileHeight
VehicleModelBuilder.DEFAULT_BLOCKOUT = DEFAULT_BLOCKOUT

function VehicleModelBuilder.build(config, owner: Player): Model
	local mass = config.mass
	local dims = config.dimensions

	local model = Instance.new("Model")
	model.Name = config.id .. "_" .. owner.Name
	model:SetAttribute("VehicleConfig", config.id)
	model:SetAttribute("OwnerUserId", owner.UserId)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic

	-- physics root at the centre of mass (the model's origin)
	local totalKg = mass.kerbKg + mass.driverKg
	local box = mass.inertiaBox
	local root = Instance.new("Part")
	root.Name = "MassBox"
	root.Size = studs(Vector3.new(box.width, box.height, box.length))
	root.CFrame = CFrame.identity
	local volume = root.Size.X * root.Size.Y * root.Size.Z
	root.CustomPhysicalProperties = PhysicalProperties.new(Units.kgToRmu(totalKg) / volume, 0.3, 0, 1, 1)
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.RootPriority = 127
	root.Parent = model
	model.PrimaryPart = root

	-- key positions in the car's frame (metres; forward is -Z, ground at ride height is y = -comHeight)
	local frontZ = -dims.wheelbase * (1 - mass.frontShare)
	local rearZ = dims.wheelbase * mass.frontShare
	local ground = -mass.comHeight
	local nose = frontZ - dims.frontOverhang
	local tail = nose + dims.length
	local midZ = (nose + tail) / 2
	local shape = config.visual.blockout or DEFAULT_BLOCKOUT
	local profile = shape.profile
	local glassFrom, glassTo = shape.greenhouse[1], shape.greenhouse[2]
	local beltline = shape.beltline
	local sill = shape.sill or 0.14
	-- where things sit along the car, as z in the car's frame
	local function zAt(share: number): number
		return nose + dims.length * share
	end
	local driverShare = glassFrom + 0.4 * (glassTo - glassFrom)
	local cabinZ = zAt(driverShare)
	local eyeHeight = profileHeight(profile, driverShare) - 0.2

	local paint = config.visual.bodyColor
	local carbon = Color3.fromRGB(28, 28, 30)
	local dark = Color3.fromRGB(18, 18, 20)
	local glass = Color3.fromRGB(18, 24, 30)
	local chrome = Color3.fromRGB(200, 202, 206)

	local body = Instance.new("Model")
	body.Name = "Body"
	body.Parent = model

	-- the lower body (sill to window line) is also the car's collision shape
	visual(body, root, "LowerBody", Vector3.new(dims.width - 0.03, beltline - sill, dims.length - 0.1), Vector3.new(0, ground + (sill + beltline) / 2, midZ), paint, Enum.Material.SmoothPlastic, { collide = true })

	-- upper body as slices along the car: painted bonnet and deck, glass cabin with a painted roof
	local sliceLength = dims.length / SLICES
	for i = 0, SLICES - 1 do
		local share = (i + 0.5) / SLICES
		local top = profileHeight(profile, share)
		local z = zAt(share)
		if share > glassFrom and share < glassTo then
			if top - 0.07 > beltline then
				visual(body, root, "Glass", Vector3.new(dims.width * shape.cabinWidth, top - 0.07 - beltline, sliceLength + 0.01), Vector3.new(0, ground + (beltline + top - 0.07) / 2, z), glass, Enum.Material.Glass, { transparency = 0.3 })
			end
		elseif top > beltline then
			visual(body, root, "Panel", Vector3.new(dims.width - 0.12, top - beltline, sliceLength + 0.01), Vector3.new(0, ground + (beltline + top) / 2, z), paint, Enum.Material.SmoothPlastic)
		end
	end

	-- smooth cabin top: a tilted plate along each piece of the profile inside the greenhouse,
	-- glass where it's steep (windscreen, rear window), painted where it's flat (roof)
	local points = { { glassFrom, profileHeight(profile, glassFrom) } }
	for _, point in profile do
		if point[1] > glassFrom and point[1] < glassTo then
			table.insert(points, point)
		end
	end
	table.insert(points, { glassTo, profileHeight(profile, glassTo) })
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local dz, dy = (b[1] - a[1]) * dims.length, b[2] - a[2]
		local length = math.sqrt(dz * dz + dy * dy)
		if length > 0.02 then
			local steep = math.abs(dy) > 0.35 * dz
			visual(body, root, if steep then "Screen" else "Roof", Vector3.new(dims.width * shape.cabinWidth, 0.04, length + 0.02),
				Vector3.new(0, ground + (a[2] + b[2]) / 2 - 0.02, zAt((a[1] + b[1]) / 2)),
				if steep then glass else paint, if steep then Enum.Material.Glass else Enum.Material.SmoothPlastic,
				{ rotation = CFrame.Angles(-math.atan2(dy, dz), 0, 0), transparency = if steep then 0.25 else nil })
		end
	end

	local noseTop = profileHeight(profile, 0.02)
	local tailTop = profileHeight(profile, 0.98)
	visual(body, root, "FrontIntake", Vector3.new(1.5, 0.22, 0.12), Vector3.new(0, ground + 0.3, nose + 0.04), dark, Enum.Material.SmoothPlastic)
	visual(body, root, "Splitter", Vector3.new(dims.width - 0.2, 0.03, 0.3), Vector3.new(0, ground + 0.135, nose + 0.15), carbon, Enum.Material.SmoothPlastic)
	visual(body, root, "Diffuser", Vector3.new(1.5, 0.16, 0.3), Vector3.new(0, ground + 0.22, tail - 0.12), carbon, Enum.Material.SmoothPlastic)
	for _, side in { -1, 1 } do
		local headlight = visual(body, root, "Headlight", Vector3.new(0.38, 0.07, 0.12), Vector3.new(side * 0.68, ground + noseTop - 0.08, nose + 0.12), Color3.fromRGB(240, 244, 255), Enum.Material.Neon)
		local beam = Instance.new("SpotLight")
		beam.Face = Enum.NormalId.Front
		beam.Brightness = 3
		beam.Range = 60
		beam.Angle = 50
		beam.Parent = headlight
		visual(body, root, "Taillight", Vector3.new(0.3, 0.08, 0.04), Vector3.new(side * 0.62, ground + tailTop - 0.12, tail), Color3.fromRGB(255, 30, 30), Enum.Material.Neon)
		visual(body, root, "Mirror", Vector3.new(0.22, 0.1, 0.12), Vector3.new(side * (dims.width / 2 + 0.05), ground + beltline + 0.08, zAt(glassFrom) + 0.15), paint, Enum.Material.SmoothPlastic)
	end
	-- exhaust tips: { sideways offset from the centre line (m, + right), height above the ground (m) }
	local tipDiameter = config.visual.exhaustTipDiameter or 0.09
	local tips = config.visual.exhaustTips or { { -0.32, 0.26 }, { -0.2, 0.26 }, { 0.2, 0.26 }, { 0.32, 0.26 } }
	for _, tip in tips do
		visual(body, root, "ExhaustTip", Vector3.new(0.12, tipDiameter, tipDiameter), Vector3.new(tip[1], ground + tip[2], tail - 0.02), chrome, Enum.Material.Metal, { shape = Enum.PartType.Cylinder, rotation = CFrame.Angles(0, math.rad(90), 0) })
	end

	local seat = Instance.new("Seat")
	seat.Name = "DriverSeat"
	seat.Size = studs(Vector3.new(0.45, 0.1, 0.45))
	local driverX = if config.visual.driverSide == "Right" then 0.38 else -0.38
	seat.CFrame = CFrame.new(studs(Vector3.new(driverX, ground + 0.18, cabinZ + 0.25)))
	seat.Transparency = 1
	seat.Massless = true
	seat.CanCollide = false
	seat.CanQuery = false
	seat.Parent = model
	weld(root, seat)

	attachment(root, "ChaseCamTarget", Vector3.new(0, 0.5, 0))
	attachment(root, "HoodCam", Vector3.new(0, ground + profileHeight(profile, glassFrom - 0.06) + 0.12, zAt(glassFrom - 0.06)))
	attachment(root, "CockpitCam", Vector3.new(driverX, ground + eyeHeight, cabinZ + 0.15))

	-- wheels: visual only. Their position, steering and spin come from the client controller.
	for _, id in WHEEL_IDS do
		local isFront = string.sub(id, 1, 1) == "F"
		local isLeft = string.sub(id, 2, 2) == "L"
		local spec = if isFront then config.tires.front else config.tires.rear
		local radius = Tire.radiusFromSize(spec.widthMm, spec.aspect, spec.rimInches)
		local track = if isFront then dims.trackFront else dims.trackRear
		local width = spec.widthMm / 1000
		local rimDiameter = spec.rimInches * 0.0254
		local centre = Vector3.new((if isLeft then -1 else 1) * track / 2, ground + radius, if isFront then frontZ else rearZ)

		local tire = Instance.new("Part")
		tire.Name = "Wheel_" .. id
		tire.Shape = Enum.PartType.Cylinder
		tire.Size = studs(Vector3.new(width, radius * 2, radius * 2))
		tire.CFrame = CFrame.new(studs(centre))
		tire.Color = Color3.fromRGB(16, 16, 16)
		tire.Material = Enum.Material.SmoothPlastic
		tire.Massless = true
		tire.CanCollide = false
		tire.CanQuery = false
		tire.CanTouch = false
		tire.Parent = model

		local rim = Instance.new("Part")
		rim.Name = "Rim"
		rim.Shape = Enum.PartType.Cylinder
		rim.Size = studs(Vector3.new(width + 0.012, rimDiameter, rimDiameter))
		rim.CFrame = tire.CFrame
		rim.Color = Color3.fromRGB(168, 170, 174)
		rim.Material = Enum.Material.Metal
		rim.Massless = true
		rim.CanCollide = false
		rim.CanQuery = false
		rim.CanTouch = false
		rim.Parent = tire
		weld(tire, rim)

		-- a dark bar across the rim so wheel spin is visible
		local spoke = Instance.new("Part")
		spoke.Name = "Spoke"
		spoke.Size = studs(Vector3.new(width + 0.02, rimDiameter * 0.9, 0.06))
		spoke.CFrame = tire.CFrame
		spoke.Color = dark
		spoke.Material = Enum.Material.SmoothPlastic
		spoke.Massless = true
		spoke.CanCollide = false
		spoke.CanQuery = false
		spoke.CanTouch = false
		spoke.Parent = tire
		weld(tire, spoke)

		local joint = Instance.new("Motor6D")
		joint.Name = "WheelJoint_" .. id
		joint.Part0 = root
		joint.Part1 = tire
		joint.C0 = CFrame.new(studs(centre))
		joint.C1 = CFrame.identity
		joint.Parent = root

		local point = attachment(root, "ForcePoint_" .. id, Vector3.new(centre.X, ground, centre.Z))
		vectorForce(root, "WheelForce_" .. id, point, false)
	end

	local centrePoint = attachment(root, "CenterPoint", Vector3.zero)
	vectorForce(root, "DragForce", centrePoint, true)
	vectorForce(root, "AeroFrontForce", attachment(root, "AeroFrontPoint", Vector3.new(0, 0, frontZ)), false)
	vectorForce(root, "AeroRearForce", attachment(root, "AeroRearPoint", Vector3.new(0, 0, rearZ)), false)

	return model
end

return VehicleModelBuilder
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000044">
<Properties>
<string name="Name">VehicleSpawner</string>
<ProtectedString name="Source"><![CDATA[--[[
	VehicleSpawner
	Gives each player a car when their character spawns, on the start grid of the map they're on,
	seats them in it and hands them network ownership so their own client simulates it. Handles
	three requests from clients, each rate-limited and checked, since the server trusts nothing a
	client sends:
	  RequestRespawn               put the car back on the nearest lane of the current map (R)
	  RequestMapSwitch(mapId)      move to another map's start grid (N); mapId must name a map
	  RequestVehicle(configId)     change car (G); configId must name a ModuleScript in
	                               VehicleSystem.VehicleConfigurations that loads as a car
	A player's map and car choice are remembered until they leave. Spawn positions come from the
	car's own configuration (centre-of-mass height), so cars of any size spawn correctly.

	Each car gets attributes: OwnerUserId and VehicleConfig (VehicleModelBuilder), MapId, and
	LengthM and WidthM (its body size in metres, for traffic). The client is told about a new car
	with VehicleSpawned(model, mapId).

	Phase 7 adds server-side checks on speed and position; for now the server trusts nothing
	that matters (there is no money or racing yet).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local VehicleSystem = ReplicatedStorage:WaitForChild("VehicleSystem")
local MapRegistry = require(ReplicatedStorage:WaitForChild("TrafficSystem"):WaitForChild("MapRegistry"))
local VehicleModelBuilder = require(script.Parent.VehicleModelBuilder)
local MapService = require(script.Parent.MapService)

local DEFAULT_VEHICLE = "Prototype812"
local RESPAWN_COOLDOWN = 2 -- seconds between respawns
local SWITCH_COOLDOWN = 4 -- seconds between map switches
local VEHICLE_COOLDOWN = 3 -- seconds between car changes
local FAR = 200 -- studs: a driver further than this from the new seat is moved next to it first

local VehicleSpawner = {}

local remotes: Folder
local vehiclesFolder: Folder
local vehicles: { [Player]: Model } = {}
local slots: { [Player]: number } = {}
local choices: { [Player]: string } = {}
local lastAction: { [Player]: { [string]: number } } = {}
local masslessConnections: { [Player]: RBXScriptConnection } = {}

-- True if the player may do this action now (and starts its cooldown).
local function allowed(player: Player, action: string, cooldown: number): boolean
	local now = os.clock()
	local times = lastAction[player]
	if times == nil then
		times = {}
		lastAction[player] = times
	end
	if times[action] ~= nil and now - times[action] < cooldown then
		return false
	end
	times[action] = now
	return true
end

-- The configuration module for an id, if the id names one.
local function configModule(id: any): ModuleScript?
	if type(id) ~= "string" or #id == 0 or #id > 64 then
		return nil
	end
	local module = VehicleSystem.VehicleConfigurations:FindFirstChild(id)
	if module and module:IsA("ModuleScript") then
		return module
	end
	return nil
end

-- A car configuration, or nil if it doesn't load or lacks what spawning needs.
local function loadConfig(id: any)
	local module = configModule(id)
	if module == nil then
		return nil
	end
	local ok, config = pcall(require, module)
	if not ok or type(config) ~= "table" or type(config.mass) ~= "table" or type(config.dimensions) ~= "table"
		or type(config.mass.comHeight) ~= "number" then
		warn("[VehicleSpawner] Vehicle configuration " .. module.Name .. " didn't load: " .. tostring(if ok then "missing fields" else config))
		return nil
	end
	return config
end

-- The configuration of the player's chosen car (the default car if the choice won't load).
local function configFor(player: Player)
	return loadConfig(choices[player] or DEFAULT_VEHICLE) or loadConfig(DEFAULT_VEHICLE)
end

local function freeSlot(): number
	local used = {}
	for _, slot in slots do
		used[slot] = true
	end
	local slot = 1
	while used[slot] do
		slot += 1
	end
	return slot
end

function VehicleSpawner.remove(player: Player)
	local model = vehicles[player]
	if model then
		model:Destroy()
		vehicles[player] = nil
	end
end

function VehicleSpawner.spawn(player: Player, cframe: CFrame, config)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not humanoid or humanoid.Health <= 0 then
		return
	end
	VehicleSpawner.remove(player)

	local mapId = MapService.mapOf(player)
	local model = VehicleModelBuilder.build(config, player)
	model:SetAttribute("MapId", mapId)
	model:SetAttribute("LengthM", config.dimensions.length)
	model:SetAttribute("WidthM", config.dimensions.width)
	model:PivotTo(cframe)
	model.Parent = vehiclesFolder
	vehicles[player] = model

	local seat = model:FindFirstChild("DriverSeat") :: Seat
	-- after a map switch the driver is kilometres away: bring them next to the seat first
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if rootPart and (rootPart.Position - seat.Position).Magnitude > FAR then
		character:PivotTo(seat.CFrame + Vector3.new(0, 4, 0))
	end
	seat:Sit(humanoid)
	-- On a respawn the humanoid may still count as seated in the old, destroyed seat, and Sit can be
	-- refused. Check shortly after and try again.
	task.spawn(function()
		for _ = 1, 3 do
			task.wait(0.25)
			if vehicles[player] ~= model or seat.Occupant == humanoid or humanoid.Health <= 0 then
				return
			end
			humanoid.Sit = false
			task.wait()
			seat:Sit(humanoid)
		end
	end)
	-- the driver's mass is already in the configuration, so the avatar itself adds none,
	-- including accessories and body parts that finish loading later
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") then
			part.Massless = true
		end
	end
	if masslessConnections[player] then
		masslessConnections[player]:Disconnect()
	end
	masslessConnections[player] = character.DescendantAdded:Connect(function(part)
		if part:IsA("BasePart") then
			part.Massless = true
		end
	end)

	local ok, err = pcall(function()
		model.PrimaryPart:SetNetworkOwner(player)
	end)
	if not ok then
		warn("[VehicleSpawner] Could not give network ownership to " .. player.Name .. ": " .. tostring(err))
	end
	remotes.VehicleSpawned:FireClient(player, model, mapId)
end

-- A new car for the player on the start grid of their current map.
local function spawnOnGrid(player: Player)
	local config = configFor(player)
	VehicleSpawner.spawn(player, MapService.gridCFrame(MapService.mapOf(player), slots[player] or 1, config.mass.comHeight), config)
end

-- A new car on the nearest lane of the current map (or the grid if there's no car yet).
local function spawnNearby(player: Player)
	local config = configFor(player)
	local current = vehicles[player]
	if current and current.PrimaryPart then
		VehicleSpawner.spawn(player, MapService.nearestCFrame(MapService.mapOf(player), current.PrimaryPart.Position, config.mass.comHeight), config)
	else
		spawnOnGrid(player)
	end
end

function VehicleSpawner.respawn(player: Player)
	if allowed(player, "respawn", RESPAWN_COOLDOWN) then
		spawnNearby(player)
	end
end

-- Move a player to another map's start grid. mapId comes from the client: it must name a map.
function VehicleSpawner.switchMap(player: Player, mapId: any)
	if not MapRegistry.isMap(mapId) or mapId == MapService.mapOf(player) then
		return
	end
	if not allowed(player, "map", SWITCH_COOLDOWN) then
		return
	end
	MapService.setMap(player, mapId)
	spawnOnGrid(player)
end

-- Change a player's car. configId comes from the client: it must name a car that loads.
function VehicleSpawner.chooseVehicle(player: Player, configId: any)
	if configModule(configId) == nil or configId == (choices[player] or DEFAULT_VEHICLE) then
		return
	end
	if not allowed(player, "vehicle", VEHICLE_COOLDOWN) then
		return
	end
	if loadConfig(configId) == nil then
		return
	end
	choices[player] = configId
	spawnNearby(player)
end

local function onCharacterAdded(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid") :: Humanoid
	character:WaitForChild("HumanoidRootPart")
	-- a reset or death takes the car away with the driver; a new one comes with the next character
	humanoid.Died:Once(function()
		if player.Character == character then
			VehicleSpawner.remove(player)
		end
	end)
	task.wait(0.5)
	if player.Parent and player.Character == character then
		spawnOnGrid(player)
	end
end

local function onPlayerAdded(player: Player)
	slots[player] = freeSlot()
	MapService.setMap(player, MapService.mapOf(player))
	player.CharacterAdded:Connect(function(character)
		onCharacterAdded(player, character)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end
end

function VehicleSpawner.init(remoteFolder: Folder)
	remotes = remoteFolder
	vehiclesFolder = Instance.new("Folder")
	vehiclesFolder.Name = "Vehicles"
	vehiclesFolder.Parent = Workspace

	remotes.RequestRespawn.OnServerEvent:Connect(function(player)
		VehicleSpawner.respawn(player)
	end)
	remotes.RequestMapSwitch.OnServerEvent:Connect(function(player, mapId)
		VehicleSpawner.switchMap(player, mapId)
	end)
	remotes.RequestVehicle.OnServerEvent:Connect(function(player, configId)
		VehicleSpawner.chooseVehicle(player, configId)
	end)
	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		onPlayerAdded(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		VehicleSpawner.remove(player)
		slots[player] = nil
		choices[player] = nil
		lastAction[player] = nil
		MapService.forget(player)
		if masslessConnections[player] then
			masslessConnections[player]:Disconnect()
			masslessConnections[player] = nil
		end
	end)
end

return VehicleSpawner
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX00000045">
<Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBX00000046">
<Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="Folder" referent="RBX00000047">
<Properties>
<string name="Name">Client</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000048">
<Properties>
<string name="Name">AudioEnvironment</string>
<ProtectedString name="Source"><![CDATA[--[[
	AudioEnvironment: how the place around the listener (the camera) changes what is heard.

	Tunnels. The maps mark the inside of every tunnel with invisible box parts tagged "TunnelZone"
	(CollectionService); long or curved tunnels are chains of boxes that overlap at the joints. While
	the camera is inside one, every SoundGroup attached here gets:
	  * reverb (ReverbSoundEffect), its decay from the zone's ReverbDecay attribute;
	  * a short slap echo between the walls (EchoSoundEffect), its delay from the zone's width;
	  * a low-mid build-up (EqualizerSoundEffect: the reverberant field of a concrete tube keeps the
	    lows and loses the highs);
	  * a level rise.
	The effect starts a little before a portal and eases in over the first metres inside, scaled by
	how fast the camera moves, then eases out the same way.

	Zone attributes (optional): ReverbDecay (seconds, default 1.6), ReverbWet (dB, default -4).
	Testing without a tunnel: during Play, set the attribute ForceTunnel = true on SoundService.

	The maths (TunnelMath below) is copied in tools/audio_preview.py, which renders a tunnel pass.
	Keep the two in step.
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local TAG = "TunnelZone"
local METERS_PER_STUD = 0.28

local TunnelMath = {
	APPROACH_M = 12, -- the effect begins this far before a portal
	APPROACH_SHARE = 0.4, -- and reaches this share of full at the portal
	EASE_M = 15, -- it is nearly complete this far inside (and gone this far outside)
	MIN_RATE = 1.2, -- 1/s, the slowest easing (a camera standing still)
	DEFAULT_DECAY = 1.6, -- s
	DEFAULT_WET = -4, -- dB
	LEVEL_RISE = 0.26, -- +2 dB
	LOW_GAIN = 5, -- dB below 400 Hz
	MID_GAIN = 1.5, -- dB from 400 Hz to 4 kHz
	HIGH_GAIN = -2, -- dB above 4 kHz
	ECHO_WET = -14, -- dB
	ECHO_FEEDBACK = 0.3,
}
TunnelMath.__index = TunnelMath

-- Target amount (0-1) for a listener this many metres outside the nearest zone (0 = inside).
function TunnelMath.target(outsideM: number): number
	if outsideM <= 0 then
		return 1
	end
	return math.clamp(1 - outsideM / TunnelMath.APPROACH_M, 0, 1) * TunnelMath.APPROACH_SHARE
end

-- One easing step: how far the amount moves toward the target this frame.
function TunnelMath.ease(amount: number, target: number, speed: number, dt: number): number
	local rate = math.max(TunnelMath.MIN_RATE, 3 * speed / TunnelMath.EASE_M)
	return amount + (target - amount) * math.clamp(rate * dt, 0, 1)
end

-- Reverb wet level (dB) for an amount, rising quickly at first.
function TunnelMath.wetLevel(amount: number, wet: number): number
	return -40 + (wet + 40) * math.sqrt(amount)
end

-- Slap echo delay (s) across a tunnel this many metres wide.
function TunnelMath.echoDelay(widthM: number): number
	return math.clamp(widthM / 343, 0.02, 0.08)
end

local AudioEnvironment = {}
AudioEnvironment.TunnelMath = TunnelMath

local zones: { [BasePart]: boolean } = {}
local groups = {} -- SoundGroup -> { reverb, echo, eq, baseVolume }
local amount = 0
local decay = TunnelMath.DEFAULT_DECAY
local wet = TunnelMath.DEFAULT_WET
local echoDelay = 0.035
local lastPosition: Vector3? = nil
local speed = 0
local started = false

local function addZone(instance: Instance)
	if instance:IsA("BasePart") then
		zones[instance] = true
	end
end

local function removeZone(instance: Instance)
	zones[instance :: BasePart] = nil
end

-- Distance in metres from a point to a box part (0 inside), using the part's own axes.
local function outsideDistance(part: BasePart, point: Vector3): number
	local p = part.CFrame:PointToObjectSpace(point)
	local h = part.Size / 2
	local dx = math.max(math.abs(p.X) - h.X, 0)
	local dy = math.max(math.abs(p.Y) - h.Y, 0)
	local dz = math.max(math.abs(p.Z) - h.Z, 0)
	return math.sqrt(dx * dx + dy * dy + dz * dz) * METERS_PER_STUD
end

local function apply(group: SoundGroup, entry)
	local on = amount > 0.002
	entry.reverb.Enabled = on
	entry.echo.Enabled = on
	entry.eq.Enabled = on
	if on then
		entry.reverb.DecayTime = decay
		entry.reverb.WetLevel = TunnelMath.wetLevel(amount, wet)
		entry.echo.Delay = echoDelay
		entry.echo.WetLevel = -40 + (TunnelMath.ECHO_WET + 40) * amount
		entry.eq.LowGain = TunnelMath.LOW_GAIN * amount
		entry.eq.MidGain = TunnelMath.MID_GAIN * amount
		entry.eq.HighGain = TunnelMath.HIGH_GAIN * amount
	end
	group.Volume = entry.baseVolume * (1 + TunnelMath.LEVEL_RISE * amount)
end

local function update(dt: number)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local position = camera.CFrame.Position
	if lastPosition and dt > 0 then
		local moved = (position - lastPosition).Magnitude * METERS_PER_STUD
		if moved < 40 then -- ignore camera cuts and respawns
			speed += (moved / dt - speed) * math.clamp(5 * dt, 0, 1)
		end
	end
	lastPosition = position

	local nearest, nearestPart = math.huge, nil
	for part in zones do
		local d = outsideDistance(part, position)
		if d < nearest then
			nearest, nearestPart = d, part
		end
	end
	local target = TunnelMath.target(nearest)
	if SoundService:GetAttribute("ForceTunnel") == true then
		target = 1
	end
	if nearestPart then
		local d = nearestPart:GetAttribute("ReverbDecay")
		local w = nearestPart:GetAttribute("ReverbWet")
		decay = math.clamp(if type(d) == "number" then d else TunnelMath.DEFAULT_DECAY, 0.1, 20)
		wet = math.clamp(if type(w) == "number" then w else TunnelMath.DEFAULT_WET, -40, 10)
		local size = nearestPart.Size
		echoDelay = TunnelMath.echoDelay(math.min(size.X, size.Z) * METERS_PER_STUD)
	end
	local before = amount
	amount = TunnelMath.ease(amount, target, speed, dt)
	if amount < 0.001 and before < 0.001 then
		amount = 0
	end
	for group, entry in groups do
		apply(group, entry)
	end
end

local function start()
	if started then
		return
	end
	started = true
	for _, instance in CollectionService:GetTagged(TAG) do
		addZone(instance)
	end
	CollectionService:GetInstanceAddedSignal(TAG):Connect(addZone)
	CollectionService:GetInstanceRemovedSignal(TAG):Connect(removeZone)
	RunService.Heartbeat:Connect(update)
end

-- Adds tunnel effects to a SoundGroup (call once per group, before it plays).
function AudioEnvironment.attach(group: SoundGroup)
	start()
	local reverb = Instance.new("ReverbSoundEffect")
	reverb.Name = "TunnelReverb"
	reverb.DryLevel = 0
	reverb.WetLevel = -40
	reverb.Density = 1
	reverb.Diffusion = 0.7
	reverb.DecayTime = TunnelMath.DEFAULT_DECAY
	reverb.Enabled = false
	reverb.Parent = group
	local echo = Instance.new("EchoSoundEffect")
	echo.Name = "TunnelEcho"
	echo.DryLevel = 0
	echo.WetLevel = -40
	echo.Feedback = TunnelMath.ECHO_FEEDBACK
	echo.Delay = 0.035
	echo.Enabled = false
	echo.Parent = group
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name = "TunnelEq"
	eq.LowGain = 0
	eq.MidGain = 0
	eq.HighGain = 0
	eq.Enabled = false
	eq.Parent = group
	groups[group] = { reverb = reverb, echo = echo, eq = eq, baseVolume = group.Volume }
	apply(group, groups[group])
end

function AudioEnvironment.detach(group: SoundGroup)
	groups[group] = nil
end

-- How much tunnel the listener hears now, 0-1 (for other modules and testing).
function AudioEnvironment.tunnelAmount(): number
	return amount
end

return AudioEnvironment
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000049">
<Properties>
<string name="Name">CameraController</string>
<ProtectedString name="Source"><![CDATA[--[[
	CameraController
	Chase, hood and cockpit cameras for the player's car.

	The chase camera follows the car's position exactly and only smooths its direction, so it
	never falls behind at 300 km/h. Field of view widens a little with speed. A very small
	high-speed vibration can be switched off with CameraController.settings.shake. In tunnels and
	beside walls, the chase camera moves in rather than through the wall or ceiling (one raycast a
	frame against the maps' solid parts, Workspace.Maps).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Units = require(ReplicatedStorage:WaitForChild("VehicleSystem"):WaitForChild("Units"))

local M = Units.METERS_PER_STUD
local MODES = { "Chase", "Hood", "Cockpit" }

local CameraController = {}

CameraController.settings = {
	shake = true,
	chaseDistance = 6.2, -- metres behind the centre of mass
	chaseHeight = 1.7, -- metres above it
	chaseFov = 68,
	hoodFov = 72,
	cockpitFov = 70,
	speedFovGain = 10, -- extra degrees of field of view at 320 km/h
}

local modeIndex = 1
local root: BasePart? = nil
local smoothedLook = Vector3.new(0, 0, -1)
local CLEARANCE = 0.4 -- m kept between the chase camera and a wall or ceiling
local mapParams = RaycastParams.new()
mapParams.FilterType = Enum.RaycastFilterType.Include
local mapsFolder: Instance? = nil

-- Where the chase camera can be: its wanted position, pulled in front of any map geometry between
-- the car and there.
local function unblocked(from: Vector3, wanted: Vector3): Vector3
	if mapsFolder == nil or mapsFolder.Parent == nil then
		mapsFolder = Workspace:FindFirstChild("Maps")
		if mapsFolder == nil then
			return wanted
		end
		mapParams.FilterDescendantsInstances = { mapsFolder }
	end
	local hit = Workspace:Raycast(from, wanted - from, mapParams)
	if hit == nil then
		return wanted
	end
	local back = from - hit.Position
	if back.Magnitude < CLEARANCE / M then
		return from
	end
	return hit.Position + back.Unit * (CLEARANCE / M)
end

local function setHeadHidden(hidden: boolean)
	local character = Players.LocalPlayer.Character
	if not character then
		return
	end
	for _, part in character:GetDescendants() do
		if part:IsA("BasePart") and (part.Name == "Head" or part:FindFirstAncestorOfClass("Accessory")) then
			part.LocalTransparencyModifier = if hidden then 1 else 0
		end
	end
end

local function update(dt: number)
	if not root then
		return
	end
	if not root.Parent then
		CameraController.stop() -- the car is gone (reset, death or respawn): hand the camera back
		return
	end
	local camera = Workspace.CurrentCamera
	local settings = CameraController.settings
	local cf = root.CFrame
	local speedKmh = root.AssemblyLinearVelocity.Magnitude * M * 3.6
	local speedShare = math.clamp(speedKmh / 320, 0, 1)
	local mode = MODES[modeIndex]

	if mode == "Chase" then
		local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
		if flat.Magnitude > 0.1 then
			smoothedLook = smoothedLook:Lerp(flat.Unit, 1 - math.exp(-dt * 6)).Unit
		end
		local position = cf.Position - smoothedLook * (settings.chaseDistance / M) + Vector3.yAxis * (settings.chaseHeight / M)
		local focus = cf.Position + smoothedLook * (2 / M) + Vector3.yAxis * (0.7 / M)
		position = unblocked(cf.Position + Vector3.yAxis * (0.7 / M), position)
		camera.CFrame = CFrame.lookAt(position, focus)
		camera.FieldOfView = settings.chaseFov + settings.speedFovGain * speedShare
	elseif mode == "Hood" then
		local mount = root:FindFirstChild("HoodCam") :: Attachment?
		camera.CFrame = if mount then mount.WorldCFrame else cf
		camera.FieldOfView = settings.hoodFov + settings.speedFovGain * 0.6 * speedShare
	else
		local mount = root:FindFirstChild("CockpitCam") :: Attachment?
		camera.CFrame = if mount then mount.WorldCFrame else cf
		camera.FieldOfView = settings.cockpitFov + settings.speedFovGain * 0.4 * speedShare
	end

	-- With a Scriptable camera, Roblox doesn't move Focus; lighting detail is centred on it.
	camera.Focus = CFrame.new(cf.Position)

	if settings.shake and speedKmh > 120 then
		local amount = math.rad(0.05) * math.clamp((speedKmh - 120) / 200, 0, 1)
		local t = os.clock() * 25
		camera.CFrame *= CFrame.Angles(math.noise(t, 1.3) * amount, math.noise(t, 7.1) * amount, 0)
	end
end

function CameraController.start(vehicle: Model)
	root = vehicle:WaitForChild("MassBox", 10) :: BasePart?
	if not root then
		return
	end
	smoothedLook = root.CFrame.LookVector
	Workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
	RunService:UnbindFromRenderStep("VehicleCamera")
	RunService:BindToRenderStep("VehicleCamera", Enum.RenderPriority.Camera.Value + 1, update)
	setHeadHidden(MODES[modeIndex] == "Cockpit")
end

function CameraController.stop()
	RunService:UnbindFromRenderStep("VehicleCamera")
	root = nil
	setHeadHidden(false)
	Workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
end

function CameraController.cycle()
	modeIndex = modeIndex % #MODES + 1
	setHeadHidden(MODES[modeIndex] == "Cockpit")
end

function CameraController.mode(): string
	return MODES[modeIndex]
end

return CameraController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000004A">
<Properties>
<string name="Name">ClosePassController</string>
<ProtectedString name="Source"><![CDATA[--[[
	ClosePassController: feeds the player's car and the traffic around it (in the road coordinates of
	the map the player is on) to the close-pass scorer every frame, and shows the result on the
	ScoreHUD. Scoring runs on this computer for now; the server checks scores once there is anything
	to win (Phase 7). The banked score carries over between maps; a new car or a new map ends the
	current combo without banking it.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local ClosePass = require(ReplicatedStorage:WaitForChild("Gameplay"):WaitForChild("ClosePass"))
local TrafficSystem = ReplicatedStorage:WaitForChild("TrafficSystem")
local DriverProfiles = require(TrafficSystem:WaitForChild("DriverProfiles"))
local Units = require(ReplicatedStorage:WaitForChild("VehicleSystem"):WaitForChild("Units"))

local Client = script.Parent
local TrafficRenderer = require(Client:WaitForChild("TrafficRenderer"))
local ScoreHUD = require(Client:WaitForChild("ScoreHUD"))

local M = Units.METERS_PER_STUD

local ClosePassController = {}

local scorer = nil
local connection: RBXScriptConnection? = nil
local player = { s = 0, offset = 0, v = 0, length = 4.7, width = 1.9 }
local cars = {} -- id -> { s, offset, v, length, width }, reused between frames

-- controller: the VehicleController of the player's car. map: the map it's on (MapRegistry).
function ClosePassController.start(controller, map)
	ClosePassController.stop()
	local road = map.road
	local dims = controller.config.dimensions
	player.length = dims.length
	player.width = dims.width
	if scorer then
		-- a new car (respawn, car change or map change) ends the current combo without banking it,
		-- and forgets cars that were alongside the old one
		table.clear(scorer.tracks)
		scorer.combo = 0
		scorer.multiplier = 1
		scorer.timer = 0
		scorer.lap = road.length
	else
		scorer = ClosePass.new(ClosePass.DEFAULTS, road.length)
	end
	table.clear(cars)
	ScoreHUD.set(scorer)
	connection = RunService.PostSimulation:Connect(function(dt)
		if controller.stopped then
			ClosePassController.stop()
			return
		end
		local root: BasePart = controller.root
		local s, offset = road:project(root.Position * M)
		local _, direction = road:centerline(s)
		player.s = s
		player.offset = offset
		player.v = (root.AssemblyLinearVelocity * M):Dot(direction)

		-- only traffic drawn for this map counts
		local live = if TrafficRenderer.mapId() == map.id then TrafficRenderer.cars() else {}
		for id in cars do
			if live[id] == nil then
				cars[id] = nil
			end
		end
		for id, car in live do
			local entry = cars[id]
			if entry == nil then
				local profile = DriverProfiles.profiles[DriverProfiles.order[car.profileIndex] or "normal"]
				entry = { s = 0, offset = 0, v = 0, length = profile.length, width = profile.width }
				cars[id] = entry
			end
			entry.s = car.s
			entry.offset = road:offsetFromLane(car.lanePos)
			entry.v = car.v
		end
		scorer:update(dt, player, cars)
		ScoreHUD.update(dt, scorer)
	end)
end

function ClosePassController.stop()
	if connection then
		connection:Disconnect()
		connection = nil
	end
end

return ClosePassController
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000004B">
<Properties>
<string name="Name">HUD</string>
<ProtectedString name="Source"><![CDATA[--[[
	HUD
	Driving display: speed, gear, gearbox mode, RPM bar with redline and shift light, pedal bars,
	ABS state and camera mode. T shows a telemetry overlay (engine, clutch or lock-up, boost, torque
	converter, all-wheel-drive split, G-forces, aero, per-wheel load, slip, slip angle, suspension
	travel, and timed 0-60 mph / 0-100 / 0-200 / quarter-mile / 100-0 runs against the car's
	performanceTargets). H shows or hides the controls.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local VehicleSystem = ReplicatedStorage:WaitForChild("VehicleSystem")
local Telemetry = require(VehicleSystem:WaitForChild("VehicleTelemetry"):WaitForChild("Telemetry"))
local VehicleSimulation = require(VehicleSystem:WaitForChild("CorePhysics"):WaitForChild("VehicleSimulation"))
local CameraController = require(script.Parent.CameraController)

local HUD = {}

local WHITE = Color3.fromRGB(240, 240, 240)
local GREY = Color3.fromRGB(150, 152, 158)
local AMBER = Color3.fromRGB(255, 176, 50)
local RED = Color3.fromRGB(235, 50, 50)
local PANEL = Color3.fromRGB(10, 10, 12)

local HELP_TEXT = table.concat({
	"CONTROLS",
	"W / S      accelerate / brake",
	"           (hold S when stopped to reverse)",
	"A / D      steer",
	"Space      handbrake",
	"E / Q      shift up / down (manual)",
	"M          automatic / manual gearbox",
	"B          ABS on / off",
	"V          traction control on / off",
	"C          camera: chase, hood, cockpit",
	"R          put the car back on the track",
	"G          next car",
	"N          switch map: Oval / City",
	"T          telemetry     H  hide this",
	"",
	"Gamepad: RT / LT pedals, left stick",
	"steers, RB / LB shift, X handbrake,",
	"Y camera, Back resets, D-pad left",
	"next car, D-pad right switch map",
}, "\n")

local refs: { [string]: any } = {}
local telemetryVisible = false
local lastTelemetryText = 0

local function make(className: string, properties: { [string]: any }, parent: Instance): any
	local object = Instance.new(className)
	for key, value in properties do
		(object :: any)[key] = value
	end
	object.Parent = parent
	return object
end

local function label(parent: Instance, properties: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextColor3 = WHITE,
		TextSize = 16,
	}
	for key, value in properties do
		defaults[key] = value
	end
	return make("TextLabel", defaults, parent)
end

local function panelText(parent: Instance, name: string, properties: { [string]: any }): TextLabel
	local text = label(parent, {
		Name = name,
		Font = Enum.Font.Code,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.3,
	})
	for key, value in properties do
		(text :: any)[key] = value
	end
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, text)
	make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingTop = UDim.new(0, 8) }, text)
	return text
end

local function formatTime(seconds: number?): string
	return if seconds then string.format("%.2f s", seconds) else "--"
end

-- "factory 2.9 s" for a target the configuration gives, otherwise nothing
local function factory(value: number?, format: string): string
	return if value then "factory " .. string.format(format, value) else ""
end

local function percent(share: number): number
	return math.floor(share * 100 + 0.5)
end

local function telemetryText(sim): string
	local t = sim.telemetry
	local frame = Telemetry.frame
	local results = Telemetry.results
	local targets = sim.config.performanceTargets or {}
	local automatic = t.lockup ~= nil
	local lines = {
		string.format("%s   gear %s (%s)   %s %3d%%", sim.config.displayName, t.gear, if t.auto then "auto" else "manual",
			if automatic then "lock-up" else "clutch", percent(t.clutch)),
		string.format("engine %5d rpm  %4d Nm      wheel torque %6d Nm", math.floor(t.rpm), math.floor(t.engineTorque), math.floor(t.wheelTorque)),
		string.format("speed %6.1f km/h    long %+.2f g    lat %+.2f g", t.speedKmh, frame.longG or 0, frame.latG or 0),
		string.format("pedal %3d%%  brake %3d%%  handbrake %3d%%  steer %+5.1f deg", math.floor(t.pedal * 100), math.floor(t.brake * 100), math.floor(t.handbrake * 100), t.steerDeg),
		string.format("drag %5d N    downforce front %5d N   rear %5d N", math.floor(t.drag), math.floor(t.downFront), math.floor(t.downRear)),
	}
	-- the drivetrain's extra state, where the car has it
	if t.forcedInduction then
		table.insert(lines, string.format("%-12s boost %+5.2f bar  (%3d%% of full)", string.lower(t.forcedInduction), t.boostBar, percent(t.boost)))
	end
	if automatic then
		table.insert(lines, string.format("converter    slip %3d%%  lock-up %3d%%%s%s", percent(math.max(t.converterSlip or 0, 0)), percent(t.lockup),
			if t.shifting then "  shifting" else "", if t.parked then "  park" else ""))
	end
	if sim.config.drivetrain.layout == "AWD" then
		table.insert(lines, string.format("all-wheel drive: %3d%% of the drive to the front axle", percent(t.frontTorqueShare or 0)))
	end
	table.insert(lines, "")
	table.insert(lines, "wheel     load N     slip    angle    travel    wheel rpm")
	for _, id in VehicleSimulation.WHEEL_IDS do
		local w = sim.wheels[id]
		local travel = math.floor((w.staticLength - w.length) * 1000 + 0.5)
		table.insert(lines, string.format("%-5s %10d  %7.3f  %5.1f deg  %+5d mm  %8d", id, math.floor(w.load), w.slipRatio, math.deg(w.slipAngle), travel, math.floor(w.omega * 30 / math.pi)))
	end
	table.insert(lines, "")
	table.insert(lines, string.format("0-60 mph     %-9s %s", formatTime(results.zeroTo60Mph), factory(targets.zeroTo60Mph, "%.1f s")))
	table.insert(lines, string.format("0-100 km/h   %-9s %s", formatTime(results.zeroTo100), factory(targets.zeroTo100, "%.1f s")))
	table.insert(lines, string.format("0-200 km/h   %-9s %s", formatTime(results.zeroTo200), factory(targets.zeroTo200, "%.1f s")))
	table.insert(lines, string.format("1/4 mile     %-9s %s %s", formatTime(results.quarterMile),
		if results.quarterMileKmh then string.format("at %.0f km/h", results.quarterMileKmh) else "", factory(targets.quarterMile, "%.1f s")))
	table.insert(lines, string.format("100-0 km/h   %-9s %s", if results.brake100 then string.format("%.1f m", results.brake100) else "--", factory(targets.brake100To0, "%.1f m")))
	table.insert(lines, string.format("top speed    %.0f km/h  %s", results.topSpeed, factory(targets.topSpeedKmh, "%.0f km/h")))
	table.insert(lines, string.format("%d fps", math.floor(frame.fps or 0)))
	return table.concat(lines, "\n")
end

local function update()
	local sim = Telemetry.sim
	refs.gui.Enabled = sim ~= nil
	if not sim or not sim.telemetry.rpm then
		return
	end
	local t = sim.telemetry
	local engine = sim.config.engine
	local maxRpm = engine.limiterRpm + 600

	refs.speed.Text = tostring(math.floor(math.abs(t.forwardKmh) + 0.5))
	refs.gear.Text = t.gear
	refs.mode.Text = if t.auto then "AUTO" else "MANUAL"
	local tcText = if not t.tractionControl then "tc off  " elseif t.tractionActive then "TC!  " else "TC  "
	refs.flags.Text = (if t.abs then "ABS  " else "abs off  ") .. tcText .. (if t.limiter then "LIMIT" else "")
	refs.flags.TextColor3 = if t.limiter then RED else GREY

	local share = math.clamp(t.rpm / maxRpm, 0, 1)
	refs.rpmFill.Size = UDim2.fromScale(share, 1)
	refs.rpmFill.BackgroundColor3 = if t.rpm > engine.limiterRpm - 900 then RED elseif t.rpm > engine.limiterRpm - 2400 then AMBER else WHITE
	refs.rpmText.Text = string.format("%d rpm", math.floor(t.rpm / 10 + 0.5) * 10)
	local nearLimit = t.rpm > engine.limiterRpm - 450
	refs.shiftLight.BackgroundTransparency = if nearLimit and (os.clock() * 8) % 2 < 1 then 0 else 1

	refs.throttleFill.Size = UDim2.fromScale(1, math.clamp(t.pedal, 0, 1))
	refs.brakeFill.Size = UDim2.fromScale(1, math.clamp(t.brake, 0, 1))
	refs.camera.Text = "Camera: " .. CameraController.mode() .. " (C)"

	if telemetryVisible and os.clock() - lastTelemetryText > 0.1 then
		lastTelemetryText = os.clock()
		refs.telemetry.Text = telemetryText(sim)
	end
end

function HUD.init()
	local gui = make("ScreenGui", { Name = "DriveHUD", ResetOnSpawn = false, IgnoreGuiInset = true, Enabled = false }, Players.LocalPlayer:WaitForChild("PlayerGui"))
	refs.gui = gui

	local cluster = make("Frame", {
		Name = "Cluster",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -24),
		Size = UDim2.fromOffset(400, 150),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
	}, gui)
	make("UICorner", { CornerRadius = UDim.new(0, 12) }, cluster)

	refs.speed = label(cluster, { Font = Enum.Font.GothamBlack, TextSize = 64, Text = "0", Position = UDim2.fromOffset(40, 6), Size = UDim2.fromOffset(170, 72), TextXAlignment = Enum.TextXAlignment.Right })
	label(cluster, { Text = "km/h", TextSize = 16, TextColor3 = GREY, Position = UDim2.fromOffset(216, 46), Size = UDim2.fromOffset(60, 24), TextXAlignment = Enum.TextXAlignment.Left })
	refs.gear = label(cluster, { Font = Enum.Font.GothamBlack, TextSize = 64, Text = "1", Position = UDim2.fromOffset(300, 6), Size = UDim2.fromOffset(80, 72) })
	refs.mode = label(cluster, { Text = "AUTO", TextSize = 13, TextColor3 = GREY, Position = UDim2.fromOffset(300, 74), Size = UDim2.fromOffset(80, 16) })

	refs.shiftLight = make("Frame", { Position = UDim2.fromOffset(40, 88), Size = UDim2.fromOffset(340, 6), BackgroundColor3 = RED, BackgroundTransparency = 1, BorderSizePixel = 0 }, cluster)
	local rpmBack = make("Frame", { Position = UDim2.fromOffset(40, 100), Size = UDim2.fromOffset(340, 14), BackgroundColor3 = Color3.fromRGB(40, 40, 44), BorderSizePixel = 0 }, cluster)
	refs.rpmFill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0 }, rpmBack)
	refs.redline = make("Frame", { Size = UDim2.new(0, 2, 1, 6), Position = UDim2.new(0, 0, 0, -3), BackgroundColor3 = RED, BorderSizePixel = 0 }, rpmBack)
	refs.rpmText = label(cluster, { Text = "0 rpm", TextSize = 14, TextColor3 = GREY, Position = UDim2.fromOffset(40, 120), Size = UDim2.fromOffset(160, 20), TextXAlignment = Enum.TextXAlignment.Left })
	refs.flags = label(cluster, { Text = "ABS", TextSize = 14, TextColor3 = GREY, Position = UDim2.fromOffset(220, 120), Size = UDim2.fromOffset(160, 20), TextXAlignment = Enum.TextXAlignment.Right })

	-- pedal bars down the left edge of the cluster
	local throttleBack = make("Frame", { Position = UDim2.fromOffset(12, 14), Size = UDim2.fromOffset(8, 122), BackgroundColor3 = Color3.fromRGB(40, 40, 44), BorderSizePixel = 0 }, cluster)
	refs.throttleFill = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), BackgroundColor3 = Color3.fromRGB(80, 200, 120), BorderSizePixel = 0 }, throttleBack)
	local brakeBack = make("Frame", { Position = UDim2.fromOffset(24, 14), Size = UDim2.fromOffset(8, 122), BackgroundColor3 = Color3.fromRGB(40, 40, 44), BorderSizePixel = 0 }, cluster)
	refs.brakeFill = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0), BackgroundColor3 = RED, BorderSizePixel = 0 }, brakeBack)

	refs.camera = label(gui, { Text = "Camera: Chase (C)", TextSize = 14, TextColor3 = GREY, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -180), Size = UDim2.fromOffset(240, 20), TextXAlignment = Enum.TextXAlignment.Right })
	refs.telemetry = panelText(gui, "Telemetry", { Position = UDim2.fromOffset(16, 56), Size = UDim2.fromOffset(560, 440), Visible = false, Text = "" })
	refs.help = panelText(gui, "Help", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -24), Size = UDim2.fromOffset(340, 330), Text = HELP_TEXT })

	RunService.RenderStepped:Connect(update)
end

-- Call once a car exists so the redline marker sits at the right rpm.
function HUD.setVehicle(config)
	if refs.redline then
		local share = config.engine.limiterRpm / (config.engine.limiterRpm + 600)
		refs.redline.Position = UDim2.new(share, -1, 0, -3)
	end
end

function HUD.toggleTelemetry()
	telemetryVisible = not telemetryVisible
	refs.telemetry.Visible = telemetryVisible
end

function HUD.toggleHelp()
	refs.help.Visible = not refs.help.Visible
end

return HUD
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000004C">
<Properties>
<string name="Name">InputController</string>
<ProtectedString name="Source"><![CDATA[--[[
	InputController
	Keyboard and gamepad driving input. Keyboard pedals and steering ramp smoothly (digital keys
	would otherwise slam a 800 CV car); gamepad triggers and stick are used directly.

	InputController.state = { throttle 0-1, brake 0-1, steer -1 to 1, handbrake 0-1 }
	One-shot actions (shifts, camera, reset, next car (G), next map (N)...) are delivered to
	listeners registered with on().
]]

local UserInputService = game:GetService("UserInputService")

local InputController = {}

InputController.state = { throttle = 0, brake = 0, steer = 0, handbrake = 0 }

local HOLD_KEYS = {
	[Enum.KeyCode.W] = "throttle",
	[Enum.KeyCode.Up] = "throttle",
	[Enum.KeyCode.S] = "brake",
	[Enum.KeyCode.Down] = "brake",
	[Enum.KeyCode.A] = "left",
	[Enum.KeyCode.Left] = "left",
	[Enum.KeyCode.D] = "right",
	[Enum.KeyCode.Right] = "right",
	[Enum.KeyCode.Space] = "handbrake",
	[Enum.KeyCode.ButtonX] = "handbrake",
}

local ACTION_KEYS = {
	[Enum.KeyCode.E] = "shiftUp",
	[Enum.KeyCode.ButtonR1] = "shiftUp",
	[Enum.KeyCode.Q] = "shiftDown",
	[Enum.KeyCode.ButtonL1] = "shiftDown",
	[Enum.KeyCode.M] = "toggleAuto",
	[Enum.KeyCode.B] = "toggleAbs",
	[Enum.KeyCode.V] = "toggleTc",
	[Enum.KeyCode.C] = "camera",
	[Enum.KeyCode.ButtonY] = "camera",
	[Enum.KeyCode.R] = "reset",
	[Enum.KeyCode.ButtonSelect] = "reset",
	[Enum.KeyCode.T] = "telemetry",
	[Enum.KeyCode.DPadUp] = "telemetry",
	[Enum.KeyCode.H] = "help",
	[Enum.KeyCode.G] = "nextCar",
	[Enum.KeyCode.DPadLeft] = "nextCar",
	[Enum.KeyCode.N] = "nextMap",
	[Enum.KeyCode.DPadRight] = "nextMap",
}

local STICK_DEADZONE = 0.12

local held: { [string]: boolean } = {}
local pad = { throttle = 0, brake = 0, steer = 0 }
local keyboard = { throttle = 0, brake = 0, steer = 0 }
local listeners: { [string]: () -> () } = {}

function InputController.on(action: string, callback: () -> ())
	listeners[action] = callback
end

local function fire(action: string)
	local callback = listeners[action]
	if callback then
		task.spawn(callback)
	end
end

local function approach(current: number, target: number, rate: number, dt: number): number
	local step = rate * dt
	if current < target then
		return math.min(current + step, target)
	end
	return math.max(current - step, target)
end

function InputController.init()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return -- typing in chat or clicking UI
		end
		local hold = HOLD_KEYS[input.KeyCode]
		if hold then
			held[hold] = true
		end
		local action = ACTION_KEYS[input.KeyCode]
		if action then
			fire(action)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local hold = HOLD_KEYS[input.KeyCode]
		if hold then
			held[hold] = false
		end
		if input.KeyCode == Enum.KeyCode.ButtonR2 then
			pad.throttle = 0
		elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
			pad.brake = 0
		elseif input.KeyCode == Enum.KeyCode.Thumbstick1 then
			pad.steer = 0
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Thumbstick1 then
			local x = input.Position.X
			if math.abs(x) < STICK_DEADZONE then
				pad.steer = 0
			else
				pad.steer = (x - math.sign(x) * STICK_DEADZONE) / (1 - STICK_DEADZONE)
			end
		elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
			pad.throttle = input.Position.Z
		elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
			pad.brake = input.Position.Z
		end
	end)

	UserInputService.WindowFocusReleased:Connect(function()
		table.clear(held)
	end)
end

-- Call once per frame before reading state.
function InputController.update(dt: number)
	keyboard.throttle = approach(keyboard.throttle, if held.throttle then 1 else 0, if held.throttle then 5 else 8, dt)
	keyboard.brake = approach(keyboard.brake, if held.brake then 1 else 0, if held.brake then 6 else 10, dt)

	local steerTarget = (if held.right then 1 else 0) - (if held.left then 1 else 0)
	local steerRate
	if steerTarget == 0 then
		steerRate = 4 -- self-centre quickly
	elseif math.sign(steerTarget) ~= math.sign(keyboard.steer) then
		steerRate = 6 -- quick change of direction
	else
		steerRate = 2.5
	end
	keyboard.steer = approach(keyboard.steer, steerTarget, steerRate, dt)

	local state = InputController.state
	state.throttle = math.max(keyboard.throttle, pad.throttle)
	state.brake = math.max(keyboard.brake, pad.brake)
	state.steer = if math.abs(pad.steer) > math.abs(keyboard.steer) then pad.steer else keyboard.steer
	state.handbrake = if held.handbrake then 1 else 0
end

return InputController
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0000004D">
<Properties>
<string name="Name">Main</string>
<ProtectedString name="Source"><![CDATA[--[[
	Client entry point: wires input to the active car, camera and HUD, follows the player from map
	to map (lighting, traffic, close-pass scoring), and sends map and car changes to the server.

	Keys: N (gamepad D-pad right) changes map, G (D-pad left) changes car; the buttons at the top
	right do the same. The server checks and rate-limits both; the client waits the same time between
	requests and says so if a key is pressed too soon.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local VehicleConfigurations = ReplicatedStorage:WaitForChild("VehicleSystem"):WaitForChild("VehicleConfigurations")
local MapRegistry = require(ReplicatedStorage:WaitForChild("TrafficSystem"):WaitForChild("MapRegistry"))
local MapLighting = require(ReplicatedStorage:WaitForChild("Gameplay"):WaitForChild("MapLighting"))

local Client = script.Parent
local InputController = require(Client:WaitForChild("InputController"))
local VehicleController = require(Client:WaitForChild("VehicleController"))
local CameraController = require(Client:WaitForChild("CameraController"))
local HUD = require(Client:WaitForChild("HUD"))
local VehicleAudio = require(Client:WaitForChild("VehicleAudio"))
local SelfTest = require(Client:WaitForChild("SelfTest"))
local TrafficRenderer = require(Client:WaitForChild("TrafficRenderer"))
local TrafficAudio = require(Client:WaitForChild("TrafficAudio"))
local ScoreHUD = require(Client:WaitForChild("ScoreHUD"))
local ClosePassController = require(Client:WaitForChild("ClosePassController"))

local MAP_COOLDOWN = 4.2 -- s, a little over the server's
local CAR_COOLDOWN = 3.2

local localPlayer = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")

InputController.init()
HUD.init()
TrafficRenderer.init(remotes)
TrafficAudio.init(TrafficRenderer)
ScoreHUD.init()

local active = nil
local audio = nil
local currentMap: string? = nil
local lastCar: string? = nil
local lastMapRequest, lastCarRequest = -math.huge, -math.huge

-- Follow the player onto a map: its lighting (this computer only), and its name on screen.
local function enterMap(id: any)
	if not MapRegistry.isMap(id) or id == currentMap then
		return
	end
	currentMap = id
	local map = MapRegistry.get(id)
	MapLighting.apply(map.data.lighting)
	ScoreHUD.setMapName(map.displayName)
	ScoreHUD.notice(string.upper(map.displayName), 3)
end

-- If the place streams instances in, the car can arrive after the event that announces it, and the
-- event then carries nil. Find our own car by its owner attribute instead.
local function findOwnCar(timeout: number): Model?
	local folder = Workspace:WaitForChild("Vehicles", timeout)
	local deadline = os.clock() + timeout
	while folder and os.clock() < deadline do
		for _, child in folder:GetChildren() do
			if child:IsA("Model") and child:GetAttribute("OwnerUserId") == localPlayer.UserId then
				return child
			end
		end
		task.wait(0.2)
	end
	return nil
end

remotes:WaitForChild("VehicleSpawned").OnClientEvent:Connect(function(model: Model?, mapId: string?)
	if not model then
		model = findOwnCar(10)
		if not model then
			warn("[Redline] The car didn't arrive on this computer; press R to try again")
			return
		end
	end
	enterMap(mapId or (model :: Model):GetAttribute("MapId"))
	if audio then
		audio:stop()
		audio = nil
	end
	if active then
		active:stop()
		active = nil
	end
	active = VehicleController.start(model)
	if active then
		local map = MapRegistry.get(currentMap or MapRegistry.default)
		CameraController.start(model)
		HUD.setVehicle(active.config)
		audio = VehicleAudio.start(active, CameraController.mode)
		SelfTest.run(active, map)
		ClosePassController.start(active, map)
		local carId = active.config.id
		if lastCar ~= nil and carId ~= lastCar then
			ScoreHUD.notice(string.upper(active.config.displayName or carId), 2.5)
		end
		lastCar = carId
	end
end)

enterMap(localPlayer:GetAttribute("MapId") or MapRegistry.default)
localPlayer:GetAttributeChangedSignal("MapId"):Connect(function()
	enterMap(localPlayer:GetAttribute("MapId"))
end)

-- The cars to choose from: every configuration module, in sorted order.
local function carIds(): { string }
	local ids = {}
	for _, child in VehicleConfigurations:GetChildren() do
		if child:IsA("ModuleScript") then
			table.insert(ids, child.Name)
		end
	end
	table.sort(ids)
	return ids
end

local function nextMap()
	if os.clock() - lastMapRequest < MAP_COOLDOWN then
		ScoreHUD.notice("One moment...", 1.2)
		return
	end
	lastMapRequest = os.clock()
	local target = MapRegistry.next(currentMap or MapRegistry.default)
	ScoreHUD.notice("TO " .. string.upper(MapRegistry.get(target).displayName), 2)
	remotes.RequestMapSwitch:FireServer(target)
end

local function nextCar()
	local ids = carIds()
	local current = if active then active.config.id else lastCar
	local index = table.find(ids, current or "") or 0
	local target = ids[index % math.max(#ids, 1) + 1]
	if target == nil or target == current then
		ScoreHUD.notice("No other cars yet", 1.5)
		return
	end
	if os.clock() - lastCarRequest < CAR_COOLDOWN then
		ScoreHUD.notice("One moment...", 1.2)
		return
	end
	lastCarRequest = os.clock()
	remotes.RequestVehicle:FireServer(target)
end

ScoreHUD.menu(nextMap, nextCar)
if currentMap then
	ScoreHUD.setMapName(MapRegistry.get(currentMap).displayName)
end

InputController.on("nextMap", nextMap)
InputController.on("nextCar", nextCar)
InputController.on("reset", function()
	remotes.RequestRespawn:FireServer()
end)
InputController.on("camera", CameraController.cycle)
InputController.on("telemetry", HUD.toggleTelemetry)
InputController.on("help", HUD.toggleHelp)
InputController.on("shiftUp", function()
	if active then
		active.sim:shiftUp()
	end
end)
InputController.on("shiftDown", function()
	if active then
		active.sim:shiftDown()
	end
end)
InputController.on("toggleAuto", function()
	if active then
		active.sim:toggleAutomatic()
	end
end)
InputController.on("toggleAbs", function()
	if active then
		active.sim:toggleAbs()
	end
end)
InputController.on("toggleTc", function()
	if active then
		active.sim:toggleTractionControl()
	end
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000004E">
<Properties>
<string name="Name">ScoreHUD</string>
<ProtectedString name="Source"><![CDATA[--[[
	ScoreHUD: the close-pass score at the top of the screen. Shows the banked score, the current
	combo with its multiplier and a bar for the time left to chain the next pass, and short popups
	for each pass ("CLOSE PASS +540"), banked combos and crashes.

	Also the always-on parts of the screen: a notice banner (map and car names when they change,
	ScoreHUD.notice) and two buttons at the top right for changing map and car with a mouse or a
	touch screen (ScoreHUD.menu), which do the same as the N and G keys.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local ScoreHUD = {}

local WHITE = Color3.fromRGB(240, 240, 240)
local AMBER = Color3.fromRGB(255, 176, 50)
local GREEN = Color3.fromRGB(120, 230, 140)
local RED = Color3.fromRGB(235, 60, 60)
local POPUP_TIME = 1.4
local POPUPS = 5

local gui: ScreenGui
local scoreLabel: TextLabel
local comboLabel: TextLabel
local timerBar: Frame
local popups = {}
local nextPopup = 1
local menu: ScreenGui
local noticeLabel: TextLabel
local noticeLeft = 0
local mapButton: TextButton

local function newLabel(parent: Instance, name: string, size: UDim2, position: UDim2, textSize: number, color: Color3): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.AnchorPoint = Vector2.new(0.5, 0)
	label.Font = Enum.Font.GothamBlack
	label.TextSize = textSize
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.5
	label.Text = ""
	label.Parent = parent
	return label
end

local function thousands(x: number): string
	local s = tostring(math.floor(math.abs(x) + 0.5))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return out
end

function ScoreHUD.init()
	gui = Instance.new("ScreenGui")
	gui.Name = "ScoreHUD"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.Enabled = false
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	scoreLabel = newLabel(gui, "Score", UDim2.fromOffset(400, 34), UDim2.new(0.5, 0, 0, 14), 28, WHITE)
	comboLabel = newLabel(gui, "Combo", UDim2.fromOffset(400, 26), UDim2.new(0.5, 0, 0, 48), 22, AMBER)
	local track = Instance.new("Frame")
	track.Name = "ComboTimer"
	track.AnchorPoint = Vector2.new(0.5, 0)
	track.Position = UDim2.new(0.5, 0, 0, 78)
	track.Size = UDim2.fromOffset(180, 4)
	track.BackgroundColor3 = Color3.fromRGB(40, 40, 44)
	track.BackgroundTransparency = 0.3
	track.BorderSizePixel = 0
	track.Parent = gui
	timerBar = Instance.new("Frame")
	timerBar.Name = "Fill"
	timerBar.Size = UDim2.fromScale(0, 1)
	timerBar.BackgroundColor3 = AMBER
	timerBar.BorderSizePixel = 0
	timerBar.Parent = track
	for i = 1, POPUPS do
		popups[i] = { label = newLabel(gui, "Popup" .. i, UDim2.fromOffset(500, 30), UDim2.new(0.5, 0, 0.3, 0), 26, WHITE), age = math.huge }
	end
	ScoreHUD.set(nil)

	-- always on: the notice banner (fades out by itself) and the menu buttons
	menu = Instance.new("ScreenGui")
	menu.Name = "MapMenu"
	menu.ResetOnSpawn = false
	menu.IgnoreGuiInset = true
	menu.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	noticeLabel = newLabel(menu, "Notice", UDim2.fromOffset(700, 40), UDim2.new(0.5, 0, 0, 104), 32, WHITE)
	RunService.Heartbeat:Connect(function(dt)
		if noticeLeft > 0 then
			noticeLeft -= dt
			local fade = math.clamp(1 - noticeLeft / 0.6, 0, 1)
			noticeLabel.TextTransparency = fade
			noticeLabel.TextStrokeTransparency = 0.5 + 0.5 * fade
		end
	end)
end

-- Show a short line of text (a map's or car's name) under the score for a few seconds.
function ScoreHUD.notice(text: string, seconds: number?)
	noticeLabel.Text = text
	noticeLabel.TextTransparency = 0
	noticeLabel.TextStrokeTransparency = 0.5
	noticeLeft = seconds or 2.5
end

local function menuButton(name: string, text: string, y: number, onClick: () -> ()): TextButton
	local button = Instance.new("TextButton")
	button.Name = name
	button.AnchorPoint = Vector2.new(1, 0)
	button.Position = UDim2.new(1, -16, 0, y)
	button.Size = UDim2.fromOffset(190, 30)
	button.BackgroundColor3 = Color3.fromRGB(10, 10, 12)
	button.BackgroundTransparency = 0.35
	button.BorderSizePixel = 0
	button.AutoButtonColor = true
	button.Font = Enum.Font.GothamBold
	button.TextSize = 14
	button.TextColor3 = WHITE
	button.Text = text
	button.Parent = menu
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = button
	button.Activated:Connect(onClick)
	return button
end

-- The two buttons at the top right: change map (N) and change car (G).
function ScoreHUD.menu(onMap: () -> (), onCar: () -> ())
	mapButton = menuButton("MapButton", "MAP  (N)", 64, onMap)
	menuButton("CarButton", "NEXT CAR  (G)", 100, onCar)
end

-- Show which map the player is on, on the map button.
function ScoreHUD.setMapName(name: string)
	if mapButton then
		mapButton.Text = string.upper(name) .. "   (N)"
	end
end

local function popup(text: string, color: Color3)
	local p = popups[nextPopup]
	nextPopup = nextPopup % POPUPS + 1
	p.label.Text = text
	p.label.TextColor3 = color
	p.age = 0
end

-- scorer: a ClosePass object (or nil to hide the display)
function ScoreHUD.set(scorer)
	gui.Enabled = scorer ~= nil
end

function ScoreHUD.update(dt: number, scorer)
	for _, e in scorer.events do
		if e.kind == "pass" then
			popup(string.format("%s  +%s", e.label, thousands(e.points)), if e.label == "INSANE PASS" then RED else WHITE)
		elseif e.kind == "banked" then
			popup("BANKED  +" .. thousands(e.points), GREEN)
		elseif e.kind == "crash" then
			popup(if e.lost > 0 then "CRASH  -" .. thousands(e.lost) else "CRASH", RED)
		end
	end
	scoreLabel.Text = "SCORE  " .. thousands(scorer.total)
	if scorer.combo > 0 then
		comboLabel.Text = string.format("x%.1f   +%s", scorer.multiplier, thousands(scorer.combo))
	else
		comboLabel.Text = ""
	end
	timerBar.Size = UDim2.fromScale(math.clamp(scorer.timer / scorer.settings.comboWindow, 0, 1), 1)
	for _, p in popups do
		if p.age < POPUP_TIME then
			p.age += dt
			local t = math.clamp(p.age / POPUP_TIME, 0, 1)
			p.label.Position = UDim2.new(0.5, 0, 0.3, -60 * t)
			p.label.TextTransparency = t * t
			p.label.TextStrokeTransparency = 0.5 + 0.5 * t
		else
			p.label.TextTransparency = 1
			p.label.TextStrokeTransparency = 1
		end
	end
end

return ScoreHUD
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000004F">
<Properties>
<string name="Name">SelfTest</string>
<ProtectedString name="Source"><![CDATA[--[[
	SelfTest: a quick health check of the car, printed to the Output window a few seconds after it
	spawns. It runs while the car sits parked, and compares the simulation with the numbers it should
	settle at (docs/TEST_CHECKLIST_PHASE1.md, M2). When reporting a problem, paste the block it prints.
	It runs again after every respawn (R), car change (G) and map change (N), and says which map the
	car is on and whether it rests on that map's road surface.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local VehicleSystem = ReplicatedStorage:WaitForChild("VehicleSystem")
local Units = require(VehicleSystem:WaitForChild("Units"))
local VehicleSimulation = require(VehicleSystem:WaitForChild("CorePhysics"):WaitForChild("VehicleSimulation"))

local InputController = require(script.Parent:WaitForChild("InputController"))

local SETTLE_SECONDS = 4

local SelfTest = {}

local function thousands(x: number): string
	local s = tostring(math.floor(math.abs(x) + 0.5))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1,")))
	if string.sub(out, 1, 1) == "," then
		out = string.sub(out, 2)
	end
	return (if x < 0 then "-" else "") .. out
end

-- controller: the car's VehicleController. map: the map it's on (MapRegistry), if known.
function SelfTest.run(controller, map)
	task.spawn(function()
		local frames, elapsed, slowest, driven = 0, 0, 0, false
		local connection = RunService.Heartbeat:Connect(function(dt)
			frames += 1
			elapsed += dt
			slowest = math.max(slowest, dt)
			local s = InputController.state
			if s.throttle > 0.05 or s.brake > 0.05 or math.abs(s.steer) > 0.05 or s.handbrake > 0 then
				driven = true
			end
		end)
		task.wait(SETTLE_SECONDS)
		connection:Disconnect()
		if controller.stopped then
			return
		end

		local sim = controller.sim
		local config = controller.config
		local root: BasePart = controller.root
		local lines = {}
		local passed, total = 0, 0
		local function check(ok: boolean, text: string)
			total += 1
			if ok then
				passed += 1
			end
			table.insert(lines, (if ok then "  ok    " else "  FAIL  ") .. text)
		end
		local function info(text: string)
			table.insert(lines, "  info  " .. text)
		end

		if map then
			local road = map.road
			local s, offset, height = road:project(root.Position * Units.METERS_PER_STUD)
			info(string.format("%s on %s, %.0f m along its %.1f km road, lane %.1f", config.displayName or config.id,
				map.displayName, s, road.length / 1000, road:laneFromOffset(offset)))
			if not driven then
				check(math.abs(height - config.mass.comHeight) < 0.25, string.format(
					"resting on the road: centre of mass %.2f m above its surface (expected about %.2f)", height, config.mass.comHeight))
			end
		end

		local fps = frames / math.max(elapsed, 1e-3)
		check(sim.telemetry.rpm ~= nil and fps > 30, string.format(
			"simulation running at %d fps on average (slowest frame %d ms)", math.floor(fps + 0.5),
			math.floor(slowest * 1000 + 0.5)))

		local gravity = Workspace.Gravity
		check(math.abs(gravity - Units.REALISTIC_GRAVITY) < 0.1, string.format(
			"gravity %.2f studs/s^2 (expected %.2f, which is 9.81 m/s^2)", gravity, Units.REALISTIC_GRAVITY))

		local massKg = root.AssemblyMass * Units.KG_PER_RMU
		local expectedKg = config.mass.kerbKg + config.mass.driverKg
		check(math.abs(massKg - expectedKg) < expectedKg * 0.02, string.format(
			"car mass %s kg (expected %s; much more means the driver's body isn't massless)",
			thousands(massKg), thousands(expectedKg)))

		if driven then
			info("the car was driven during the test, so the parked checks were skipped; press R to rerun")
		else
			local touching, loads, travel = 0, {}, {}
			local loadsOk, travelOk = true, true
			local expectedFront, expectedRear = 0, 0
			for _, id in VehicleSimulation.WHEEL_IDS do
				local w = sim.wheels[id]
				if w.contact then
					touching += 1
				end
				if w.front then
					expectedFront = w.staticLoad
				else
					expectedRear = w.staticLoad
				end
				if math.abs(w.load - w.staticLoad) > w.staticLoad * 0.12 then
					loadsOk = false
				end
				local mm = (w.suspension.rideLength - w.length) * 1000
				if math.abs(mm) > 20 then
					travelOk = false
				end
				table.insert(loads, id .. " " .. thousands(w.load))
				table.insert(travel, string.format("%s %+d", id, math.floor(mm + 0.5)))
			end
			check(touching == 4, string.format("wheels on the road: %d of 4", touching))
			check(loadsOk, string.format("wheel loads (N): %s (expected about %s front, %s rear)",
				table.concat(loads, "  "), thousands(expectedFront), thousands(expectedRear)))
			check(travelOk, "suspension compression from ride height (mm): " .. table.concat(travel, "  "))

			local creep = root.AssemblyLinearVelocity.Magnitude * Units.METERS_PER_STUD
			check(creep < 0.15, string.format("parked still: moving at %.2f m/s", creep))

			local cf = root.CFrame
			local pitch = math.deg(math.asin(math.clamp(cf.LookVector.Y, -1, 1)))
			local roll = math.deg(math.asin(math.clamp(cf.RightVector.Y, -1, 1)))
			check(math.abs(pitch) < 1 and math.abs(roll) < 1, string.format(
				"body level: pitch %.2f deg, roll %.2f deg", pitch, roll))

			local rpm = sim.telemetry.rpm or 0
			check(math.abs(rpm - config.engine.idleRpm) < 200, string.format(
				"idling at %s rpm (target %s)", thousands(rpm), thousands(config.engine.idleRpm)))
		end

		print(string.format("[Redline] Self-test, %d s after the car spawned:\n%s\n[Redline] Self-test: %d of %d passed."
			.. " Paste this block when you report a problem.", SETTLE_SECONDS, table.concat(lines, "\n"), passed, total))
	end)
end

return SelfTest
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000050">
<Properties>
<string name="Name">TrafficAudio</string>
<ProtectedString name="Source"><![CDATA[--[[
	TrafficAudio: positional engine and tyre sound for the traffic nearest the camera.

	The nearest cars (up to VOICES.car) and trucks (up to VOICES.truck) each get a voice: an
	Attachment in Workspace.Terrain that follows the car, carrying looping Sounds (engine on and off
	throttle from the traffic engine sheets, and tyre roar from the effects sheet). Roblox places
	the Sounds in 3D and applies distance roll-off. Every frame TrafficMix adds engine speed from
	road speed, Doppler from the relative speed of car and camera, and air absorption (a treble cut
	growing with distance) through an equaliser on each Sound. Voices fade between cars as the
	nearest set changes. The group gets tunnel reverb from AudioEnvironment.

	Doppler is applied here, so SoundService.DopplerScale is set to 0 (Roblox would otherwise add
	its own shift from the parts' and listener's motion, which for these anchored parts is wrong).

	Traffic cars come from TrafficRenderer.cars(): id -> { s, lanePos, v, profileIndex, body }. A car
	is gone when its id leaves that table or its body is no longer in the Workspace.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local AudioFolder = ReplicatedStorage:WaitForChild("VehicleSystem"):WaitForChild("VehicleAudio")
local AudioAssets = require(AudioFolder:WaitForChild("AudioAssets"))
local TrafficMix = require(AudioFolder:WaitForChild("TrafficMix"))
local DriverProfiles = require(ReplicatedStorage:WaitForChild("TrafficSystem"):WaitForChild("DriverProfiles"))
local AudioEnvironment = require(script.Parent:WaitForChild("AudioEnvironment"))

local METERS_PER_STUD = 0.28
local VOICES = { car = 5, truck = 2 }
local SHEETS = { car = "TrafficCar_Engine", truck = "TrafficTruck_Engine" }
local MAX_DISTANCE_M = 320
local FADE_RATE = 6 -- 1/s

local TrafficAudio = {}

local renderer
local group: SoundGroup
local voices = {}
local listenerVel = Vector3.zero
local lastListener: Vector3? = nil
local checkTimer = 0

local function newLoop(name: string, id: string, region, parent: Instance): (Sound, EqualizerSoundEffect)
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Looped = true
	sound.PlaybackRegionsEnabled = true
	sound.PlaybackRegion = NumberRange.new(region.start, region.stop)
	sound.LoopRegion = NumberRange.new(region.loopStart, region.loopEnd)
	sound.Volume = 0
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = TrafficMix.ROLLOFF_MIN_M / METERS_PER_STUD
	sound.RollOffMaxDistance = TrafficMix.ROLLOFF_MAX_M / METERS_PER_STUD
	sound.SoundGroup = group
	local eq = Instance.new("EqualizerSoundEffect")
	eq.Name = "AirAbsorption"
	eq.LowGain = 0
	eq.MidGain = 0
	eq.HighGain = 0
	eq.Parent = sound
	sound.Parent = parent
	return sound, eq
end

-- The on- and off-throttle loops at the sheet's engine speed nearest the middle of its range.
local function pickLoops(sheet)
	local best, bestOn, bestOff = math.huge, nil, nil
	local byRpm = {}
	for _, loop in sheet.loops do
		if loop.load == "on" or loop.load == "off" then
			local key = math.floor(loop.rpm + 0.5)
			byRpm[key] = byRpm[key] or {}
			byRpm[key][loop.load] = loop
		end
	end
	local mid = (sheet.idleRpm or 800) * 2.5
	for key, pair in byRpm do
		local d = math.abs(math.log(key / mid))
		if d < best and pair.on then
			best, bestOn, bestOff = d, pair.on, pair.off or pair.on
		end
	end
	return bestOn, bestOff
end

local function makeVoice(kind: string, engineSheet, engineId: string, tyreRegion, effectsId: string, index: number)
	local attachment = Instance.new("Attachment")
	attachment.Name = string.format("TrafficVoice_%s%d", kind, index)
	attachment.Parent = Workspace.Terrain
	local onLoop, offLoop = pickLoops(engineSheet)
	local voice = {
		kind = kind,
		profile = TrafficMix.PROFILES[kind],
		attachment = attachment,
		carId = nil,
		fade = 0,
		target = 0,
		lastV = nil,
		accel = 0,
		load = 0.3,
		onRpm = onLoop.rpm,
		offRpm = offLoop.rpm,
		onGain = onLoop.gain or 1,
		offGain = offLoop.gain or 1,
	}
	local onEq, offEq, tyreEq
	voice.on, onEq = newLoop("EngineOn", engineId, onLoop, attachment)
	voice.off, offEq = newLoop("EngineOff", engineId, offLoop, attachment)
	voice.tyre, tyreEq = newLoop("Tyres", effectsId, tyreRegion, attachment)
	voice.sounds = { voice.on, voice.off, voice.tyre }
	voice.eqs = { onEq, offEq, tyreEq }
	return voice
end

local function silence(voice)
	for _, sound in voice.sounds do
		sound.Volume = 0
	end
end

local function kindOf(car): string
	return if DriverProfiles.order[car.profileIndex] == "truck" then "truck" else "car"
end

local function update(dt: number)
	local camera = Workspace.CurrentCamera
	if not camera or dt <= 0 then
		return
	end
	local listener = camera.CFrame.Position
	if lastListener then
		local step = (listener - lastListener) * METERS_PER_STUD
		if step.Magnitude < 40 then -- ignore camera cuts
			listenerVel = listenerVel:Lerp(step / dt, math.clamp(8 * dt, 0, 1))
		end
	end
	lastListener = listener

	-- the nearest cars of each kind
	local cars = renderer.cars()
	local nearest = { car = {}, truck = {} }
	for id, car in cars do
		local body = car.body
		if body and body:IsDescendantOf(Workspace) then
			local d = (body.Position - listener).Magnitude * METERS_PER_STUD
			if d < MAX_DISTANCE_M then
				local list = nearest[kindOf(car)]
				table.insert(list, { id = id, d = d })
			end
		end
	end
	local wanted = {}
	for kind, list in nearest do
		table.sort(list, function(a, b)
			return a.d < b.d
		end)
		for i = 1, math.min(#list, VOICES[kind]) do
			wanted[list[i].id] = kind
		end
	end

	-- keep voices on cars that are still near, fade out the others, give free voices to new cars
	local served = {}
	for _, voice in voices do
		if voice.carId and wanted[voice.carId] == voice.kind and cars[voice.carId] then
			voice.target = 1
			served[voice.carId] = true
		else
			voice.target = 0
		end
	end
	for id, kind in wanted do
		if not served[id] then
			for _, voice in voices do
				if voice.kind == kind and (voice.carId == nil or (voice.target == 0 and voice.fade <= 0.01)) then
					voice.carId = id
					voice.target = 1
					voice.fade = 0
					voice.lastV = nil
					served[id] = true
					break
				end
			end
		end
	end

	for _, voice in voices do
		voice.fade += (voice.target - voice.fade) * math.clamp(FADE_RATE * dt, 0, 1)
		local car = voice.carId and cars[voice.carId]
		if not car or not car.body or not car.body:IsDescendantOf(Workspace) then
			voice.carId = nil
			voice.fade = 0
			silence(voice)
			continue
		end
		if voice.target == 0 and voice.fade < 0.01 then
			voice.carId = nil
			silence(voice)
			continue
		end
		local body = car.body
		local position = body.Position
		voice.attachment.WorldPosition = position
		local v = car.v
		local accel = if voice.lastV then (v - voice.lastV) / dt else 0
		voice.lastV = v
		voice.accel += (math.clamp(accel, -8, 8) - voice.accel) * math.clamp(3 * dt, 0, 1)
		voice.load += (TrafficMix.load(voice.accel) - voice.load) * math.clamp(4 * dt, 0, 1)
		local profile = voice.profile
		local rpm = TrafficMix.engineRpm(profile, v, voice.load)
		local offset = (position - listener) * METERS_PER_STUD
		local doppler = TrafficMix.doppler(offset, body.CFrame.LookVector * v, listenerVel)
		local engine, tyre = TrafficMix.levels(profile, v, voice.load, rpm)
		local mid, high = TrafficMix.airAbsorption(offset.Magnitude)
		voice.on.Volume = voice.fade * engine * math.sqrt(voice.load) * voice.onGain
		voice.off.Volume = voice.fade * engine * math.sqrt(1 - voice.load) * voice.offGain
		voice.on.PlaybackSpeed = math.clamp(rpm / voice.onRpm, 0.4, 2.5) * doppler
		voice.off.PlaybackSpeed = math.clamp(rpm / voice.offRpm, 0.4, 2.5) * doppler
		voice.tyre.Volume = voice.fade * tyre
		voice.tyre.PlaybackSpeed = (0.8 + 0.4 * math.clamp(v / 40, 0, 1)) * doppler
		for _, eq in voice.eqs do
			eq.MidGain = mid
			eq.HighGain = high
		end
	end

	-- start any loop that wasn't playing yet (its sound may still have been loading)
	checkTimer -= dt
	if checkTimer <= 0 then
		checkTimer = 1
		for _, voice in voices do
			for _, sound in voice.sounds do
				if sound.IsLoaded and not sound.IsPlaying then
					sound:Play()
				end
			end
		end
	end
end

-- trafficRenderer: the TrafficRenderer module.
function TrafficAudio.init(trafficRenderer)
	renderer = trafficRenderer
	local effectsId = AudioAssets.Driving_Effects
	if type(effectsId) ~= "string" or effectsId == "" then
		return -- VehicleAudio already reminds about the missing upload
	end
	local sheets = AudioFolder:WaitForChild("Sheets")
	local effects = require(sheets:WaitForChild("Driving_Effects"))
	local tyreRegion = nil
	for _, loop in effects.loops do
		if loop.name == "tyre_roll" then
			tyreRegion = loop
		end
	end
	if not tyreRegion then
		return
	end
	SoundService.DopplerScale = 0
	group = Instance.new("SoundGroup")
	group.Name = "TrafficAudio"
	group.Volume = 1
	group.Parent = SoundService
	AudioEnvironment.attach(group)
	for kind, count in VOICES do
		local module = sheets:FindFirstChild(SHEETS[kind])
		if module and module:IsA("ModuleScript") then
			local sheet = require(module)
			local id = AudioAssets[sheet.asset]
			if type(id) == "string" and id ~= "" then
				for i = 1, count do
					table.insert(voices, makeVoice(kind, sheet, id, tyreRegion, effectsId, i))
				end
			end
		end
	end
	for _, voice in voices do
		for _, sound in voice.sounds do
			sound:Play()
		end
	end
	RunService.Heartbeat:Connect(update)
end

return TrafficAudio
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000051">
<Properties>
<string name="Name">TrafficRenderer</string>
<ProtectedString name="Source"><![CDATA[--[[
	TrafficRenderer: draws the traffic the server sends for the player's map (see TrafficService for
	the snapshot format).

	Each traffic car is a simple stand-in (a body box, a darker cabin, and head and tail lights; one
	tall box for a truck) taken from a pool. Every frame it moves forward at its own speed, so it
	doesn't stutter between the server's 10 snapshots a second, and eases toward each new snapshot.
	Cars follow the road's curves and grades. All cars move together with Workspace:BulkMoveTo. The
	cars are anchored and solid on this computer, so your car can hit them; the crash physics of the
	traffic car itself comes later.

	Snapshots carry their map's id. When the player changes map, every car is put away and the new
	map's cars arrive with new ids (ids are unique across maps). Lights glow on night maps.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local TrafficSystem = ReplicatedStorage:WaitForChild("TrafficSystem")
local MapRegistry = require(TrafficSystem:WaitForChild("MapRegistry"))
local DriverProfiles = require(TrafficSystem:WaitForChild("DriverProfiles"))
local Units = require(ReplicatedStorage:WaitForChild("VehicleSystem"):WaitForChild("Units"))

local M = Units.METERS_PER_STUD
local RECORD_BYTES = 12
local FORGET_AFTER = 0.6 -- s without an update before a car is put away
local CORRECTION_RATE = 4 -- 1/s, how quickly a car eases onto the server's position
local RIDE = 0.18 -- m from the road to the bottom of the body

local PAINT = {
	Color3.fromRGB(235, 235, 232), Color3.fromRGB(30, 30, 34), Color3.fromRGB(120, 124, 130),
	Color3.fromRGB(170, 172, 176), Color3.fromRGB(28, 52, 110), Color3.fromRGB(122, 18, 24),
	Color3.fromRGB(46, 70, 52), Color3.fromRGB(196, 170, 120), Color3.fromRGB(60, 90, 140),
}
local HEADLIGHT = Color3.fromRGB(255, 244, 220)
local TAILLIGHT = Color3.fromRGB(210, 24, 24)

local TrafficRenderer = {}

local folder: Folder
local cars = {} -- id -> car
local pool = {} -- profile index -> spare cars
local parts: { BasePart } = {}
local frames: { CFrame } = {}
local road = nil -- RoadGeometry of the map being drawn
local mapId: string? = nil
local lightsOn = false

local function newPart(name: string, size: Vector3, color: Color3, material: Enum.Material, parent: Instance, collide: boolean): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.CanCollide = collide
	part.CanQuery = collide
	part.CanTouch = false
	part.CastShadow = collide
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

local function styleLights(car)
	local material = if lightsOn then Enum.Material.Neon else Enum.Material.SmoothPlastic
	car.head.Material = material
	car.tail.Material = material
end

local function makeCar(profileIndex: number)
	local name = DriverProfiles.order[profileIndex] or "normal"
	local p = DriverProfiles.profiles[name]
	local truck = name == "truck"
	local height = if truck then 3.8 else 1.15
	local model = Instance.new("Model")
	model.Name = "Traffic_" .. name
	local paint = PAINT[math.random(1, #PAINT)]
	local body = newPart("Body", Vector3.new(p.width, height, p.length) / M, paint, Enum.Material.SmoothPlastic, model, true)
	local lightY = (RIDE + (if truck then 0.7 else 0.55)) / M
	local car = {
		model = model,
		body = body,
		bodyLift = (RIDE + height / 2) / M,
		-- lights sit on the body's front (-Z, the way it drives) and rear faces
		head = newPart("Headlights", Vector3.new(p.width * 0.86, 0.14, 0.06) / M, HEADLIGHT, Enum.Material.SmoothPlastic, model, false),
		tail = newPart("Taillights", Vector3.new(p.width * 0.86, 0.14, 0.06) / M, TAILLIGHT, Enum.Material.SmoothPlastic, model, false),
		headOffset = CFrame.new(0, lightY, -(p.length / 2 + 0.03) / M),
		tailOffset = CFrame.new(0, lightY, (p.length / 2 + 0.03) / M),
		profileIndex = profileIndex,
		s = 0,
		lanePos = 1,
		v = 0,
		targetS = 0,
		targetLane = 1,
		stamp = 0,
		seen = 0,
	}
	if not truck then
		car.cabin = newPart("Cabin", Vector3.new(p.width * 0.86, 0.5, p.length * 0.48) / M,
			Color3.fromRGB(20, 24, 30), Enum.Material.Glass, model, true)
		car.cabinLift = (RIDE + height + 0.25) / M
	end
	styleLights(car)
	model.Parent = folder
	return car
end

local function take(profileIndex: number)
	local spare = pool[profileIndex]
	if spare and #spare > 0 then
		local car = table.remove(spare)
		car.model.Parent = folder
		return car
	end
	return makeCar(profileIndex)
end

local function putAway(id: number)
	local car = cars[id]
	cars[id] = nil
	car.model.Parent = nil
	pool[car.profileIndex] = pool[car.profileIndex] or {}
	table.insert(pool[car.profileIndex], car)
end

-- Switch to drawing another map: put every car away and restyle the lights.
local function setMap(id: string)
	for carId in cars do
		putAway(carId)
	end
	mapId = id
	local map = MapRegistry.get(id)
	road = map.road
	lightsOn = map.data.lighting == "Night"
	for _, spare in pool do
		for _, car in spare do
			styleLights(car)
		end
	end
end

local function onSnapshot(snapshotMap: string, serverTime: number, data: buffer)
	if not MapRegistry.isMap(snapshotMap) then
		return
	end
	-- a late snapshot from the map the player just left: ignore it
	local current = Players.LocalPlayer:GetAttribute("MapId")
	if current ~= nil and current ~= snapshotMap then
		return
	end
	if snapshotMap ~= mapId then
		setMap(snapshotMap)
	end
	local length = road.length
	local now = Workspace:GetServerTimeNow()
	local age = math.clamp(now - serverTime, 0, 0.5)
	local count = buffer.len(data) // RECORD_BYTES
	for i = 0, count - 1 do
		local o = i * RECORD_BYTES
		local id = buffer.readu16(data, o)
		local s = buffer.readf32(data, o + 2)
		local lanePos = buffer.readu16(data, o + 6) / 1000
		local v = buffer.readu16(data, o + 8) / 100
		local profileIndex = buffer.readu8(data, o + 10)
		local car = cars[id]
		if car and car.profileIndex ~= profileIndex then
			putAway(id) -- the id was reused for a different kind of car
			car = nil
		end
		if not car then
			car = take(profileIndex)
			cars[id] = car
			car.s = (s + v * age) % length
			car.lanePos = lanePos
		end
		car.targetS = s
		car.targetLane = lanePos
		car.v = v
		car.stamp = serverTime
		car.seen = os.clock()
	end
end

local function render(dt: number)
	if road == nil then
		return
	end
	local length = road.length
	local clock = os.clock()
	local now = Workspace:GetServerTimeNow()
	table.clear(parts)
	table.clear(frames)
	for id, car in cars do
		if clock - car.seen > FORGET_AFTER then
			putAway(id)
			continue
		end
		-- where the server's car is now, extrapolated from its last snapshot
		local target = car.targetS + car.v * math.clamp(now - car.stamp, 0, 0.5)
		car.s = (car.s + car.v * dt) % length
		local drift = (target - car.s + length / 2) % length - length / 2
		if math.abs(drift) > 30 then
			car.s = target % length -- too far off (a long stall): jump
		else
			car.s = (car.s + drift * math.clamp(dt * CORRECTION_RATE, 0, 1)) % length
		end
		car.lanePos += (car.targetLane - car.lanePos) * math.clamp(dt * CORRECTION_RATE, 0, 1)

		local p, direction = road:pointAt(car.s, car.lanePos, 0)
		local base = CFrame.lookAt(p / M, (p + direction) / M)
		table.insert(parts, car.body)
		table.insert(frames, base * CFrame.new(0, car.bodyLift, 0))
		table.insert(parts, car.head)
		table.insert(frames, base * car.headOffset)
		table.insert(parts, car.tail)
		table.insert(frames, base * car.tailOffset)
		if car.cabin then
			table.insert(parts, car.cabin)
			table.insert(frames, base * CFrame.new(0, car.cabinLift, 0.15 / M))
		end
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, frames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

-- The cars being drawn: id -> { s, lanePos, v, profileIndex, body, ... }, where s is along the
-- current map's road and body is the car's body part. Other modules only read it.
function TrafficRenderer.cars()
	return cars
end

-- The id of the map whose traffic is being drawn (nil before the first snapshot).
function TrafficRenderer.mapId(): string?
	return mapId
end

function TrafficRenderer.init(remotes: Folder)
	folder = Instance.new("Folder")
	folder.Name = "Traffic"
	folder.Parent = Workspace
	remotes:WaitForChild("TrafficState").OnClientEvent:Connect(onSnapshot)
	RunService.PreRender:Connect(render)
end

return TrafficRenderer
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000052">
<Properties>
<string name="Name">VehicleAudio</string>
<ProtectedString name="Source"><![CDATA[--[[
	VehicleAudio: plays the player's car sounds.

	Each sound layer is a Sound that plays one region of a sound pack (a packed sound file, see
	docs/AUDIO.md): PlaybackRegion bounds it and LoopRegion loops it. Every frame, after the
	simulation step, EngineMix works out each layer's volume and playback speed from the car's
	state: engine loops, the limiter loops, turbo whistle or supercharger whine. One-shots (shift
	cracks, exhaust crackles, suspension knocks, turbo blow-off) play on small pools of Sounds.

	The player's own car plays non-positionally (the Sounds live in SoundService), the way a driver
	hears their own car. The cockpit camera switches on an equaliser that muffles the cabin, and
	AudioEnvironment adds tunnel reverb when the camera is inside a tunnel. Traffic has its own
	positional sound (TrafficAudio).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local VehicleSystem = ReplicatedStorage:WaitForChild("VehicleSystem")
local AudioFolder = VehicleSystem:WaitForChild("VehicleAudio")
local AudioAssets = require(AudioFolder:WaitForChild("AudioAssets"))
local EngineMix = require(AudioFolder:WaitForChild("EngineMix"))
local Engine = require(VehicleSystem:WaitForChild("EngineSimulation"):WaitForChild("Engine"))
local VehicleSimulation = require(VehicleSystem:WaitForChild("CorePhysics"):WaitForChild("VehicleSimulation"))
local AudioEnvironment = require(script.Parent:WaitForChild("AudioEnvironment"))

local ONE_SHOT_VOICES = 6
local ENGINE_SHOT_VOICES = 2
local RPM_PER_RAD_S = 30 / math.pi

local VehicleAudio = {}
VehicleAudio.__index = VehicleAudio

local warned = {}

local function assetId(sheet): string?
	local id = AudioAssets[sheet.asset]
	if type(id) ~= "string" or id == "" then
		if not warned[sheet.asset] then
			warned[sheet.asset] = true
			warn(string.format(
				"[Redline] No sound asset ID for %s, so those sounds are off. Upload assets/audio/%s.flac and "
					.. "paste its ID into ReplicatedStorage.VehicleSystem.VehicleAudio.AudioAssets (see docs/AUDIO.md).",
				sheet.asset,
				sheet.asset
			))
		end
		return nil
	end
	return id
end

local function newSound(name: string, id: string, region, looped: boolean, group: SoundGroup, parent: Instance): Sound
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Looped = looped
	sound.PlaybackRegionsEnabled = true
	sound.PlaybackRegion = NumberRange.new(region.start, region.stop)
	if looped then
		sound.LoopRegion = NumberRange.new(region.loopStart, region.loopEnd)
	end
	sound.Volume = 0
	sound.SoundGroup = group
	sound.Parent = parent
	return sound
end

-- controller: a running VehicleController. cameraMode: returns the camera mode's name.
function VehicleAudio.start(controller, cameraMode: () -> string)
	local config = controller.config
	local spec = config.audio
	if not spec then
		return nil
	end
	local sheets = AudioFolder:WaitForChild("Sheets")
	local engineSheet = require(sheets:WaitForChild(spec.engineSheet))
	local effectsSheet = require(sheets:WaitForChild(spec.effectsSheet))
	local engineId = assetId(engineSheet)
	local effectsId = assetId(effectsSheet)
	if not engineId and not effectsId then
		return nil
	end

	local self = setmetatable({}, VehicleAudio)
	self.controller = controller
	self.config = config
	self.spec = spec
	self.cameraMode = cameraMode
	self.mix = EngineMix.new(spec, engineSheet, if effectsId then effectsSheet else nil)
	self.inputs = {
		rpm = 0,
		load = 0,
		pedal = 0,
		clutch = 1,
		gear = 0,
		shifting = false,
		limiter = false,
		boost = 0,
		speed = 0,
		slip = 0,
		slideSpeed = 0,
		shaftRpm = 0,
		bump = 0,
		interior = false,
	}
	self.interior = false
	self.checkTimer = 0

	self.group = Instance.new("SoundGroup")
	self.group.Name = "VehicleAudio"
	self.group.Volume = 1
	self.equalizer = Instance.new("EqualizerSoundEffect")
	self.equalizer.LowGain = 0
	self.equalizer.MidGain = 0
	self.equalizer.HighGain = 0
	self.equalizer.Parent = self.group
	self.group.Parent = SoundService
	self.folder = Instance.new("Folder")
	self.folder.Name = "VehicleAudioSounds"
	self.folder.Parent = SoundService

	self.engineSounds = {}
	-- one-shot pools: the effects sheet (crackles, shifts, knocks) and the engine sheet (blow-off)
	self.pools = {
		effects = { shots = {}, voices = {}, next = 1 },
		engine = { shots = {}, voices = {}, next = 1 },
	}
	if engineId then
		for i, loop in engineSheet.loops do
			self.engineSounds[i] = newSound(loop.name, engineId, loop, true, self.group, self.folder)
		end
		local shots = engineSheet.oneShots or {}
		for _, shot in shots do
			self.pools.engine.shots[shot.name] = shot
		end
		if #shots > 0 then
			for v = 1, ENGINE_SHOT_VOICES do
				self.pools.engine.voices[v] = newSound("EngineShot" .. v, engineId, shots[1], false, self.group, self.folder)
			end
		end
	end
	self.effectSounds = {}
	if effectsId then
		local wanted = {}
		for _, name in EngineMix.EFFECT_LOOPS do
			wanted[name] = true
		end
		for _, loop in effectsSheet.loops do
			if wanted[loop.name] then
				self.effectSounds[loop.name] = newSound(loop.name, effectsId, loop, true, self.group, self.folder)
			end
		end
		for _, shot in effectsSheet.oneShots do
			self.pools.effects.shots[shot.name] = shot
		end
		for v = 1, ONE_SHOT_VOICES do
			self.pools.effects.voices[v] = newSound("OneShot" .. v, effectsId, effectsSheet.oneShots[1], false, self.group, self.folder)
		end
	end
	AudioEnvironment.attach(self.group)
	for _, child in self.folder:GetChildren() do
		if child:IsA("Sound") and child.Looped then
			child:Play()
		end
	end

	self.connection = RunService.Heartbeat:Connect(function(dt)
		self:update(dt)
	end)
	return self
end

function VehicleAudio:update(dt: number)
	local controller = self.controller
	if controller.stopped then
		self:stop()
		return
	end
	local sim = controller.sim
	local t = sim.telemetry
	if t.rpm == nil then
		return -- the simulation hasn't run a step yet
	end

	local input = self.inputs
	input.rpm = t.rpm
	-- Load: torque as a share of full-throttle torque, or the throttle opening if that is more, so a
	-- turbo car still off boost counts as on throttle. A fuel cut or closed throttle reads as off.
	local torqueShare = t.engineTorque / math.max(Engine.curveTorque(self.config.engine, t.rpm), 1)
	input.load = math.clamp(math.max(torqueShare, t.throttle or 0), 0, 1)
	input.pedal = t.pedal or 0
	input.clutch = t.clutch or 1
	input.gear = t.gearNumber
	input.shifting = t.shifting
	input.limiter = t.limiter
	-- boost 0-1 (t.boostBar holds the gauge pressure; the layers only need the share)
	input.boost = if t.forcedInduction ~= nil then t.boost or 0 else 0
	input.speed = t.speedKmh / 3.6

	local slip, slide, bump, shaft, driven = 0, 0, 0, 0, 0
	for _, id in VehicleSimulation.WHEEL_IDS do
		local w = sim.wheels[id]
		if w.contact then
			local sx = w.slipRatio / w.tire.compound.peakSlipRatio
			local sy = w.slipAngle / w.tire.peakSlipAngle
			slip = math.max(slip, math.sqrt(sx * sx + sy * sy))
			local slideLong = w.omega * w.tire.radius - w.vLong
			slide = math.max(slide, math.sqrt(slideLong * slideLong + w.vLat * w.vLat))
			if w.length <= w.suspension.minLength + 0.002 then
				bump = math.max(bump, -w.lengthVelocity)
			end
		end
		if w.driven then
			shaft += w.omega
			driven += 1
		end
	end
	input.slip = slip
	input.slideSpeed = slide
	input.bump = bump
	input.shaftRpm = if driven > 0
		then shaft / driven * self.config.transmission.finalDrive * RPM_PER_RAD_S
		else 0

	local interior = self.cameraMode() == "Cockpit"
	input.interior = interior
	if interior ~= self.interior then
		self.interior = interior
		local cabin = self.spec.interior
		self.equalizer.LowGain = if interior then cabin.lowGain else 0
		self.equalizer.MidGain = if interior then cabin.midGain else 0
		self.equalizer.HighGain = if interior then cabin.highGain else 0
	end

	local mix = self.mix
	EngineMix.update(mix, dt, input)
	for i, sound in self.engineSounds do
		sound.Volume = mix.engineVolume[i]
		sound.PlaybackSpeed = mix.engineSpeed[i]
	end
	for name, sound in self.effectSounds do
		local layer = mix.effects[name]
		if layer then
			sound.Volume = layer.volume
			sound.PlaybackSpeed = layer.speed
		end
	end
	for _, e in mix.events do
		self:playOneShot(e.sheet, e.name, e.volume, e.speed)
	end

	-- start any loop that wasn't playing yet (for example, its sound was still loading)
	self.checkTimer -= dt
	if self.checkTimer <= 0 then
		self.checkTimer = 1
		for _, child in self.folder:GetChildren() do
			if child:IsA("Sound") and child.Looped and child.IsLoaded and not child.IsPlaying then
				child:Play()
			end
		end
	end
end

function VehicleAudio:playOneShot(sheet: string, name: string, volume: number, speed: number)
	local pool = self.pools[sheet]
	local shot = pool and pool.shots[name]
	if not shot or #pool.voices == 0 then
		return
	end
	local voice = pool.voices[pool.next]
	pool.next = pool.next % #pool.voices + 1
	voice:Stop()
	voice.PlaybackRegion = NumberRange.new(shot.start, shot.stop)
	voice.TimePosition = shot.start
	voice.Volume = volume
	voice.PlaybackSpeed = speed
	voice:Play()
end

function VehicleAudio:stop()
	if self.stopped then
		return
	end
	self.stopped = true
	if self.connection then
		self.connection:Disconnect()
		self.connection = nil
	end
	AudioEnvironment.detach(self.group)
	self.folder:Destroy()
	self.group:Destroy()
end

return VehicleAudio
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000053">
<Properties>
<string name="Name">VehicleController</string>
<ProtectedString name="Source"><![CDATA[--[[
	VehicleController
	Runs the player's car on their own machine (they own it on the network). Every frame, before
	Roblox's physics step (RunService.PreSimulation), it:
	  1. reads input and updates steering,
	  2. raycasts each suspension and measures the contact patch velocity in each wheel's frame,
	  3. runs the shared VehicleSimulation,
	  4. applies wheel, drag and downforce forces through the car's VectorForce objects,
	  5. moves the visual wheels and feeds the telemetry.
	All simulation maths is in metres and newtons; this script converts at the edges.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local VehicleSystem = ReplicatedStorage:WaitForChild("VehicleSystem")
local Units = require(VehicleSystem:WaitForChild("Units"))
local VehicleSimulation = require(VehicleSystem:WaitForChild("CorePhysics"):WaitForChild("VehicleSimulation"))
local Telemetry = require(VehicleSystem:WaitForChild("VehicleTelemetry"):WaitForChild("Telemetry"))
local InputController = require(script.Parent.InputController)

local M = Units.METERS_PER_STUD
local FORCE = Units.FORCE_PER_NEWTON
local WHEEL_IDS = VehicleSimulation.WHEEL_IDS

-- Grip multiplier for each surface material (1 = dry asphalt). Estimates, to tune in testing.
local SURFACE_GRIP: { [Enum.Material]: number } = {
	[Enum.Material.Asphalt] = 1.0,
	[Enum.Material.Pavement] = 0.98,
	[Enum.Material.Concrete] = 0.95,
	[Enum.Material.Slate] = 0.9,
	[Enum.Material.Basalt] = 0.9,
	[Enum.Material.Brick] = 0.85,
	[Enum.Material.Cobblestone] = 0.8,
	[Enum.Material.Rock] = 0.8,
	[Enum.Material.SmoothPlastic] = 0.85,
	[Enum.Material.Plastic] = 0.85,
	[Enum.Material.DiamondPlate] = 0.75,
	[Enum.Material.Metal] = 0.7,
	[Enum.Material.Wood] = 0.7,
	[Enum.Material.WoodPlanks] = 0.7,
	[Enum.Material.Ground] = 0.6,
	[Enum.Material.Grass] = 0.55,
	[Enum.Material.LeafyGrass] = 0.5,
	[Enum.Material.Sand] = 0.45,
	[Enum.Material.Mud] = 0.4,
	[Enum.Material.Snow] = 0.3,
	[Enum.Material.Ice] = 0.12,
	[Enum.Material.Glacier] = 0.12,
}

local VehicleController = {}
VehicleController.__index = VehicleController

function VehicleController.start(model: Model)
	local root = model:WaitForChild("MassBox", 10) :: BasePart?
	if not root then
		warn("[VehicleController] The car has no MassBox; it may not have streamed in")
		return nil
	end
	local configName = model:GetAttribute("VehicleConfig") or "Prototype812"
	local configModule = VehicleSystem.VehicleConfigurations:FindFirstChild(configName)
	if not configModule then
		warn("[VehicleController] Unknown vehicle configuration " .. tostring(configName))
		return nil
	end

	local self = setmetatable({}, VehicleController)
	self.model = model
	self.root = root
	self.config = require(configModule)
	self.sim = VehicleSimulation.new(self.config)

	self.rayParams = RaycastParams.new()
	self.rayParams.FilterType = Enum.RaycastFilterType.Exclude
	self.filterTimer = 0
	self:_updateRayFilter()

	self.forcePoints = {}
	self.wheelForces = {}
	self.wheelJoints = {}
	self.contacts = {}
	for _, id in WHEEL_IDS do
		self.forcePoints[id] = root:WaitForChild("ForcePoint_" .. id)
		self.wheelForces[id] = root:WaitForChild("WheelForce_" .. id)
		self.wheelJoints[id] = root:WaitForChild("WheelJoint_" .. id)
		self.contacts[id] = { hit = false, distance = 0, vLong = 0, vLat = 0, grip = 1, point = root.Position, forward = Vector3.zero, right = Vector3.zero }
	end
	self.dragForce = root:WaitForChild("DragForce")
	self.aeroFront = root:WaitForChild("AeroFrontForce")
	self.aeroRear = root:WaitForChild("AeroRearForce")

	-- the character's own controls would walk it and jump out of the seat with Space
	local ok, controls = pcall(function()
		local playerModule = Players.LocalPlayer:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")
		return require(playerModule):GetControls()
	end)
	if ok and controls then
		controls:Disable()
		self.controls = controls
	end

	self.previousVelocity = Vector3.zero
	self.gForce = Vector2.zero
	Telemetry.reset()
	Telemetry.sim = self.sim

	self.connection = RunService.PreSimulation:Connect(function(dt)
		self:step(dt)
	end)
	self.ancestryConnection = model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(Workspace) then
			self:stop()
		end
	end)
	return self
end

-- The suspension rays ignore the car itself, the driver and the traffic cars (a ray landing on a
-- traffic car in a crash would launch the car). The traffic folder can appear later or be replaced
-- on a map switch, so step() checks again about once a second.
function VehicleController:_updateRayFilter()
	local traffic = Workspace:FindFirstChild("Traffic")
	local character = Players.LocalPlayer.Character
	if self.filterReady and traffic == self.filterTraffic and character == self.filterCharacter then
		return
	end
	self.filterReady = true
	self.filterTraffic = traffic
	self.filterCharacter = character
	local exclude: { Instance } = { self.model }
	if character then
		table.insert(exclude, character)
	end
	if traffic then
		table.insert(exclude, traffic)
	end
	self.rayParams.FilterDescendantsInstances = exclude
end

function VehicleController:step(dt: number)
	local root = self.root
	if not root.Parent then
		return
	end
	dt = math.clamp(dt, 1 / 240, 1 / 20)
	local sim = self.sim
	self.filterTimer += dt
	if self.filterTimer > 1 then
		self.filterTimer = 0
		self:_updateRayFilter()
	end

	InputController.update(dt)
	local input = InputController.state

	local cf = root.CFrame
	local up = cf.UpVector
	local velocity = root.AssemblyLinearVelocity * M -- m/s
	local forwardSpeed = velocity:Dot(cf.LookVector)
	local speed = velocity.Magnitude

	local steerLeft, steerRight = sim:updateSteering(dt, input.steer, forwardSpeed)

	for _, id in WHEEL_IDS do
		local wheel = sim.wheels[id]
		local contact = self.contacts[id]
		local mountWorld = cf:PointToWorldSpace(wheel.mount / M)
		local rayLength = wheel.rayLength / M
		local result = Workspace:Raycast(mountWorld, -up * rayLength, self.rayParams)

		local steer = if id == "FL" then steerLeft elseif id == "FR" then steerRight else 0
		local wheelFrame = cf * CFrame.Angles(0, -steer, 0)
		local forward, right = wheelFrame.LookVector, wheelFrame.RightVector
		if result then
			local normal = result.Normal
			forward = (forward - normal * forward:Dot(normal)).Unit
			right = (right - normal * right:Dot(normal)).Unit
			contact.hit = true
			contact.distance = (mountWorld - result.Position):Dot(up) * M
			contact.point = result.Position
			contact.grip = SURFACE_GRIP[result.Material] or 0.9
		else
			contact.hit = false
			contact.point = mountWorld - up * rayLength
		end
		local pointVelocity = root:GetVelocityAtPosition(contact.point) * M
		contact.vLong = pointVelocity:Dot(forward)
		contact.vLat = pointVelocity:Dot(right)
		contact.forward = forward
		contact.right = right
	end

	local aero = sim:step(dt, input, self.contacts, forwardSpeed, speed)

	for _, id in WHEEL_IDS do
		local wheel = sim.wheels[id]
		local contact = self.contacts[id]
		local force = self.wheelForces[id]
		if wheel.contact then
			local newtons = up * wheel.load + contact.forward * wheel.fx + contact.right * wheel.fy
			-- lateral force acts at the roll centre height above the contact patch
			local applyAt = contact.point + up * (wheel.suspension.rollCenterHeight / M)
			self.forcePoints[id].Position = cf:PointToObjectSpace(applyAt)
			force.Force = newtons * FORCE
		else
			force.Force = Vector3.zero
		end
		-- visual wheel: suspension travel, steering and spin
		local drop = (wheel.length - wheel.staticLength) / M
		self.wheelJoints[id].Transform = CFrame.new(0, -drop, 0) * CFrame.Angles(0, -wheel.steer, 0) * CFrame.Angles(-wheel.spin, 0, 0)
	end

	if speed > 0.5 then
		self.dragForce.Force = -velocity.Unit * aero.drag * FORCE
	else
		self.dragForce.Force = Vector3.zero
	end
	self.aeroFront.Force = -up * aero.downFront * FORCE
	self.aeroRear.Force = -up * aero.downRear * FORCE

	local acceleration = (velocity - self.previousVelocity) / dt
	self.previousVelocity = velocity
	local longG = acceleration:Dot(cf.LookVector) / Units.GRAVITY
	local latG = acceleration:Dot(cf.RightVector) / Units.GRAVITY
	self.gForce = self.gForce:Lerp(Vector2.new(latG, longG), math.clamp(dt * 8, 0, 1))
	Telemetry.frame.latG = self.gForce.X
	Telemetry.frame.longG = self.gForce.Y
	Telemetry.frame.fps = 1 / dt
	Telemetry.updateTimers(os.clock(), speed * 3.6, sim.telemetry.brake, root.Position * M)
end

function VehicleController:stop()
	if self.stopped then
		return
	end
	self.stopped = true
	if self.connection then
		self.connection:Disconnect()
	end
	if self.ancestryConnection then
		self.ancestryConnection:Disconnect()
	end
	if self.controls then
		self.controls:Enable()
	end
	if Telemetry.sim == self.sim then
		Telemetry.sim = nil
	end
end

return VehicleController
]]></ProtectedString>
